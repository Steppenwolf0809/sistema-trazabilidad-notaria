{{! Detalle de Documento - Archivo }}
{{#if documento}}
<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <div>
      <i class="fas fa-file-alt me-2"></i> Detalle de Documento
    </div>
    <div>
      <a href="/archivo/documentos/mis-documentos" class="btn btn-sm btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i> Volver
      </a>
      
      {{#if esDocumentoPropio}}
        <a href="/archivo/documentos/editar/{{documento.id}}" class="btn btn-sm btn-primary ms-1">
          <i class="fas fa-edit me-1"></i> Editar
        </a>
        
        {{#if (eq documento.estado "en_proceso")}}
        <button type="button" class="btn btn-sm btn-success ms-1" onclick="marcarListo({{documento.id}})">
          <i class="fas fa-check me-1"></i> Marcar como listo
        </button>
        {{/if}}
        
        {{#if (eq documento.estado "listo_para_entrega")}}
        <a href="/archivo/documentos/entrega/{{documento.id}}" class="btn btn-sm btn-info ms-1">
          <i class="fas fa-hand-holding me-1"></i> Entrega
        </a>
        {{/if}}
      {{else}}
        <span class="badge bg-warning">Solo Lectura</span>
      {{/if}}
    </div>
  </div>
  <div class="card-body">
    <!-- Información general -->
    <div class="row mb-4">
      <div class="col-md-4">
        <div class="mb-3">
          <h5 class="border-bottom pb-2">Información General</h5>
          <p><strong>Número Documento:</strong> <span class="badge bg-primary fs-6">{{documento.codigoBarras}}</span></p>
          <p><strong>Tipo:</strong> {{documento.tipoDocumento}}</p>
          <p><strong>Estado:</strong> 
            {{#if (eq documento.estado "en_proceso")}}
            <span class="badge bg-warning">En Proceso</span>
            {{else if (eq documento.estado "listo_para_entrega")}}
            <span class="badge bg-success">Listo para Entrega</span>
            {{else if (eq documento.estado "entregado")}}
            <span class="badge bg-primary">Entregado</span>
            {{else if (eq documento.estado "cancelado")}}
            <span class="badge bg-danger">Cancelado</span>
            {{else}}
            <span class="badge bg-secondary">{{documento.estado}}</span>
            {{/if}}
          </p>
          <p><strong>📅 Fecha Documento:</strong> {{formatDate documento.fechaFactura}}</p>
          {{#if documento.fechaEntrega}}
          <p><strong>🚀 Fecha Entrega:</strong> {{formatDate documento.fechaEntrega}}</p>
          {{/if}}
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="mb-3">
          <h5 class="border-bottom pb-2">Cliente</h5>
          <p><strong>Nombre:</strong> {{documento.nombreCliente}}</p>
          <p><strong>Identificación:</strong> {{documento.identificacionCliente}}</p>
          {{#if documento.emailCliente}}
          <p><strong>Email:</strong> {{documento.emailCliente}}</p>
          {{/if}}
          {{#if documento.telefonoCliente}}
          <p><strong>Teléfono:</strong> {{documento.telefonoCliente}}</p>
          {{/if}}
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="mb-3">
          <h5 class="border-bottom pb-2">Responsable</h5>
          <p><strong>Matrizador:</strong> {{documento.matrizador.nombre}}</p>
          {{#if esDocumentoPropio}}
            <p><strong>Mi Documento:</strong> <span class="badge bg-success">✅ Asignado a mí</span></p>
            {{#if (eq documento.estado "listo_para_entrega")}}
            <p><strong>🔑 Código de Entrega:</strong> 
              <span class="badge bg-success fs-5">{{documento.codigoVerificacion}}</span>
            </p>
            {{/if}}
          {{else}}
            <p><strong>Acceso:</strong> <span class="badge bg-warning">Solo Lectura</span></p>
          {{/if}}
        </div>
      </div>
    </div>

    <!-- ============== SECCIÓN DE NOTIFICACIONES GRUPALES ============== -->
    {{#if esDocumentoPropio}}
    <div class="row mb-4">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h5 class="mb-0">
              <i class="fas fa-users me-2"></i>Sistema de Notificaciones Grupales
              <small class="text-muted">(Solo documentos propios)</small>
            </h5>
          </div>
          <div class="card-body">
            <!-- Información de grupo actual -->
            <div id="infoGrupoActual">
              {{#if documento.notificacionGrupal}}
                <div class="alert alert-info">
                  <div class="d-flex justify-content-between align-items-start">
                    <div>
                      <h6><i class="fas fa-users me-1"></i> Documento en Grupo</h6>
                      <p class="mb-1"><strong>Código del Grupo:</strong> <span class="badge bg-primary">{{documento.notificacionGrupal.codigoVerificacion}}</span></p>
                      <p class="mb-1"><strong>Total de Documentos:</strong> {{documento.notificacionGrupal.totalDocumentos}}</p>
                      <p class="mb-1"><strong>Rol en el Grupo:</strong> 
                        {{#if documento.esLiderGrupo}}
                          <span class="badge bg-success">👑 Líder del Grupo</span>
                        {{else}}
                          <span class="badge bg-secondary">👥 Miembro del Grupo</span>
                        {{/if}}
                      </p>
                      <p class="mb-0"><small class="text-muted">Creado: {{formatDateTime documento.notificacionGrupal.fechaCreacion}}</small></p>
                    </div>
                    <div>
                      <button type="button" class="btn btn-sm btn-outline-danger" onclick="abrirModalSeparar()">
                        <i class="fas fa-unlink me-1"></i> Separar
                      </button>
                    </div>
                  </div>
                </div>
              {{else}}
                <div class="alert alert-light">
                  <h6><i class="fas fa-info-circle me-1"></i> Documento Individual</h6>
                  <p class="mb-2">Este documento no pertenece a ningún grupo de notificación.</p>
                  <button type="button" class="btn btn-sm btn-primary" onclick="abrirModalAgrupar()">
                    <i class="fas fa-plus me-1"></i> Agrupar con otros documentos
                  </button>
                  {{!-- 💡 AVISO INFORMATIVO PARA ARCHIVO --}}
                  <div class="mt-3 pt-2 border-top">
                    <small class="text-muted d-flex align-items-start">
                      <i class="fas fa-lightbulb me-2 mt-1 opacity-75" style="font-size: 0.8rem;"></i>
                      <span>
                        <strong>Código grupal:</strong> Se generará automáticamente cuando agrupe documentos propios del mismo cliente. 
                        Solo puede agrupar documentos que le pertenecen.
                      </span>
                    </small>
                  </div>
                </div>
              {{/if}}
            </div>
          </div>
        </div>
      </div>
    </div>
    {{/if}}
    <!-- ============== FIN SECCIÓN NOTIFICACIONES GRUPALES ============== -->
        </div>
      </div>
    </div>
    
    <!-- Información financiera -->
    {{#if documento.valorFactura}}
    <div class="row mb-4">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-money-bill-wave me-2"></i>Información Financiera</h5>
          </div>
          <div class="card-body">
            <div class="row">
              <div class="col-md-6">
                <p><strong>💰 Valor Total:</strong> <span class="fs-5 text-primary">${{formatMoney documento.valorFactura}}</span></p>
                <p><strong>🏷️ Estado Pago:</strong> 
                  {{#if (eq documento.estadoPago "pagado_completo")}}
                  <span class="badge bg-success">Pagado Completo</span>
                  {{else if (eq documento.estadoPago "pagado_con_retencion")}}
                  <span class="badge bg-info">Con Retención</span>
                  {{else if (eq documento.estadoPago "pago_parcial")}}
                  <span class="badge bg-warning">Pago Parcial</span>
                  {{else}}
                  <span class="badge bg-danger">Pendiente</span>
                  {{/if}}
                </p>
              </div>
              <div class="col-md-6">
                {{#if documento.metodoPago}}
                <p><strong>💳 Método de Pago:</strong> {{documento.metodoPago}}</p>
                {{/if}}
                {{#if documento.fechaPago}}
                <p><strong>📅 Fecha de Pago:</strong> {{formatDateTime documento.fechaPago}}</p>
                {{/if}}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    {{/if}}
    
    <!-- Notas -->
    {{#if documento.notas}}
    <div class="row mb-4">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-sticky-note me-2"></i>Notas</h5>
          </div>
          <div class="card-body">
            <p>{{documento.notas}}</p>
          </div>
        </div>
      </div>
    </div>
    {{/if}}
    
    <!-- 🆕 HISTORIAL UNIVERSAL -->
    {{> historial-universal eventos=eventos}}
  </div>
</div>
{{else}}
<div class="alert alert-danger">
  <h4>Documento no encontrado</h4>
  <p>El documento solicitado no existe o no tienes permisos para verlo.</p>
  <a href="/archivo/documentos/mis-documentos" class="btn btn-primary">Volver a mis documentos</a>
</div>
{{/if}}

<!-- CSS eliminado - Ahora usa el sistema universal -->

<!-- Incluir sistema de notificaciones grupales para archivo -->
<script src="/js/notificaciones-grupales.js"></script>
<script>
// Configuración específica para archivo
window.NOTIFICACIONES_GRUPALES_CONFIG = {
  documentoId: {{documento.id}},
  documentoCodigoBarras: '{{documento.codigoBarras}}',
  clienteIdentificacion: '{{documento.identificacionCliente}}',
  esDocumentoPropio: {{#if esDocumentoPropio}}true{{else}}false{{/if}},
  perteneceAGrupo: {{#if documento.notificacionGrupal}}true{{else}}false{{/if}},
  esLiderGrupo: {{#if documento.esLiderGrupo}}true{{else}}false{{/if}},
  endpoints: {
    detectar: '/archivo/api/documentos/{{documento.id}}/detectar-notificacion',
    crear: '/archivo/api/grupos-notificacion/crear',
    separar: '/archivo/api/grupos-notificacion/{{documento.id}}/separar',
    marcarListo: '/archivo/api/documentos/{{documento.id}}/marcar-listo-grupo'
  },
  interfaz: {
    contenedorInfo: '#infoGrupoActual',
    botonMarcarListo: 'button[onclick*="marcarListo"]'
  }
};

// Función original de marcar listo (interceptada por el sistema de grupos)
function marcarListo(documentoId) {
  // Esta función será interceptada por el sistema de notificaciones grupales
  // si el documento pertenece a un grupo
  
  if (confirm('¿Está seguro de marcar este documento como listo para entrega?')) {
    fetch(`/archivo/documentos/marcar-listo/${documentoId}`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.exito) {
        alert('Documento marcado como listo exitosamente');
        location.reload();
      } else if (data.requiereConfirmacionGrupo) {
        // Redirigir al sistema de grupos
        if (window.notificacionesGrupales) {
          window.notificacionesGrupales.mostrarModalMarcarGrupo(data.grupo);
        }
      } else {
        alert('Error: ' + data.mensaje);
      }
    })
    .catch(error => {
      console.error('Error:', error);
      alert('Error al marcar documento como listo');
    });
  }
}

// Funciones para modales de notificaciones grupales
function abrirModalAgrupar() {
  if (window.notificacionesGrupales) {
    window.notificacionesGrupales.abrirModalAgrupar();
  } else {
    alert('Sistema de notificaciones grupales no disponible');
  }
}

function abrirModalSeparar() {
  if (window.notificacionesGrupales) {
    window.notificacionesGrupales.abrirModalSeparar();
  } else {
    alert('Sistema de notificaciones grupales no disponible');
  }
}

// Inicializar sistema de notificaciones grupales cuando el DOM esté listo
document.addEventListener('DOMContentLoaded', function() {
  if (window.NotificacionesGrupales && window.NOTIFICACIONES_GRUPALES_CONFIG.esDocumentoPropio) {
    window.notificacionesGrupales = new NotificacionesGrupales(window.NOTIFICACIONES_GRUPALES_CONFIG);
    console.log('✅ Sistema de notificaciones grupales inicializado para archivo');
  }
});
</script> 