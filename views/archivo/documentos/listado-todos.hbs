<!-- HEADER PROFESIONAL CON PALETA AZUL -->
<div class="dashboard-header">
  <div class="container-fluid">
    <div class="row align-items-center">
      <div class="col-md-8">
        <h2 class="dashboard-title">
          <i class="fas fa-list me-3"></i>Todos los Documentos del Sistema
        </h2>
        <p class="dashboard-subtitle">Vista completa de documentos en el sistema</p>
      </div>
      <div class="col-md-4 text-end">
        <a href="/archivo" class="btn btn-secondary">
          <i class="fas fa-arrow-left me-1"></i> Volver al Dashboard
        </a>
      </div>
    </div>
  </div>
</div>

<!-- FILTROS PROFESIONALES -->
<div class="tarjeta-contenido">
  <div class="seccion-titulo">🔍 Filtros de Búsqueda</div>
  <form method="GET" action="/archivo/documentos/todos" id="filtrosFormArchivo">
    <div class="row">
      <div class="col-md-3 mb-3">
        <label for="buscar" class="form-label">Buscar</label>
        <input type="text" 
               class="form-input" 
               id="buscar" 
               name="buscar" 
               placeholder="Protocolo, cliente, identificación..."
               value="{{filtros.buscar}}">
      </div>
      <div class="col-md-2 mb-3">
        <label for="estado" class="form-label">Estado</label>
        <select class="form-input" id="estado" name="estado">
          <option value="">Todos</option>
          <option value="proceso" {{#if (eq filtros.estado 'proceso')}}selected{{/if}}>En Proceso</option>
          <option value="listo" {{#if (eq filtros.estado 'listo')}}selected{{/if}}>Listo</option>
          <option value="entregado" {{#if (eq filtros.estado 'entregado')}}selected{{/if}}>Entregado</option>
          <option value="cancelado" {{#if (eq filtros.estado 'cancelado')}}selected{{/if}}>Cancelado</option>
        </select>
      </div>
      <div class="col-md-2 mb-3">
        <label for="estadoPago" class="form-label">Estado Pago</label>
        <select class="form-input" id="estadoPago" name="estadoPago">
          <option value="">Todos</option>
          <option value="pendiente" {{#if (eq filtros.estadoPago 'pendiente')}}selected{{/if}}>Pendiente</option>
          <option value="pago_parcial" {{#if (eq filtros.estadoPago 'pago_parcial')}}selected{{/if}}>Pago Parcial</option>
          <option value="pagado_completo" {{#if (eq filtros.estadoPago 'pagado_completo')}}selected{{/if}}>Pagado Completo</option>
          <option value="pagado_con_retencion" {{#if (eq filtros.estadoPago 'pagado_con_retencion')}}selected{{/if}}>Con Retención</option>
        </select>
      </div>
      <div class="col-md-2 mb-3">
        <label for="tipoDocumento" class="form-label">Tipo</label>
        <select class="form-input" id="tipoDocumento" name="tipoDocumento">
          <option value="">Todos</option>
          <option value="Protocolo" {{#if (eq filtros.tipoDocumento 'Protocolo')}}selected{{/if}}>Protocolo</option>
          <option value="Diligencias" {{#if (eq filtros.tipoDocumento 'Diligencias')}}selected{{/if}}>Diligencias</option>
          <option value="Certificaciones" {{#if (eq filtros.tipoDocumento 'Certificaciones')}}selected{{/if}}>Certificaciones</option>
          <option value="Arrendamientos" {{#if (eq filtros.tipoDocumento 'Arrendamientos')}}selected{{/if}}>Arrendamientos</option>
          <option value="Otros" {{#if (eq filtros.tipoDocumento 'Otros')}}selected{{/if}}>Otros</option>
        </select>
      </div>
      <div class="col-md-2 mb-3">
        <label for="matrizador" class="form-label">Matrizador</label>
        <select class="form-input" id="matrizador" name="matrizador">
          <option value="">Todos</option>
          {{#each matrizadores}}
          <option value="{{this.id}}" {{#if (eq ../filtros.matrizador this.id)}}selected{{/if}}>
            {{this.nombre}}
          </option>
          {{/each}}
        </select>
      </div>
      <div class="col-md-1 d-flex align-items-end mb-3">
        <button type="submit" class="btn btn-primary w-100">
          <i class="fas fa-search"></i>
        </button>
      </div>
    </div>
    <div class="row">
      <div class="col-md-12">
        <a href="/archivo/documentos/todos" class="btn btn-secondary btn-sm">
          <i class="fas fa-times me-1"></i>
          Limpiar Filtros
        </a>
      </div>
    </div>
  </form>
</div>

<!-- TABLA PROFESIONAL CON PALETA AZUL -->
<div class="tarjeta-contenido">
  <div class="seccion-titulo">
    📋 Resultados de la Búsqueda
    <div class="float-end">
      <span class="badge bg-light text-dark">{{paginacion.totalDocuments}} documento(s)</span>
      <span class="badge badge-info ms-2">Solo lectura para documentos ajenos</span>
    </div>
  </div>
  
  <div class="table-responsive">
    <table class="tabla-moderna tabla-ordenable" id="tablaDocumentosArchivo">
      <thead>
        <tr>
          <th class="col-codigo ordenable" data-columna="codigoBarras" data-tipo="texto" style="width: 26%;">
            <span>Código</span>
            <i class="fas fa-sort ms-1 sort-icon"></i>
          </th>
          <th class="col-cliente ordenable" data-columna="nombreCliente" data-tipo="texto" style="width: 30%;">
            <span>Cliente</span>
            <i class="fas fa-sort ms-1 sort-icon"></i>
          </th>
          <th class="col-matrizador ordenable" data-columna="matrizador" data-tipo="texto" style="width: 8%;">
            <span>Matrizador</span>
            <i class="fas fa-sort ms-1 sort-icon"></i>
          </th>
          <th class="col-fecha ordenable" data-columna="fechaFactura" data-tipo="fecha" style="width: 7%;">
            <span>Fecha</span>
            <i class="fas fa-sort ms-1 sort-icon"></i>
          </th>
          <th class="col-estados ordenable" data-columna="estado" data-tipo="texto" style="width: 15%;">
            <span>Estados</span>
            <i class="fas fa-sort ms-1 sort-icon"></i>
          </th>
          <th class="col-valor ordenable" data-columna="valorFactura" data-tipo="numero" style="width: 8%;">
            <span>Valor</span>
            <i class="fas fa-sort ms-1 sort-icon"></i>
          </th>
          <th class="col-acciones" style="width: 6%;">
            Ver
          </th>
        </tr>
      </thead>
    <tbody>
      {{#each documentos}}
      <tr data-documento-id="{{this.id}}" {{#if (esDocumentoAjeno ../usuario this)}}class="documento-ajeno"{{/if}}>
        <!-- Código con paleta profesional -->
        <td class="col-codigo">
            <a href="/archivo/documentos/detalle/{{this.id}}" class="codigo-link" title="{{this.codigoBarras}} - Click para ver detalles">
                {{this.codigoBarras}}
            </a>
            <div class="tipo-documento">
                <span class="badge badge-info">{{this.tipoDocumento}}</span>
            </div>
            {{#if (esDocumentoAjeno ../usuario this)}}
            <span class="badge bg-warning text-dark ms-1">AJENO</span>
            {{/if}}
        </td>
        
        <!-- Cliente optimizado -->
        <td class="col-cliente">
          <div class="cliente-nombre"><strong>{{this.nombreCliente}}</strong></div>
          <div class="cliente-identificacion text-muted">{{this.identificacionCliente}}</div>
        </td>
        
        <!-- Matrizador -->
        <td class="col-matrizador text-center">
          {{#if this.matrizador}}
          <span class="badge badge-info" title="{{this.matrizador.nombre}}">
            {{getIniciales this.matrizador.nombre}}
          </span>
          {{else}}
          <span class="badge bg-secondary" title="Sin asignar">
            --
          </span>
          {{/if}}
        </td>
        
        <!-- Fecha -->
        <td class="col-fecha">
          {{#if this.fechaFactura}}
          <span class="fecha-universal">{{formatFechaCorta this.fechaFactura}}</span>
          {{else}}
          <span class="fecha-universal sin-fecha text-muted">--/--/--</span>
          {{/if}}
        </td>
        
        <!-- Estados con paleta -->
        <td class="col-estados">
          <div class="estados-container">
            <div class="estado-entrega">
              {{{badgeEstadoEntrega this.estado}}}
            </div>
            <div class="estado-pago mt-1">
              {{#if this.numeroFactura}}
                {{{badgeEstadoPago this.estadoPago}}}
              {{else}}
                <span class="badge bg-secondary badge-sm" title="Sin factura">
                    <i class="fas fa-file-invoice-dollar"></i> S/F
                </span>
              {{/if}}
            </div>
          </div>
        </td>
        
        <!-- Valor -->
        <td class="col-valor text-end">
          {{#if this.valorFactura}}
          <span class="valor-monetario">{{formatDineroCompleto this.valorFactura}}</span>
          {{else}}
          <span class="valor-monetario text-muted">$0.00</span>
          {{/if}}
        </td>
        
        <!-- Acciones con paleta -->
        <td class="col-acciones text-center">
          <a href="/archivo/documentos/detalle/{{this.id}}" class="btn btn-primary btn-sm">
            <i class="fas fa-eye me-1"></i><span class="d-none d-lg-inline">Ver</span>
          </a>
        </td>
      </tr>
      {{else}}
      <tr>
        <td colspan="7" class="text-center py-5">
          <div class="sin-resultados">
            <i class="fas fa-search fa-2x mb-3 text-muted"></i>
            <h5 class="text-muted">No se encontraron documentos</h5>
            <p class="mb-0 text-muted">Pruebe ajustando los filtros de búsqueda</p>
          </div>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  </div>
</div>

<!-- PAGINACIÓN PROFESIONAL -->
{{#if (gt paginacion.totalPages 1)}}
<nav aria-label="Paginación de documentos" class="mt-4">
    <ul class="pagination justify-content-center">
        {{#if paginacion.hasPrevPage}}
            <li class="page-item">
                <a class="page-link" href="?page={{paginacion.prevPage}}&{{#each filtros}}{{@key}}={{this}}&{{/each}}" style="color: var(--tufts-blue); border-color: var(--jordy-blue-30);">
                    <i class="fas fa-chevron-left"></i>
                </a>
            </li>
        {{/if}}
        
        {{#each (range 1 paginacion.totalPages)}}
            <li class="page-item {{#if (eq this ../paginacion.currentPage)}}active{{/if}}">
                <a class="page-link" href="?page={{this}}&{{#each ../filtros}}{{@key}}={{this}}&{{/each}}">
                    {{this}}
                </a>
            </li>
        {{/each}}
        
        {{#if paginacion.hasNextPage}}
            <li class="page-item">
                <a class="page-link" href="?page={{paginacion.nextPage}}&{{#each filtros}}{{@key}}={{this}}&{{/each}}">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        {{/if}}
    </ul>
</nav>
{{/if}}

<!-- Información adicional -->
<div class="row mt-4">
    <div class="col-md-12">
        <div class="alert alert-info">
            <h6><i class="bi bi-info-circle me-2"></i>Información sobre la Vista</h6>
            <ul class="mb-0">
                <li><strong>Visualización:</strong> Esta vista muestra TODOS los documentos del sistema de todos los matrizadores</li>
                <li><strong>Tus documentos:</strong> Los documentos asignados a ti aparecen marcados con <i class="bi bi-person-check text-success"></i></li>
                <li><strong>Permisos:</strong> Solo puedes editar documentos asignados a ti (marcados en verde)</li>
                <li><strong>Documentos ajenos:</strong> Solo tienes acceso de lectura (marcados con <i class="bi bi-lock"></i>)</li>
                <li><strong>Ordenamiento:</strong> Haz clic en los encabezados de columna para ordenar los documentos</li>
            </ul>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    console.log('🎯 Inicializando tabla ARCHIVO - Sistema Universal v2.0 OPTIMIZADA');
    
    // Inicializar ordenamiento manual corregido
    inicializarOrdenamientoManual();
    
    // ✨ INICIALIZAR TOOLTIPS PARA TEXTOS TRUNCADOS
    const tooltipTriggerList = [].slice.call(document.querySelectorAll('[title]'));
    const tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
      return new bootstrap.Tooltip(tooltipTriggerEl, {
        placement: 'top',
        trigger: 'hover'
      });
    });
    
    console.log('✅ Vista ARCHIVO migrada al sistema universal - Funcionalidad completa + Tooltips activos');
});

// Función de ordenamiento manual específica para ARCHIVO
function inicializarOrdenamientoManual() {
    console.log('🔧 Inicializando ordenamiento manual para ARCHIVO');
    
    // Buscar todos los headers ordenables
    const headersOrdenables = document.querySelectorAll('.tabla-ordenable th.ordenable');
    
    headersOrdenables.forEach(header => {
      header.style.cursor = 'pointer';
      header.addEventListener('click', function() {
        const columna = this.getAttribute('data-columna');
        const tipoColumna = this.getAttribute('data-tipo') || 'texto';
        
        console.log('📊 Click en columna ARCHIVO:', columna, tipoColumna);
        
        // Obtener dirección actual
        let direccion = 'asc';
        if (this.classList.contains('asc')) {
          direccion = 'desc';
        } else if (this.classList.contains('desc')) {
          direccion = 'asc';
        }
        
        // Limpiar otros headers
        headersOrdenables.forEach(h => {
          h.classList.remove('asc', 'desc', 'active');
          const icono = h.querySelector('.sort-icon');
          if (icono) {
            icono.className = 'fas fa-sort ms-1 sort-icon';
          }
        });
        
        // Marcar header actual
        this.classList.add(direccion, 'active');
        const icono = this.querySelector('.sort-icon');
        if (icono) {
          icono.className = `fas fa-sort-${direccion} ms-1 sort-icon`;
        }
        
        // Ejecutar ordenamiento por servidor
        const params = new URLSearchParams(window.location.search);
        params.set('ordenarPor', columna);
        params.set('ordenDireccion', direccion);
        
        window.location.search = params.toString();
      });
    });
    
    console.log('✅ Ordenamiento manual configurado para ARCHIVO:', headersOrdenables.length, 'columnas');
}

function limpiarFiltrosArchivo() {
    document.getElementById('busqueda').value = '';
    document.getElementById('estado').value = '';
    document.getElementById('estadoPago').value = '';
    document.getElementById('tipoDocumento').value = '';
    document.getElementById('matrizadorId').value = '';
    document.getElementById('fechaDesde').value = '';
    document.getElementById('fechaHasta').value = '';
    document.getElementById('filtrosFormArchivo').submit(); 
}
</script>

<!-- Estilos específicos para archivo optimizados -->
<style>
