{{! Dashboard de Archivo - MODERNIZADO CON PALETA PROFESIONAL }}
{{! layout: 'archivo' }}

<!-- HEADER PROFESIONAL CON PALETA AZUL -->
<div class="dashboard-header">
  <div class="container-fluid">
    <div class="row align-items-center">
      <div class="col-md-8">
        <h2 class="dashboard-title"><i class="fas fa-eye me-3"></i>Dashboard Archivo</h2>
        <p class="dashboard-subtitle">Vista general del estado de documentos</p>
      </div>
      <div class="col-md-4 text-end">
        <div class="badge bg-light text-dark p-2">
          <i class="fas fa-clock me-1"></i>
          {{formatDate now 'DD/MM/YYYY HH:mm'}}
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 4 TARJETAS PRINCIPALES EN UNA SOLA FILA -->
<div class="row mb-4">
  <!-- DOCUMENTOS EN PROCESO -->
  <div class="col-xl-3 col-lg-6 mb-3">
    <div class="tarjeta-kpi">
      <div class="kpi-header">
        <div class="kpi-icono naranja">
          <i class="fas fa-cog"></i>
        </div>
        <div class="kpi-info">
          <div class="kpi-etiqueta">⚠️ En Proceso</div>
          <div class="kpi-numero">{{documentos_en_proceso}}</div>
          <div class="kpi-descripcion">Documentos trabajándose</div>
        </div>
      </div>
    </div>
  </div>

  <!-- DOCUMENTOS LISTOS -->
  <div class="col-xl-3 col-lg-6 mb-3">
    <div class="tarjeta-kpi">
      <div class="kpi-header">
        <div class="kpi-icono azul">
          <i class="fas fa-check-circle"></i>
        </div>
        <div class="kpi-info">
          <div class="kpi-etiqueta">✅ Listos</div>
          <div class="kpi-numero">{{documentos_listos}}</div>
          <div class="kpi-descripcion">Para entrega</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ENTREGADOS HOY -->
  <div class="col-xl-3 col-lg-6 mb-3">
    <div class="tarjeta-kpi">
      <div class="kpi-header">
        <div class="kpi-icono verde">
          <i class="fas fa-handshake"></i>
        </div>
        <div class="kpi-info">
          <div class="kpi-etiqueta">📤 Entregados Hoy</div>
          <div class="kpi-numero">{{documentos_entregados_hoy}}</div>
          <div class="kpi-descripcion">Productividad del día</div>
        </div>
      </div>
    </div>
  </div>

  <!-- TOTAL DEL MES -->
  <div class="col-xl-3 col-lg-6 mb-3">
    <div class="tarjeta-kpi">
      <div class="kpi-header">
        <div class="kpi-icono purpura">
          <i class="fas fa-chart-bar"></i>
        </div>
        <div class="kpi-info">
          <div class="kpi-etiqueta">📊 Este Mes</div>
          <div class="kpi-numero">{{documentos_entregados_mes}}</div>
          <div class="kpi-descripcion">Total entregados</div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ACCESO RÁPIDO CON BOTONES PROFESIONALES -->
<div class="tarjeta-contenido">
  <div class="seccion-titulo">🚀 Acceso Rápido</div>
  <div class="row">
    <div class="col-md-4 mb-3">
      <a href="/archivo/documentos/todos" class="btn btn-primary w-100">
        <i class="fas fa-list me-2"></i> Todos los Documentos
      </a>
    </div>
    <div class="col-md-4 mb-3">
      <a href="/archivo/documentos/mis-documentos" class="btn btn-secondary w-100">
        <i class="fas fa-user me-2"></i> Mis Documentos
      </a>
    </div>
    <div class="col-md-4 mb-3">
      <a href="/archivo/notificaciones/historial" class="btn btn-secondary w-100">
        <i class="fas fa-bell me-2"></i> Historial Notificaciones
      </a>
    </div>
  </div>
</div>

<!-- DOCUMENTOS ATRASADOS CON DISEÑO PROFESIONAL -->
{{#if documentosAtrasados.length}}
<div class="tarjeta-contenido">
  <div class="seccion-titulo text-danger">
    <i class="fas fa-exclamation-triangle me-2"></i>
    Documentos Atrasados (más de 15 días)
    <span class="badge bg-danger ms-2">{{totalAtrasados}}</span>
  </div>
  <div class="table-responsive">
    <table class="tabla-moderna">
      <thead>
        <tr>
          <th width="22%">Código Completo</th>
          <th width="33%">Cliente</th>
          <th width="10%">Tipo</th>
          <th width="20%">Matrizador</th>
          <th width="10%">Días</th>
          <th width="5%">Acciones</th>
        </tr>
      </thead>
      <tbody>
        {{#each documentosAtrasados}}
        <tr class="{{#gt diasTranscurridos 30}}table-danger{{else}}{{#gt diasTranscurridos 20}}table-warning{{else}}table-info{{/gt}}{{/gt}}">
          <td>
            <a href="/archivo/documentos/detalle/{{id}}" class="codigo-link">
              {{codigoBarras}}
            </a>
          </td>
          <td>
            <strong>{{nombreCliente}}</strong>
          </td>
          <td>
            <span class="badge badge-info">
              {{abreviarTipoDocumento tipoDocumento}}
            </span>
          </td>
          <td>
            {{#if matrizador.nombre}}
              <small>{{matrizador.nombre}}</small>
            {{else}}
              <span class="text-danger"><strong>Sin asignar</strong></span>
            {{/if}}
          </td>
          <td>
            <span class="badge bg-{{clasePrioridad}}">{{diasTranscurridos}}d</span>
          </td>
          <td>
            <a href="/archivo/documentos/detalle/{{id}}" class="btn btn-outline-primary btn-sm" title="Ver detalles">
              <i class="fas fa-eye"></i>
            </a>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
{{else}}
<div class="alert alert-success" role="alert">
  <i class="fas fa-check-circle me-2"></i>
  <strong>¡Excelente!</strong> No hay documentos atrasados en este momento.
</div>
{{/if}}

<!-- ESTILOS ADICIONALES PARA CÓDIGO CLICKEABLE -->
<style>
.codigo-link {
  color: var(--tufts-blue);
  text-decoration: none;
  font-weight: 500;
  font-family: 'Courier New', monospace;
  padding: 2px 6px;
  background: var(--alice-blue);
  border-radius: 4px;
  transition: all 0.3s ease;
}

.codigo-link:hover {
  color: var(--cobalt-blue);
  background: var(--jordy-blue-30);
  text-decoration: none;
  transform: translateY(-1px);
}

/* Optimizaciones para móvil */
@media (max-width: 768px) {
  .dashboard-header {
    padding: var(--spacing-lg);
  }
  
  .dashboard-title {
    font-size: 1.5rem;
  }
  
  .btn {
    min-height: 48px;
  }
}
</style>

<!-- JavaScript mejorado para UX -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Animación de aparición de tarjetas
  const tarjetas = document.querySelectorAll('.tarjeta-kpi');
  tarjetas.forEach((tarjeta, index) => {
    tarjeta.style.opacity = '0';
    tarjeta.style.transform = 'translateY(20px)';
    setTimeout(() => {
      tarjeta.style.transition = 'all 0.3s ease';
      tarjeta.style.opacity = '1';
      tarjeta.style.transform = 'translateY(0)';
    }, index * 100);
  });

  // Mejorar accesibilidad de códigos
  const codigoLinks = document.querySelectorAll('.codigo-link');
  codigoLinks.forEach(link => {
    if (link.textContent.length > 15) {
      link.title = link.textContent;
    }
  });

  console.log('📊 Dashboard de Archivo Modernizado - Paleta Profesional Aplicada');
});
</script> 