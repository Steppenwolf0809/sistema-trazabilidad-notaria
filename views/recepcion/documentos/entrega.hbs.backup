{{! Entrega de Documento - Recepción }}
{{! layout: 'recepcion' }}
<div class="container-fluid" data-user-role="recepcion">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-handshake me-2"></i>Entrega de Documentos - Recepción</h2>
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/recepcion">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/recepcion/documentos">Documentos</a></li>
            <li class="breadcrumb-item active">Entrega</li>
          </ol>
        </nav>
      </div>

      {{!-- Mensajes de estado --}}
      {{#if error}}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <i class="fas fa-exclamation-triangle me-2"></i>{{error}}
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      {{/if}}

      {{#if success}}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <i class="fas fa-check-circle me-2"></i>{{success}}
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      {{/if}}

      {{#if documento}}

        {{!-- ============== 1. DOCUMENTO PRINCIPAL CON INFORMACIÓN COMPLETA ============== --}}
        <div class="card mb-3 table-universal-card">
          <div class="card-header bg-info text-white table-universal-header">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h5 class="mb-1">
                  <i class="fas fa-file-alt me-2"></i>📄 Documento Principal: {{documento.codigoBarras}}
                </h5>
                <small class="opacity-75">
                  <strong>Código de Verificación:</strong> 
                  {{#if documento.codigoVerificacion}}
                    {{#if (eq documento.codigoVerificacion 'sin_codigo')}}
                      <span class="badge bg-warning text-dark">Sin código</span>
                    {{else}}
                      <code class="bg-light text-dark px-2 py-1 rounded">{{documento.codigoVerificacion}}</code>
                    {{/if}}
                  {{else}}
                    <span class="badge bg-warning text-dark">Sin código</span>
                  {{/if}}
                </small>
              </div>
              <span class="badge bg-light text-dark fs-6">{{documento.tipoDocumento}}</span>
            </div>
          </div>
          <div class="card-body table-universal-body">
            <div class="row">
              <div class="col-md-3">
                <h6><i class="fas fa-user me-1"></i> Cliente</h6>
                <p class="mb-1"><strong>{{documento.nombreCliente}}</strong></p>
                <p class="text-muted mb-0"><small>{{documento.identificacionCliente}}</small></p>
              </div>
              <div class="col-md-3">
                <h6><i class="fas fa-user-tie me-1"></i> Matrizador</h6>
                <p class="mb-1"><strong>{{#if documento.matrizador}}{{documento.matrizador.nombre}}{{else}}Sin asignar{{/if}}</strong></p>
                <p class="text-muted mb-0"><small>Responsable</small></p>
              </div>
              <div class="col-md-3">
                <h6><i class="fas fa-dollar-sign me-1"></i> Valor</h6>
                <p class="mb-1"><strong>${{formatMoney documento.valorFactura}}</strong></p>
                <p class="text-muted mb-0"><small>{{#if documento.numeroFactura}}Fact: {{documento.numeroFactura}}{{else}}Sin factura{{/if}}</small></p>
              </div>
              <div class="col-md-3">
                <h6><i class="fas fa-credit-card me-1"></i> Estado Pago</h6>
                {{#if documento.entrega_sin_verificar_pago}}
                  {{!-- DOCUMENTO CON CRÉDITO AUTORIZADO --}}
                  <div class="d-flex flex-column gap-1">
                    <span class="badge bg-success fs-6">
                      <i class="fas fa-shield-check me-1"></i>CRÉDITO AUTORIZADO
                    </span>
                    <small class="text-success">
                      <i class="fas fa-info-circle me-1"></i>
                      {{#if (eq documento.justificacion_entrega_sin_pago 'historial_pagos')}}
                        Cliente con excelente historial de pagos
                      {{else if (eq documento.justificacion_entrega_sin_pago 'cliente_corporativo')}}
                        Cliente corporativo autorizado
                      {{else if (eq documento.justificacion_entrega_sin_pago 'emergencia')}}
                        Entrega por emergencia autorizada
                      {{else}}
                        {{documento.justificacion_entrega_sin_pago}}
                      {{/if}}
                    </small>
                  </div>
                {{else}}
                  {{!-- ESTADO DE PAGO NORMAL --}}
                  <span class="badge {{estadoPagoClass documento.estadoPago}} fs-6">
                    {{estadoPagoTexto documento.estadoPago}}
                  </span>
                  {{#if (eq documento.estadoPago 'pendiente')}}
                    <br><small class="text-warning">
                      <i class="fas fa-exclamation-triangle me-1"></i>
                      Requiere verificación de pago
                    </small>
                  {{/if}}
                {{/if}}
              </div>
            </div>
          </div>
        </div>

        {{!-- ============== 2. DOCUMENTOS ADICIONALES DETECTADOS ============== --}}
        {{#if documentosGrupales.tieneDocumentosAdicionales}}
          <div class="alert alert-info" id="alerta-entrega-grupal">
            <div class="d-flex justify-content-between align-items-start">
              <div class="flex-grow-1">
                <h6><i class="fas fa-boxes me-2"></i>Documentos Adicionales Detectados</h6>
                <p class="mb-2">
                  Se encontraron <strong>{{documentosGrupales.cantidad}} documento(s) adicional(es)</strong> 
                  del mismo cliente listos para entrega.
                </p>
                <p class="mb-0 text-info">
                  <i class="fas fa-shield-alt me-1"></i>
                  <strong>Acceso Recepción:</strong> Puede entregar TODOS los documentos sin restricciones
                </p>
                
                {{!-- NUEVA INFORMACIÓN: Documentos ya entregados --}}
                {{#if documentosGrupales.tieneDocumentosEntregados}}
                  <div class="mt-2 p-2 bg-light border-start border-success border-3">
                    <small class="text-success">
                      <i class="fas fa-check-circle me-1"></i>
                      <strong>Documentos ya entregados del mismo cliente:</strong>
                    </small>
                    <div class="mt-1">
                      {{#each documentosGrupales.documentosEntregados}}
                        <small class="d-block text-muted">
                          <i class="fas fa-file-check me-1"></i>
                          {{this.codigo}} ({{this.tipo}}) - 
                          Entregado: {{formatDateTime this.fechaEntrega}}
                          {{#if this.receptor}} a {{this.receptor}}{{/if}}
                        </small>
                      {{/each}}
                    </div>
                  </div>
                {{/if}}
                
                {{!-- ============== ALERTAS INTELIGENTES SEGÚN TIPO ============== --}}
                {{#if documentosGrupales.alertas.length}}
                  <div class="mt-3" id="alertas-validacion">
                    {{#each documentosGrupales.alertas}}
                      {{#if (eq this.tipo 'credito_autorizado')}}
                        {{!-- ALERTA VERDE: Crédito autorizado --}}
                        <div class="alert alert-success border-success p-3 mb-2">
                          <div class="d-flex align-items-center">
                            <i class="fas fa-shield-check text-success fs-4 me-3"></i>
                            <div class="flex-grow-1">
                              <h6 class="mb-1 text-success">
                                <strong>✅ CRÉDITO AUTORIZADO</strong>
                              </h6>
                              <p class="mb-1">
                                <strong>{{this.codigo}}</strong> - {{this.tipoDocumento}} (${{formatMoney this.valor}})
                              </p>
                              <small class="text-success">
                                <i class="fas fa-university me-1"></i>
                                Cliente autorizado para retirar sin verificar pago previo
                                {{#if this.justificacion}}
                                  <br><i class="fas fa-info-circle me-1"></i>
                                  Justificación: <strong>{{this.justificacion}}</strong>
                                {{/if}}
                                {{#if this.fecha_autorizacion}}
                                  <br><i class="fas fa-clock me-1"></i>
                                  Autorizado: {{formatDateTime this.fecha_autorizacion}}
                                {{/if}}
                              </small>
                            </div>
                            <div class="text-end">
                              <span class="badge bg-success fs-6">
                                <i class="fas fa-check-circle me-1"></i>ENTREGA LIBRE
                              </span>
                              <br><small class="text-success">
                                <strong>{{this.matrizador}}</strong>
                              </small>
                            </div>
                          </div>
                        </div>
                      {{else if (eq this.tipo 'pago_pendiente')}}
                        {{!-- ALERTA AMARILLA: Pago pendiente --}}
                        <div class="alert alert-warning border-warning p-3 mb-2">
                          <div class="d-flex align-items-center">
                            <i class="fas fa-exclamation-triangle text-warning fs-4 me-3"></i>
                            <div class="flex-grow-1">
                              <h6 class="mb-1 text-warning">
                                <strong>⚠️ PAGO PENDIENTE</strong>
                              </h6>
                              <p class="mb-1">
                                <strong>{{this.codigo}}</strong> - {{this.tipoDocumento}} (${{formatMoney this.valor}})
                              </p>
                              <small class="text-warning">
                                <i class="fas fa-credit-card me-1"></i>
                                Estado: <strong>{{this.estadoPago}}</strong> - Requiere verificación de pago
                              </small>
                            </div>
                            <div class="text-end">
                              <span class="badge bg-warning text-dark fs-6">
                                <i class="fas fa-clock me-1"></i>VERIFICAR PAGO
                              </span>
                              <br><small class="text-muted">
                                <strong>{{this.matrizador}}</strong>
                              </small>
                            </div>
                          </div>
                        </div>
                      {{/if}}
                    {{/each}}
                  </div>
                  
                  {{!-- RESUMEN FINAL --}}
                  {{#if documentosGrupales.requiereAutorizacion}}
                    <div class="alert alert-info border-info mt-3">
                      <h6><i class="fas fa-info-circle me-2"></i>Resumen de Validación</h6>
                      <p class="mb-2">
                        <strong>{{documentosGrupales.documentosPendientes.length}} documento(s)</strong> con pago pendiente detectados.
                        Para continuar, debe confirmar que ha consultado con el matrizador responsable.
                      </p>
                    </div>
                  {{/if}}
                {{/if}}
              </div>
              <button type="button" class="btn btn-sm btn-outline-secondary" onclick="ocultarEntregaGrupal()">
                <i class="fas fa-times"></i>
              </button>
            </div>
          </div>

          {{!-- ============== NUEVA ESTRUCTURA JERÁRQUICA DE DOCUMENTOS ============== --}}
          <div class="card mb-4 table-universal-card" id="seccion-entrega-grupal">
            <div class="card-header table-universal-header">
              <div class="d-flex justify-content-between align-items-center">
                <h6 class="mb-0">
                  <i class="fas fa-sitemap me-2"></i>
                  Documentos Estructurados para Entrega
                </h6>
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" id="selectAll">
                  <label class="form-check-label" for="selectAll">
                    <strong>Seleccionar todos</strong>
                  </label>
                </div>
              </div>
            </div>
            <div class="card-body table-universal-body">
              {{!-- Encabezado con nombre del cliente --}}
              <div class="alert alert-info border-info mb-3">
                <div class="d-flex align-items-center">
                  <i class="fas fa-user me-3 fs-4"></i>
                  <div>
                    <h6 class="mb-1">📄 <strong>DOCUMENTOS PARA:</strong></h6>
                    <h5 class="mb-0 text-info"><strong>{{documento.nombreCliente}}</strong></h5>
                    <small class="text-muted">ID: {{documento.identificacionCliente}}</small>
                  </div>
                </div>
              </div>

              {{!-- Resumen de estructura --}}
              {{#if (or documentosGrupales.tieneGruposRelacionados documentosGrupales.tieneDocumentosIndependientes)}}
                <div class="resumen-estructura">
                  <div class="estadisticas">
                    <div class="estadistica">
                      <div class="numero">{{documentosGrupales.gruposRelacionados.length}}</div>
                      <div class="etiqueta">Grupos Relacionados</div>
                    </div>
                    <div class="estadistica">
                      <div class="numero">{{documentosGrupales.documentosIndependientes.length}}</div>
                      <div class="etiqueta">Documentos Independientes</div>
                    </div>
                    <div class="estadistica">
                      <div class="numero">{{documentosGrupales.cantidad}}</div>
                      <div class="etiqueta">Total Documentos</div>
                    </div>
                  </div>
                </div>
              {{/if}}

              <div class="documentos-estructurados">
                {{!-- ============== GRUPOS RELACIONADOS ============== --}}
                {{#if documentosGrupales.tieneGruposRelacionados}}
                  <div class="table-universal-section grupos-relacionados">
                    <h5 class="table-universal-section-title">🔗 DOCUMENTOS RELACIONADOS (deben entregarse juntos)</h5>
                    
                    {{#each documentosGrupales.gruposRelacionados}}
                      <div class="table-universal-group grupo-documentos" data-grupo-id="{{@index}}">
                        {{!-- Documento Principal --}}
                        <div class="table-universal-main-item documento-principal">
                          <div class="checkbox-grupo">
                            <input 
                              class="form-check-input documento-checkbox grupo-checkbox" 
                              type="checkbox" 
                              value="{{this.principal.id}}"
                              data-codigo="{{this.principal.codigoVerificacion}}"
                              data-es-grupo="true"
                              data-grupo-id="{{@index}}"
                              id="grupo_{{@index}}_principal">
                          </div>
                          
                          <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                              <div class="codigo-principal">{{this.principal.codigoBarras}}</div>
                              <div class="mt-1">
                                <div class="nombre-cliente-principal text-primary fw-semibold">{{this.principal.nombreCliente}}</div>
                                <div class="small text-muted">{{this.principal.identificacionCliente}}</div>
                              </div>
                              <div class="mt-2">
                                <span class="tipo-principal">{{this.principal.tipoDocumento}}</span>
                                <span class="badge-principal ms-2">PRINCIPAL</span>
                              </div>
                              <div class="mt-2 small text-muted">
                                <i class="fas fa-user-tie me-1"></i>
                                Matrizador: {{#if this.principal.matrizador}}{{this.principal.matrizador.nombre}}{{else}}Sin asignar{{/if}}
                              </div>
                            </div>
                            <div class="text-end">
                              <div class="fw-bold">${{formatMoney this.principal.valorFactura}}</div>
                              <span class="badge {{estadoPagoClass this.principal.estadoPago}}">
                                {{estadoPagoTexto this.principal.estadoPago}}
                              </span>
                            </div>
                          </div>
                        </div>

                        {{!-- Documentos Habilitantes --}}
                        {{#if this.habilitantes.length}}
                          <div class="table-universal-sub-items documentos-habilitantes">
                            {{#each this.habilitantes}}
                              <div class="table-universal-sub-item documento-habilitante">
                                <div class="d-flex justify-content-between align-items-start">
                                  <div class="flex-grow-1">
                                    <div class="codigo-habilitante">{{this.codigoBarras}}</div>
                                    <div class="mt-1">
                                      <div class="nombre-cliente-habilitante text-primary small">{{this.nombreCliente}}</div>
                                    </div>
                                    <div class="mt-1">
                                      <span class="tipo-habilitante">{{this.tipoDocumento}}</span>
                                    </div>
                                    <div class="relacion-info">
                                      Se entrega con: {{this.principalCodigo}}
                                    </div>
                                  </div>
                                  <div class="text-end small">
                                    <div class="fw-bold">${{formatMoney this.valorFactura}}</div>
                                    <span class="badge {{estadoPagoClass this.estadoPago}} small">
                                      {{estadoPagoTexto this.estadoPago}}
                                    </span>
                                  </div>
                                </div>
                              </div>
                            {{/each}}
                          </div>
                        {{/if}}

                        {{!-- Advertencia del grupo --}}
                        <div class="advertencia-grupo">
                          Estos {{this.totalDocumentos}} documentos DEBEN entregarse juntos
                        </div>

                        {{!-- Información del grupo --}}
                        <div class="info-grupo">
                          Valor total del grupo: ${{formatMoney this.valorTotalGrupo}} | 
                          Códigos: {{join this.codigosGrupo ", "}}
                        </div>
                      </div>
                    {{/each}}
                  </div>
                {{/if}}

                {{!-- ============== DOCUMENTOS INDEPENDIENTES ============== --}}
                {{#if documentosGrupales.tieneDocumentosIndependientes}}
                  <div class="table-universal-section documentos-independientes">
                    <h5 class="table-universal-section-title">📄 DOCUMENTOS INDEPENDIENTES</h5>
                    
                    {{#each documentosGrupales.documentosIndependientes}}
                      <div class="table-universal-item documento-individual {{#if this.esHabilitanteHuerfano}}habilitante-huerfano{{/if}}">
                        <div class="checkbox-individual">
                          <input 
                            class="form-check-input documento-checkbox individual-checkbox" 
                            type="checkbox" 
                            value="{{this.id}}"
                            data-codigo="{{this.codigoVerificacion}}"
                            data-es-individual="true"
                            id="individual_{{this.id}}">
                        </div>
                        
                        <div class="d-flex justify-content-between align-items-start">
                          <div class="flex-grow-1" style="margin-left: 35px;">
                            <div class="codigo-individual">{{this.codigoBarras}}</div>
                            <div class="mt-1">
                              <div class="nombre-cliente-individual text-primary fw-semibold">{{this.nombreCliente}}</div>
                              <div class="small text-muted">{{this.identificacionCliente}}</div>
                            </div>
                            <div class="mt-2">
                              <span class="tipo-individual">{{this.tipoDocumento}}</span>
                            </div>
                            <div class="mt-2 small text-muted">
                              <i class="fas fa-user-tie me-1"></i>
                              Matrizador: {{#if this.matrizador}}{{this.matrizador.nombre}}{{else}}Sin asignar{{/if}}
                            </div>
                            {{#unless this.esHabilitanteHuerfano}}
                              <div class="entrega-individual-permitida">
                                Entrega individual permitida
                              </div>
                            {{/unless}}
                            {{#if this.advertencia}}
                              <div class="text-warning small mt-1">
                                <i class="fas fa-exclamation-triangle me-1"></i>
                                {{this.advertencia}}
                              </div>
                            {{/if}}
                          </div>
                          <div class="text-end">
                            <div class="fw-bold">${{formatMoney this.valorFactura}}</div>
                            <span class="badge {{estadoPagoClass this.estadoPago}}">
                              {{estadoPagoTexto this.estadoPago}}
                            </span>
                          </div>
                        </div>
                      </div>
                    {{/each}}
                  </div>
                {{/if}}
              </div>

              {{!-- Contador de selección mejorado --}}
              <div class="mt-3">
                <div class="alert alert-light border">
                  <div class="d-flex justify-content-between align-items-center">
                    <span>
                      <i class="fas fa-info-circle me-2 text-info"></i>
                      <span id="contador-seleccion">0 documento(s) seleccionado(s)</span>
                    </span>
                    <div id="codigos-seleccionados" class="small text-muted"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        {{/if}}

        {{!-- ============== 3. FORMULARIO DE ENTREGA CORREGIDO ============== --}}
        <form id="formEntrega" action="/recepcion/documentos/entrega/{{documento.id}}" method="POST">
          {{!-- Campos ocultos para entrega grupal --}}
          <input type="hidden" id="documentos_seleccionados" name="documentosAdicionales" value="">
          <input type="hidden" id="entrega_grupal" name="entregaGrupal" value="false">
          <input type="hidden" name="tipoEntregaGrupal" value="recepcion_completa">

          {{!-- SECCIÓN: VALIDACIÓN DE CÓDIGO CORREGIDA --}}
          <div class="card mb-4 table-universal-card">
            <div class="card-header table-universal-header">
              <h6 class="mb-0">
                <i class="fas fa-key me-2"></i>
                Validación de Código
              </h6>
            </div>
            <div class="card-body table-universal-body">
              {{!-- Mostrar códigos válidos dinámicamente --}}
              <div class="alert alert-info" id="alert-codigos-validos">
                <strong>Códigos válidos para esta entrega:</strong>
                <div id="lista-codigos-validos">
                  {{#if documento.codigoVerificacion}}
                    {{#unless (eq documento.codigoVerificacion 'sin_codigo')}}
                      <code class="bg-dark text-light px-2 py-1 rounded me-2">${{documento.codigoVerificacion}}</code>
                      <small class="text-muted">(documento principal)</small>
                    {{/unless}}
                  {{/if}}
                </div>
              </div>

              {{!-- Input de código con validación mejorada --}}
              <div class="row">
                <div class="col-md-6">
                  <label for="codigoVerificacion" class="form-label">
                    <strong>Código de Verificación</strong>
                    <span class="text-danger">*</span>
                  </label>
                  <div class="input-group">
                    <input type="text" class="form-control" id="codigoVerificacion" name="codigoVerificacion" 
                           placeholder="Ingrese código de 4 dígitos" maxlength="6" required>
                    <button type="button" class="btn btn-outline-primary" id="validarCodigo">
                      <i class="fas fa-check me-1"></i>Validar
                    </button>
                  </div>
                  <div id="mensaje-validacion-codigo" class="mt-2"></div>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Método de verificación alternativo</label>
                  <div class="form-check">
                    <input class="form-check-input" type="radio" name="tipoVerificacion" value="llamada" id="verificacionLlamada">
                    <label class="form-check-label" for="verificacionLlamada">
                      Verificación por llamada telefónica
                    </label>
                  </div>
                  <div id="div-observaciones" class="mt-2 d-none">
                    <textarea class="form-control" id="observaciones" name="observaciones" rows="2" 
                              placeholder="Detalles de la verificación por llamada..."></textarea>
                  </div>
                </div>
              </div>
            </div>
          </div>

          {{!-- SECCIÓN: INFORMACIÓN DEL RECEPTOR --}}
          <div class="card mb-4 table-universal-card">
            <div class="card-header table-universal-header">
              <h6 class="mb-0">
                <i class="fas fa-user-check me-2"></i>
                Información del Receptor
              </h6>
            </div>
            <div class="card-body table-universal-body">
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label for="nombreReceptor" class="form-label">
                    <strong>Nombre completo del receptor</strong>
                    <span class="text-danger">*</span>
                  </label>
                  <input type="text" class="form-control" id="nombreReceptor" name="nombreReceptor" 
                         placeholder="Nombre completo de quien recibe" required>
                </div>
                <div class="col-md-6 mb-3">
                  <label for="identificacionReceptor" class="form-label">
                    <strong>Identificación del receptor</strong>
                    <span class="text-danger">*</span>
                  </label>
                  <input type="text" class="form-control" id="identificacionReceptor" name="identificacionReceptor" 
                         placeholder="Cédula o identificación" required>
                </div>
              </div>
              <div class="mb-3">
                <label for="relacionReceptor" class="form-label">
                  <strong>Relación con el cliente</strong>
                  <span class="text-danger">*</span>
                </label>
                <select class="form-select" id="relacionReceptor" name="relacionReceptor" required>
                  <option value="">Seleccione la relación</option>
                  <option value="titular">Titular del documento</option>
                  <option value="representante_legal">Representante legal</option>
                  <option value="apoderado">Apoderado</option>
                  <option value="familiar">Familiar autorizado</option>
                  <option value="empleado">Empleado autorizado</option>
                  <option value="tercero_autorizado">Tercero autorizado</option>
                </select>
              </div>
            </div>
          </div>



          {{!-- ============== SECCIÓN AUTORIZACIÓN URGENTE ============== --}}
          {{#if (and (or (eq documento.estadoPago 'pendiente') (eq documento.estadoPago 'pago_parcial')) (not documento.entrega_sin_verificar_pago))}}
            <div class="card mb-4 border-warning" id="seccion-autorizacion-urgente">
              <div class="card-header bg-light">
                <div class="d-flex align-items-center justify-content-between">
                  <div>
                    <h6 class="mb-1 text-warning">
                      <i class="fas fa-exclamation-triangle me-2"></i>
                      Cliente Presente - Pago Pendiente
                    </h6>
                    <small class="text-muted">
                      ¿El cliente necesita retirar el documento sin verificar el pago?
                    </small>
                  </div>
                  <span class="badge bg-warning text-dark fs-6">
                    AUTORIZACIÓN DISPONIBLE
                  </span>
                </div>
              </div>
              <div class="card-body">
                <div class="alert alert-info border-info">
                  <div class="d-flex align-items-start">
                    <i class="fas fa-info-circle me-3 mt-1 fs-5 text-info"></i>
                    <div class="flex-grow-1">
                      <h6 class="mb-2 text-info">📋 ¿Cuándo usar la Autorización Urgente?</h6>
                      <ul class="mb-2 small">
                        <li><strong>Cliente presente</strong> esperando el documento</li>
                        <li><strong>Emergencia médica</strong> o situación urgente</li>
                        <li><strong>Cliente corporativo</strong> con historial confiable</li>
                        <li><strong>Error del sistema</strong> de pagos</li>
                      </ul>
                      <div class="text-warning small">
                        <i class="fas fa-clock me-1"></i>
                        <strong>Proceso rápido:</strong> El matrizador responsable recibirá una alerta y puede autorizar en 2-5 minutos.
                      </div>
                    </div>
                  </div>
                </div>

                {{!-- Botones de autorización --}}
                <div class="row mb-3">
                  <div class="col-md-6">
                    <div class="d-grid">
                      <button type="button" class="btn btn-warning btn-lg" id="btnSolicitarAutorizacion"
                              data-documento-id="{{documento.id}}"
                              data-cliente="{{documento.nombreCliente}}"
                              data-monto="{{documento.valorFactura}}"
                              data-matrizador="{{#if documento.matrizador}}{{documento.matrizador.nombre}}{{else}}Sin asignar{{/if}}"
                              data-extension="{{#if documento.matrizador}}{{documento.matrizador.extension}}{{else}}---{{/if}}"
                              onclick="solicitarAutorizacionUrgente()">
                        <i class="fas fa-computer me-2"></i>
                        Autorización Digital
                      </button>
                      <small class="text-muted mt-1 text-center">
                        <i class="fas fa-bolt me-1"></i>Respuesta en 2-5 minutos
                      </small>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="d-grid">
                      <button type="button" class="btn btn-info btn-lg" id="btnAutorizacionVerbal"
                              data-documento-id="{{documento.id}}"
                              data-cliente="{{documento.nombreCliente}}"
                              data-monto="{{documento.valorFactura}}"
                              data-matrizador="{{#if documento.matrizador}}{{documento.matrizador.nombre}}{{else}}Sin asignar{{/if}}"
                              onclick="mostrarModalAutorizacionVerbal()">
                        <i class="fas fa-phone me-2"></i>
                        Autorización Verbal
                      </button>
                      <small class="text-muted mt-1 text-center">
                        <i class="fas fa-phone me-1"></i>Confirmar por teléfono
                      </small>
                    </div>
                  </div>
                </div>

                {{!-- Estado de la solicitud (se actualiza dinámicamente) --}}
                <div id="estado-autorizacion" class="d-none">
                  <div class="alert alert-success border-success">
                    <div class="d-flex align-items-center">
                      <i class="fas fa-check-circle me-3 fs-4 text-success"></i>
                      <div class="flex-grow-1">
                        <h6 class="mb-1 text-success">✅ Autorización Concedida</h6>
                        <p class="mb-0 small">Puede proceder con la entrega del documento.</p>
                      </div>
                    </div>
                  </div>
                </div>

                {{!-- Información del proceso --}}
                <div class="small text-muted">
                  <i class="fas fa-shield-alt me-1"></i>
                  <strong>Proceso seguro:</strong> Se registra auditoría completa de quien autoriza y por qué.
                </div>
              </div>
            </div>
          {{/if}}

          {{!-- BOTÓN DE CONFIRMACIÓN --}}
          <div class="d-grid gap-2">
            <button type="submit" class="btn btn-info btn-lg" id="btnConfirmarEntrega">
              <i class="fas fa-check-circle me-2"></i>
              Confirmar Entrega
            </button>
          </div>
        </form>

      {{else}}
        {{!-- ============== BÚSQUEDA Y LISTADO DE DOCUMENTOS ============== --}}
        <div class="card table-universal-card">
          <div class="card-header table-universal-header">
            <h5 class="mb-0">
              <i class="fas fa-search me-2"></i>
              Buscar Documento para Entrega
            </h5>
          </div>
          <div class="card-body table-universal-body">
            <form action="/recepcion/documentos/entrega" method="GET" id="formBusqueda">
              {{!-- Búsqueda rápida principal --}}
              <div class="row mb-3">
                <div class="col-md-8">
                  <label for="busqueda" class="form-label">
                    <strong>Búsqueda Rápida</strong>
                    <small class="text-muted">(código, nombre, cédula, factura)</small>
                  </label>
                  <div class="input-group">
                    <input type="text" class="form-control form-control-lg" id="busqueda" name="busqueda" 
                           placeholder="Busque por código, nombre, cédula o número de factura..." 
                           value="{{filtros.busqueda}}" autofocus>
                    <button class="btn btn-primary btn-lg" type="submit">
                      <i class="fas fa-search me-1"></i>Buscar
                    </button>
                  </div>
                </div>
                <div class="col-md-4">
                  <label class="form-label">
                    <strong>Búsqueda por código específico</strong>
                  </label>
                  <input type="text" class="form-control" name="codigo" 
                         placeholder="Código exacto..." 
                         value="{{filtros.codigo}}">
                </div>
              </div>

              {{!-- Filtros avanzados --}}
              <div class="border-top pt-3 mt-4">
                <h6 class="mb-3"><i class="fas fa-filter me-2"></i>Filtros Avanzados</h6>
                <div id="filtrosAvanzados">
                  <div class="row">
                    <div class="col-md-4 mb-3">
                      <label for="tipo" class="form-label">Tipo de Documento</label>
                      <select class="form-select" name="tipo" id="tipo">
                        <option value="todos" {{#if (eq filtros.tipoDocumento 'todos')}}selected{{/if}}>Todos los tipos</option>
                        <option value="Diligencias" {{#if (eq filtros.tipoDocumento 'Diligencias')}}selected{{/if}}>Diligencias</option>
                        <option value="Certificaciones" {{#if (eq filtros.tipoDocumento 'Certificaciones')}}selected{{/if}}>Certificaciones</option>
                        <option value="Copias" {{#if (eq filtros.tipoDocumento 'Copias')}}selected{{/if}}>Copias</option>
                        <option value="Autenticaciones" {{#if (eq filtros.tipoDocumento 'Autenticaciones')}}selected{{/if}}>Autenticaciones</option>
                        <option value="Otros" {{#if (eq filtros.tipoDocumento 'Otros')}}selected{{/if}}>Otros</option>
                      </select>
                    </div>
                    <div class="col-md-4 mb-3">
                      <label for="estadoPago" class="form-label">Estado de Pago</label>
                      <select class="form-select" name="estadoPago" id="estadoPago">
                        <option value="todos" {{#if (eq filtros.estadoPago 'todos')}}selected{{/if}}>Todos los estados</option>
                        <option value="pagado_completo" {{#if (eq filtros.estadoPago 'pagado_completo')}}selected{{/if}}>Pagado</option>
                        <option value="pendiente" {{#if (eq filtros.estadoPago 'pendiente')}}selected{{/if}}>Pendiente</option>
                        <option value="pagado_con_retencion" {{#if (eq filtros.estadoPago 'pagado_con_retencion')}}selected{{/if}}>Con Retención</option>
                        <option value="pago_parcial" {{#if (eq filtros.estadoPago 'pago_parcial')}}selected{{/if}}>Pago Parcial</option>
                      </select>
                    </div>
                    <div class="col-md-2 mb-3">
                      <label for="matrizador" class="form-label">Matrizador</label>
                      <select class="form-select" name="matrizador" id="matrizador">
                        <option value="">Todos los matrizadores</option>
                        {{#each matrizadores}}
                          <option value="{{this.id}}" {{#if (eq ../filtros.matrizador (stringifyNumber this.id))}}selected{{/if}}>
                            {{this.nombre}}{{#if (eq this.rol 'archivo')}} (Archivo){{/if}}
                          </option>
                        {{/each}}
                      </select>
                    </div>
                    <div class="col-md-2 mb-3">
                      <label for="fechaDesde" class="form-label">Fecha</label>
                      <div class="row">
                        <div class="col-6">
                          <input type="date" class="form-control" name="fechaDesde" id="fechaDesde" 
                                 placeholder="Desde" value="{{filtros.fechaDesde}}">
                        </div>
                        <div class="col-6">
                          <input type="date" class="form-control" name="fechaHasta" id="fechaHasta" 
                                 placeholder="Hasta" value="{{filtros.fechaHasta}}">
                        </div>
                      </div>
                    </div>
                  </div>
                  
                  <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary">
                      <i class="fas fa-search me-1"></i>Aplicar Filtros
                    </button>
                    <a href="/recepcion/documentos/entrega" class="btn btn-outline-secondary">
                      <i class="fas fa-times me-1"></i>Limpiar
                    </a>
                  </div>
                </div>
              </div>
            </form>
          </div>
        </div>

        {{!-- LISTA DE DOCUMENTOS LISTOS CON ESTADO DE PAGO VISIBLE --}}
        {{#if documentosListos.length}}
          <div class="card mt-4 table-universal-card">
            <div class="card-header table-universal-header">
              <h6 class="mb-0">
                <i class="fas fa-list me-2"></i>
                Documentos Listos para Entrega ({{documentosListos.length}})
              </h6>
            </div>
            <div class="card-body table-universal-body">
              <div class="table-responsive">
                <table id="tabla-entrega-recepcion" class="table table-hover table-universal tabla-ordenable table-striped">
                  <thead class="table-light">
                    <tr>
                      <th class="col-codigo" style="width: 120px;">Código</th>
                      <th class="col-cliente" style="width: 200px;">Cliente</th>
                      <th class="col-tipo text-center" style="width: 80px;">Tipo</th>
                      <th class="col-matrizador" style="width: 120px;">Matrizador</th>
                      <th class="col-valor text-end" style="width: 80px;">Valor</th>
                      <th class="col-pago text-center" style="width: 100px;">Pago</th>
                      <th class="col-fecha text-center" style="width: 100px;">Fecha</th>
                      <th class="col-acciones text-center" style="width: 100px;">Acciones</th>
                    </tr>
                  </thead>
                  <tbody>
                    {{#each documentosListos}}
                      <tr class="table-row">
                        <!-- Código del documento -->
                        <td>
                          <a href="/recepcion/documentos/entrega/{{this.id}}" class="text-primary text-decoration-none">
                            <strong>{{this.codigoBarras}}</strong>
                          </a>
                          {{#if this.numeroFactura}}
                            <br><small class="text-muted">F: {{this.numeroFactura}}</small>
                          {{/if}}
                        </td>
                        
                        <!-- Cliente -->
                        <td>
                          <div class="fw-bold">{{this.nombreCliente}}</div>
                          {{#if this.identificacionCliente}}
                            <small class="text-muted">{{this.identificacionCliente}}</small>
                          {{/if}}
                        </td>
                        
                        <!-- Tipo de documento -->
                        <td class="text-center">
                          <span class="badge bg-info">{{tipoDocumentoAbrev this.tipoDocumento}}</span>
                        </td>
                        
                        <!-- Matrizador -->
                        <td>
                          {{#if this.matrizador}}
                            <span class="fw-bold" title="{{this.matrizador.nombre}}">
                              <i class="fas fa-user-tie me-1"></i>
                              {{formatMatrizadorNombre this.matrizador}}
                            </span>
                          {{else}}
                            <span class="text-muted">
                              <i class="fas fa-user-slash me-1"></i>Sin asignar
                            </span>
                          {{/if}}
                        </td>
                        
                        <!-- Valor -->
                        <td class="text-end">
                          <strong class="text-success">${{formatMoney this.valorFactura}}</strong>
                        </td>
                        
                        <!-- Estado de pago -->
                        <td class="text-center">
                          {{#if (eq this.estadoPago 'pagado_completo')}}
                            <span class="badge bg-success">
                              <i class="fas fa-check-circle me-1"></i>Pagado
                            </span>
                          {{else if (eq this.estadoPago 'pagado_con_retencion')}}
                            <span class="badge bg-warning">
                              <i class="fas fa-university me-1"></i>Con Retención
                            </span>
                          {{else if (eq this.estadoPago 'pago_parcial')}}
                            <span class="badge bg-info">
                              <i class="fas fa-circle-half-stroke me-1"></i>Parcial
                            </span>
                          {{else}}
                            <span class="badge bg-danger">
                              <i class="fas fa-exclamation-triangle me-1"></i>Pendiente
                            </span>
                          {{/if}}
                        </td>
                        
                        <!-- Fecha -->
                        <td class="text-center">
                          <small class="text-muted">{{formatDateShort this.created_at}}</small>
                        </td>
                        
                        <!-- Acciones -->
                        <td class="text-center">
                          <a href="/recepcion/documentos/entrega/{{this.id}}" class="btn btn-sm btn-success">
                            <i class="fas fa-handshake me-1"></i>Entregar
                          </a>
                        </td>
                      </tr>
                    {{/each}}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        {{/if}}
      {{/if}}
    </div>
  </div>
</div>

{{!-- ============== JAVASCRIPT SIMPLIFICADO PARA ENTREGA ============== --}}
<script>
console.log('🔍 [DEBUG] Iniciando JavaScript simplificado...');

document.addEventListener('DOMContentLoaded', function() {
  console.log('✅ [DEBUG] DOM cargado - script básico funcionando');
  
  // Funcionalidad básica de búsqueda
  const busquedaInput = document.getElementById('busqueda');
  if (busquedaInput) {
    console.log('✅ [DEBUG] Input de búsqueda encontrado');
  }
  
  // Variables globales mínimas
  window.documentoPrincipal = null;
  window.documentosDisponibles = [];
  window.usuarioActual = { rol: 'recepcion' };
  
  // Verificar tabla
  const tabla = document.getElementById('tabla-entrega-recepcion');
  if (tabla) {
    console.log('✅ [DEBUG] Tabla encontrada:', tabla.id);
  } else {
    console.log('⚠️ [DEBUG] Tabla no encontrada');
  }
  
  console.log('✅ [DEBUG] Configuración básica completada');
  
}); // Cierre de DOMContentLoaded

console.log('✅ [DEBUG] Script JavaScript simplificado completado');

</script>

<style>
        codigosHTML += `<code class="bg-dark text-light px-2 py-1 rounded me-2">${window.documentoPrincipal.codigoVerificacion}</code><small class="text-muted me-3">(principal)</small>`;
      }
      seleccionados.forEach(checkbox => {
        const codigo = checkbox.dataset.codigo;
        if (codigo && codigo !== 'sin_codigo') {
          codigosHTML += `<code class="bg-info text-light px-2 py-1 rounded me-2">${codigo}</code><small class="text-muted me-3">(seleccionado)</small>`;
        }
      });
      if (codigosHTML === '') {
        codigosHTML = '<span class="text-warning">⚠️ Documentos sin código - usar verificación alternativa</span>';
      }
      listaCodigosValidos.innerHTML = codigosHTML;
    }
    
    function aplicarEstilosSeleccion(seleccionados) {
      document.querySelectorAll('.grupo-seleccionado, .individual-seleccionado').forEach(el => {
        el.classList.remove('grupo-seleccionado', 'individual-seleccionado');
      });
      seleccionados.forEach(checkbox => {
        const grupoElement = checkbox.closest('.grupo-documentos');
        const individualElement = checkbox.closest('.documento-individual');
        if (grupoElement) grupoElement.classList.add('grupo-seleccionado');
        if (individualElement) individualElement.classList.add('individual-seleccionado');
      });
    }
    
    if (selectAll) {
      selectAll.addEventListener('change', function() {
        documentoCheckboxes.forEach(cb => { cb.checked = this.checked; });
        actualizarSeleccion();
      });
    }
    
    documentoCheckboxes.forEach(checkbox => {
      checkbox.addEventListener('change', function() {
        if (this.dataset.esGrupo === 'true') {
          console.log(`Grupo seleccionado: ${this.dataset.grupoId}`);
        }
        actualizarSeleccion();
      });
    });

    function mostrarMensajeValidacion(mensaje, tipo) {
      const mensajeDiv = document.getElementById('mensaje-validacion-codigo');
      if (!mensajeDiv) return;
      const claseColor = tipo === 'success' ? 'text-success' : 'text-danger';
      mensajeDiv.innerHTML = `<div class="${claseColor}">${mensaje}</div>`;
    }
    
    if (btnValidar) {
      btnValidar.addEventListener('click', function() {
        const codigo = codigoInput.value.trim();
        if (!codigo) {
          mostrarMensajeValidacion('Debe ingresar un código de verificación', 'error');
          return;
        }
        const codigosValidos = [];
        if (window.documentoPrincipal && window.documentoPrincipal.codigoVerificacion !== 'sin_codigo') {
          codigosValidos.push(window.documentoPrincipal.codigoVerificacion);
        }
        Array.from(documentoCheckboxes).filter(cb => cb.checked).forEach(cb => {
          if (cb.dataset.codigo && cb.dataset.codigo !== 'sin_codigo') {
            codigosValidos.push(cb.dataset.codigo);
          }
        });
        
        if (codigosValidos.includes(codigo)) {
          mostrarMensajeValidacion('✅ Código válido. Puede proceder.', 'success');
        } else {
          mostrarMensajeValidacion('❌ Código incorrecto.', 'error');
        }
      });
    }
    
    if (verificacionLlamada) {
      verificacionLlamada.addEventListener('change', function() {
        if (divObservaciones) divObservaciones.classList.toggle('d-none', !this.checked);
      });
    }
    
    if (btnConfirmar) {
      document.getElementById('formEntrega').addEventListener('submit', function(e) {
        const checkboxAutorizacion = document.getElementById('confirmarEntregaPendiente');
        if (checkboxAutorizacion && !checkboxAutorizacion.checked) {
          e.preventDefault();
          alert('Debe confirmar la consulta con el matrizador para entregar documentos pendientes.');
          checkboxAutorizacion.focus();
          return false;
        }
        btnConfirmar.innerHTML = `<i class="fas fa-spinner fa-spin me-2"></i>Procesando...`;
        btnConfirmar.disabled = true;
      });
    }
    
    // ✅ CORRECCIÓN: Ejecutar actualización inicial para asegurar contador correcto
    setTimeout(() => {
      actualizarSeleccion();
      console.log('🔢 [CONTADOR] Inicialización del contador completada');
    }, 100);
    
    window.ocultarEntregaGrupal = function() {
      document.getElementById('alerta-entrega-grupal').style.display = 'none';
      document.getElementById('seccion-entrega-grupal').style.display = 'none';
    };
  }
  
  console.log('✅ [DEBUG] Funcionalidad básica configurada - tabla debería funcionar ahora');
  
}); // Cierre de DOMContentLoaded

// ============== FUNCIONES COMENTADAS TEMPORALMENTE ==============
/*
   
   window.solicitarAutorizacionUrgente = function() {
     console.log('🔄 Iniciando solicitud de autorización urgente...');
     
     // ============== NUEVO: DETECTAR SI ES AUTORIZACIÓN GRUPAL ==============
     const documentosSeleccionados = Array.from(document.querySelectorAll('.documento-checkbox:checked'));
     const esAutorizacionGrupal = documentosSeleccionados.length > 0;
     
     if (esAutorizacionGrupal) {
       console.log('📦 [GRUPAL] Solicitando autorización para múltiples documentos:', documentosSeleccionados.length);
       solicitarAutorizacionGrupal(documentosSeleccionados);
       return;
     }
     
     console.log('📋 [INDIVIDUAL] Solicitando autorización para documento principal');
     // Poblar modal con datos del documento actual
     crearModalAutorizacion();
   }
   
   function crearModalAutorizacion() {
     const modalHTML = `
       <div class="modal fade" id="modalSolicitarAutorizacion" tabindex="-1">
         <div class="modal-dialog modal-lg">
           <div class="modal-content">
             <div class="modal-header bg-warning text-dark">
               <h5 class="modal-title">
                 <i class="fas fa-exclamation-triangle"></i> Solicitar Autorización Urgente
               </h5>
               <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
             </div>
             <div class="modal-body">
               
               <!-- Información del documento -->
               <div class="alert alert-info">
                 <h6><i class="fas fa-file-text"></i> Documento a Autorizar</h6>
                 <p><strong>Cliente:</strong> ${window.documentoActual.nombreCliente}</p>
                 <p><strong>Documento:</strong> ${window.documentoActual.tipoDocumento} #${window.documentoActual.codigoBarras}</p>
                 <p><strong>Monto pendiente:</strong> $${window.documentoActual.valorFactura}</p>
                 <p class="mb-0"><strong>Matrizador responsable:</strong> ${window.documentoActual.matrizador ? window.documentoActual.matrizador.nombre : 'Sin asignar'}</p>
               </div>
               
               <!-- Justificación detallada -->
               <div class="mb-4">
                 <label for="justificacionDetallada" class="form-label">
                   <i class="fas fa-comment"></i> Justificación detallada de la urgencia *
                 </label>
                 <textarea class="form-control" id="justificacionDetallada" rows="3" 
                           placeholder="Explique detalladamente por qué es necesario entregar sin verificar pago..."></textarea>
                 <div class="form-text">
                   <strong>Ejemplos:</strong> "Cliente presente con urgencia bancaria para crédito hipotecario", 
                   "Situación médica familiar urgente", "Cliente corporativo con convenio establecido"
                 </div>
               </div>
               
               <!-- Método de autorización preferido -->
               <div class="mb-4">
                 <h6><i class="fas fa-route"></i> Método de Autorización Preferido</h6>
                 
                 <div class="form-check mb-2">
                   <input class="form-check-input" type="radio" name="metodoAutorizacion" 
                          id="metodoDigital" value="digital" checked>
                   <label class="form-check-label" for="metodoDigital">
                     <strong><i class="fas fa-desktop text-primary"></i> Autorización Digital (Recomendada)</strong><br>
                     <small class="text-muted">Notificación inmediata a dashboard del matrizador + caja + admin</small>
                   </label>
                 </div>
                 
                 <div class="form-check">
                   <input class="form-check-input" type="radio" name="metodoAutorizacion" 
                          id="metodoVerbal" value="verbal">
                   <label class="form-check-label" for="metodoVerbal">
                     <strong><i class="fas fa-phone text-warning"></i> Autorización Verbal + Confirmación</strong><br>
                     <small class="text-muted">Para cuando el matrizador no está en su computadora</small>
                   </label>
                 </div>
               </div>
               
               <!-- Información de contacto (aparece si elige verbal) -->
               <div id="infoContactoVerbal" style="display: none;" class="alert alert-warning">
                 <h6><i class="fas fa-phone"></i> Información de Contacto</h6>
                 <p><strong>Matrizador:</strong> ${window.documentoActual.matrizador ? window.documentoActual.matrizador.nombre : 'Sin asignar'}</p>
                 <p><strong>Extensión:</strong> ${window.documentoActual.matrizador ? window.documentoActual.matrizador.extension : '---'}</p>
                 <p class="mb-0"><strong>Recordatorio:</strong> El matrizador debe confirmar en sistema dentro de 24 horas</p>
               </div>
               
               <!-- Confirmación de responsabilidad -->
               <div class="form-check">
                 <input class="form-check-input" type="checkbox" id="confirmoUrgencia">
                 <label class="form-check-label" for="confirmoUrgencia">
                   <strong>Confirmo que esta es una situación que justifica autorización urgente</strong>
                 </label>
               </div>
               
             </div>
             <div class="modal-footer">
               <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                 <i class="fas fa-times"></i> Cancelar
               </button>
               <button type="button" class="btn btn-warning btn-lg" id="btnEnviarSolicitud" disabled>
                 <i class="fas fa-paper-plane"></i> <strong>ENVIAR SOLICITUD</strong>
               </button>
             </div>
           </div>
         </div>
       </div>
     `;
     
     // Remover modal existente si existe
     const modalExistente = document.getElementById('modalSolicitarAutorizacion');
     if (modalExistente) modalExistente.remove();
     
     // Añadir modal al DOM
     document.body.insertAdjacentHTML('beforeend', modalHTML);
     
     // Configurar event listeners
     configurarModalListeners();
     
     // Mostrar modal
     const modal = new bootstrap.Modal(document.getElementById('modalSolicitarAutorizacion'));
     modal.show();
   }
   
   function configurarModalListeners() {
     // Event listeners para el modal
     document.querySelectorAll('input[name="metodoAutorizacion"]').forEach(radio => {
       radio.addEventListener('change', function() {
         const infoContacto = document.getElementById('infoContactoVerbal');
         infoContacto.style.display = this.value === 'verbal' ? 'block' : 'none';
       });
     });

     document.getElementById('justificacionDetallada').addEventListener('input', validarModalAutorizacion);
     document.getElementById('confirmoUrgencia').addEventListener('change', validarModalAutorizacion);
     
     document.getElementById('btnEnviarSolicitud').addEventListener('click', enviarSolicitudAutorizacion);
   }
   
   function validarModalAutorizacion() {
     const justificacion = document.getElementById('justificacionDetallada').value.trim();
     const confirmado = document.getElementById('confirmoUrgencia').checked;
     
     document.getElementById('btnEnviarSolicitud').disabled = !(justificacion.length >= 15 && confirmado);
   }
  
  // ============== FUNCIONES DE ENVÍO Y PROCESAMIENTO ==============
   
   function enviarSolicitudAutorizacion() {
     const metodo = document.querySelector('input[name="metodoAutorizacion"]:checked').value;
     const justificacion = document.getElementById('justificacionDetallada').value.trim();
     
     if (metodo === 'digital') {
       enviarAutorizacionDigital(justificacion);
     } else {
       iniciarAutorizacionVerbal(justificacion);
     }
   }

   function enviarAutorizacionDigital(justificacion) {
     // Cerrar modal
     bootstrap.Modal.getInstance(document.getElementById('modalSolicitarAutorizacion')).hide();
     
     // Mostrar indicador de carga
     mostrarIndicadorEspera();
     
     // Enviar solicitud
     fetch('/api/autorizaciones-urgentes/solicitar', {
       method: 'POST',
       headers: { 
         'Content-Type': 'application/json'
       },
       body: JSON.stringify({
         documento_id: window.documentoActual.id,
         justificacion: justificacion,
         urgencia: 'alta',
         solicitado_desde: 'vista_entrega'
       })
     })
     .then(response => response.json())
     .then(data => {
       if (data.success) {
         // Actualizar UI para mostrar estado de espera
         actualizarUIEsperandoAutorizacion(data.autorizacion_id);
         
         // Iniciar verificación periódica
         verificarAutorizacionPeriodicamente(data.autorizacion_id);
       } else {
         alert('Error al enviar solicitud: ' + data.message);
         ocultarIndicadorEspera();
       }
     })
     .catch(error => {
       console.error('Error:', error);
       alert('Error de conexión al enviar solicitud');
       ocultarIndicadorEspera();
     });
   }

   function mostrarIndicadorEspera() {
     const seccionAutorizacion = document.getElementById('seccion-autorizacion-urgente');
     if (seccionAutorizacion) {
       seccionAutorizacion.innerHTML = `
         <div class="alert alert-info">
           <div class="d-flex justify-content-between align-items-center">
             <div>
               <h6><i class="fas fa-hourglass-half"></i> Enviando solicitud...</h6>
               <p class="mb-0">Procesando autorización urgente</p>
             </div>
             <div class="spinner-border spinner-border-sm text-info" role="status"></div>
           </div>
         </div>
       `;
     }
   }

   function actualizarUIEsperandoAutorizacion(autorizacionId) {
     const seccionAutorizacion = document.getElementById('seccion-autorizacion-urgente');
     if (seccionAutorizacion) {
       seccionAutorizacion.innerHTML = `
         <div class="alert alert-info">
           <div class="d-flex justify-content-between align-items-center">
             <div>
               <h6><i class="fas fa-hourglass-half"></i> Esperando Autorización Digital</h6>
               <p class="mb-1">Solicitud enviada a matrizador, caja y administradores</p>
               <small class="text-muted">ID de solicitud: ${autorizacionId}</small>
             </div>
             <div class="text-end">
               <div class="spinner-border spinner-border-sm text-info me-2" role="status"></div>
               <span class="badge bg-info">EN PROCESO</span>
             </div>
           </div>
           
           <div class="progress mt-2" style="height: 4px;">
             <div class="progress-bar progress-bar-striped progress-bar-animated bg-info" 
                  style="width: 100%"></div>
           </div>
           
           <div class="mt-2">
             <small><i class="fas fa-clock"></i> Tiempo transcurrido: <span id="tiempoEspera">0:00</span></small>
             <button class="btn btn-outline-warning btn-sm ms-2" onclick="cambiarAVerbal('${autorizacionId}')">
               <i class="fas fa-phone"></i> Usar método verbal
             </button>
           </div>
         </div>
       `;
       
       // Iniciar contador de tiempo
       iniciarContadorTiempo();
     }
   }

   function verificarAutorizacionPeriodicamente(autorizacionId) {
     // Limpiar intervalo previo si existe
     if (intervaloPoll) clearInterval(intervaloPoll);
     
     intervaloPoll = setInterval(() => {
       fetch(`/api/autorizaciones-urgentes/${autorizacionId}/datos`)
         .then(response => response.json())
         .then(data => {
           if (data.success) {
             if (data.estado === 'autorizada') {
               clearInterval(intervaloPoll);
               onAutorizacionConcedida(data);
             } else if (data.estado === 'rechazada') {
               clearInterval(intervaloPoll);
               onAutorizacionRechazada(data);
             }
           }
           // Si sigue pendiente, continúa verificando
         })
         .catch(error => console.error('Error verificando autorización:', error));
     }, 15000); // Verificar cada 15 segundos
     
     // Timeout después de 10 minutos
     setTimeout(() => {
       if (intervaloPoll) {
         clearInterval(intervaloPoll);
         mostrarOpcionEscalacion(autorizacionId);
       }
     }, 10 * 60 * 1000);
   }
  
   function iniciarContadorTiempo() {
     tiempoInicioEspera = new Date();
     
     if (contadorTiempo) clearInterval(contadorTiempo);
     
     contadorTiempo = setInterval(() => {
       const ahora = new Date();
       const diferencia = Math.floor((ahora - tiempoInicioEspera) / 1000);
       const minutos = Math.floor(diferencia / 60);
       const segundos = diferencia % 60;
       
       const tiempoElement = document.getElementById('tiempoEspera');
       if (tiempoElement) {
         tiempoElement.textContent = `${minutos}:${segundos.toString().padStart(2, '0')}`;
       }
     }, 1000);
   }

   function onAutorizacionConcedida(data) {
     // Limpiar temporizadores
     if (contadorTiempo) clearInterval(contadorTiempo);
     if (intervaloPoll) clearInterval(intervaloPoll);
     
     // Actualizar UI para mostrar autorización concedida
     const seccionAutorizacion = document.getElementById('seccion-autorizacion-urgente');
     if (seccionAutorizacion) {
       seccionAutorizacion.innerHTML = `
         <div class="alert alert-success">
           <div class="d-flex justify-content-between align-items-center">
             <div>
               <h6><i class="fas fa-check-circle"></i> Autorización Concedida</h6>
               <p class="mb-1"><strong>Autorizada por:</strong> ${data.autorizado_por_nombre || 'N/A'}</p>
               <p class="mb-1"><strong>Justificación:</strong> ${data.justificacion_autorizacion || 'N/A'}</p>
               <small class="text-muted">Autorizada el ${formatearFecha(data.fecha_autorizacion)}</small>
             </div>
             <div class="text-end">
               <span class="badge bg-success">AUTORIZADA</span>
             </div>
           </div>
         </div>
       `;
     }
     
     // Habilitar entrega final
     habilitarEntregaFinal();
     
     // Mostrar notificación de éxito
     mostrarNotificacionExito('¡Autorización concedida! Puede proceder con la entrega del documento.');
   }

   function onAutorizacionRechazada(data) {
     // Limpiar temporizadores
     if (contadorTiempo) clearInterval(contadorTiempo);
     if (intervaloPoll) clearInterval(intervaloPoll);
     
     // Actualizar UI para mostrar rechazo
     const seccionAutorizacion = document.getElementById('seccion-autorizacion-urgente');
     if (seccionAutorizacion) {
       seccionAutorizacion.innerHTML = `
         <div class="alert alert-danger">
           <div class="d-flex justify-content-between align-items-center">
             <div>
               <h6><i class="fas fa-times-circle"></i> Autorización Rechazada</h6>
               <p class="mb-1"><strong>Rechazada por:</strong> ${data.rechazado_por_nombre || 'N/A'}</p>
               <p class="mb-1"><strong>Motivo:</strong> ${data.motivo_rechazo || 'No especificado'}</p>
               <small class="text-muted">Rechazada el ${formatearFecha(data.fecha_rechazo)}</small>
             </div>
             <div class="text-end">
               <span class="badge bg-danger">RECHAZADA</span>
             </div>
           </div>
           <div class="mt-2">
             <p class="mb-2"><strong>Opciones disponibles:</strong></p>
             <button class="btn btn-warning btn-sm me-2" onclick="solicitarAutorizacionUrgente()">
               <i class="fas fa-redo"></i> Nueva solicitud
             </button>
             <button class="btn btn-info btn-sm" onclick="contactarSupervision()">
               <i class="fas fa-phone"></i> Contactar supervisión
             </button>
           </div>
         </div>
       `;
     }
   }

   function mostrarNotificacionExito(mensaje) {
     // Crear notificación toast
     const toastHTML = `
       <div class="toast align-items-center text-white bg-success border-0" role="alert">
         <div class="d-flex">
           <div class="toast-body">
             <i class="fas fa-check-circle me-2"></i>${mensaje}
           </div>
           <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
         </div>
       </div>
     `;
     
     // Añadir al DOM y mostrar
     document.body.insertAdjacentHTML('beforeend', toastHTML);
     const toast = new bootstrap.Toast(document.body.lastElementChild);
     toast.show();
   }

   function formatearFecha(fecha) {
     if (!fecha) return 'N/A';
     return new Date(fecha).toLocaleString('es-EC', {
       year: 'numeric',
       month: '2-digit',
       day: '2-digit',
       hour: '2-digit',
       minute: '2-digit'
     });
   }

   function ocultarIndicadorEspera() {
     // Restaurar estado original de la sección
     const seccionAutorizacion = document.getElementById('seccion-autorizacion-urgente');
     if (seccionAutorizacion) {
       seccionAutorizacion.innerHTML = `
         <div class="alert alert-warning">
           <!-- Contenido original restaurado -->
         </div>
       `;
     }
   }

   // ============== FUNCIONES ADICIONALES ==============
   
   window.cambiarAVerbal = function(autorizacionId) {
     if (confirm('¿Está seguro de cambiar a autorización verbal? Esto requerirá contacto directo con el matrizador.')) {
       iniciarAutorizacionVerbal(null, autorizacionId);
     }
   }
   
   function iniciarAutorizacionVerbal(justificacion, autorizacionExistente = null) {
     alert('Función de autorización verbal en desarrollo. Por favor use el método digital o contacte al administrador.');
   }
   
   window.contactarSupervision = function() {
     alert('Por favor contacte a supervisión al ext. 101 para resolver esta situación.');
   }
   
        function mostrarOpcionEscalacion(autorizacionId) {
       const seccionAutorizacion = document.getElementById('seccion-autorizacion-urgente');
     if (seccionAutorizacion) {
       const alertaEscalacion = document.createElement('div');
       alertaEscalacion.className = 'alert alert-warning mt-2';
       alertaEscalacion.innerHTML = `
         <h6><i class="fas fa-exclamation-triangle"></i> Sin respuesta después de 10 minutos</h6>
         <p>Considere usar autorización verbal o contactar supervisión.</p>
         <button class="btn btn-warning btn-sm me-2" onclick="cambiarAVerbal('${autorizacionId}')">
           <i class="fas fa-phone"></i> Autorización verbal
         </button>
         <button class="btn btn-info btn-sm" onclick="contactarSupervision()">
           <i class="fas fa-user-tie"></i> Contactar supervisión
         </button>
       `;
       seccionAutorizacion.appendChild(alertaEscalacion);
     }
   }
});

// ============== FUNCIONES GLOBALES DE AUTORIZACIÓN ==============

// Función global para habilitar entrega final tras autorización
function habilitarEntregaFinal() {
  // Encontrar y habilitar el botón de confirmación de entrega
  const formEntrega = document.querySelector('form[action*="confirmar-entrega"]');
  if (formEntrega) {
    const btnConfirmar = formEntrega.querySelector('button[type="submit"]');
    if (btnConfirmar) {
      btnConfirmar.disabled = false;
      btnConfirmar.className = 'btn btn-success btn-lg';
      btnConfirmar.innerHTML = '<i class="fas fa-check-circle"></i> <strong>CONFIRMAR ENTREGA AUTORIZADA</strong>';
    }
  }
  
  // También buscar por ID específico como backup
  const btnConfirmarEntrega = document.getElementById('btnConfirmarEntrega');
  if (btnConfirmarEntrega) {
    btnConfirmarEntrega.disabled = false;
    btnConfirmarEntrega.className = 'btn btn-success btn-lg';
    btnConfirmarEntrega.innerHTML = '<i class="fas fa-check-circle"></i> <strong>CONFIRMAR ENTREGA AUTORIZADA</strong>';
  }
  
  // Marcar visualmente que la autorización está concedida
  const seccionFormulario = document.getElementById('formEntrega');
  if (seccionFormulario) {
    seccionFormulario.classList.add('entrega-autorizada');
  }
  
  console.log('✅ Entrega habilitada tras autorización');
}

// ============== FUNCIONES PARA AUTORIZACIÓN VERBAL ==============

function mostrarModalAutorizacionVerbal() {
  // Crear o mostrar modal
  const modalId = 'modalAutorizacionVerbal';
  let modal = document.getElementById(modalId);
  
  if (!modal) {
    // Crear modal dinámicamente
    const modalHTML = `
      <div class="modal fade" id="${modalId}" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-lg">
          <div class="modal-content">
            <div class="modal-header bg-info text-white">
              <h5 class="modal-title">
                <i class="fas fa-phone me-2"></i>Autorización Verbal por Teléfono
              </h5>
              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
              <div class="alert alert-info">
                <h6><i class="fas fa-info-circle me-2"></i>Instrucciones</h6>
                <ol class="mb-0">
                  <li><strong>Llame</strong> al matrizador responsable por teléfono</li>
                  <li><strong>Explique</strong> la situación del cliente presente</li>
                  <li><strong>Obtenga</strong> autorización verbal clara</li>
                  <li><strong>Complete</strong> este formulario con los datos</li>
                </ol>
              </div>
              
              <form id="formAutorizacionVerbal">
                <div class="row mb-3">
                  <div class="col-md-6">
                    <label class="form-label"><strong>Cliente:</strong></label>
                    <input type="text" class="form-control" id="clienteVerbal" readonly>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label"><strong>Monto:</strong></label>
                    <input type="text" class="form-control" id="montoVerbal" readonly>
                  </div>
                </div>
                
                <div class="row mb-3">
                  <div class="col-md-8">
                    <label class="form-label"><strong>Matrizador Responsable:</strong></label>
                    <input type="text" class="form-control" id="matrizadorVerbal" readonly>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label"><strong>Hora de Llamada:</strong></label>
                    <input type="text" class="form-control" id="horaLlamada" readonly>
                  </div>
                </div>
                
                <div class="mb-3">
                  <label for="quienAutorizo" class="form-label">
                    <strong>¿Quién autorizó verbalmente?</strong>
                    <span class="text-danger">*</span>
                  </label>
                  <select class="form-select" id="quienAutorizo" required>
                    <option value="">Seleccione...</option>
                    <option value="matrizador_responsable">Matrizador responsable directamente</option>
                    <option value="supervisor_caja">Supervisor de caja</option>
                    <option value="administrador">Administrador</option>
                    <option value="otro">Otro (especificar)</option>
                  </select>
                </div>
                
                <div class="mb-3" id="divOtroAutorizador" style="display: none;">
                  <label for="otroAutorizador" class="form-label">
                    <strong>Especifique quién autorizó:</strong>
                  </label>
                  <input type="text" class="form-control" id="otroAutorizador" 
                         placeholder="Nombre y cargo de quien autorizó">
                </div>
                
                <div class="mb-3">
                  <label for="justificacionVerbal" class="form-label">
                    <strong>Justificación de la Autorización Verbal</strong>
                    <span class="text-danger">*</span>
                  </label>
                  <textarea class="form-control" id="justificacionVerbal" rows="3" required
                            placeholder="Explique por qué se requiere autorización verbal (ej: Cliente presente esperando, emergencia médica, etc.)"></textarea>
                </div>
                
                <div class="form-check mb-3">
                  <input class="form-check-input" type="checkbox" id="confirmarLlamada" required>
                  <label class="form-check-label" for="confirmarLlamada">
                    <strong>Confirmo que hablé directamente con el matrizador y obtuve autorización verbal clara</strong>
                  </label>
                </div>
                
                <div class="alert alert-warning">
                  <h6><i class="fas fa-exclamation-triangle me-2"></i>Importante</h6>
                  <ul class="mb-0">
                    <li>Esta autorización permitirá la entrega inmediata</li>
                    <li>El matrizador debe <strong>ratificar digitalmente</strong> en 24 horas</li>
                    <li>Se registra auditoría completa de esta transacción</li>
                  </ul>
                </div>
              </form>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                <i class="fas fa-times me-1"></i>Cancelar
              </button>
              <button type="button" class="btn btn-info" onclick="procesarAutorizacionVerbal()">
                <i class="fas fa-phone-check me-1"></i>Confirmar Autorización Verbal
              </button>
            </div>
          </div>
        </div>
      </div>
    `;
    
    document.body.insertAdjacentHTML('beforeend', modalHTML);
    modal = document.getElementById(modalId);
    
    // Agregar event listener para mostrar/ocultar campo "otro"
    document.getElementById('quienAutorizo').addEventListener('change', function() {
      const divOtro = document.getElementById('divOtroAutorizador');
      divOtro.style.display = this.value === 'otro' ? 'block' : 'none';
    });
  }
  
  // Llenar datos del documento
  const btnVerbal = document.getElementById('btnAutorizacionVerbal');
  document.getElementById('clienteVerbal').value = btnVerbal.dataset.cliente;
  document.getElementById('montoVerbal').value = '$' + parseFloat(btnVerbal.dataset.monto || 0).toFixed(2);
  document.getElementById('matrizadorVerbal').value = btnVerbal.dataset.matrizador;
  document.getElementById('horaLlamada').value = new Date().toLocaleTimeString('es-EC');
  
  // Mostrar modal
  const bsModal = new bootstrap.Modal(modal);
  bsModal.show();
}

function procesarAutorizacionVerbal() {
  const form = document.getElementById('formAutorizacionVerbal');
  if (!form.checkValidity()) {
    form.reportValidity();
    return;
  }
  
  const documentoId = document.getElementById('btnAutorizacionVerbal').dataset.documentoId;
  const quienAutorizo = document.getElementById('quienAutorizo').value;
  const otroAutorizador = document.getElementById('otroAutorizador').value;
  const justificacion = document.getElementById('justificacionVerbal').value;
  
  // Determinar nombre de quien autorizó
  let nombreAutorizador;
  switch(quienAutorizo) {
    case 'matrizador_responsable':
      nombreAutorizador = document.getElementById('matrizadorVerbal').value;
      break;
    case 'supervisor_caja':
      nombreAutorizador = 'Supervisor de Caja';
      break;
    case 'administrador':
      nombreAutorizador = 'Administrador';
      break;
    case 'otro':
      nombreAutorizador = otroAutorizador;
      break;
    default:
      nombreAutorizador = 'No especificado';
  }
  
  // Mostrar loading
  const btnConfirmar = document.querySelector('#modalAutorizacionVerbal .modal-footer .btn-info');
  const textoOriginal = btnConfirmar.innerHTML;
  btnConfirmar.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Procesando...';
  btnConfirmar.disabled = true;
  
  // Primero solicitar autorización urgente
  fetch('/api/autorizaciones-urgentes/solicitar', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': 'Bearer ' + (localStorage.getItem('token') || '')
    },
    body: JSON.stringify({
      documento_id: documentoId,
      justificacion: justificacion,
      urgencia: 'alta',
      solicitado_desde: 'autorización_verbal'
    })
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      // Ahora marcar como verbal
      return fetch('/api/autorizaciones-urgentes/' + data.autorizacion_id + '/verbal', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + (localStorage.getItem('token') || '')
        },
        body: JSON.stringify({
          quien_autorizo: nombreAutorizador,
          justificacion: justificacion
        })
      });
    } else {
      throw new Error(data.message || 'Error al crear solicitud');
    }
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      // Cerrar modal
      bootstrap.Modal.getInstance(document.getElementById('modalAutorizacionVerbal')).hide();
      
      // Actualizar UI
      actualizarUIAutorizacionVerbal();
      
      // Mostrar mensaje de éxito
      mostrarNotificacionExito('Autorización verbal registrada. El documento puede ser entregado.');
      
    } else {
      throw new Error(data.message || 'Error al procesar autorización verbal');
    }
  })
  .catch(error => {
    console.error('Error:', error);
    alert('Error al procesar autorización verbal: ' + error.message);
  })
  .finally(() => {
    // Restaurar botón
    btnConfirmar.innerHTML = textoOriginal;
    btnConfirmar.disabled = false;
  });
}

function actualizarUIAutorizacionVerbal() {
  const seccionAutorizacion = document.getElementById('seccion-autorizacion-urgente');
  if (seccionAutorizacion) {
    seccionAutorizacion.innerHTML = 
      '<div class="alert alert-success border-success">' +
        '<div class="d-flex align-items-center">' +
          '<i class="fas fa-phone-check me-3 fs-4 text-success"></i>' +
          '<div class="flex-grow-1">' +
            '<h6 class="mb-1 text-success">✅ Autorización Verbal Registrada</h6>' +
            '<p class="mb-1">El documento puede ser entregado inmediatamente.</p>' +
            '<small class="text-success">' +
              '<i class="fas fa-clock me-1"></i>' +
              '<strong>Pendiente:</strong> El matrizador debe ratificar digitalmente en 24 horas.' +
            '</small>' +
          '</div>' +
          '<div class="text-end">' +
            '<span class="badge bg-success fs-6">AUTORIZADA</span>' +
          '</div>' +
        '</div>' +
      '</div>';
  }
  
  // Habilitar entrega
  habilitarEntregaFinal();
}

// ============== NUEVA FUNCIONALIDAD: AUTORIZACIÓN GRUPAL ==============

/**
 * Solicita autorización para múltiples documentos seleccionados
 */
function solicitarAutorizacionGrupal(documentosSeleccionados) {
  console.log('📦 [GRUPAL] Iniciando autorización para', documentosSeleccionados.length, 'documentos');
  
  // Recopilar información de documentos pendientes
  const documentosPendientes = [];
  let valorTotalPendiente = 0;
  
  documentosSeleccionados.forEach(checkbox => {
    const documentoId = checkbox.value;
    const documentoData = obtenerDatosDocumento(documentoId);
    
    if (documentoData && documentoData.requiereAutorizacion) {
      documentosPendientes.push(documentoData);
      valorTotalPendiente += parseFloat(documentoData.valorFactura || 0);
    }
  });
  
  if (documentosPendientes.length === 0) {
    console.log('✅ [GRUPAL] No hay documentos que requieran autorización');
    return;
  }
  
  console.log('💰 [GRUPAL] Documentos pendientes:', documentosPendientes.length, 'Total: $', valorTotalPendiente.toFixed(2));
  
  // Crear modal de autorización grupal
  crearModalAutorizacionGrupal(documentosPendientes, valorTotalPendiente);
}

/**
 * Obtiene datos de un documento específico desde las variables globales
 */
function obtenerDatosDocumento(documentoId) {
  // Buscar en documentos independientes
  if (window.documentosIndependientes) {
    const docIndependiente = window.documentosIndependientes.find(doc => doc.id == documentoId);
    if (docIndependiente) {
      return {
        id: docIndependiente.id,
        codigoBarras: docIndependiente.codigoBarras,
        tipoDocumento: docIndependiente.tipoDocumento,
        nombreCliente: docIndependiente.nombreCliente,
        valorFactura: docIndependiente.valorFactura,
        estadoPago: docIndependiente.estadoPago,
        matrizador: docIndependiente.matrizador,
        requiereAutorizacion: !['pagado_completo', 'pagado_con_retencion'].includes(docIndependiente.estadoPago) && !docIndependiente.entrega_sin_verificar_pago
      };
    }
  }
  
  // Buscar en grupos relacionados
  if (window.gruposRelacionados) {
    for (const grupo of window.gruposRelacionados) {
      // Buscar en documento principal
      if (grupo.principal && grupo.principal.id == documentoId) {
        return {
          id: grupo.principal.id,
          codigoBarras: grupo.principal.codigoBarras,
          tipoDocumento: grupo.principal.tipoDocumento,
          nombreCliente: grupo.principal.nombreCliente,
          valorFactura: grupo.principal.valorFactura,
          estadoPago: grupo.principal.estadoPago,
          matrizador: grupo.principal.matrizador,
          requiereAutorizacion: !['pagado_completo', 'pagado_con_retencion'].includes(grupo.principal.estadoPago) && !grupo.principal.entrega_sin_verificar_pago
        };
      }
      
      // Buscar en habilitantes
      if (grupo.habilitantes) {
        const habilitante = grupo.habilitantes.find(hab => hab.id == documentoId);
        if (habilitante) {
          return {
            id: habilitante.id,
            codigoBarras: habilitante.codigoBarras,
            tipoDocumento: habilitante.tipoDocumento,
            nombreCliente: habilitante.nombreCliente,
            valorFactura: habilitante.valorFactura,
            estadoPago: habilitante.estadoPago,
            matrizador: habilitante.matrizador,
            requiereAutorizacion: !['pagado_completo', 'pagado_con_retencion'].includes(habilitante.estadoPago) && !habilitante.entrega_sin_verificar_pago
          };
        }
      }
    }
  }
  
  // Si es el documento principal actual
  if (window.documentoPrincipal && window.documentoPrincipal.id == documentoId) {
    return {
      id: window.documentoPrincipal.id,
      codigoBarras: window.documentoPrincipal.codigoBarras,
      tipoDocumento: window.documentoPrincipal.tipoDocumento,
      nombreCliente: window.documentoPrincipal.nombreCliente,
      valorFactura: window.documentoPrincipal.valorFactura,
      estadoPago: window.documentoPrincipal.estadoPago,
      matrizador: window.documentoPrincipal.matrizador,
      requiereAutorizacion: !['pagado_completo', 'pagado_con_retencion'].includes(window.documentoPrincipal.estadoPago) && !window.documentoPrincipal.entrega_sin_verificar_pago
    };
  }
  
  return null;
}

/**
 * Crea modal específico para autorización grupal
 */
function crearModalAutorizacionGrupal(documentosPendientes, valorTotal) {
  const listaDocumentos = documentosPendientes.map(doc => 
    `<li><strong>${doc.codigoBarras}</strong> - ${doc.tipoDocumento} ($${parseFloat(doc.valorFactura || 0).toFixed(2)})</li>`
  ).join('');
  
  const modalHTML = `
    <div class="modal fade" id="modalAutorizacionGrupal" tabindex="-1">
      <div class="modal-dialog modal-xl">
        <div class="modal-content">
          <div class="modal-header bg-warning text-dark">
            <h5 class="modal-title">
              <i class="fas fa-exclamation-triangle"></i> Autorización Urgente Grupal
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            
            <!-- Resumen de la solicitud -->
            <div class="alert alert-warning border-warning">
              <h6><i class="fas fa-list-check"></i> Documentos que Requieren Autorización</h6>
              <div class="row">
                <div class="col-md-8">
                  <ul class="mb-0">
                    ${listaDocumentos}
                  </ul>
                </div>
                <div class="col-md-4 text-end">
                  <h5 class="text-warning mb-0">
                    <strong>Total: $${valorTotal.toFixed(2)}</strong>
                  </h5>
                  <small class="text-muted">${documentosPendientes.length} documento(s)</small>
                </div>
              </div>
            </div>
            
            <!-- Información del cliente -->
            <div class="alert alert-info">
              <h6><i class="fas fa-user"></i> Cliente</h6>
              <p class="mb-0"><strong>${documentosPendientes[0].nombreCliente}</strong></p>
            </div>
            
            <!-- Justificación grupal -->
            <div class="mb-4">
              <label for="justificacionGrupal" class="form-label">
                <i class="fas fa-comment"></i> Justificación para Autorización Grupal *
              </label>
              <textarea class="form-control" id="justificacionGrupal" rows="4" 
                        placeholder="Explique por qué es necesario autorizar la entrega de TODOS estos documentos sin verificar pago..."></textarea>
              <div class="form-text">
                <strong>Ejemplo:</strong> "Cliente presente necesita todos los documentos para trámite urgente en banco. 
                Historial de pagos excelente y matrizador informado telefónicamente."
              </div>
            </div>
            
            <!-- Método de autorización -->
            <div class="mb-4">
              <h6><i class="fas fa-route"></i> Método de Autorización</h6>
              
              <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="metodoGrupal" 
                       id="grupalDigital" value="digital" checked>
                <label class="form-check-label" for="grupalDigital">
                  <strong><i class="fas fa-desktop text-primary"></i> Notificación Digital Grupal</strong><br>
                  <small class="text-muted">Se enviará UNA solicitud que incluye todos los documentos</small>
                </label>
              </div>
              
              <div class="form-check">
                <input class="form-check-input" type="radio" name="metodoGrupal" 
                       id="grupalVerbal" value="verbal">
                <label class="form-check-label" for="grupalVerbal">
                  <strong><i class="fas fa-phone text-warning"></i> Autorización Verbal Inmediata</strong><br>
                  <small class="text-muted">Para autorizar TODOS los documentos vía telefónica</small>
                </label>
              </div>
            </div>
            
            <!-- Confirmación especial para grupal -->
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="confirmoGrupal">
              <label class="form-check-label" for="confirmoGrupal">
                <strong>Confirmo que he verificado la necesidad de autorizar TODOS estos ${documentosPendientes.length} documentos simultáneamente</strong>
              </label>
            </div>
            
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
              <i class="fas fa-times"></i> Cancelar
            </button>
            <button type="button" class="btn btn-warning btn-lg" id="btnEnviarGrupal" disabled>
              <i class="fas fa-paper-plane"></i> <strong>AUTORIZAR ${documentosPendientes.length} DOCUMENTOS</strong>
            </button>
          </div>
        </div>
      </div>
    </div>
  `;
  
  // Remover modal existente
  const modalExistente = document.getElementById('modalAutorizacionGrupal');
  if (modalExistente) modalExistente.remove();
  
  // Añadir modal al DOM
  document.body.insertAdjacentHTML('beforeend', modalHTML);
  
  // Configurar listeners específicos para autorización grupal
  configurarModalGrupalListeners(documentosPendientes);
  
  // Mostrar modal
  const modal = new bootstrap.Modal(document.getElementById('modalAutorizacionGrupal'));
  modal.show();
}

/**
 * Configura event listeners para el modal de autorización grupal
 */
function configurarModalGrupalListeners(documentosPendientes) {
  const justificacionInput = document.getElementById('justificacionGrupal');
  const confirmarCheckbox = document.getElementById('confirmoGrupal');
  const btnEnviar = document.getElementById('btnEnviarGrupal');
  
  function validarFormularioGrupal() {
    const justificacion = justificacionInput.value.trim();
    const confirmado = confirmarCheckbox.checked;
    
    btnEnviar.disabled = !(justificacion.length >= 20 && confirmado);
  }
  
  justificacionInput.addEventListener('input', validarFormularioGrupal);
  confirmarCheckbox.addEventListener('change', validarFormularioGrupal);
  
  btnEnviar.addEventListener('click', function() {
    procesarAutorizacionGrupal(documentosPendientes);
  });
}

/**
 * Procesa la autorización grupal enviando solicitudes para cada documento
 */
async function procesarAutorizacionGrupal(documentosPendientes) {
  const metodo = document.querySelector('input[name="metodoGrupal"]:checked').value;
  const justificacion = document.getElementById('justificacionGrupal').value.trim();
  
  // Cerrar modal
  bootstrap.Modal.getInstance(document.getElementById('modalAutorizacionGrupal')).hide();
  
  // Mostrar indicador de progreso
  mostrarProgresoAutorizacionGrupal(documentosPendientes.length);
  
  try {
    if (metodo === 'digital') {
      await procesarAutorizacionDigitalGrupal(documentosPendientes, justificacion);
    } else {
      await procesarAutorizacionVerbalGrupal(documentosPendientes, justificacion);
    }
  } catch (error) {
    console.error('❌ Error en autorización grupal:', error);
    mostrarErrorAutorizacionGrupal(error.message);
  }
}

/**
 * Procesa autorización digital para múltiples documentos
 */
async function procesarAutorizacionDigitalGrupal(documentosPendientes, justificacion) {
  const resultados = [];
  
  for (let i = 0; i < documentosPendientes.length; i++) {
    const documento = documentosPendientes[i];
    
    actualizarProgresoGrupal(i + 1, documentosPendientes.length, `Autorizando ${documento.codigoBarras}...`);
    
    try {
      const response = await fetch('/api/autorizaciones-urgentes/solicitar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          documento_id: documento.id,
          justificacion: `[GRUPAL] ${justificacion} - Documento: ${documento.codigoBarras}`,
          urgencia: 'alta',
          solicitado_desde: 'entrega_grupal'
        })
      });
      
      const data = await response.json();
      
      if (data.success) {
        resultados.push({
          documento: documento,
          autorizacionId: data.autorizacion_id,
          exito: true
        });
      } else {
        resultados.push({
          documento: documento,
          error: data.message,
          exito: false
        });
      }
    } catch (error) {
      resultados.push({
        documento: documento,
        error: error.message,
        exito: false
      });
    }
    
    // Pequeña pausa entre solicitudes
    await new Promise(resolve => setTimeout(resolve, 500));
  }
  
  mostrarResultadosAutorizacionGrupal(resultados, 'digital');
}

/**
 * Procesa autorización verbal para múltiples documentos
 */
async function procesarAutorizacionVerbalGrupal(documentosPendientes, justificacion) {
  // Para autorización verbal, aplicar directamente a todos los documentos
  try {
    const idsDocumentos = documentosPendientes.map(doc => doc.id);
    
    const response = await fetch('/api/autorizaciones-urgentes/autorizar-grupal-verbal', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        documentos_ids: idsDocumentos,
        justificacion: justificacion,
        quien_autorizo: 'matrizador_responsable'
      })
    });
    
    const data = await response.json();
    
    if (data.success) {
      mostrarExitoAutorizacionVerbalGrupal(documentosPendientes.length);
      actualizarUIDocumentosAutorizados(idsDocumentos);
    } else {
      throw new Error(data.message || 'Error en autorización verbal grupal');
    }
  } catch (error) {
    mostrarErrorAutorizacionGrupal(error.message);
  }
}

/**
 * Muestra indicador de progreso para autorización grupal
 */
function mostrarProgresoAutorizacionGrupal(totalDocumentos) {
  const seccionAutorizacion = document.getElementById('seccion-autorizacion-urgente');
  if (seccionAutorizacion) {
    seccionAutorizacion.innerHTML = `
      <div class="alert alert-info">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6><i class="fas fa-cogs"></i> Procesando Autorización Grupal</h6>
            <p class="mb-1" id="mensaje-progreso">Iniciando proceso para ${totalDocumentos} documentos...</p>
            <div class="progress" style="height: 6px;">
              <div class="progress-bar progress-bar-striped progress-bar-animated" 
                   id="barra-progreso" style="width: 0%"></div>
            </div>
          </div>
          <div class="spinner-border spinner-border-sm text-info" role="status"></div>
        </div>
      </div>
    `;
  }
}

/**
 * Actualiza el progreso de autorización grupal
 */
function actualizarProgresoGrupal(actual, total, mensaje) {
  const mensajeProgreso = document.getElementById('mensaje-progreso');
  const barraProgreso = document.getElementById('barra-progreso');
  
  if (mensajeProgreso) {
    mensajeProgreso.textContent = `${mensaje} (${actual}/${total})`;
  }
  
  if (barraProgreso) {
    const porcentaje = (actual / total) * 100;
    barraProgreso.style.width = `${porcentaje}%`;
  }
}

/**
 * Muestra resultados de autorización grupal
 */
function mostrarResultadosAutorizacionGrupal(resultados, metodo) {
  const exitosos = resultados.filter(r => r.exito);
  const fallidos = resultados.filter(r => !r.exito);
  
  let mensaje = `<h6><i class="fas fa-check-circle text-success"></i> Autorización Grupal Completada</h6>`;
  mensaje += `<p><strong>Exitosos:</strong> ${exitosos.length} documentos</p>`;
  
  if (fallidos.length > 0) {
    mensaje += `<p><strong>Errores:</strong> ${fallidos.length} documentos</p>`;
    mensaje += `<ul class="small text-danger">`;
    fallidos.forEach(f => {
      mensaje += `<li>${f.documento.codigoBarras}: ${f.error}</li>`;
    });
    mensaje += `</ul>`;
  }
  
  if (metodo === 'digital') {
    mensaje += `<p class="small text-info">Las solicitudes están siendo procesadas. Se notificará cuando sean autorizadas.</p>`;
  }
  
  const seccionAutorizacion = document.getElementById('seccion-autorizacion-urgente');
  if (seccionAutorizacion) {
    seccionAutorizacion.innerHTML = `
      <div class="alert alert-${fallidos.length === 0 ? 'success' : 'warning'}">
        ${mensaje}
      </div>
    `;
  }
  
  // Si todos fueron exitosos, permitir entrega
  if (fallidos.length === 0 && metodo === 'verbal') {
    habilitarEntregaFinal();
  }
}

/**
 * Muestra éxito de autorización verbal grupal
 */
function mostrarExitoAutorizacionVerbalGrupal(cantidad) {
  const seccionAutorizacion = document.getElementById('seccion-autorizacion-urgente');
  if (seccionAutorizacion) {
    seccionAutorizacion.innerHTML = `
      <div class="alert alert-success">
        <h6><i class="fas fa-phone-check text-success"></i> Autorización Verbal Grupal Completada</h6>
        <p><strong>${cantidad} documentos</strong> autorizados para entrega inmediata.</p>
        <p class="mb-0 small">
          <i class="fas fa-clock me-1"></i>
          <strong>Recordatorio:</strong> El matrizador debe ratificar digitalmente en 24 horas.
        </p>
      </div>
    `;
  }
}

/**
 * Muestra error en autorización grupal
 */
function mostrarErrorAutorizacionGrupal(mensaje) {
  const seccionAutorizacion = document.getElementById('seccion-autorizacion-urgente');
  if (seccionAutorizacion) {
    seccionAutorizacion.innerHTML = `
      <div class="alert alert-danger">
        <h6><i class="fas fa-exclamation-triangle"></i> Error en Autorización Grupal</h6>
        <p class="mb-0">${mensaje}</p>
      </div>
    `;
  }
}

/**
 * Actualiza UI para mostrar documentos como autorizados
 */
function actualizarUIDocumentosAutorizados(documentosIds) {
  documentosIds.forEach(docId => {
    const checkbox = document.querySelector(`input[value="${docId}"]`);
    if (checkbox) {
      const contenedor = checkbox.closest('.documento-individual, .documento-principal');
      if (contenedor) {
        // Agregar indicador visual de autorizado
        const indicador = contenedor.querySelector('.indicador-autorizado');
        if (!indicador) {
          const badge = document.createElement('div');
          badge.className = 'indicador-autorizado badge bg-success small mt-1';
          badge.innerHTML = '<i class="fas fa-check-circle me-1"></i>AUTORIZADO';
          contenedor.querySelector('.flex-grow-1').appendChild(badge);
        }
      }
    }
  });
}

*/

console.log('✅ [DEBUG] Script JavaScript simplificado completado');

</script>

