<!-- VISTA: Entregas del Día -->
<div class="container-fluid">
  <!-- Header con información -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card border-left-primary shadow">
        <div class="card-header bg-primary text-white">
          <h4 class="m-0 font-weight-bold">
            <i class="fas fa-calendar-day me-2"></i>
            📦 Entregas del Día - {{fechaHoy}}
          </h4>
        </div>
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-md-8">
              <p class="mb-2 text-muted">
                Todos los documentos que han sido entregados exitosamente el día de hoy.
              </p>
              <div class="d-flex align-items-center">
                <span class="badge bg-primary me-2">{{totalDocumentos}} entregas</span>
                <span class="text-sm text-muted">Página {{currentPage}} de {{#if pagination.pages.length}}{{pagination.pages.length}}{{else}}1{{/if}}</span>
              </div>
            </div>
            <div class="col-md-4 text-end">
              <a href="/recepcion" class="btn btn-outline-primary">
                <i class="fas fa-arrow-left"></i> Volver al Dashboard
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tabla de entregas -->
  {{#if documentos.length}}
  <div class="row">
    <div class="col-12">
      <div class="card shadow">
        <div class="card-header">
          <h6 class="m-0 font-weight-bold text-primary">
            Lista de Entregas Realizadas Hoy
          </h6>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-hover mb-0 table-striped">
              <thead class="table-light">
                <tr>
                  <th class="text-center" style="width: 80px;">Hora</th>
                  <th style="width: 120px;">Código</th>
                  <th style="width: 200px;">Cliente</th>
                  <th class="text-center" style="width: 80px;">Tipo</th>
                  <th style="width: 120px;">Matrizador</th>
                  <th class="text-end" style="width: 80px;">Valor</th>
                  <th class="text-center" style="width: 100px;">Estado Pago</th>
                  <th class="text-center" style="width: 80px;">Acciones</th>
                </tr>
              </thead>
              <tbody>
                {{#each documentos}}
                <tr>
                  <!-- Hora de entrega -->
                  <td class="text-center">
                    <strong class="text-success">
                      {{formatTime this.fechaEntrega}}
                    </strong>
                  </td>
                  
                  <!-- Código del documento -->
                  <td>
                    <a href="/recepcion/documentos/detalle/{{this.id}}" class="text-primary text-decoration-none">
                      <strong>{{this.codigoBarras}}</strong>
                    </a>
                    {{#if this.numeroFactura}}
                      <br><small class="text-muted">F: {{this.numeroFactura}}</small>
                    {{/if}}
                  </td>
                  
                  <!-- Cliente -->
                  <td>
                    <div class="fw-bold">{{this.nombreCliente}}</div>
                    {{#if this.identificacionCliente}}
                      <small class="text-muted">{{this.identificacionCliente}}</small>
                    {{/if}}
                  </td>
                  
                  <!-- Tipo de documento -->
                  <td class="text-center">
                    <span class="badge bg-info">{{this.tipoDocumento}}</span>
                  </td>
                  
                  <!-- Matrizador -->
                  <td>
                    {{#if this.matrizador}}
                      <span class="fw-bold">{{this.matrizador.nombre}}</span>
                    {{else}}
                      <span class="text-muted">Sin asignar</span>
                    {{/if}}
                  </td>
                  
                  <!-- Valor -->
                  <td class="text-end">
                    <strong class="text-success">${{formatMoney this.valorFactura}}</strong>
                  </td>
                  
                  <!-- Estado de pago -->
                  <td class="text-center">
                    {{#if (eq this.estadoPago 'pagado_completo')}}
                      <span class="badge bg-success">
                        <i class="fas fa-check-circle me-1"></i>Pagado
                      </span>
                    {{else if (eq this.estadoPago 'pagado_con_retencion')}}
                      <span class="badge bg-warning">
                        <i class="fas fa-university me-1"></i>Con Retención
                      </span>
                    {{else}}
                      <span class="badge bg-danger">
                        <i class="fas fa-exclamation-triangle me-1"></i>Pendiente
                      </span>
                    {{/if}}
                  </td>
                  
                  <!-- Acciones -->
                  <td class="text-center">
                    <div class="btn-group btn-group-sm" role="group">
                      <a href="/recepcion/documentos/detalle/{{this.id}}" 
                         class="btn btn-outline-info" title="Ver Detalle">
                        <i class="fas fa-eye"></i>
                      </a>
                    </div>
                  </td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Paginación -->
  {{#if pagination.pages.length}}
  <div class="row mt-4">
    <div class="col-12">
      <nav aria-label="Paginación de entregas">
        <ul class="pagination justify-content-center">
          {{#if pagination.prev}}
          <li class="page-item">
            <a class="page-link" href="{{pagination.prev}}">
              <i class="fas fa-chevron-left"></i> Anterior
            </a>
          </li>
          {{/if}}
          
          {{#each pagination.pages}}
          <li class="page-item {{#if this.active}}active{{/if}}">
            <a class="page-link" href="{{this.url}}">{{this.num}}</a>
          </li>
          {{/each}}
          
          {{#if pagination.next}}
          <li class="page-item">
            <a class="page-link" href="{{pagination.next}}">
              Siguiente <i class="fas fa-chevron-right"></i>
            </a>
          </li>
          {{/if}}
        </ul>
      </nav>
    </div>
  </div>
  {{/if}}

  {{else}}
  <!-- Estado vacío -->
  <div class="row">
    <div class="col-12">
      <div class="card border-left-info shadow">
        <div class="card-body text-center py-5">
          <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
          <h5 class="text-muted">No hay entregas registradas hoy</h5>
          <p class="text-muted">
            Aún no se han realizado entregas el día de hoy ({{fechaHoy}}).
          </p>
          <a href="/recepcion" class="btn btn-primary">
            <i class="fas fa-arrow-left"></i> Volver al Dashboard
          </a>
        </div>
      </div>
    </div>
  </div>
  {{/if}}
</div>

<style>
.border-left-primary {
  border-left: 0.25rem solid #4e73df !important;
}
.border-left-info {
  border-left: 0.25rem solid #36b9cc !important;
}

/* 🎯 TABLA OPTIMIZADA - Headers legibles y alineados */
.table thead.table-light th {
  background-color: #f8f9fa !important;
  color: #495057 !important;
  font-weight: 600 !important;
  border-bottom: 2px solid #dee2e6 !important;
  font-size: 0.875rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 0.75rem 0.5rem;
  vertical-align: middle;
}

.table tbody td {
  vertical-align: middle;
  padding: 0.75rem 0.5rem;
  border-top: 1px solid #dee2e6;
}

.table-striped tbody tr:nth-of-type(odd) {
  background-color: rgba(0, 0, 0, 0.02);
}

.table-hover tbody tr:hover {
  background-color: rgba(0, 123, 255, 0.1);
}

/* Responsive: Ajustes para móviles */
@media (max-width: 768px) {
  .table thead th {
    font-size: 0.75rem;
    padding: 0.5rem 0.25rem;
  }
  
  .table tbody td {
    padding: 0.5rem 0.25rem;
    font-size: 0.875rem;
  }
  
  .badge {
    font-size: 0.7rem;
  }
}

/* Mejorar legibilidad de badges */
.badge {
  font-size: 0.75rem;
  padding: 0.375rem 0.5rem;
}

.badge i {
  font-size: 0.7rem;
}

/* Enlaces más visibles */
.text-primary {
  color: #0d6efd !important;
}

.text-primary:hover {
  color: #0a58ca !important;
}

.btn-group-sm > .btn {
  padding: 0.25rem 0.5rem;
}
</style> 