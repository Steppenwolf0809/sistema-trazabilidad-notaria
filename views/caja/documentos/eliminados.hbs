{{! Vista de Documentos Eliminados - Caja - Auditoría Completa }}
<div class="container-fluid">
  
  <!-- Header -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h2><i class="fas fa-trash-restore text-danger me-3"></i>🗑️ Documentos Eliminados</h2>
          <p class="text-muted mb-0">Auditoría completa de documentos eliminados por caja</p>
        </div>
        <div>
          <a href="/caja/documentos" class="btn btn-outline-primary">
            <i class="fas fa-arrow-left me-2"></i>Volver a Documentos
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Estadísticas Resumidas -->
  {{#if stats}}
  <div class="row mb-4">
    <div class="col-12">
      <div class="card border-info">
        <div class="card-header bg-info text-white">
          <h5 class="mb-0"><i class="fas fa-chart-bar me-2"></i>📊 Estadísticas de Eliminaciones</h5>
        </div>
        <div class="card-body">
          <div class="row">
            {{#each stats}}
            <div class="col-md-3 mb-3">
              <div class="text-center p-3 border rounded">
                <h4 class="text-danger mb-1">{{this.total}}</h4>
                <p class="mb-1 fw-bold">{{getTextoMotivo this.deletion_reason}}</p>
                <small class="text-muted">Valor: ${{formatMoney this.valorTotal}}</small>
              </div>
            </div>
            {{/each}}
          </div>
        </div>
      </div>
    </div>
  </div>
  {{/if}}

  <!-- Filtros -->
  <div class="card mb-4">
    <div class="card-header">
      <h5 class="mb-0"><i class="fas fa-filter me-2"></i>🔍 Filtros de Búsqueda</h5>
    </div>
    <div class="card-body">
      <form method="GET" action="/caja/documentos/eliminados">
        <div class="row">
          <div class="col-md-4">
            <label class="form-label">Motivo de Eliminación</label>
            <select class="form-select" name="motivo">
              <option value="">Todos los motivos</option>
              <option value="error_xml_importado" {{#if (eq filtros.motivo "error_xml_importado")}}selected{{/if}}>
                🔍 Error en XML importado
              </option>
              <option value="error_creacion_documento" {{#if (eq filtros.motivo "error_creacion_documento")}}selected{{/if}}>
                ✏️ Error al crear documento
              </option>
              <option value="solicitud_nota_credito" {{#if (eq filtros.motivo "solicitud_nota_credito")}}selected{{/if}}>
                📄 Solicitud de nota de crédito
              </option>
              <option value="documento_duplicado" {{#if (eq filtros.motivo "documento_duplicado")}}selected{{/if}}>
                📋 Documento duplicado
              </option>
              <option value="datos_incorrectos" {{#if (eq filtros.motivo "datos_incorrectos")}}selected{{/if}}>
                🔧 Datos incorrectos
              </option>
              <option value="cliente_cancelo_tramite" {{#if (eq filtros.motivo "cliente_cancelo_tramite")}}selected{{/if}}>
                ❌ Cliente canceló trámite
              </option>
              <option value="error_sistema" {{#if (eq filtros.motivo "error_sistema")}}selected{{/if}}>
                ⚙️ Error del sistema
              </option>
              <option value="otro" {{#if (eq filtros.motivo "otro")}}selected{{/if}}>
                📝 Otro motivo
              </option>
            </select>
          </div>
          
          <div class="col-md-3">
            <label class="form-label">Fecha Desde</label>
            <input type="date" class="form-control" name="fechaDesde" value="{{filtros.fechaDesde}}">
          </div>
          
          <div class="col-md-3">
            <label class="form-label">Fecha Hasta</label>
            <input type="date" class="form-control" name="fechaHasta" value="{{filtros.fechaHasta}}">
          </div>
          
          <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">
              <i class="fas fa-search me-1"></i>Filtrar
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- Tabla de Documentos Eliminados -->
  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h5 class="mb-0">
        <i class="fas fa-list me-2"></i>Documentos Eliminados 
        {{#if pagination.totalCount}}
        <span class="badge bg-danger">{{pagination.totalCount}}</span>
        {{/if}}
      </h5>
      {{#if documentosEliminados.length}}
      <div>
        <small class="text-muted">
          Página {{pagination.currentPage}} de {{pagination.totalPages}}
        </small>
      </div>
      {{/if}}
    </div>
    
    <div class="card-body p-0">
      {{#if documentosEliminados.length}}
      <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
          <thead class="table-dark">
            <tr>
              <th width="10%">📄 Código</th>
              <th width="15%">👤 Cliente</th>
              <th width="10%">💰 Valor</th>
              <th width="15%">🗑️ Motivo</th>
              <th width="15%">👨‍💼 Eliminado Por</th>
              <th width="12%">📅 Fecha</th>
              <th width="8%">💳 Pago</th>
              <th width="15%">🔍 Acciones</th>
            </tr>
          </thead>
          <tbody>
            {{#each documentosEliminados}}
            <tr>
              <!-- Código del documento -->
              <td>
                <div class="fw-bold text-danger">{{this.codigoBarras}}</div>
                <small class="text-muted">{{this.tipoDocumento}}</small>
              </td>
              
              <!-- Cliente -->
              <td>
                <div class="fw-bold">{{this.nombreCliente}}</div>
                <small class="text-muted">{{this.identificacionCliente}}</small>
              </td>
              
              <!-- Valor -->
              <td>
                <div class="fw-bold">{{formatMoney this.valorFactura}}</div>
                {{#if this.numeroFactura}}
                <small class="text-muted">{{this.numeroFactura}}</small>
                {{else}}
                <small class="text-muted">Sin factura</small>
                {{/if}}
              </td>
              
              <!-- Motivo -->
              <td>
                <span class="badge bg-danger mb-1">{{getTextoMotivo this.deletionReason}}</span>
                {{#if this.paymentHandling}}
                <br>
                <small class="text-info">
                  <i class="fas fa-credit-card me-1"></i>{{getTextoManejosPago this.paymentHandling}}
                </small>
                {{/if}}
              </td>
              
              <!-- Eliminado por -->
              <td>
                <div class="fw-bold">{{this.deletedByUser.nombre}}</div>
                <small class="text-muted">{{this.deletedByUser.rol}}</small>
              </td>
              
              <!-- Fecha eliminación -->
              <td>
                <div class="fw-bold">{{formatDate this.deletedAt}}</div>
                <small class="text-muted">{{formatTime this.deletedAt}}</small>
              </td>
              
              <!-- Estado de pago -->
              <td>
                {{#if (gt this.valorPagado 0)}}
                <span class="badge bg-warning text-dark">
                  <i class="fas fa-exclamation-triangle me-1"></i>Tenía Pago
                </span>
                <div class="small text-muted">${{formatMoney this.valorPagado}}</div>
                {{else}}
                <span class="badge bg-secondary">Sin Pago</span>
                {{/if}}
              </td>
              
              <!-- Acciones -->
              <td>
                <div class="btn-group btn-group-sm">
                  <button 
                    type="button" 
                    class="btn btn-outline-info" 
                    data-bs-toggle="modal" 
                    data-bs-target="#verDetalleModal"
                    onclick="verDetalleEliminacion('{{this.id}}')"
                    title="Ver detalle completo">
                    <i class="fas fa-eye"></i>
                  </button>
                  
                  <button 
                    type="button" 
                    class="btn btn-outline-secondary" 
                    onclick="verJustificacion('{{this.deletionJustification}}')"
                    title="Ver justificación completa">
                    <i class="fas fa-comment-alt"></i>
                  </button>
                </div>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      {{else}}
      <div class="text-center py-5">
        <i class="fas fa-search fa-3x text-muted mb-3"></i>
        <h4 class="text-muted">No se encontraron documentos eliminados</h4>
        <p class="text-muted">
          {{#if (or filtros.motivo filtros.fechaDesde filtros.fechaHasta)}}
          Pruebe ajustando los filtros de búsqueda.
          {{else}}
          No hay documentos eliminados en el sistema.
          {{/if}}
        </p>
      </div>
      {{/if}}
    </div>
    
    <!-- Paginación -->
    {{#if (gt pagination.totalPages 1)}}
    <div class="card-footer">
      <nav aria-label="Paginación de documentos eliminados">
        <ul class="pagination justify-content-center mb-0">
          {{#if pagination.hasPrev}}
          <li class="page-item">
            <a class="page-link" href="?page={{sub pagination.currentPage 1}}{{#if filtros.motivo}}&motivo={{filtros.motivo}}{{/if}}{{#if filtros.fechaDesde}}&fechaDesde={{filtros.fechaDesde}}{{/if}}{{#if filtros.fechaHasta}}&fechaHasta={{filtros.fechaHasta}}{{/if}}">
              <i class="fas fa-chevron-left"></i> Anterior
            </a>
          </li>
          {{/if}}
          
          {{#range 1 pagination.totalPages}}
          <li class="page-item {{#if (eq this ../pagination.currentPage)}}active{{/if}}">
            <a class="page-link" href="?page={{this}}{{#if ../filtros.motivo}}&motivo={{../filtros.motivo}}{{/if}}{{#if ../filtros.fechaDesde}}&fechaDesde={{../filtros.fechaDesde}}{{/if}}{{#if ../filtros.fechaHasta}}&fechaHasta={{../filtros.fechaHasta}}{{/if}}">
              {{this}}
            </a>
          </li>
          {{/range}}
          
          {{#if pagination.hasNext}}
          <li class="page-item">
            <a class="page-link" href="?page={{add pagination.currentPage 1}}{{#if filtros.motivo}}&motivo={{filtros.motivo}}{{/if}}{{#if filtros.fechaDesde}}&fechaDesde={{filtros.fechaDesde}}{{/if}}{{#if filtros.fechaHasta}}&fechaHasta={{filtros.fechaHasta}}{{/if}}">
              Siguiente <i class="fas fa-chevron-right"></i>
            </a>
          </li>
          {{/if}}
        </ul>
      </nav>
    </div>
    {{/if}}
  </div>
</div>

<!-- Modal para ver detalle completo -->
<div class="modal fade" id="verDetalleModal" tabindex="-1" aria-labelledby="verDetalleModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-info text-white">
        <h5 class="modal-title" id="verDetalleModalLabel">
          <i class="fas fa-info-circle me-2"></i>Detalle Completo de Eliminación
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="contenidoDetalleModal">
        <!-- El contenido se carga dinámicamente -->
        <div class="text-center py-4">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
          </div>
          <p class="mt-2 text-muted">Cargando información...</p>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<!-- JavaScript -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  
  // Función para ver justificación completa
  window.verJustificacion = function(justificacion) {
    alert(`📝 Justificación Completa:\n\n${justificacion}`);
  };
  
  // Función para ver detalle completo de eliminación
  window.verDetalleEliminacion = function(documentoId) {
    const modal = document.getElementById('verDetalleModal');
    const contenido = document.getElementById('contenidoDetalleModal');
    
    // Mostrar loading
    contenido.innerHTML = `
      <div class="text-center py-4">
        <div class="spinner-border text-primary" role="status">
          <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="mt-2 text-muted">Cargando información detallada...</p>
      </div>
    `;
    
    // Cargar detalles (simulado - aquí iría una petición AJAX real)
    setTimeout(() => {
      const documentoData = obtenerDatosDocumento(documentoId);
      mostrarDetalleCompleto(documentoData);
    }, 1000);
  };
  
  function obtenerDatosDocumento(documentoId) {
    // En una implementación real, esto sería una petición AJAX
    // Por ahora simulamos con datos estáticos
    return {
      id: documentoId,
      codigoBarras: 'DOC-2024-001',
      nombreCliente: 'Juan Pérez',
      motivo: 'error_xml_importado',
      justificacion: 'El archivo XML tenía datos incorrectos que no coincidían con la información del cliente.',
      fechaEliminacion: new Date(),
      eliminadoPor: 'María González',
      valorFactura: 150.00,
      valorPagado: 150.00,
      paymentHandling: 'nota_credito_automatica'
    };
  }
  
  function mostrarDetalleCompleto(datos) {
    const contenido = document.getElementById('contenidoDetalleModal');
    
    contenido.innerHTML = `
      <div class="row">
        <div class="col-md-6">
          <h6 class="text-primary border-bottom pb-2">📄 Información del Documento</h6>
          <p><strong>Código:</strong> ${datos.codigoBarras}</p>
          <p><strong>Cliente:</strong> ${datos.nombreCliente}</p>
          <p><strong>Valor Factura:</strong> $${datos.valorFactura.toFixed(2)}</p>
          <p><strong>Valor Pagado:</strong> $${datos.valorPagado.toFixed(2)}</p>
        </div>
        
        <div class="col-md-6">
          <h6 class="text-danger border-bottom pb-2">🗑️ Información de Eliminación</h6>
          <p><strong>Motivo:</strong> ${getTextoMotivo(datos.motivo)}</p>
          <p><strong>Eliminado por:</strong> ${datos.eliminadoPor}</p>
          <p><strong>Fecha:</strong> ${formatearFecha(datos.fechaEliminacion)}</p>
          ${datos.paymentHandling ? `<p><strong>Manejo Pago:</strong> ${getTextoManejosPago(datos.paymentHandling)}</p>` : ''}
        </div>
      </div>
      
      <div class="row mt-3">
        <div class="col-12">
          <h6 class="text-warning border-bottom pb-2">📝 Justificación Completa</h6>
          <div class="alert alert-light border">
            <p class="mb-0">${datos.justificacion}</p>
          </div>
        </div>
      </div>
      
      <div class="alert alert-info mt-3">
        <i class="fas fa-shield-alt me-2"></i>
        <strong>Auditoría:</strong> Esta información queda registrada permanentemente para cumplimiento normativo.
      </div>
    `;
  }
  
  function getTextoMotivo(motivo) {
    const textos = {
      'error_xml_importado': '🔍 Error en XML importado',
      'error_creacion_documento': '✏️ Error al crear documento',
      'solicitud_nota_credito': '📄 Solicitud de nota de crédito',
      'documento_duplicado': '📋 Documento duplicado',
      'datos_incorrectos': '🔧 Datos incorrectos',
      'cliente_cancelo_tramite': '❌ Cliente canceló trámite',
      'error_sistema': '⚙️ Error del sistema',
      'otro': '📝 Otro motivo'
    };
    return textos[motivo] || motivo;
  }
  
  function getTextoManejosPago(manejo) {
    const textos = {
      'nota_credito_automatica': '📄 Nota de crédito automática',
      'reembolso_manual': '💳 Reembolso manual procesado'
    };
    return textos[manejo] || manejo;
  }
  
  function formatearFecha(fecha) {
    return new Date(fecha).toLocaleString('es-ES', {
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit'
    });
  }
  
  console.log('📋 Vista de documentos eliminados cargada correctamente');
});
</script>

<!-- Estilos específicos -->
<style>
.table th {
  font-size: 0.85rem;
  white-space: nowrap;
}

.table td {
  font-size: 0.85rem;
  vertical-align: middle;
}

.badge {
  font-size: 0.75rem;
}

.btn-group-sm .btn {
  padding: 0.25rem 0.5rem;
}

.spinner-border-sm {
  width: 1rem;
  height: 1rem;
}

.pagination .page-link {
  font-size: 0.875rem;
}

@media (max-width: 768px) {
  .table-responsive {
    font-size: 0.75rem;
  }
  
  .btn-group-sm .btn {
    padding: 0.125rem 0.25rem;
  }
}
</style> 