  function validarFormularioEliminacion() {
    // 🔧 CORRECCIÓN: Obtener valor sin trim() para el contador, con trim() para validación
    const valorBruto = justificacionInput ? justificacionInput.value : '';
    const justificacion = valorBruto.trim();
    const motivoSeleccionado = document.querySelector('input[name="motivo"]:checked');
    const confirmado = confirmarCheckbox ? confirmarCheckbox.checked : false;
    
    // 🐛 DEBUG: Log para debugging
    console.log('🔍 Validando formulario eliminación:', {
      valorBruto: valorBruto,
      valorBrutoLength: valorBruto.length,
      justificacion: justificacion,
      justificacionLength: justificacion.length,
      motivoSeleccionado: motivoSeleccionado?.value || 'ninguno',
      confirmado: confirmado,
      contadorElement: !!contadorCaracteres,
      botonElement: !!btnConfirmarEliminacion,
      textareaValue: justificacionInput?.value,
      textareaExists: !!justificacionInput
    });
    
    // Actualizar contador de caracteres (usar valor bruto para mostrar caracteres reales)
    if (contadorCaracteres) {
      contadorCaracteres.textContent = valorBruto.length;
      
      if (justificacion.length >= 5) {
        contadorCaracteres.className = 'text-success fw-bold';
        console.log('✅ Justificación válida:', justificacion.length, 'caracteres (limpio)');
      } else {
        contadorCaracteres.className = 'text-danger';
        console.log('❌ Justificación insuficiente:', justificacion.length, 'caracteres (limpio), mínimo 5');
      }
      
      console.log('📊 Contador actualizado:', {
        caracteresReales: valorBruto.length,
        caracteresLimpios: justificacion.length,
        contadorMuestra: contadorCaracteres.textContent
      });
    } else {
      console.warn('⚠️ Elemento contador de caracteres no encontrado');
    }
    
    // Validar si hay pago registrado y se necesita seleccionar manejo
    const seccionPago = document.getElementById('seccion-manejo-pago');
    let manejosPagoValido = true;
    
    if (seccionPago && seccionPago.style.display !== 'none') {
      const manejoSeleccionado = document.querySelector('input[name="manejosPago"]:checked');
      manejosPagoValido = !!manejoSeleccionado;
    }
    
    // Habilitar/deshabilitar botón
    const esValido = motivoSeleccionado && 
                     justificacion.length >= 5 && 
                     confirmado && 
                     manejosPagoValido;
    
    // 🐛 DEBUG: Log del estado final de validación
    console.log('📊 Estado de validación final:', {
      esValido: esValido,
      motivoSeleccionado: !!motivoSeleccionado,
      justificacionValida: justificacion.length >= 5,
      confirmado: confirmado,
      manejosPagoValido: manejosPagoValido
    });
    
    if (btnConfirmarEliminacion) {
      btnConfirmarEliminacion.disabled = !esValido;
      
      if (esValido) {
        btnConfirmarEliminacion.className = 'btn btn-danger btn-lg';
        btnConfirmarEliminacion.innerHTML = '<i class="fas fa-trash-alt me-2"></i>🗑️ ELIMINAR DOCUMENTO';
        console.log('✅ Botón habilitado - formulario válido');
      } else {
        btnConfirmarEliminacion.className = 'btn btn-secondary btn-lg';
        btnConfirmarEliminacion.innerHTML = '<i class="fas fa-trash-alt me-2"></i>Complete todos los campos';
        console.log('❌ Botón deshabilitado - formulario incompleto');
      }
    } else {
      console.warn('⚠️ Elemento botón de confirmación no encontrado');
    }
  }
  
  function procesarEliminacionDocumento() {
    const formData = new FormData(formEliminar);
    
    // Obtener datos del documento desde el modal
    const documentoId = modalEliminar.querySelector('[data-documento-id]')?.getAttribute('data-documento-id');
    const codigoBarras = document.getElementById('modal-codigo-documento').textContent;
    
    if (!documentoId) {
      mostrarNotificacion('❌ Error: No se pudo identificar el documento', 'error');
      return;
    }
    
    // Mostrar confirmación final
    const motivo = formData.get('motivo');
    const justificacion = formData.get('justificacion');
    const manejosPago = formData.get('manejosPago');
    
    let mensaje = `⚠️ ¿CONFIRMAR ELIMINACIÓN PERMANENTE?

📄 Documento: ${codigoBarras}
🔍 Motivo: ${getTextoMotivo(motivo)}
📝 Justificación: ${justificacion.substring(0, 100)}${justificacion.length > 100 ? '...' : ''}`;

    if (manejosPago) {
      mensaje += `\n💳 Manejo de pago: ${getTextoManejosPago(manejosPago)}`;
    }

    mensaje += `\n\n⚠️ ESTA ACCIÓN NO SE PUEDE DESHACER`;
    
    if (!confirm(mensaje)) {
      return;
    }
    
    // Deshabilitar botón y mostrar loading
    btnConfirmarEliminacion.disabled = true;
    btnConfirmarEliminacion.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Eliminando...';
    
    // Preparar datos para envío
    const datosEnvio = {
      motivo: motivo,
      justificacion: justificacion,
      confirmarEliminacion: true
    };
    
    if (manejosPago) {
      datosEnvio.manejosPago = manejosPago;
    }
    
    // Enviar petición AJAX
    fetch(`/caja/documentos/eliminar/${documentoId}`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: JSON.stringify(datosEnvio)
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        // Éxito
        mostrarNotificacion(`✅ ${data.message}`, 'success', 5000);
        
        // Cerrar modal
        const modalInstance = bootstrap.Modal.getInstance(modalEliminar);
        modalInstance.hide();
        
        // Recargar página después de un momento
        setTimeout(() => {
          window.location.reload();
        }, 2000);
        
      } else {
        // Error del servidor
        mostrarNotificacion(`❌ ${data.message}`, 'error', 6000);
        
        // Rehabilitar botón
        btnConfirmarEliminacion.disabled = false;
        btnConfirmarEliminacion.innerHTML = '<i class="fas fa-trash-alt me-2"></i>🗑️ Reintentar Eliminación';
      }
    })
    .catch(error => {
      console.error('Error eliminando documento:', error);
      mostrarNotificacion('❌ Error de conexión al eliminar documento', 'error', 6000);
      
      // Rehabilitar botón
      btnConfirmarEliminacion.disabled = false;
      btnConfirmarEliminacion.innerHTML = '<i class="fas fa-trash-alt me-2"></i>🗑️ Reintentar Eliminación';
    });
  }
  
  function getTextoMotivo(motivo) {
    const textos = {
      'error_xml_importado': 'Error en XML importado',
      'error_creacion_documento': 'Error al crear documento',
      'solicitud_nota_credito': 'Solicitud de nota de crédito',
      'documento_duplicado': 'Documento duplicado',
      'datos_incorrectos': 'Datos incorrectos',
      'cliente_cancelo_tramite': 'Cliente canceló trámite',
      'error_sistema': 'Error del sistema',
      'otro': 'Otro motivo'
    };
    return textos[motivo] || motivo;
  }
  
  function getTextoManejosPago(manejo) {
    const textos = {
      'pago_sera_manejado': 'El pago será manejado adecuadamente'
    };
    return textos[manejo] || manejo;
  }

