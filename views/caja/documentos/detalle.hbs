    document.getElementById('confirmarReversionCaja').checked = false;
    document.getElementById('btnEjecutarReversionCaja').disabled = true;
    // NO ocultar camposCorreccion - se manejará específicamente por cada función
    actualizarContadorCaja();
  }
  
  function actualizarContadorCaja() {
    const textarea = document.getElementById('justificacionReversionCaja');
    const contador = document.getElementById('contadorCaracteresCaja');
    
    if (!textarea || !contador) {
      console.warn('❌ No se encontraron elementos del contador');
      return;
    }
    
    const longitud = textarea.value.length;
    
    console.log('📊 Actualizando contador:', { longitud, minimo: 5 });
    
    contador.textContent = longitud;
    if (longitud >= 5) {
      contador.className = 'text-success fw-bold';
    } else {
      contador.className = 'text-danger fw-bold';
    }
    
    validarFormularioCaja();
  }
  
  function validarFormularioCaja() {
    const motivo = document.getElementById('motivoReversionCaja')?.value || '';
    const justificacion = document.getElementById('justificacionReversionCaja')?.value || '';
    const confirmacion = document.getElementById('confirmarReversionCaja')?.checked || false;
    const btnEjecutar = document.getElementById('btnEjecutarReversionCaja');
    
    if (!btnEjecutar) {
      console.warn('❌ No se encontró botón de ejecución');
      return;
    }
    
    const esValido = motivo && justificacion.length >= 5 && confirmacion;
    
    console.log('🔍 Validando formulario:', {
      motivo: !!motivo,
      justificacionLength: justificacion.length,
      confirmacion: confirmacion,
      esValido: esValido
    });
    
    btnEjecutar.disabled = !esValido;
    
    if (esValido) {
      btnEjecutar.className = 'btn btn-warning btn-lg';
      btnEjecutar.innerHTML = '<i class="fas fa-undo me-2"></i>Ejecutar Reversión';
      console.log('✅ Formulario válido - botón habilitado');
    } else {
      btnEjecutar.className = 'btn btn-secondary btn-lg';
      btnEjecutar.innerHTML = '<i class="fas fa-times me-2"></i>Complete los campos requeridos';
      console.log('❌ Formulario inválido - botón deshabilitado');
    }
  }
  
  window.ejecutarReversionCaja = function() {
    const motivo = document.getElementById('motivoReversionCaja').value;
    const justificacion = document.getElementById('justificacionReversionCaja').value;
    const pagoData = window.currentPagoData;
    
    // CRÍTICO: Obtener el ID del documento correctamente
    const documentoId = '{{documento.id}}';
    
    if (!motivo || justificacion.length < 5 || !pagoData) {
      alert('Por favor complete todos los campos requeridos (mínimo 5 caracteres en justificación)');
      return;
    }
    
    // Deshabilitar botón
    const btn = document.getElementById('btnEjecutarReversionCaja');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Ejecutando...';
    
    let url, body;
    
    if (pagoData.tipo === 'corregir' || pagoData.tipo === 'corregir_virtual') {
      // Corrección de pago (normal o virtual)
      const nuevoMetodo = document.getElementById('nuevoMetodo').value;
      const nuevoMonto = document.getElementById('nuevoMonto').value;
      const tipoCorreccion = nuevoMonto !== pagoData.monto ? 'monto_pago' : 'metodo_pago';
      
      if (pagoData.tipo === 'corregir_virtual') {
        // Para pagos virtuales, usar ruta especial que actualiza directamente el documento
        url = `/caja/documentos/${documentoId}/corregir-pago-virtual`;
        body = {
          tipoCorreccion,
          nuevoMetodo,
          nuevoMonto: parseFloat(nuevoMonto),
          montoAnterior: parseFloat(pagoData.monto),
          metodoAnterior: pagoData.metodo,
          motivoCategoria: motivo,
          justificacion
        };
      } else {
        // Pago normal
        url = `/caja/pagos/${pagoData.id}/corregir`;
        body = {
          tipoCorreccion,
          nuevoMetodo,
          nuevoMonto,
          motivoCategoria: motivo,
          justificacion
        };
      }
    } else if (pagoData.tipo === 'retencion') {
      // Deshacer retención
      url = `/caja/retenciones/${pagoData.id}/deshacer`;
      body = {
        motivoCategoria: motivo,
        justificacion
      };
    } else if (pagoData.tipo === 'deshacer_virtual') {
      // Deshacer pago virtual - actualiza directamente el documento
      url = `/caja/documentos/${documentoId}/deshacer-pago-virtual`;
      body = {
        montoOriginal: parseFloat(pagoData.monto),
        metodoOriginal: pagoData.metodo,
        motivoCategoria: motivo,
        justificacion
      };
    } else {
      // Deshacer pago normal
      url = `/caja/pagos/${pagoData.id}/deshacer`;
      body = {
        motivoCategoria: motivo,
        justificacion
      };
    }
    
    // Hacer petición AJAX
    fetch(url, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(body)
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        // Cerrar modal
        const modal = bootstrap.Modal.getInstance(document.getElementById('modalReversionCaja'));
        modal.hide();
        
        // Mostrar mensaje de éxito
        mostrarNotificacion('✅ Reversión financiera ejecutada exitosamente', 'success');
        
        // Recargar página
        setTimeout(() => location.reload(), 1500);
      } else {
        alert('❌ Error: ' + (data.mensaje || data.error || 'No se pudo ejecutar la reversión'));
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-undo"></i> Ejecutar Reversión';
      }
    })
    .catch(error => {
      console.error('Error:', error);
      alert('❌ Error de conexión. Intente nuevamente.');
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-undo"></i> Ejecutar Reversión';
    });
  };
  
  // ============================================================================
  // INICIALIZACIÓN DE EVENT LISTENERS PARA REVERSIONES FINANCIERAS
  // ============================================================================
  
  // Agregar event listeners para el modal de reversiones al DOM principal
  const justificacionTextarea = document.getElementById('justificacionReversionCaja');
  const motivoSelect = document.getElementById('motivoReversionCaja');
  const confirmarCheck = document.getElementById('confirmarReversionCaja');
  const btnEjecutar = document.getElementById('btnEjecutarReversionCaja');
  
  console.log('🔧 Configurando event listeners para reversiones...');
  console.log('Elementos encontrados:', {
    justificacion: !!justificacionTextarea,
    motivo: !!motivoSelect,
    confirmar: !!confirmarCheck,
    boton: !!btnEjecutar
  });
  
  if (justificacionTextarea) {
    justificacionTextarea.addEventListener('input', function() {
      console.log('📝 Input en justificación, caracteres:', this.value.length);
      actualizarContadorCaja();
    });
    console.log('✅ Event listener agregado a textarea de justificación');
  } else {
    console.warn('❌ No se encontró textarea de justificación');
  }
  
  if (motivoSelect) {
    motivoSelect.addEventListener('change', function() {
      console.log('📋 Cambio en motivo:', this.value);
      validarFormularioCaja();
    });
    console.log('✅ Event listener agregado a select de motivo');
  } else {
    console.warn('❌ No se encontró select de motivo');
  }
  
  if (confirmarCheck) {
    confirmarCheck.addEventListener('change', function() {
      console.log('☑️ Cambio en confirmación:', this.checked);
      validarFormularioCaja();
    });
    console.log('✅ Event listener agregado a checkbox de confirmación');
  } else {
    console.warn('❌ No se encontró checkbox de confirmación');
  }
  
  if (btnEjecutar) {
    // NOTA: No agregar event listener aquí porque ya tiene onclick en HTML
    console.log('✅ Botón de ejecución encontrado (usando onclick del HTML)');
  } else {
    console.warn('❌ No se encontró botón de ejecución');
  }

  console.log('📖 Vista caja con modal de reversiones completo cargada para documento {{documento.codigoBarras}}');
});

function deshacerPagoVirtual(pagoId, monto, metodoPago) {
  console.log('🔄 Revirtiendo pago virtual:', pagoId, monto, metodoPago);
  
  // Extraer ID del documento del pagoId virtual
  const documentoId = pagoId.replace('virtual_', '');
  
  // Crear modal dinámico para reversión
  const modalHtml = `
    <div class="modal fade" id="modalRevertirPago" tabindex="-1">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header bg-warning">
            <h5 class="modal-title">⚠️ Revertir Pago</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <form action="/caja/documentos/${documentoId}/revertir-pago" method="POST">
            <div class="modal-body">
              <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle"></i>
                <strong>¡Atención!</strong> Esta acción eliminará el pago de <strong>$${monto}</strong> registrado por <strong>${metodoPago}</strong>.
              </div>
              <div class="mb-3">
                <label class="form-label">Justificación (requerida)</label>
                <textarea class="form-control" name="justificacion" rows="3" required 
                          placeholder="Explique por qué se está revirtiendo este pago..."></textarea>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="confirmarReversion" required>
                <label class="form-check-label" for="confirmarReversion">
                  Confirmo que deseo revertir este pago y que la justificación es correcta
                </label>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
              <button type="submit" class="btn btn-warning">Revertir Pago</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  `;
  
  // Agregar modal al DOM y mostrarlo
  document.body.insertAdjacentHTML('beforeend', modalHtml);
  const modal = new bootstrap.Modal(document.getElementById('modalRevertirPago'));
  modal.show();
  
  // Limpiar modal cuando se cierre
  document.getElementById('modalRevertirPago').addEventListener('hidden.bs.modal', function() {
    this.remove();
  });
}

// Funciones para pagos normales (no virtuales)

function deshacerPago(pagoId, monto, metodoPago) {
  console.log('🔄 Revirtiendo pago normal:', pagoId, monto, metodoPago);
  // Reutilizar la función de pago virtual ya que la lógica es similar
  deshacerPagoVirtual(`virtual_{{documento.id}}`, monto, metodoPago);
}

function deshacerRetencion(pagoId, monto, metodoPago) {
  console.log('🔄 Revirtiendo retención:', pagoId, monto, metodoPago);
  // Reutilizar la función de pago virtual ya que la lógica es similar
  deshacerPagoVirtual(`virtual_{{documento.id}}`, monto, metodoPago);
}
</script>
