</div>

<!-- Documentos -->
<div class="row mt-4">
  <div class="col-md-6">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span>Documentos En Proceso</span>
        <a href="/matrizador/documentos?estado=en_proceso" class="btn btn-sm btn-outline-primary">Ver Todos</a>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead>
              <tr>
                <th>Código</th>
                <th>Tipo</th>
                <th>Cliente</th>
                <th>Fecha Inicio</th>
                <th>Tiempo</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody>
              {{#each documentosEnProceso}}
              <tr>
                <td>{{this.codigoBarras}}</td>
                <td>{{this.tipoDocumento}}</td>
                <td>{{this.nombreCliente}}</td>
                <td>
                  <span class="fecha-documento-dashboard" data-fecha="{{this.fechaFactura}}">
                    Cargando...
                  </span>
                </td>
                <td>
                  {{this.diasEnProceso}} días
                  {{#if (gte this.diasEnProceso 7)}}
                  <i class="fas fa-exclamation-triangle text-danger"></i>
                  {{/if}}
                </td>
                <td>
                  <a href="/matrizador/documentos/editar/{{this.id}}" class="btn btn-sm btn-primary">
                    <i class="fas fa-edit"></i>
                  </a>
                </td>
              </tr>
              {{else}}
              <tr>
                <td colspan="6" class="text-center py-3">No hay documentos en proceso</td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  
  <div class="col-md-6">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span>Documentos Listos Sin Retirar</span>
        <a href="/matrizador/documentos?estado=listo_para_entrega" class="btn btn-sm btn-outline-primary">Ver Todos</a>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead>
              <tr>
                <th>Código</th>
                <th>Tipo</th>
                <th>Cliente</th>
                <th>Listo Desde</th>
                <th>Días Sin Retirar</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody>
              {{#each documentosListos}}
              <tr>
                <td>{{this.codigoBarras}}</td>
                <td>{{this.tipoDocumento}}</td>
                <td>{{this.nombreCliente}}</td>
                <td>
                  <span class="fecha-documento-dashboard" data-fecha="{{this.fechaListo}}">
                    Cargando...
                  </span>
                </td>
                <td>
                  {{this.diasSinRetirar}} días
                  {{#if (gte this.diasSinRetirar 15)}}
                  <i class="fas fa-exclamation-triangle text-danger"></i>
                  {{else if (gte this.diasSinRetirar 7)}}
                  <i class="fas fa-exclamation-circle text-warning"></i>
                  {{/if}}
                </td>
                <td>
                  <a href="/matrizador/documentos/entrega/{{this.id}}" class="btn btn-sm btn-success">
                    <i class="fas fa-hand-holding"></i>
                  </a>
                </td>
              </tr>
              {{else}}
              <tr>
                <td colspan="6" class="text-center py-3">No hay documentos listos sin retirar</td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Contenedor para Alertas de Autorización Urgente -->
<div id="contenedor-alertas-urgentes" class="mb-4"></div>

<!-- Scripts para el funcionamiento del dashboard -->
<script>
  // Mostrar/ocultar selector de fechas personalizadas
  document.getElementById('tipoPeriodo').addEventListener('change', function() {
    const fechasPersonalizadas = document.getElementById('fechasPersonalizadas');
    if (this.value === 'personalizado') {
      fechasPersonalizadas.style.display = 'flex';
    } else {
      fechasPersonalizadas.style.display = 'none';
    }
  });

  // Configuración de gráficos cuando los datos estén disponibles
  document.addEventListener('DOMContentLoaded', function() {
    // Cambio entre diferentes gráficos
    document.getElementById('btnProductividad').addEventListener('click', function() {
      document.getElementById('graficoProductividad').style.display = 'block';
      document.getElementById('graficoTiempos').style.display = 'none';
      document.getElementById('graficoTipos').style.display = 'none';
      this.classList.add('active');
      document.getElementById('btnTiempos').classList.remove('active');
      document.getElementById('btnTipos').classList.remove('active');
    });

    document.getElementById('btnTiempos').addEventListener('click', function() {
      document.getElementById('graficoProductividad').style.display = 'none';
      document.getElementById('graficoTiempos').style.display = 'block';
      document.getElementById('graficoTipos').style.display = 'none';
      this.classList.add('active');
      document.getElementById('btnProductividad').classList.remove('active');
      document.getElementById('btnTipos').classList.remove('active');
    });

    document.getElementById('btnTipos').addEventListener('click', function() {
      document.getElementById('graficoProductividad').style.display = 'none';
      document.getElementById('graficoTiempos').style.display = 'none';
      document.getElementById('graficoTipos').style.display = 'block';
      this.classList.add('active');
      document.getElementById('btnProductividad').classList.remove('active');
      document.getElementById('btnTiempos').classList.remove('active');
    });

    // Inicializar gráficos si hay datos
    if (typeof Chart !== 'undefined') {
      {{#if datosGraficos}}
        // Gráfico de productividad
        const ctxProductividad = document.getElementById('productividadChart').getContext('2d');
        const labelsProductividad = {{{json datosGraficos.productividad.labels}}};
        const datosProductividad = {{{json datosGraficos.productividad.datos}}};
        
        new Chart(ctxProductividad, {
          type: 'line',
          data: {
            labels: labelsProductividad,
            datasets: [{
              label: 'Documentos procesados',
              data: datosProductividad,
              backgroundColor: 'rgba(54, 162, 235, 0.2)',
              borderColor: 'rgba(54, 162, 235, 1)',
              borderWidth: 2,
              tension: 0.4
            }]
          },
          options: {
            scales: {
              y: {
                beginAtZero: true,
                title: {
                  display: true,
                  text: 'Cantidad de documentos'
                }
              },
              x: {
                title: {
                  display: true,
                  text: 'Fecha'
                }
              }
            }
          }
        });

        // Gráfico de tiempos
        const ctxTiempos = document.getElementById('tiemposChart').getContext('2d');
        const labelsTiempos = {{{json datosGraficos.tiempos.labels}}};
        const datosTiempos = {{{json datosGraficos.tiempos.datos}}};
        
        new Chart(ctxTiempos, {
          type: 'bar',
          data: {
            labels: labelsTiempos,
            datasets: [{
              label: 'Tiempo promedio (días)',
              data: datosTiempos,
              backgroundColor: 'rgba(255, 159, 64, 0.2)',
              borderColor: 'rgba(255, 159, 64, 1)',
              borderWidth: 1
            }]
          },
          options: {
            scales: {
              y: {
                beginAtZero: true,
                title: {
                  display: true,
                  text: 'Días'
                }
              }
            }
          }
        });

        // Gráfico por tipos
        const ctxTipos = document.getElementById('tiposChart').getContext('2d');
        const labelsTipos = {{{json datosGraficos.tipos.labels}}};
        const datosTipos = {{{json datosGraficos.tipos.datos}}};
        
        new Chart(ctxTipos, {
          type: 'pie',
          data: {
            labels: labelsTipos,
            datasets: [{
              data: datosTipos,
              backgroundColor: [
                'rgba(54, 162, 235, 0.7)',
                'rgba(255, 99, 132, 0.7)',
                'rgba(255, 206, 86, 0.7)',
                'rgba(75, 192, 192, 0.7)',
                'rgba(153, 102, 255, 0.7)',
                'rgba(255, 159, 64, 0.7)',
                'rgba(199, 199, 199, 0.7)'
              ],
              borderWidth: 1
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: true,
            plugins: {
              legend: {
                position: 'bottom',
                labels: {
                  boxWidth: 12,
                  font: {
                    size: 11
                  }
                }
              }
            }
          }
        });
      {{/if}}
    }
    
    // ============== FORMATEAR FECHAS DE DOCUMENTOS EN DASHBOARD ==============
    console.log('🕒 Iniciando formateo de fechas en dashboard de matrizador...');
    
    // Función para formatear fecha de manera robusta
    function formatearFechaSegura(fechaRaw) {
      if (!fechaRaw || fechaRaw === 'null' || fechaRaw === '' || fechaRaw === 'undefined') {
        return 'Sin fecha';
      }
      
      try {
        // Intentar diferentes formatos de fecha
        let fecha;
        
        // Si ya es un objeto Date
        if (fechaRaw instanceof Date) {
          fecha = fechaRaw;
        }
        // Si es un string ISO
        else if (typeof fechaRaw === 'string') {
          // Limpiar la fecha de caracteres extraños
          const fechaLimpia = fechaRaw.trim();
          fecha = new Date(fechaLimpia);
        }
        // Si es un timestamp
        else if (typeof fechaRaw === 'number') {
          fecha = new Date(fechaRaw);
        }
        else {
          console.warn('Formato de fecha no reconocido:', fechaRaw);
          return 'Formato inválido';
        }
        
        // Verificar si la fecha es válida
        if (isNaN(fecha.getTime())) {
          console.warn('Fecha inválida después de conversión:', fechaRaw);
          return 'Fecha inválida';
        }
        
        return fecha;
      } catch (error) {
        console.error('Error procesando fecha:', error, 'Fecha original:', fechaRaw);
        return 'Error en fecha';
      }
    }
    
    // Formatear fechas de documentos en dashboard
    document.querySelectorAll('.fecha-documento-dashboard').forEach(function(elemento) {
      const fechaRaw = elemento.getAttribute('data-fecha');
      console.log('📅 Procesando fecha de documento en dashboard:', fechaRaw);
      
      const fechaFormateada = formatearFechaSegura(fechaRaw);
      
      if (fechaFormateada instanceof Date) {
        elemento.textContent = fechaFormateada.toLocaleDateString('es-EC', {
          day: '2-digit',
          month: '2-digit', 
          year: 'numeric'
        });
        elemento.classList.add('text-success');
      } else {
        elemento.textContent = fechaFormateada;
        elemento.classList.add('text-muted');
      }
    });
    
    console.log('✅ Formateo de fechas de documentos en dashboard completado');
    
    // ============== SISTEMA DE ALERTAS DE AUTORIZACIÓN URGENTE ==============
    
    function cargarAlertasAutorizacionUrgente() {
      console.log('🔄 Cargando alertas de autorización urgente...');
      
      fetch('/api/autorizaciones-urgentes/pendientes', {
        method: 'GET',
        credentials: 'include',
        headers: {
          'Content-Type': 'application/json'
        }
      })
        .then(response => {
          console.log('📡 Respuesta del servidor:', response.status);
          if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
          }
          return response.json();
        })
        .then(data => {
          console.log('📊 Datos recibidos:', data);
          if (data.success && data.autorizaciones && data.autorizaciones.length > 0) {
            console.log(`✅ Mostrando ${data.autorizaciones.length} alertas de autorización`);
            mostrarAlertasAutorizacion(data.autorizaciones);
          } else {
            console.log('ℹ️ No hay autorizaciones pendientes');
            ocultarAlertasAutorizacion();
          }
        })
        .catch(error => {
          console.error('❌ Error al cargar alertas de autorización urgente:', error);
        });
    }
    
    function mostrarAlertasAutorizacion(autorizaciones) {
      console.log('🎯 Mostrando alertas de autorización:', autorizaciones);
      
      // FILTRAR SOLO LAS AUTORIZACIONES DIGITALES PENDIENTES (excluir verbales)
      const autorizacionesDigitales = autorizaciones.filter(auth => auth.estado === 'pendiente');
      
      if (autorizacionesDigitales.length === 0) {
        ocultarAlertasAutorizacion();
        return;
      }
      
      const contenedor = document.getElementById('alertas-autorizacion-urgente');
      
      if (!contenedor) {
        console.error('❌ No se encontró el contenedor de alertas: alertas-autorizacion-urgente');
        return;
      }
      
      const alertasHTML = autorizacionesDigitales.map(auth => {
        const esUrgente = auth.es_urgente;
        const badgeClass = esUrgente ? 'bg-danger' : 'bg-warning';
        const iconClass = esUrgente ? 'fa-bell' : 'fa-clock';
        const cardClass = esUrgente ? 'border-danger' : 'border-warning';
        const headerClass = esUrgente ? 'bg-danger' : 'bg-warning';
        
        return `
          <div class="col-12 mb-3">
            <div class="card ${cardClass} shadow-sm">
              <div class="card-header ${headerClass} text-white">
                <div class="d-flex justify-content-between align-items-center">
                  <h6 class="mb-0">
                    <i class="fas ${iconClass} me-2"></i>
                    ${esUrgente ? '🚨 AUTORIZACIÓN URGENTE CRÍTICA' : '⚠️ Solicitud de Autorización Urgente'}
                  </h6>
                  <span class="badge ${badgeClass}">
                    ${auth.minutos_espera} min esperando
                  </span>
                </div>
              </div>
              <div class="card-body">
                <div class="row">
                  <div class="col-md-8">
                    <h6 class="text-primary">${auth.cliente_nombre}</h6>
                    <p class="mb-1">
                      <strong>Documento:</strong> ${auth.tipo_documento} - ${auth.codigo_barras}
                    </p>
                    <p class="mb-1">
                      <strong>Monto pendiente:</strong> $${auth.monto_pendiente}
                    </p>
                    <p class="mb-1">
                      <strong>Solicitado por:</strong> ${auth.solicitado_por_nombre} (${auth.solicitado_por_rol})
                    </p>
                    <p class="mb-0 text-muted">
                      <strong>Justificación:</strong> ${auth.justificacion_solicitud}
                    </p>
                  </div>
                  <div class="col-md-4 text-end">
                    <div class="mb-2">
                      <small class="text-muted">Solicitado hace:</small><br>
                      <strong class="${esUrgente ? 'text-danger' : 'text-warning'}">
                        ${auth.minutos_espera} minutos
                      </strong>
                    </div>
                    <a href="/matrizador/autorizacion/revisar/${auth.id}" 
                       class="btn ${esUrgente ? 'btn-danger' : 'btn-warning'} btn-lg">
                      <i class="fas fa-gavel me-1"></i>
                      <strong>REVISAR Y AUTORIZAR</strong>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        `;
      }).join('');
      
      contenedor.innerHTML = alertasHTML;
      console.log('✅ Alertas de autorización digital mostradas en el DOM');
    }
    
    function ocultarAlertasAutorizacion() {
      const contenedor = document.getElementById('alertas-autorizacion-urgente');
      contenedor.innerHTML = '';
    }
    
    // Cargar alertas al inicio
    cargarAlertasAutorizacionUrgente();
    
    // Actualizar alertas cada 20 segundos
    setInterval(cargarAlertasAutorizacionUrgente, 20000);
    
    // ============== SISTEMA DE AUTORIZACIONES VERBALES PENDIENTES ==============
    
    function cargarAutorizacionesVerbalesPendientes() {
      console.log('🔄 Cargando autorizaciones verbales pendientes...');
      
      fetch('/api/autorizaciones-urgentes/pendientes', {
        method: 'GET',
        credentials: 'include',
        headers: {
          'Content-Type': 'application/json'
        }
      })
        .then(response => response.json())
        .then(data => {
          if (data.success && data.autorizaciones) {
            // Filtrar solo las que están en estado 'verbal_pendiente'
            const verbalesPendientes = data.autorizaciones.filter(auth => auth.estado === 'verbal_pendiente');
            
            if (verbalesPendientes.length > 0) {
              mostrarAutorizacionesVerbales(verbalesPendientes);
            } else {
              ocultarAutorizacionesVerbales();
            }
          }
        })
        .catch(error => {
          console.error('❌ Error al cargar autorizaciones verbales:', error);
        });
    }
    
    function mostrarAutorizacionesVerbales(autorizaciones) {
      const contenedor = document.getElementById('autorizaciones-verbales-pendientes');
      const contador = document.getElementById('contador-verbales');
      const tablaContainer = document.getElementById('tabla-verbales-container');
      
      contador.textContent = autorizaciones.length;
      contenedor.style.display = 'block';
      
      const tablaHTML = `
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-warning">
              <tr>
                <th>Cliente</th>
                <th>Documento</th>
                <th>Monto</th>
                <th>Autorizado Verbalmente</th>
                <th>Fecha Límite</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody>
              ${autorizaciones.map(auth => {
                const fechaLimite = new Date(auth.verbal_fecha_limite);
                const horasRestantes = Math.max(0, Math.floor((fechaLimite - new Date()) / (1000 * 60 * 60)));
                const esUrgente = horasRestantes <= 6;
                
                return `
                  <tr class="${esUrgente ? 'table-danger' : ''}">
                    <td>
                      <strong>${auth.cliente_nombre}</strong>
                      <br><small class="text-muted">${auth.solicitado_por_nombre}</small>
                    </td>
                    <td>
                      <span class="badge bg-info">${auth.tipo_documento}</span>
                      <br><small>${auth.codigo_barras}</small>
                    </td>
                    <td>
                      <strong>$${auth.monto_pendiente}</strong>
                    </td>
                    <td>
                      <strong>${auth.verbal_quien_autorizo}</strong>
                      <br><small class="text-muted">${new Date(auth.verbal_fecha).toLocaleString('es-EC')}</small>
                    </td>
                    <td>
                      <span class="badge ${esUrgente ? 'bg-danger' : 'bg-warning'}">
                        ${horasRestantes}h restantes
                      </span>
                      <br><small class="text-muted">${fechaLimite.toLocaleDateString('es-EC')}</small>
                    </td>
                    <td>
                      <button class="btn btn-success btn-sm me-1" 
                              onclick="ratificarAutorizacionVerbal('${auth.id}', true)">
                        <i class="fas fa-check"></i> Ratificar
                      </button>
                      <button class="btn btn-danger btn-sm" 
                              onclick="ratificarAutorizacionVerbal('${auth.id}', false)">
                        <i class="fas fa-times"></i> Rechazar
                      </button>
                    </td>
                  </tr>
                `;
              }).join('')}
            </tbody>
          </table>
        </div>
      `;
      
      tablaContainer.innerHTML = tablaHTML;
    }
    
    function ocultarAutorizacionesVerbales() {
      const contenedor = document.getElementById('autorizaciones-verbales-pendientes');
      contenedor.style.display = 'none';
    }
    
    // Función global para ratificar autorizaciones verbales
    window.ratificarAutorizacionVerbal = function(autorizacionId, confirmar) {
      const accion = confirmar ? 'ratificar' : 'rechazar';
      const mensaje = confirmar 
        ? '¿Confirma que ratifica esta autorización verbal? Esto validará la entrega ya realizada.'
        : '¿Está seguro de rechazar esta ratificación? Esto revocará la autorización y se registrará en auditoría.';
      
      if (!confirm(mensaje)) return;
      
      const btnRatificar = document.querySelector(`button[onclick*="${autorizacionId}"][onclick*="true"]`);
      const btnRechazar = document.querySelector(`button[onclick*="${autorizacionId}"][onclick*="false"]`);
      
      if (btnRatificar) btnRatificar.disabled = true;
      if (btnRechazar) btnRechazar.disabled = true;
      
      fetch(`/api/autorizaciones-urgentes/${autorizacionId}/ratificar`, {
        method: 'POST',
        credentials: 'include',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          confirmar_ratificacion: confirmar
        })
      })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            alert(confirmar ? 'Autorización ratificada correctamente' : 'Ratificación rechazada');
            location.reload(); // Recargar para actualizar
          } else {
            alert('Error: ' + data.message);
          }
        })
        .catch(error => {
          console.error('Error:', error);
          alert('Error al procesar la ratificación');
        })
        .finally(() => {
          if (btnRatificar) btnRatificar.disabled = false;
          if (btnRechazar) btnRechazar.disabled = false;
        });
    };
    
    // Cargar autorizaciones verbales al inicio
    cargarAutorizacionesVerbalesPendientes();
    
    // Actualizar cada 30 segundos
    setInterval(cargarAutorizacionesVerbalesPendientes, 30000);

  });

</script>

<div class="statistic">
  <h5>Total Facturado</h5>
  <div class="d-flex align-items-center">
    <h2>${{formatMoney stats.totalFacturado}}</h2>
  </div>
</div>

 