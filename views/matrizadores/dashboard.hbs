{{! Dashboard de Matrizadores - MODERNIZADO CON PALETA AZUL PROFESIONAL }}
{{! layout: 'matrizador' }}

<!-- HEADER PROFESIONAL CON PALETA AZUL -->
<div class="dashboard-header">
  <div class="container-fluid">
    <div class="row align-items-center">
      <div class="col-md-8">
        <h2 class="dashboard-title"><i class="fas fa-user-cog me-3"></i>Dashboard Matrizador</h2>
        <p class="dashboard-subtitle">Gestión y control de documentos</p>
      </div>
      <div class="col-md-4 text-end">
        <div class="badge bg-light text-dark p-2">
          <i class="fas fa-clock me-1"></i>
          {{formatDate now 'DD/MM/YYYY HH:mm'}}
        </div>
      </div>
    </div>
  </div>
</div>

<!-- FILTROS SEGMENTADOS MODERNOS -->
<div class="tarjeta-contenido">
  <div class="seccion-titulo">📊 Filtros de Período</div>
  <form id="periodoForm" class="row align-items-end">
    <div class="col-md-3">
      <label for="tipoPeriodo" class="form-label">Período</label>
      <select id="tipoPeriodo" name="tipoPeriodo" class="form-input">
        <option value="hoy" {{#if periodo.esHoy}}selected{{/if}}>Hoy</option>
        <option value="semana" {{#if periodo.esSemana}}selected{{/if}}>Esta semana</option>
        <option value="mes" {{#if periodo.esMes}}selected{{/if}}>Este mes</option>
        <option value="ultimo_mes" {{#if periodo.esUltimoMes}}selected{{/if}}>Último mes</option>
        <option value="personalizado" {{#if periodo.esPersonalizado}}selected{{/if}}>Personalizado</option>
      </select>
    </div>
    
    <div id="fechasPersonalizadas" class="row align-items-end" style="{{#unless periodo.esPersonalizado}}display: none;{{/unless}}">
      <div class="col-md-3">
        <label for="fechaInicio" class="form-label">Desde</label>
        <input type="date" id="fechaInicio" name="fechaInicio" class="form-input" value="{{periodo.fechaInicio}}">
      </div>
      <div class="col-md-3">
        <label for="fechaFin" class="form-label">Hasta</label>
        <input type="date" id="fechaFin" name="fechaFin" class="form-input" value="{{periodo.fechaFin}}">
      </div>
    </div>
    
    <div class="col-md-3">
      <button type="submit" class="btn btn-primary">
        <i class="fas fa-filter me-1"></i> Aplicar Filtro
      </button>
      <button type="button" id="exportarBtn" class="btn btn-secondary ms-2">
        <i class="fas fa-download me-1"></i> Exportar
      </button>
    </div>
  </form>
</div>

<!-- Sistema de Alertas de Autorización Urgente -->
<div class="row mb-4" id="alertas-autorizacion-urgente">
  <!-- Las alertas se cargarán aquí dinámicamente -->
</div>

<!-- Autorizaciones Verbales Pendientes de Ratificación -->
<div class="row mb-4" id="autorizaciones-verbales-pendientes" style="display: none;">
  <div class="col-12">
    <div class="card border-warning">
      <div class="card-header bg-warning text-dark">
        <h5 class="mb-0">
          <i class="fas fa-phone-check me-2"></i> Autorizaciones Verbales - Requieren Ratificación
          <span class="badge bg-dark float-end" id="contador-verbales">0</span>
        </h5>
      </div>
      <div class="card-body p-0" id="tabla-verbales-container">
        <!-- Se carga dinámicamente -->
      </div>
    </div>
  </div>
</div>

<!-- SISTEMA DE ALERTAS PROFESIONAL -->
{{#if stats.alertas.length}}
<div class="tarjeta-contenido">
  <div class="seccion-titulo text-danger">
    <i class="fas fa-exclamation-triangle me-2"></i>
    🚨 Alertas Prioritarias
    <span class="badge bg-danger ms-2">{{stats.alertas.length}}</span>
  </div>
  <div class="table-responsive">
    <table class="tabla-moderna">
      <thead>
        <tr>
          <th>Documento</th>
          <th>Cliente</th>
          <th>Tiempo en Sistema</th>
          <th>Estado</th>
          <th>Prioridad</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        {{#each stats.alertas}}
        <tr class="{{#if (gte this.diasEnSistema 10)}}table-danger{{else if (gte this.diasEnSistema 7)}}table-warning{{else}}table-info{{/if}}">
          <td>
            <a href="/matrizador/documentos/detalle/{{this.id}}" class="codigo-link">{{this.codigoBarras}}</a>
            <span class="d-block small text-muted">{{this.tipoDocumento}}</span>
          </td>
          <td><strong>{{this.nombreCliente}}</strong></td>
          <td>
            <strong class="text-danger">{{this.diasEnSistema}} días</strong>
            <div class="progress" style="height: 4px;">
              <div class="progress-bar bg-danger" style="width: {{this.porcentajeDemora}}%"></div>
            </div>
          </td>
          <td>
            {{#if (eq this.estado "en_proceso")}}
            <span class="badge badge-warning">En Proceso</span>
            {{else}}
            <span class="badge badge-info">{{this.estado}}</span>
            {{/if}}
          </td>
          <td>
            {{#if (gte this.diasEnSistema 10)}}
            <span class="badge bg-danger">Crítica</span>
            {{else if (gte this.diasEnSistema 7)}}
            <span class="badge bg-warning">Alta</span>
            {{else}}
            <span class="badge badge-info">Media</span>
            {{/if}}
          </td>
          <td>
            <a href="/matrizador/documentos/detalle/{{this.id}}" class="btn btn-primary btn-sm">
              <i class="fas fa-edit"></i> Procesar
            </a>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
{{else}}
<div class="alert alert-success" role="alert">
  <i class="fas fa-check-circle me-2"></i>
  <strong>¡Excelente!</strong> No tienes documentos con alta prioridad en este momento.
</div>
{{/if}}

<!-- MÉTRICAS PRINCIPALES DEL MATRIZADOR -->

<!-- TARJETAS KPI PROFESIONALES - 4 TARJETAS EN UNA FILA -->
<div class="tarjetas-kpi" style="display: grid !important; grid-template-columns: repeat(4, 1fr) !important; gap: 1.5rem !important; margin-bottom: 2rem !important;">
<style>
/* Responsive para tarjetas en fila única */
@media (max-width: 1200px) {
  .tarjetas-kpi {
    gap: 1rem !important;
  }
  .kpi-numero { font-size: 1.5rem !important; }
  .kpi-etiqueta { font-size: 0.65rem !important; }
  .kpi-descripcion { font-size: 0.75rem !important; }
}

@media (max-width: 992px) {
  .tarjetas-kpi {
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 1rem !important;
  }
}

@media (max-width: 576px) {
  .tarjetas-kpi {
    grid-template-columns: 1fr !important;
    gap: 1rem !important;
  }
}
</style>
  <!-- DOCUMENTOS ACTIVOS -->
  <div class="tarjeta-kpi" style="background: white !important; border-radius: 12px !important; padding: 1.25rem !important; box-shadow: 0 4px 6px rgba(0,0,0,0.1) !important; border: 1px solid #E9F5FF !important; min-height: 110px !important;">
    <div class="kpi-header" style="display: flex !important; align-items: center !important; gap: 0.75rem !important;">
      <div class="kpi-icono verde" style="width: 40px !important; height: 40px !important; background: linear-gradient(135deg, #4680EB, #1A5799) !important; border-radius: 10px !important; display: flex !important; align-items: center !important; justify-content: center !important; color: white !important; font-size: 0.9rem !important;">
        <i class="fas fa-file-alt"></i>
      </div>
      <div class="kpi-info">
        <div class="kpi-etiqueta" style="font-size: 0.7rem !important; color: #092F64 !important; font-weight: 600 !important; text-transform: uppercase !important;">📋 Activos</div>
        <div class="kpi-numero" style="font-size: 1.75rem !important; font-weight: 800 !important; color: #092F64 !important; line-height: 1 !important;">{{#if stats.activos}}{{stats.activos}}{{else}}0{{/if}}</div>
        <div class="kpi-descripcion" style="font-size: 0.8rem !important; color: #1F1F1F !important; opacity: 0.7 !important;">Total gestión</div>
      </div>
    </div>
  </div>

  <!-- EN PROCESO -->
  <div class="tarjeta-kpi" style="background: white !important; border-radius: 12px !important; padding: 1.25rem !important; box-shadow: 0 4px 6px rgba(0,0,0,0.1) !important; border: 1px solid #E9F5FF !important; min-height: 110px !important;">
    <div class="kpi-header" style="display: flex !important; align-items: center !important; gap: 0.75rem !important;">
      <div class="kpi-icono naranja" style="width: 40px !important; height: 40px !important; background: linear-gradient(135deg, #9BBFFF, #4680EB) !important; border-radius: 10px !important; display: flex !important; align-items: center !important; justify-content: center !important; color: white !important; font-size: 0.9rem !important;">
        <i class="fas fa-clock"></i>
      </div>
      <div class="kpi-info">
        <div class="kpi-etiqueta" style="font-size: 0.7rem !important; color: #092F64 !important; font-weight: 600 !important; text-transform: uppercase !important;">⚠️ En Proceso</div>
        <div class="kpi-numero" style="font-size: 1.75rem !important; font-weight: 800 !important; color: #092F64 !important; line-height: 1 !important;">{{#if stats.enProceso}}{{stats.enProceso}}{{else}}0{{/if}}</div>
        <div class="kpi-descripcion" style="font-size: 0.8rem !important; color: #1F1F1F !important; opacity: 0.7 !important;">En período</div>
      </div>
    </div>
  </div>

  <!-- COMPLETADOS -->
  <div class="tarjeta-kpi" style="background: white !important; border-radius: 12px !important; padding: 1.25rem !important; box-shadow: 0 4px 6px rgba(0,0,0,0.1) !important; border: 1px solid #E9F5FF !important; min-height: 110px !important;">
    <div class="kpi-header" style="display: flex !important; align-items: center !important; gap: 0.75rem !important;">
      <div class="kpi-icono azul" style="width: 40px !important; height: 40px !important; background: linear-gradient(135deg, #4680EB, #9BBFFF) !important; border-radius: 10px !important; display: flex !important; align-items: center !important; justify-content: center !important; color: white !important; font-size: 0.9rem !important;">
        <i class="fas fa-check-circle"></i>
      </div>
      <div class="kpi-info">
        <div class="kpi-etiqueta" style="font-size: 0.7rem !important; color: #092F64 !important; font-weight: 600 !important; text-transform: uppercase !important;">✅ Completados</div>
        <div class="kpi-numero" style="font-size: 1.75rem !important; font-weight: 800 !important; color: #092F64 !important; line-height: 1 !important;">{{#if stats.completados}}{{stats.completados}}{{else}}0{{/if}}</div>
        <div class="kpi-descripcion" style="font-size: 0.8rem !important; color: #1F1F1F !important; opacity: 0.7 !important;">Listos entrega</div>
      </div>
    </div>
  </div>

  <!-- ENTREGADOS -->
  <div class="tarjeta-kpi" style="background: white !important; border-radius: 12px !important; padding: 1.25rem !important; box-shadow: 0 4px 6px rgba(0,0,0,0.1) !important; border: 1px solid #E9F5FF !important; min-height: 110px !important;">
    <div class="kpi-header" style="display: flex !important; align-items: center !important; gap: 0.75rem !important;">
      <div class="kpi-icono purpura" style="width: 40px !important; height: 40px !important; background: linear-gradient(135deg, #1A5799, #092F64) !important; border-radius: 10px !important; display: flex !important; align-items: center !important; justify-content: center !important; color: white !important; font-size: 0.9rem !important;">
        <i class="fas fa-hand-holding"></i>
      </div>
      <div class="kpi-info">
        <div class="kpi-etiqueta" style="font-size: 0.7rem !important; color: #092F64 !important; font-weight: 600 !important; text-transform: uppercase !important;">📤 Entregados</div>
        <div class="kpi-numero" style="font-size: 1.75rem !important; font-weight: 800 !important; color: #092F64 !important; line-height: 1 !important;">{{#if stats.entregados}}{{stats.entregados}}{{else}}0{{/if}}</div>
        <div class="kpi-descripcion" style="font-size: 0.8rem !important; color: #1F1F1F !important; opacity: 0.7 !important;">Ya entregados</div>
      </div>
    </div>
  </div>
</div>

<!-- MÉTRICAS ADICIONALES PROFESIONALES -->
<div class="contenido-principal">
  <div class="tarjeta-contenido">
    <div class="seccion-titulo">⏱️ Tiempo Promedio de Procesamiento</div>
    <div class="kpi-numero text-center">{{stats.tiempoPromedio}} días</div>
    <div class="kpi-descripcion text-center">Desde registro hasta listo para entrega</div>
  </div>
  
  <div class="tarjeta-contenido">
    <div class="seccion-titulo">🎯 Eficiencia de Procesamiento</div>
    <div class="kpi-numero text-center">{{stats.eficiencia}}%</div>
    <div class="kpi-descripcion text-center">Documentos completados dentro del tiempo esperado</div>
  </div>
</div>

<!-- GRÁFICOS ESTADÍSTICOS PROFESIONALES -->
<div class="tarjeta-contenido">
  <div class="seccion-titulo">
    📊 Estadísticas Personales
    <div class="filtros-segmentados float-end">
      <button type="button" class="filtro-btn activo" id="btnProductividad">Productividad</button>
      <button type="button" class="filtro-btn" id="btnTiempos">Tiempos</button>
      <button type="button" class="filtro-btn" id="btnTipos">Por Tipo</button>
    </div>
  </div>
  
  <div id="graficoProductividad" style="max-height: 350px;">
    <canvas id="productividadChart" height="200"></canvas>
  </div>
  <div id="graficoTiempos" style="display: none; max-height: 350px;">
    <canvas id="tiemposChart" height="200"></canvas>
  </div>
  <div id="graficoTipos" style="display: none; max-height: 350px;">
    <canvas id="tiposChart" height="200"></canvas>
  </div>
</div>

<!-- ACCESOS RÁPIDOS PROFESIONALES -->
<div class="tarjeta-contenido">
  <div class="seccion-titulo">🚀 Accesos Rápidos</div>
  <div class="row">
    <div class="col-md-4 mb-3">
      <a href="/matrizador/documentos" class="btn btn-primary w-100 py-3">
        <i class="fas fa-folder-open fa-2x mb-2 d-block"></i>
        <strong>Ver Mis Documentos</strong>
      </a>
    </div>
    <div class="col-md-4 mb-3">
      <a href="/matrizador/documentos/entrega" class="btn btn-secondary w-100 py-3">
        <i class="fas fa-hand-holding fa-2x mb-2 d-block"></i>
        <strong>Entregas Pendientes</strong>
      </a>
    </div>
    <div class="col-md-4 mb-3">
      <a href="/matrizador/documentos/buscar" class="btn btn-secondary w-100 py-3">
        <i class="fas fa-search fa-2x mb-2 d-block"></i>
        <strong>Buscar Documento</strong>
      </a>
    </div>
  </div>
</div>

<!-- DOCUMENTOS PRINCIPALES CON PALETA -->
<div class="contenido-principal">
  <!-- DOCUMENTOS EN PROCESO -->
  <div class="tarjeta-contenido">
    <div class="seccion-titulo">
      ⚠️ Documentos En Proceso
      <a href="/matrizador/documentos?estado=en_proceso" class="btn btn-secondary btn-sm float-end">Ver Todos</a>
    </div>
    <div class="table-responsive">
      <table class="tabla-moderna">
        <thead>
          <tr>
            <th>Código</th>
            <th>Tipo</th>
            <th>Cliente</th>
            <th>Fecha Inicio</th>
            <th>Tiempo</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          {{#each documentosEnProceso}}
          <tr class="{{#if (gte this.diasEnProceso 7)}}table-warning{{/if}}">
            <td><a href="/matrizador/documentos/editar/{{this.id}}" class="codigo-link">{{this.codigoBarras}}</a></td>
            <td><span class="badge badge-info">{{this.tipoDocumento}}</span></td>
            <td><strong>{{this.nombreCliente}}</strong></td>
            <td>
              <span class="fecha-documento-dashboard" data-fecha="{{this.fechaFactura}}">
                Cargando...
              </span>
            </td>
            <td>
              <span class="badge {{#if (gte this.diasEnProceso 7)}}bg-danger{{else}}badge-warning{{/if}}">
                {{this.diasEnProceso}} días
              </span>
            </td>
            <td>
              <a href="/matrizador/documentos/editar/{{this.id}}" class="btn btn-primary btn-sm">
                <i class="fas fa-edit"></i>
              </a>
            </td>
          </tr>
          {{else}}
          <tr>
            <td colspan="6" class="text-center py-3 text-muted">No hay documentos en proceso</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
  
  <!-- DOCUMENTOS LISTOS SIN RETIRAR -->
  <div class="tarjeta-contenido">
    <div class="seccion-titulo">
      ✅ Documentos Listos Sin Retirar
      <a href="/matrizador/documentos?estado=listo_para_entrega" class="btn btn-secondary btn-sm float-end">Ver Todos</a>
    </div>
    <div class="table-responsive">
      <table class="tabla-moderna">
        <thead>
          <tr>
            <th>Código</th>
            <th>Tipo</th>
            <th>Cliente</th>
            <th>Listo Desde</th>
            <th>Días Sin Retirar</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          {{#each documentosListos}}
          <tr class="{{#if (gte this.diasSinRetirar 15)}}table-danger{{else if (gte this.diasSinRetirar 7)}}table-warning{{/if}}">
            <td><a href="/matrizador/documentos/entrega/{{this.id}}" class="codigo-link">{{this.codigoBarras}}</a></td>
            <td><span class="badge badge-success">{{this.tipoDocumento}}</span></td>
            <td><strong>{{this.nombreCliente}}</strong></td>
            <td>
              <span class="fecha-documento-dashboard" data-fecha="{{this.fechaListo}}">
                Cargando...
              </span>
            </td>
            <td>
              <span class="badge {{#if (gte this.diasSinRetirar 15)}}bg-danger{{else if (gte this.diasSinRetirar 7)}}bg-warning{{else}}badge-info{{/if}}">
                {{this.diasSinRetirar}} días
              </span>
            </td>
            <td>
              <a href="/matrizador/documentos/entrega/{{this.id}}" class="btn btn-primary btn-sm">
                <i class="fas fa-hand-holding"></i>
              </a>
            </td>
          </tr>
          {{else}}
          <tr>
            <td colspan="6" class="text-center py-3 text-muted">No hay documentos listos sin retirar</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Contenedor para Alertas de Autorización Urgente -->
<div id="contenedor-alertas-urgentes" class="mb-4"></div>

<!-- Scripts para el funcionamiento del dashboard -->
<script>
  // Mostrar/ocultar selector de fechas personalizadas
  document.getElementById('tipoPeriodo').addEventListener('change', function() {
    const fechasPersonalizadas = document.getElementById('fechasPersonalizadas');
    if (this.value === 'personalizado') {
      fechasPersonalizadas.style.display = 'flex';
    } else {
      fechasPersonalizadas.style.display = 'none';
    }
  });

  // Configuración de gráficos cuando los datos estén disponibles
  document.addEventListener('DOMContentLoaded', function() {
    // Cambio entre diferentes gráficos
    document.getElementById('btnProductividad').addEventListener('click', function() {
      document.getElementById('graficoProductividad').style.display = 'block';
      document.getElementById('graficoTiempos').style.display = 'none';
      document.getElementById('graficoTipos').style.display = 'none';
      this.classList.add('active');
      document.getElementById('btnTiempos').classList.remove('active');
      document.getElementById('btnTipos').classList.remove('active');
    });

    document.getElementById('btnTiempos').addEventListener('click', function() {
      document.getElementById('graficoProductividad').style.display = 'none';
      document.getElementById('graficoTiempos').style.display = 'block';
      document.getElementById('graficoTipos').style.display = 'none';
      this.classList.add('active');
      document.getElementById('btnProductividad').classList.remove('active');
      document.getElementById('btnTipos').classList.remove('active');
    });

    document.getElementById('btnTipos').addEventListener('click', function() {
      document.getElementById('graficoProductividad').style.display = 'none';
      document.getElementById('graficoTiempos').style.display = 'none';
      document.getElementById('graficoTipos').style.display = 'block';
      this.classList.add('active');
      document.getElementById('btnProductividad').classList.remove('active');
      document.getElementById('btnTiempos').classList.remove('active');
    });

    // Inicializar gráficos si hay datos
    if (typeof Chart !== 'undefined') {
      {{#if datosGraficos}}
        // Gráfico de productividad
        const ctxProductividad = document.getElementById('productividadChart').getContext('2d');
        const labelsProductividad = {{{json datosGraficos.productividad.labels}}};
        const datosProductividad = {{{json datosGraficos.productividad.datos}}};
        
        new Chart(ctxProductividad, {
          type: 'line',
          data: {
            labels: labelsProductividad,
            datasets: [{
              label: 'Documentos procesados',
              data: datosProductividad,
              backgroundColor: 'rgba(54, 162, 235, 0.2)',
              borderColor: 'rgba(54, 162, 235, 1)',
              borderWidth: 2,
              tension: 0.4
            }]
          },
          options: {
            scales: {
              y: {
                beginAtZero: true,
                title: {
                  display: true,
                  text: 'Cantidad de documentos'
                }
              },
              x: {
                title: {
                  display: true,
                  text: 'Fecha'
                }
              }
            }
          }
        });

        // Gráfico de tiempos
        const ctxTiempos = document.getElementById('tiemposChart').getContext('2d');
        const labelsTiempos = {{{json datosGraficos.tiempos.labels}}};
        const datosTiempos = {{{json datosGraficos.tiempos.datos}}};
        
        new Chart(ctxTiempos, {
          type: 'bar',
          data: {
            labels: labelsTiempos,
            datasets: [{
              label: 'Tiempo promedio (días)',
              data: datosTiempos,
              backgroundColor: 'rgba(255, 159, 64, 0.2)',
              borderColor: 'rgba(255, 159, 64, 1)',
              borderWidth: 1
            }]
          },
          options: {
            scales: {
              y: {
                beginAtZero: true,
                title: {
                  display: true,
                  text: 'Días'
                }
              }
            }
          }
        });

        // Gráfico por tipos
        const ctxTipos = document.getElementById('tiposChart').getContext('2d');
        const labelsTipos = {{{json datosGraficos.tipos.labels}}};
        const datosTipos = {{{json datosGraficos.tipos.datos}}};
        
        new Chart(ctxTipos, {
          type: 'pie',
          data: {
            labels: labelsTipos,
            datasets: [{
              data: datosTipos,
              backgroundColor: [
                'rgba(54, 162, 235, 0.7)',
                'rgba(255, 99, 132, 0.7)',
                'rgba(255, 206, 86, 0.7)',
                'rgba(75, 192, 192, 0.7)',
                'rgba(153, 102, 255, 0.7)',
                'rgba(255, 159, 64, 0.7)',
                'rgba(199, 199, 199, 0.7)'
              ],
              borderWidth: 1
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: true,
            plugins: {
              legend: {
                position: 'bottom',
                labels: {
                  boxWidth: 12,
                  font: {
                    size: 11
                  }
                }
              }
            }
          }
        });
      {{/if}}
    }
    
    // ============== FORMATEAR FECHAS DE DOCUMENTOS EN DASHBOARD ==============
    console.log('🕒 Iniciando formateo de fechas en dashboard de matrizador...');
    
    // Función para formatear fecha de manera robusta
    function formatearFechaSegura(fechaRaw) {
      if (!fechaRaw || fechaRaw === 'null' || fechaRaw === '' || fechaRaw === 'undefined') {
        return 'Sin fecha';
      }
      
      try {
        // Intentar diferentes formatos de fecha
        let fecha;
        
        // Si ya es un objeto Date
        if (fechaRaw instanceof Date) {
          fecha = fechaRaw;
        }
        // Si es un string ISO
        else if (typeof fechaRaw === 'string') {
          // Limpiar la fecha de caracteres extraños
          const fechaLimpia = fechaRaw.trim();
          fecha = new Date(fechaLimpia);
        }
        // Si es un timestamp
        else if (typeof fechaRaw === 'number') {
          fecha = new Date(fechaRaw);
        }
        else {
          console.warn('Formato de fecha no reconocido:', fechaRaw);
          return 'Formato inválido';
        }
        
        // Verificar si la fecha es válida
        if (isNaN(fecha.getTime())) {
          console.warn('Fecha inválida después de conversión:', fechaRaw);
          return 'Fecha inválida';
        }
        
        return fecha;
      } catch (error) {
        console.error('Error procesando fecha:', error, 'Fecha original:', fechaRaw);
        return 'Error en fecha';
      }
    }
    
    // Formatear fechas de documentos en dashboard
    document.querySelectorAll('.fecha-documento-dashboard').forEach(function(elemento) {
      const fechaRaw = elemento.getAttribute('data-fecha');
      console.log('📅 Procesando fecha de documento en dashboard:', fechaRaw);
      
      const fechaFormateada = formatearFechaSegura(fechaRaw);
      
      if (fechaFormateada instanceof Date) {
        elemento.textContent = fechaFormateada.toLocaleDateString('es-EC', {
          day: '2-digit',
          month: '2-digit', 
          year: 'numeric'
        });
        elemento.classList.add('text-success');
      } else {
        elemento.textContent = fechaFormateada;
        elemento.classList.add('text-muted');
      }
    });
    
    console.log('✅ Formateo de fechas de documentos en dashboard completado');
    
    // ============== SISTEMA DE ALERTAS DE AUTORIZACIÓN URGENTE ==============
    
    function cargarAlertasAutorizacionUrgente() {
      console.log('🔄 Cargando alertas de autorización urgente...');
      
      fetch('/api/autorizaciones-urgentes/pendientes', {
        method: 'GET',
        credentials: 'include',
        headers: {
          'Content-Type': 'application/json'
        }
      })
        .then(response => {
          console.log('📡 Respuesta del servidor:', response.status);
          if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
          }
          return response.json();
        })
        .then(data => {
          console.log('📊 Datos recibidos:', data);
          if (data.success && data.autorizaciones && data.autorizaciones.length > 0) {
            console.log(`✅ Mostrando ${data.autorizaciones.length} alertas de autorización`);
            mostrarAlertasAutorizacion(data.autorizaciones);
          } else {
            console.log('ℹ️ No hay autorizaciones pendientes');
            ocultarAlertasAutorizacion();
          }
        })
        .catch(error => {
          console.error('❌ Error al cargar alertas de autorización urgente:', error);
        });
    }
    
    function mostrarAlertasAutorizacion(autorizaciones) {
      console.log('🎯 Mostrando alertas de autorización:', autorizaciones);
      
      // FILTRAR SOLO LAS AUTORIZACIONES DIGITALES PENDIENTES (excluir verbales)
      const autorizacionesDigitales = autorizaciones.filter(auth => auth.estado === 'pendiente');
      
      if (autorizacionesDigitales.length === 0) {
        ocultarAlertasAutorizacion();
        return;
      }
      
      const contenedor = document.getElementById('alertas-autorizacion-urgente');
      
      if (!contenedor) {
        console.error('❌ No se encontró el contenedor de alertas: alertas-autorizacion-urgente');
        return;
      }
      
      const alertasHTML = autorizacionesDigitales.map(auth => {
        const esUrgente = auth.es_urgente;
        const badgeClass = esUrgente ? 'bg-danger' : 'bg-warning';
        const iconClass = esUrgente ? 'fa-bell' : 'fa-clock';
        const cardClass = esUrgente ? 'border-danger' : 'border-warning';
        const headerClass = esUrgente ? 'bg-danger' : 'bg-warning';
        
        return `
          <div class="col-12 mb-3">
            <div class="card ${cardClass} shadow-sm">
              <div class="card-header ${headerClass} text-white">
                <div class="d-flex justify-content-between align-items-center">
                  <h6 class="mb-0">
                    <i class="fas ${iconClass} me-2"></i>
                    ${esUrgente ? '🚨 AUTORIZACIÓN URGENTE CRÍTICA' : '⚠️ Solicitud de Autorización Urgente'}
                  </h6>
                  <span class="badge ${badgeClass}">
                    ${auth.minutos_espera} min esperando
                  </span>
                </div>
              </div>
              <div class="card-body">
                <div class="row">
                  <div class="col-md-8">
                    <h6 class="text-primary">${auth.cliente_nombre}</h6>
                    <p class="mb-1">
                      <strong>Documento:</strong> ${auth.tipo_documento} - ${auth.codigo_barras}
                    </p>
                    <p class="mb-1">
                      <strong>Monto pendiente:</strong> $${auth.monto_pendiente}
                    </p>
                    <p class="mb-1">
                      <strong>Solicitado por:</strong> ${auth.solicitado_por_nombre} (${auth.solicitado_por_rol})
                    </p>
                    <p class="mb-0 text-muted">
                      <strong>Justificación:</strong> ${auth.justificacion_solicitud}
                    </p>
                  </div>
                  <div class="col-md-4 text-end">
                    <div class="mb-2">
                      <small class="text-muted">Solicitado hace:</small><br>
                      <strong class="${esUrgente ? 'text-danger' : 'text-warning'}">
                        ${auth.minutos_espera} minutos
                      </strong>
                    </div>
                    <a href="/matrizador/autorizacion/revisar/${auth.id}" 
                       class="btn ${esUrgente ? 'btn-danger' : 'btn-warning'} btn-lg">
                      <i class="fas fa-gavel me-1"></i>
                      <strong>REVISAR Y AUTORIZAR</strong>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        `;
      }).join('');
      
      contenedor.innerHTML = alertasHTML;
      console.log('✅ Alertas de autorización digital mostradas en el DOM');
    }
    
    function ocultarAlertasAutorizacion() {
      const contenedor = document.getElementById('alertas-autorizacion-urgente');
      contenedor.innerHTML = '';
    }
    
    // Cargar alertas al inicio
    cargarAlertasAutorizacionUrgente();
    
    // Actualizar alertas cada 20 segundos
    setInterval(cargarAlertasAutorizacionUrgente, 20000);
    
    // ============== SISTEMA DE AUTORIZACIONES VERBALES PENDIENTES ==============
    
    function cargarAutorizacionesVerbalesPendientes() {
      console.log('🔄 Cargando autorizaciones verbales pendientes...');
      
      fetch('/api/autorizaciones-urgentes/pendientes', {
        method: 'GET',
        credentials: 'include',
        headers: {
          'Content-Type': 'application/json'
        }
      })
        .then(response => response.json())
        .then(data => {
          if (data.success && data.autorizaciones) {
            // Filtrar solo las que están en estado 'verbal_pendiente'
            const verbalesPendientes = data.autorizaciones.filter(auth => auth.estado === 'verbal_pendiente');
            
            if (verbalesPendientes.length > 0) {
              mostrarAutorizacionesVerbales(verbalesPendientes);
            } else {
              ocultarAutorizacionesVerbales();
            }
          }
        })
        .catch(error => {
          console.error('❌ Error al cargar autorizaciones verbales:', error);
        });
    }
    
    function mostrarAutorizacionesVerbales(autorizaciones) {
      const contenedor = document.getElementById('autorizaciones-verbales-pendientes');
      const contador = document.getElementById('contador-verbales');
      const tablaContainer = document.getElementById('tabla-verbales-container');
      
      contador.textContent = autorizaciones.length;
      contenedor.style.display = 'block';
      
      const tablaHTML = `
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-warning">
              <tr>
                <th>Cliente</th>
                <th>Documento</th>
                <th>Monto</th>
                <th>Autorizado Verbalmente</th>
                <th>Fecha Límite</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody>
              ${autorizaciones.map(auth => {
                const fechaLimite = new Date(auth.verbal_fecha_limite);
                const horasRestantes = Math.max(0, Math.floor((fechaLimite - new Date()) / (1000 * 60 * 60)));
                const esUrgente = horasRestantes <= 6;
                
                return `
                  <tr class="${esUrgente ? 'table-danger' : ''}">
                    <td>
                      <strong>${auth.cliente_nombre}</strong>
                      <br><small class="text-muted">${auth.solicitado_por_nombre}</small>
                    </td>
                    <td>
                      <span class="badge bg-info">${auth.tipo_documento}</span>
                      <br><small>${auth.codigo_barras}</small>
                    </td>
                    <td>
                      <strong>$${auth.monto_pendiente}</strong>
                    </td>
                    <td>
                      <strong>${auth.verbal_quien_autorizo}</strong>
                      <br><small class="text-muted">${new Date(auth.verbal_fecha).toLocaleString('es-EC')}</small>
                    </td>
                    <td>
                      <span class="badge ${esUrgente ? 'bg-danger' : 'bg-warning'}">
                        ${horasRestantes}h restantes
                      </span>
                      <br><small class="text-muted">${fechaLimite.toLocaleDateString('es-EC')}</small>
                    </td>
                    <td>
                      <button class="btn btn-success btn-sm me-1" 
                              onclick="ratificarAutorizacionVerbal('${auth.id}', true)">
                        <i class="fas fa-check"></i> Ratificar
                      </button>
                      <button class="btn btn-danger btn-sm" 
                              onclick="ratificarAutorizacionVerbal('${auth.id}', false)">
                        <i class="fas fa-times"></i> Rechazar
                      </button>
                    </td>
                  </tr>
                `;
              }).join('')}
            </tbody>
          </table>
        </div>
      `;
      
      tablaContainer.innerHTML = tablaHTML;
    }
    
    function ocultarAutorizacionesVerbales() {
      const contenedor = document.getElementById('autorizaciones-verbales-pendientes');
      contenedor.style.display = 'none';
    }
    
    // Función global para ratificar autorizaciones verbales
    window.ratificarAutorizacionVerbal = function(autorizacionId, confirmar) {
      const accion = confirmar ? 'ratificar' : 'rechazar';
      const mensaje = confirmar 
        ? '¿Confirma que ratifica esta autorización verbal? Esto validará la entrega ya realizada.'
        : '¿Está seguro de rechazar esta ratificación? Esto revocará la autorización y se registrará en auditoría.';
      
      if (!confirm(mensaje)) return;
      
      const btnRatificar = document.querySelector(`button[onclick*="${autorizacionId}"][onclick*="true"]`);
      const btnRechazar = document.querySelector(`button[onclick*="${autorizacionId}"][onclick*="false"]`);
      
      if (btnRatificar) btnRatificar.disabled = true;
      if (btnRechazar) btnRechazar.disabled = true;
      
      fetch(`/api/autorizaciones-urgentes/${autorizacionId}/ratificar`, {
        method: 'POST',
        credentials: 'include',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          confirmar_ratificacion: confirmar
        })
      })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            alert(confirmar ? 'Autorización ratificada correctamente' : 'Ratificación rechazada');
            location.reload(); // Recargar para actualizar
          } else {
            alert('Error: ' + data.message);
          }
        })
        .catch(error => {
          console.error('Error:', error);
          alert('Error al procesar la ratificación');
        })
        .finally(() => {
          if (btnRatificar) btnRatificar.disabled = false;
          if (btnRechazar) btnRechazar.disabled = false;
        });
    };
    
    // Cargar autorizaciones verbales al inicio
    cargarAutorizacionesVerbalesPendientes();
    
    // Actualizar cada 30 segundos
    setInterval(cargarAutorizacionesVerbalesPendientes, 30000);

  });

</script>

