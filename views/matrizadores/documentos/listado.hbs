<!-- HEADER PROFESIONAL CON PALETA AZUL -->
<div class="dashboard-header">
  <div class="container-fluid">
    <div class="row align-items-center">
      <div class="col-md-8">
        <h2 class="dashboard-title"><i class="fas fa-list me-3"></i>Mis Documentos</h2>
        <p class="dashboard-subtitle">Gestión y seguimiento de documentos asignados</p>
      </div>
      <div class="col-md-4 text-end">
        <div class="badge bg-light text-dark p-2">
          <i class="fas fa-file-alt me-1"></i>
          {{documentos.length}} documentos
        </div>
      </div>
    </div>
  </div>
</div>

<!-- FILTROS PROFESIONALES -->
<div class="tarjeta-contenido">
  <div class="seccion-titulo">🔍 Filtros de Búsqueda</div>
  <form id="filtrosForm" method="GET" action="/matrizador/documentos">
    <div class="row">
      <div class="col-md-3 mb-3">
        <label for="filtroEstado" class="form-label">Estado</label>
        <select class="form-input" id="filtroEstado" name="estado">
          <option value="">Todos</option>
          <option value="en_proceso" {{#if filtros.estado.en_proceso}}selected{{/if}}>En Proceso</option>
          <option value="listo_para_entrega" {{#if filtros.estado.listo_para_entrega}}selected{{/if}}>Listos para Entrega</option>
          <option value="entregado" {{#if filtros.estado.entregado}}selected{{/if}}>Entregados</option>
          <option value="cancelado" {{#if filtros.estado.cancelado}}selected{{/if}}>Cancelados</option>
        </select>
      </div>
      
      <div class="col-md-3 mb-3">
        <label for="filtroTipo" class="form-label">Tipo de Documento</label>
        <select class="form-input" id="filtroTipo" name="tipoDocumento">
          <option value="">Todos</option>
          {{#each tiposDocumento}}
          <option value="{{this}}" {{#if (eq ../filtros.tipoDocumento this)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select>
      </div>
      
      <div class="col-md-2 mb-3">
        <label for="fechaDesde" class="form-label">Desde</label>
        <input type="date" class="form-input" id="fechaDesde" name="fechaDesde" value="{{filtros.fechaDesde}}">
      </div>
      
      <div class="col-md-2 mb-3">
        <label for="fechaHasta" class="form-label">Hasta</label>
        <input type="date" class="form-input" id="fechaHasta" name="fechaHasta" value="{{filtros.fechaHasta}}">
      </div>
      
      <div class="col-md-2 mb-3">
        <label for="filtroBusqueda" class="form-label">Búsqueda</label>
        <input type="text" class="form-input" id="filtroBusqueda" name="busqueda" placeholder="Código o cliente" value="{{filtros.busqueda}}">
      </div>
      
      <div class="col-md-12 text-end">
        <button type="submit" class="btn btn-primary">
          <i class="fas fa-filter me-1"></i> Filtrar
        </button>
        <a href="/matrizador/documentos" class="btn btn-secondary ms-2">
          <i class="fas fa-times me-1"></i> Limpiar
        </a>
      </div>
    </div>
  </form>
</div>
    
<!-- TABLA PROFESIONAL CON PALETA AZUL -->
<div class="tarjeta-contenido">
  <div class="seccion-titulo">📋 Lista de Documentos</div>
  <div class="table-responsive">
    <table class="tabla-moderna tabla-ordenable" id="tablaDocumentosMatrizadores">
      <thead>
        <tr>
          <th class="col-codigo ordenable" data-columna="codigoBarras" data-tipo="texto">
            <span>Código</span>
            <i class="fas fa-sort ms-1 sort-icon"></i>
          </th>
          <th class="col-cliente ordenable" data-columna="nombreCliente" data-tipo="texto">
            <span>Cliente</span>
            <i class="fas fa-sort ms-1 sort-icon"></i>
          </th>
          <th class="col-fecha ordenable" data-columna="fechaFactura" data-tipo="fecha">
            <span>Fecha</span>
            <i class="fas fa-sort ms-1 sort-icon"></i>
          </th>
          <th class="col-estado ordenable" data-columna="estado" data-tipo="texto" title="Estado de Entrega">
            <span><i class="fas fa-truck"></i></span>
            <i class="fas fa-sort ms-1 sort-icon"></i>
          </th>
          <th class="col-pago ordenable" data-columna="estadoPago" data-tipo="texto" title="Estado de Pago">
            <span><i class="fas fa-dollar-sign"></i></span>
            <i class="fas fa-sort ms-1 sort-icon"></i>
          </th>
          <th class="col-valor ordenable" data-columna="valorFactura" data-tipo="numero">
            <span>Valor</span>
            <i class="fas fa-sort ms-1 sort-icon"></i>
          </th>
          <th class="col-acciones">Acciones</th>
        </tr>
      </thead>
        <tbody>
          {{#each documentos}}
          <tr data-documento-id="{{this.id}}">
            <!-- Código con paleta profesional -->
            <td class="col-codigo">
                <a href="/matrizador/documentos/detalle/{{this.id}}" class="codigo-link">
                  {{this.codigoBarras}}
                </a>
                <div class="tipo-documento">
                    <span class="badge badge-info">{{this.tipoDocumento}}</span>
                </div>
            </td>
            
            <!-- Cliente optimizado -->
            <td class="col-cliente">
              <div class="cliente-nombre"><strong>{{this.nombreCliente}}</strong></div>
              <div class="cliente-identificacion text-muted">{{this.identificacionCliente}}</div>
            </td>
            
            <!-- Fecha -->
            <td class="col-fecha">
              {{#if this.fechaFactura}}
              <span class="fecha-universal">{{formatFechaCorta this.fechaFactura}}</span>
              {{else}}
              <span class="fecha-universal sin-fecha text-muted">--/--/--</span>
              {{/if}}
            </td>
            
            <!-- Estado de Entrega con paleta -->
            <td class="col-estado text-center">
              {{#if (eq this.estado 'entregado')}}
                <i class="fas fa-check-circle text-success fs-5" title="Entregado" style="color: var(--tufts-blue) !important;"></i>
              {{else if (eq this.estado 'listo_para_entrega')}}
                <i class="fas fa-clock fs-5" title="Listo para Entrega" style="color: var(--cobalt-blue) !important;"></i>
              {{else if (eq this.estado 'en_proceso')}}
                <i class="fas fa-cog fa-spin fs-5" title="En Proceso" style="color: var(--jordy-blue) !important;"></i>
              {{else}}
                <i class="fas fa-question-circle text-muted fs-5" title="{{this.estado}}"></i>
              {{/if}}
            </td>
            
            <!-- Estado de Pago con paleta -->
            <td class="col-pago text-center">
              {{#if this.numeroFactura}}
                {{#if (eq this.estadoPago 'pagado_completo')}}
                  <i class="fas fa-dollar-sign fs-5" title="Pagado Completo" style="color: var(--tufts-blue) !important;"></i>
                {{else if (eq this.estadoPago 'pagado_con_retencion')}}
                  <i class="fas fa-university fs-5" title="Pagado con Retención" style="color: var(--cobalt-blue) !important;"></i>
                {{else if (eq this.estadoPago 'pago_parcial')}}
                  <i class="fas fa-circle-half-stroke fs-5" title="Pago Parcial" style="color: var(--jordy-blue) !important;"></i>
                {{else}}
                  <i class="fas fa-times-circle text-danger fs-5" title="No Pagado"></i>
                {{/if}}
              {{else}}
                <i class="fas fa-file-invoice text-muted fs-5" title="Sin Factura"></i>
              {{/if}}
            </td>
            
            <!-- Valor con formato mejorado -->
            <td class="col-valor text-end">
              {{#if this.valorFactura}}
              <span class="valor-monetario">{{formatDineroCompleto this.valorFactura}}</span>
              {{else}}
              <span class="valor-monetario text-muted">$0.00</span>
              {{/if}}
            </td>
            
            <!-- Acciones con paleta -->
            <td class="col-acciones text-center">
              <a href="/matrizador/documentos/detalle/{{this.id}}" class="btn btn-primary btn-sm" title="Ver y Editar Documento">
                <i class="fas fa-edit"></i>
              </a>
            </td>
          </tr>
          {{else}}
          <tr>
            <td colspan="7" class="text-center py-5">
              <div class="sin-resultados">
                <i class="fas fa-search fa-2x mb-3 text-muted"></i>
                <h5 class="text-muted">No se encontraron documentos</h5>
                <p class="mb-0 text-muted">Pruebe ajustando los filtros de búsqueda</p>
              </div>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    
    <!-- PAGINACIÓN PROFESIONAL -->
    {{#if pagination}}
    <nav aria-label="Paginación de documentos" class="mt-4">
      <ul class="pagination justify-content-center">
        {{#if pagination.prev}}
        <li class="page-item">
          <a class="page-link" href="{{pagination.prev}}" style="color: var(--tufts-blue); border-color: var(--jordy-blue-30);">Anterior</a>
        </li>
        {{else}}
        <li class="page-item disabled">
          <a class="page-link">Anterior</a>
        </li>
        {{/if}}
        
        {{#each pagination.pages}}
        <li class="page-item {{#if this.active}}active{{/if}}">
          <a class="page-link" href="{{this.url}}" {{#if this.active}}style="background-color: var(--tufts-blue); border-color: var(--tufts-blue);"{{else}}style="color: var(--tufts-blue); border-color: var(--jordy-blue-30);"{{/if}}>{{this.num}}</a>
        </li>
        {{/each}}
        
        {{#if pagination.next}}
        <li class="page-item">
          <a class="page-link" href="{{pagination.next}}" style="color: var(--tufts-blue); border-color: var(--jordy-blue-30);">Siguiente</a>
        </li>
        {{else}}
        <li class="page-item disabled">
          <a class="page-link">Siguiente</a>
        </li>
        {{/if}}
      </ul>
    </nav>
    {{/if}}
</div>



<script>
  document.addEventListener('DOMContentLoaded', function() {
    console.log('🎯 Inicializando tabla MATRIZADORES - Sistema Universal v2.0 OPTIMIZADA');
    
    // Inicializar ordenamiento manual corregido
    inicializarOrdenamientoManual();
    
    // ✨ INICIALIZAR TOOLTIPS PARA NOMBRES TRUNCADOS
    const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    const tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
      return new bootstrap.Tooltip(tooltipTriggerEl);
    });
    
    console.log('✅ Vista MATRIZADORES migrada al sistema universal - Funcionalidad completa + Tooltips activos');
  });

  // Función de ordenamiento manual específica para MATRIZADORES
  function inicializarOrdenamientoManual() {
    console.log('🔧 Inicializando ordenamiento manual para MATRIZADORES');
    
    // Buscar todos los headers ordenables
    const headersOrdenables = document.querySelectorAll('.tabla-ordenable th.ordenable');
    
    headersOrdenables.forEach(header => {
      header.style.cursor = 'pointer';
      header.addEventListener('click', function() {
        const columna = this.getAttribute('data-columna');
        const tipoColumna = this.getAttribute('data-tipo') || 'texto';
        
        console.log('📊 Click en columna MATRIZADORES:', columna, tipoColumna);
        
        // Obtener dirección actual
        let direccion = 'asc';
        if (this.classList.contains('asc')) {
          direccion = 'desc';
        } else if (this.classList.contains('desc')) {
          direccion = 'asc';
        }
        
        // Limpiar otros headers
        headersOrdenables.forEach(h => {
          h.classList.remove('asc', 'desc', 'active');
          const icono = h.querySelector('.sort-icon');
          if (icono) {
            icono.className = 'fas fa-sort ms-1 sort-icon';
          }
        });
        
        // Marcar header actual
        this.classList.add(direccion, 'active');
        const icono = this.querySelector('.sort-icon');
        if (icono) {
          icono.className = `fas fa-sort-${direccion} ms-1 sort-icon`;
        }
        
        // Ejecutar ordenamiento por servidor
        const params = new URLSearchParams(window.location.search);
        params.set('ordenarPor', columna);
        params.set('ordenDireccion', direccion);
        
        window.location.search = params.toString();
      });
    });
    
    console.log('✅ Ordenamiento manual configurado para MATRIZADORES:', headersOrdenables.length, 'columnas');
  }

  function limpiarFiltrosMatrizadores() {
    document.getElementById('busqueda').value = '';
    document.getElementById('estado').value = '';
    document.getElementById('estadoPago').value = '';
    document.getElementById('tipoDocumento').value = '';
    document.getElementById('fechaDesde').value = '';
    document.getElementById('fechaHasta').value = '';
    document.getElementById('filtrosFormMatrizadores').submit(); 
  }
</script>

<!-- ESTILOS ESPECÍFICOS PARA LISTADO MATRIZADOR -->
<style>
/* Optimizaciones para listado de documentos */
.codigo-link {
  color: var(--tufts-blue);
  text-decoration: none;
  font-weight: 600;
  font-family: 'Courier New', monospace;
  padding: 2px 6px;
  background: var(--alice-blue);
  border-radius: 4px;
  transition: all 0.3s ease;
  display: inline-block;
}

.codigo-link:hover {
  color: var(--cobalt-blue);
  background: var(--jordy-blue-30);
  text-decoration: none;
  transform: translateY(-1px);
}

/* Badges con paleta profesional */
.badge-info {
  background-color: var(--alice-blue) !important;
  color: var(--cool-black) !important;
  border: 1px solid var(--tufts-blue-20);
}

/* Estados de las filas */
.tabla-moderna tbody tr:hover {
  background-color: rgba(70, 128, 235, 0.05) !important;
  transition: background-color 0.3s ease;
}

/* Optimización para iconos de ordenamiento */
.sort-icon {
  color: var(--tufts-blue);
  transition: all 0.3s ease;
}

.ordenable:hover .sort-icon {
  color: var(--cobalt-blue);
}

.ordenable.active .sort-icon {
  color: var(--cobalt-blue);
}

/* Formato de valores monetarios */
.valor-monetario {
  font-weight: 600;
  color: var(--cool-black);
  font-family: 'Courier New', monospace;
}

/* Responsive específico para móvil */
@media (max-width: 768px) {
  .dashboard-header {
    padding: var(--spacing-lg);
  }
  
  .dashboard-title {
    font-size: 1.5rem;
  }
  
  .btn.float-end {
    float: none !important;
    margin-top: var(--spacing-sm);
    width: 100%;
  }
  
  .col-codigo, .col-cliente {
    min-width: 150px;
  }
  
  .col-acciones {
    min-width: 80px;
  }
}

/* Animaciones sutiles */
.tarjeta-contenido {
  animation: fadeInUp 0.6s ease-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
</style>