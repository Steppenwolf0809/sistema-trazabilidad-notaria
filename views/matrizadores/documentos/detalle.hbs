      checkboxes: checkboxes.length,
      selectAll: !!selectAllCheckbox,
      botonAgrupar: !!botonAgrupar
    });
    
    // Agregar event listeners a checkboxes individuales
    checkboxes.forEach((checkbox, index) => {
      checkbox.addEventListener('change', function() {
        console.log(`📋 [CHECKBOX ${index + 1}] Cambio:`, this.id, '→', this.checked);
        updateGroupButton();
        
        // Actualizar el checkbox "Todos" si es necesario
        if (selectAllCheckbox) {
          const todosSeleccionados = Array.from(checkboxes).every(cb => cb.checked);
          const ningunoSeleccionado = Array.from(checkboxes).every(cb => !cb.checked);
          
          if (todosSeleccionados) {
            selectAllCheckbox.checked = true;
            selectAllCheckbox.indeterminate = false;
          } else if (ningunoSeleccionado) {
            selectAllCheckbox.checked = false;
            selectAllCheckbox.indeterminate = false;
          } else {
            selectAllCheckbox.checked = false;
            selectAllCheckbox.indeterminate = true;
          }
        }
      });
    });
    
    // Agregar event listener al checkbox "Todos"
    if (selectAllCheckbox) {
      selectAllCheckbox.addEventListener('change', function() {
        console.log('📋 [SELECT ALL] Cambio:', this.checked);
        toggleSelectAll(this.checked);
      });
    }
    
    // Inicializar estado del botón
    if (botonAgrupar) {
      updateGroupButton();
    }
    
    console.log('✅ [INIT] Sistema de checkboxes inicializado correctamente');
    
    // ============== VERIFICACIÓN DE TELÉFONOS PARA AGRUPACIÓN ==============
    
    // Verificar consistencia de teléfonos al mostrar documentos agrupables
    verificarConsistenciaTelefonos();
  });

  /**
   * 📱 NUEVA FUNCIÓN: Verificar consistencia de teléfonos en documentos agrupables
   */
  function verificarConsistenciaTelefonos() {
    const telefonoActual = '{{documento.telefonoCliente}}';
    const documentosAgrupables = document.querySelectorAll('.doc-checkbox');
    
    if (!telefonoActual || telefonoActual === '' || documentosAgrupables.length === 0) {
      return; // No hay nada que verificar
    }
    
    console.log('📱 [TELÉFONOS] Verificando consistencia...');
    
    // Verificar si el teléfono actual es válido para WhatsApp (celular)
    const esWhatsAppValido = /^09\d{8}$/.test(telefonoActual);
    
    if (!esWhatsAppValido) {
      mostrarAlertaTelefono('actual_invalido', telefonoActual);
      return;
    }
    
    // TODO: En una implementación futura, verificar teléfonos de otros documentos
    // Por ahora, mostrar sugerencia para sincronizar
    if (documentosAgrupables.length > 0) {
      mostrarSugerenciaSincronizacion(telefonoActual);
    }
  }
  
  /**
   * 📱 NUEVA FUNCIÓN: Mostrar alerta sobre problemas de teléfono
   */
  function mostrarAlertaTelefono(tipo, telefono) {
    let mensaje = '';
    let icono = '⚠️';
    let clase = 'alert-warning';
    
    switch (tipo) {
      case 'actual_invalido':
        mensaje = `El número de teléfono actual (${telefono}) no es válido para WhatsApp. `;
        mensaje += `Para notificaciones grupales, necesitas un número de celular que inicie con 09.`;
        icono = '❌';
        clase = 'alert-danger';
        break;
      case 'inconsistente':
        mensaje = `Los documentos del mismo cliente tienen números diferentes. `;
        mensaje += `Para notificaciones grupales efectivas, todos deberían tener el mismo número de WhatsApp.`;
        break;
    }
    
    // Crear alerta temporal
    const alertaHtml = `
      <div class="alert ${clase} alert-dismissible fade show mt-3" role="alert" id="alerta-telefono">
        <strong>${icono} Atención:</strong> ${mensaje}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    `;
    
    // Insertar la alerta después del título del documento
    const titulo = document.querySelector('h2');
    if (titulo) {
      titulo.insertAdjacentHTML('afterend', alertaHtml);
      
      // Auto-remover después de 10 segundos
      setTimeout(() => {
        const alerta = document.getElementById('alerta-telefono');
        if (alerta) {
          alerta.remove();
        }
      }, 10000);
    }
  }
  
  /**
   * 📱 NUEVA FUNCIÓN: Mostrar sugerencia de sincronización de teléfonos
   */
  function mostrarSugerenciaSincronizacion(telefonoValido) {
    // Solo mostrar si hay documentos agrupables
    const seccionAgrupacion = document.querySelector('.documentos-agrupables');
    if (!seccionAgrupacion) return;
    
    const sugerenciaHtml = `
      <div class="alert alert-info mt-2" id="sugerencia-telefono">
        <i class="fas fa-lightbulb me-2"></i>
        <strong>💡 Sugerencia:</strong> 
        Para notificaciones grupales efectivas, asegúrate de que todos los documentos del cliente 
        tengan el mismo número de WhatsApp: <strong>${telefonoValido}</strong>
        <br>
        <small class="text-muted">
          <i class="fas fa-info-circle me-1"></i>
          Edita cada documento para actualizar el número antes de agrupar.
        </small>
      </div>
    `;
    
    // Agregar la sugerencia al final de la sección de agrupación
    seccionAgrupacion.insertAdjacentHTML('beforeend', sugerenciaHtml);
  }
</script>
{{else}}
<div class="alert alert-warning">
  <i class="fas fa-exclamation-triangle me-2"></i> El documento solicitado no existe o no tienes permisos para verlo.
</div>
{{/if}} 