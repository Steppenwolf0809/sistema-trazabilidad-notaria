<script src="/js/notificaciones-grupales.js"></script>
<script>
  // ============== FUNCIONES GLOBALES PARA NOTIFICACIONES GRUPALES ==============
  
  // ✅ FUNCIÓN mostrarModalAgrupar ELIMINADA - Era innecesaria
  // Los usuarios ahora usan directamente los checkboxes para seleccionar documentos
  
  /**
   * Función global para separar documento del grupo (OPTIMIZADA)
   * @param {number} documentoId - ID del documento
   */
  async function separarDeGrupo(documentoId) {
    console.log('🔗 [SEPARAR GRUPO] Separando documento:', documentoId);
    
    // Obtener información del grupo para personalizar mensaje
    const informacionGrupal = document.querySelector('[data-grupo-id]');
    const puedeModificar = informacionGrupal ? informacionGrupal.getAttribute('data-puede-modificar') === 'true' : false;
    
    // Personalizar mensaje según estado del grupo
    let mensaje;
    if (puedeModificar) {
      mensaje = '¿Estás seguro de que quieres separar este documento del grupo?\n\nEsto disolverá la agrupación y cada documento tendrá su propia notificación.';
    } else {
      mensaje = '¿Estás seguro de que quieres separar TU documento del grupo?\n\nNOTA: El grupo ya fue procesado, pero puedes separar tu documento.\nLos demás documentos permanecerán agrupados.';
    }
    
    // Confirmar acción
    if (!confirm(mensaje)) {
      return;
    }
    
    try {
      // 🚀 OPTIMIZADO: Usar la nueva función rápida sin hooks
      const response = await fetch(`/matrizador/api/revertir-agrupacion/${documentoId}`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        }
      });
      
      const resultado = await response.json();
      
      if (resultado.success || resultado.exito) {
        // Mensaje personalizado según el contexto
        let mensajeExito;
        if (puedeModificar) {
          mensajeExito = '✅ Documento separado del grupo exitosamente.\n\nAhora tendrá su propia notificación individual.';
        } else {
          mensajeExito = '✅ Tu documento fue separado del grupo.\n\nAhora podrás gestionarlo de manera independiente.\nLos demás documentos siguen agrupados.';
        }
        
        alert(mensajeExito);
        
        // Recargar la página para mostrar el nuevo estado
        setTimeout(() => {
          window.location.reload();
        }, 1500);
        
      } else {
        throw new Error(resultado.mensaje || resultado.error || 'Error desconocido al separar del grupo');
      }
      
    } catch (error) {
      console.error('❌ Error separando del grupo:', error);
      alert(`❌ Error al separar del grupo: ${error.message}`);
    }
  }

  // ============== FUNCIONES PARA MANEJO DE CHECKBOXES ==============
  
  /**
   * Seleccionar/deseleccionar todos los documentos
   * @param {boolean} seleccionar - Si seleccionar o deseleccionar
   */
  function toggleSelectAll(seleccionar) {
    console.log('🔄 [CHECKBOXES] Seleccionar todos:', seleccionar);
    const checkboxes = document.querySelectorAll('.doc-checkbox');
    console.log('📋 [CHECKBOXES] Encontrados', checkboxes.length, 'checkboxes');
    
    checkboxes.forEach((checkbox, index) => {
      checkbox.checked = seleccionar;
      console.log(`   - Checkbox ${index + 1}:`, checkbox.id, '→', checkbox.checked);
    });
    
    updateGroupButton();
  }
  
  /**
   * Actualizar el estado del botón de agrupación
   */
  function updateGroupButton() {
    const checkboxes = document.querySelectorAll('.doc-checkbox:checked');
    const contador = document.getElementById('contadorSeleccionados');
    const boton = document.getElementById('btnAgruparSeleccionados');
    
    console.log('🔄 [BOTÓN] Actualizando botón - Seleccionados:', checkboxes.length);
    
    if (contador) {
      contador.textContent = checkboxes.length;
    }
    
    if (boton) {
      boton.disabled = checkboxes.length === 0;
      
      if (checkboxes.length > 0) {
        boton.innerHTML = `<i class="fas fa-layer-group me-1"></i> Agrupar ${checkboxes.length} documentos`;
        boton.classList.remove('btn-secondary');
        boton.classList.add('btn-success');
        console.log('✅ [BOTÓN] Habilitado para', checkboxes.length, 'documentos');
      } else {
        boton.innerHTML = `<i class="fas fa-layer-group me-1"></i> Agrupar <span id="contadorSeleccionados">0</span> documentos`;
        boton.classList.remove('btn-success');
        boton.classList.add('btn-secondary');
        console.log('❌ [BOTÓN] Deshabilitado - sin selecciones');
      }
    } else {
      console.warn('⚠️ [BOTÓN] No se encontró el botón btnAgruparSeleccionados');
    }
  }
  
  /**
   * Procesar la agrupación de documentos seleccionados
   */
  async function procesarAgrupacion() {
    const checkboxes = document.querySelectorAll('.doc-checkbox:checked');
    const documentoActualId = {{documento.id}};
    
    console.log('📋 [AGRUPACIÓN] Iniciando procesamiento:', {
      documentoActual: documentoActualId,
      checkboxesSeleccionados: checkboxes.length
    });
    
    if (checkboxes.length === 0) {
      alert('Por favor selecciona al menos un documento para agrupar');
      return;
    }
    
    // Obtener IDs de documentos seleccionados
    const documentosIds = Array.from(checkboxes).map(cb => parseInt(cb.value));
    
    console.log('📋 [AGRUPACIÓN] Procesando agrupación:', {
      documentoLider: documentoActualId,
      documentosAdicionales: documentosIds,
      total: documentosIds.length + 1
    });
    
    // Mostrar estado de carga
    const boton = document.getElementById('btnAgruparSeleccionados');
    const textoOriginal = boton.innerHTML;
    boton.disabled = true;
    boton.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Agrupando...';
    
    try {
      // Llamar a la API para crear el grupo
      const response = await fetch('/matrizador/api/grupos-notificacion/crear', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          documentoLiderId: documentoActualId,
          documentosIds: documentosIds
        })
      });
      
      const resultado = await response.json();
      
      if (resultado.exito) {
        // Mostrar mensaje de éxito
        alert(`✅ ¡Grupo creado exitosamente!\n\nSe agruparon ${resultado.datos.documentosAgrupados} documentos.\nCódigo de verificación: ${resultado.datos.codigoVerificacion}\n\nAhora el cliente recibirá una sola notificación para todos los documentos.`);
        
        // Recargar la página para mostrar el nuevo estado
        setTimeout(() => {
          window.location.reload();
        }, 2000);
        
      } else {
        throw new Error(resultado.mensaje || 'Error desconocido al crear el grupo');
      }
      
    } catch (error) {
      console.error('❌ Error en agrupación:', error);
      alert(`❌ Error al agrupar documentos: ${error.message}`);
      
      // Restaurar botón
      boton.disabled = false;
      boton.innerHTML = textoOriginal;
    }
  }

  // Configurar datos del documento para notificaciones grupales
