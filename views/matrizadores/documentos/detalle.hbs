<!-- CSS eliminado - Ahora usa el sistema universal -->

<script>
  // 🎯 SISTEMA DE DOBLE VERIFICACIÓN - CHECKPOINT 2
  function marcarListo(id) {
    document.getElementById('documentoIdDetalle').value = id;
    
    // Mostrar modal dinámico según estado real del servidor
    mostrarModalMarcarListo(id);
    
    const modal = new bootstrap.Modal(document.getElementById('marcarListoModal'));
    modal.show();
  }

  // 🔄 MODAL HÍBRIDO - BD + CHECKBOX ACTUAL
  function mostrarModalMarcarListo(documentoId) {
    console.log('🔍 DEBUG MODAL ABIERTO (BD + CHECKBOX) - Documento:', documentoId);
    
    // 1. VERIFICAR estado actual del checkbox en la página (si existe)
    const checkboxCredito = document.getElementById('preAutorizacionCredito');
    const estadoCheckbox = checkboxCredito ? checkboxCredito.checked : null;
    const justificacionSelect = document.querySelector('select[name="justificacion_entrega_sin_pago"]');
    const justificacionCheckbox = justificacionSelect ? justificacionSelect.value : null;
    
    console.log('📋 Estado actual del checkbox:', {
      checkbox_existe: !!checkboxCredito,
      checkbox_elemento: checkboxCredito ? 'ENCONTRADO' : 'NO EXISTE (vista detalle)',
      checkbox_marcado: estadoCheckbox,
      justificacion_checkbox: justificacionCheckbox,
      vista_actual: checkboxCredito ? 'EDITAR' : 'DETALLE'
    });
    
    // 2. OBTENER datos guardados en la BASE DE DATOS
    fetch(`/matrizador/documentos/${documentoId}/datos`)
      .then(response => {
        if (!response.ok) {
          throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }
        return response.json();
      })
      .then(respuestaServidor => {
        // EXTRAER documento de la respuesta del servidor
        const documento = respuestaServidor.documento || respuestaServidor;
        
        console.log('📋 Datos obtenidos del servidor:', {
          respuesta_completa: respuestaServidor,
          documento_extraido: documento,
          id: documento?.id || 'No disponible',
          entrega_sin_verificar_pago_bd: documento?.entrega_sin_verificar_pago,
          tipo_dato: typeof documento?.entrega_sin_verificar_pago,
          valor_exacto: documento?.entrega_sin_verificar_pago,
          es_true: documento?.entrega_sin_verificar_pago === true,
          es_string_true: documento?.entrega_sin_verificar_pago === 'true',
          justificacion_bd: documento?.justificacion_entrega_sin_pago || null,
          fuente: 'SERVIDOR BD'
        });
        
        // 3. DETERMINAR estado final: BD es base, checkbox solo sobrescribe si existe
        let estadoFinal = documento?.entrega_sin_verificar_pago === true; // CORRECCIÓN: comparación exacta
        let justificacionFinal = documento?.justificacion_entrega_sin_pago || null;
        let fuente = 'BD';
        
        // SOLO si hay checkbox presente, usar su valor (vista de editar)
        if (checkboxCredito && estadoCheckbox === true) {
          estadoFinal = true;
          justificacionFinal = justificacionCheckbox || justificacionFinal || 'cliente_corporativo';
          fuente = 'CHECKBOX ACTUAL (marcado)';
        } else if (checkboxCredito && estadoCheckbox === false) {
          estadoFinal = false;
          justificacionFinal = null;
          fuente = 'CHECKBOX ACTUAL (desmarcado)';
        }
        // Si no hay checkbox (vista detalle), mantener estado de BD
        
        console.log('🎯 ESTADO FINAL DETERMINADO:', {
          bd_original: documento?.entrega_sin_verificar_pago,
          bd_es_true: documento?.entrega_sin_verificar_pago === true,
          checkbox_presente: !!checkboxCredito,
          checkbox_valor: estadoCheckbox,
          estado_final: estadoFinal,
          sera_credito: estadoFinal === true,
          justificacion: justificacionFinal,
          fuente: fuente
        });
        
        // 4. Configurar modal con estado final
        const documentoFinal = {
          ...documento,
          entrega_sin_verificar_pago: estadoFinal,
          justificacion_entrega_sin_pago: justificacionFinal,
          fuente_estado: fuente
        };
        
        configurarModalSegunDatos(documentoFinal);
      })
      .catch(error => {
        console.error('❌ Error al obtener datos del documento:', error);
        alert('Error al cargar información del documento. Por favor, recargue la página.');
      });
  }

  // 🎯 CONFIGURAR MODAL CON DATOS HÍBRIDOS (BD + CHECKBOX)
  function configurarModalSegunDatos(documento) {
    const modalBody = document.getElementById('modalBodyContent');
    const tieneCredito = documento.entrega_sin_verificar_pago === true;
    const fuente = documento.fuente_estado || 'BD';
    
    // ✅ NUEVA VALIDACIÓN: Verificar estado de pago del documento
    const estadoPago = documento.estadoPago || documento.estado_pago || 'sin_informacion';
    const estaPagado = ['pagado_completo', 'pagado_con_retencion'].includes(estadoPago);
    
    console.log('🔍 DEBUG CONFIGURACIÓN MODAL:', {
      documento_id: documento?.id || 'No disponible',
      tiene_credito: tieneCredito,
      estado_pago: estadoPago,
      esta_pagado: estaPagado,
      justificacion: documento?.justificacion_entrega_sin_pago || 'No especificada',
      fuente_datos: fuente
    });
    
    // ✅ NUEVA LÓGICA: Priorizar estado de pago sobre autorización de crédito
    if (estaPagado) {
      // ESCENARIO A: DOCUMENTO YA PAGADO - No necesita autorización de crédito
      modalBody.innerHTML = `
        <div class="alert alert-success">
          <i class="fas fa-check-circle"></i>
          <strong>✅ Documento pagado</strong><br>
          Estado de pago: <span class="badge bg-success text-white px-2 py-1 rounded">${estadoPago.replace('_', ' ').toUpperCase()}</span><br>
          <small class="text-success">El cliente ya completó el pago. Listo para entrega.</small>
        </div>
        <p>¿Confirma marcar como listo para entrega?</p>
        <p><strong>Recepción entregará directamente al verificar identidad.</strong></p>
      `;
    } else if (tieneCredito) {
      // ESCENARIO B: DOCUMENTO CON CRÉDITO AUTORIZADO (pero no pagado)
      const fuenteTexto = fuente.includes('CHECKBOX') ? 
        '<small class="text-success"><i class="fas fa-edit"></i> Estado actualizado en esta sesión</small>' :
        `<small>Autorizado por: ${documento?.matrizador_nombre || 'Sistema'} el ${formatearFecha(documento?.fecha_autorizacion_entrega)}</small>`;
      
      modalBody.innerHTML = `
        <div class="alert alert-warning">
          <i class="fas fa-shield-check"></i>
          <strong>Cliente con crédito autorizado</strong><br>
          Estado de pago: <span class="badge bg-warning text-dark px-2 py-1 rounded">${estadoPago.replace('_', ' ').toUpperCase()}</span><br>
          Justificación: ${formatearJustificacion(documento?.justificacion_entrega_sin_pago)}<br>
          ${fuenteTexto}
        </div>
        <p>¿Confirma marcar como listo para entrega?</p>
        <p><strong>Recepción podrá entregar SIN verificar estado de pago.</strong></p>
        
        <div class="form-check mt-3">
          <input type="checkbox" id="revocarAutorizacion" name="revocar_autorizacion">
          <label for="revocarAutorizacion" class="text-warning">
            <i class="fas fa-exclamation-triangle"></i>
            Cambiar: Requiere verificación de pago para entregar
          </label>
        </div>
      `;
    } else {
      // ESCENARIO C: DOCUMENTO SIN PAGO Y SIN AUTORIZACIÓN
      const fuenteTexto = fuente.includes('CHECKBOX') ? 
        '<small class="text-muted"><i class="fas fa-edit"></i> Sin autorización (actualizado en esta sesión)</small>' :
        '<small class="text-muted">Estado actual: Sin autorización de crédito</small>';
      
      modalBody.innerHTML = `
        <div class="alert alert-info">
          <i class="fas fa-credit-card"></i>
          <strong>Entrega con verificación de pago</strong><br>
          Estado de pago: <span class="badge bg-secondary text-white px-2 py-1 rounded">${estadoPago.replace('_', ' ').toUpperCase()}</span><br>
          Recepción verificará que el pago esté al día antes de entregar.<br>
          ${fuenteTexto}
        </div>
        <p>¿Confirma marcar como listo para entrega?</p>
        
        <div class="form-check mt-3">
          <input type="checkbox" id="autorizarAhora" name="autorizar_ahora">
          <label for="autorizarAhora" class="text-success">
            <i class="fas fa-university"></i>
            <strong>Cliente con crédito autorizado</strong> - Última oportunidad
          </label>
          <small class="form-text text-muted">
            Marque solo si el cliente tiene crédito autorizado por la notaría
          </small>
        </div>
        
        <div id="justificacionFinal" style="display: none;" class="mt-3">
          <label class="form-label">Justificación:</label>
          <select class="form-select" name="justificacion_final">
            <option value="cliente_corporativo">Cliente corporativo con convenio</option>
            <option value="historial_pagos">Cliente con excelente historial</option>
            <option value="urgencia">Situación urgente justificada</option>
            <option value="otro">Otro motivo</option>
          </select>
        </div>
      `;
      
      // Event listener para justificación
      setTimeout(() => {
        const checkbox = document.getElementById('autorizarAhora');
        const justDiv = document.getElementById('justificacionFinal');
        if (checkbox && justDiv) {
          checkbox.addEventListener('change', function() {
            justDiv.style.display = this.checked ? 'block' : 'none';
          });
        }
      }, 100);
    }
  }

  // FUNCIÓN PARA FORMATEAR FECHAS
  function formatearFecha(fechaString) {
    if (!fechaString) return 'Fecha no disponible';
    
    const fecha = new Date(fechaString);
    return fecha.toLocaleDateString('es-EC', {
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit'
    });
  }

  // FUNCIÓN PARA FORMATEAR JUSTIFICACIONES
  function formatearJustificacion(justificacion) {
    if (!justificacion) return 'No especificada';
    
    const traducciones = {
      'cliente_corporativo': 'Cliente corporativo con convenio',
      'historial_pagos': 'Cliente con excelente historial de pagos',
      'urgencia_justificada': 'Situación urgente justificada',
      'cliente_frecuente': 'Cliente frecuente de confianza',
      'otro': 'Otro motivo'
    };
    
    return traducciones[justificacion] || justificacion;
  }

  // 🚀 CONFIRMACIÓN FINAL HÍBRIDA (BD + CHECKBOX)
  async function confirmarMarcarListoDetalle() {
    const documentoId = document.getElementById('documentoIdDetalle').value;
    
    console.log('🔍 DEBUG CONFIRMACIÓN (BD + CHECKBOX) - Documento:', documentoId);
    
    // 1. VERIFICAR estado actual del checkbox en la página (si existe)
    const checkboxCredito = document.getElementById('preAutorizacionCredito');
    const estadoCheckboxPagina = checkboxCredito ? checkboxCredito.checked : null;
    const justificacionSelectPagina = document.querySelector('select[name="justificacion_entrega_sin_pago"]');
    const justificacionCheckboxPagina = justificacionSelectPagina ? justificacionSelectPagina.value : null;
    
    // 2. OBTENER estado desde checkboxes del modal
    const revocarCheckbox = document.getElementById('revocarAutorizacion');
    const autorizarCheckbox = document.getElementById('autorizarAhora');
    const justificacionSelect = document.querySelector('select[name="justificacion_final"]');
    
    let estadoFinal = false;
    let justificacion = null;
    let fuenteDecision = '';
    
    // 3. LÓGICA DE PRIORIDAD PARA DETERMINAR ESTADO FINAL
    if (revocarCheckbox && revocarCheckbox.checked) {
      // Usuario quiere REVOCAR crédito en el modal
      estadoFinal = false;
      justificacion = null;
      fuenteDecision = 'MODAL: Revocado';
    } else if (autorizarCheckbox && autorizarCheckbox.checked) {
      // Usuario quiere AUTORIZAR crédito en el modal
      estadoFinal = true;
      justificacion = justificacionSelect ? justificacionSelect.value : 'cliente_corporativo';
      fuenteDecision = 'MODAL: Autorizado';
      
      if (!justificacion) {
        alert('⚠️ Debe seleccionar una justificación para autorizar el crédito');
        return;
      }
    } else if (estadoCheckboxPagina !== null) {
      // USAR estado del checkbox de la página (prioridad alta)
      estadoFinal = estadoCheckboxPagina;
      justificacion = estadoCheckboxPagina ? (justificacionCheckboxPagina || 'cliente_corporativo') : null;
      fuenteDecision = estadoCheckboxPagina ? 'CHECKBOX PÁGINA: Autorizado' : 'CHECKBOX PÁGINA: Sin autorización';
    } else {
      // FALLBACK: Consultar BD para mantener estado actual
      try {
        const response = await fetch(`/matrizador/documentos/${documentoId}/datos`);
        const documento = await response.json();
        estadoFinal = documento.entrega_sin_verificar_pago === true;
        justificacion = documento.justificacion_entrega_sin_pago;
        fuenteDecision = 'BD: Estado mantenido';
      } catch (error) {
        console.error('Error al obtener estado actual:', error);
        estadoFinal = false;
        fuenteDecision = 'FALLBACK: Sin crédito';
      }
    }
    
    console.log('🎯 DECISIÓN FINAL:', {
      estado_final: estadoFinal,
      justificacion: justificacion,
      fuente: fuenteDecision
    });
    
    // ✅ LÓGICA CORREGIDA: Detectar si el documento está en grupo
    let accionGrupo = 'marcar_solo_documento'; // Valor por defecto
    
    // Verificar si hay información de grupo en la página
    const informacionGrupal = document.querySelector('[data-grupo-id]');
    const grupoId = informacionGrupal ? informacionGrupal.getAttribute('data-grupo-id') : null;
    
    if (grupoId && grupoId !== 'null') {
      console.log('🔍 Documento está en grupo:', grupoId);
      
      // 🎯 MENSAJE CORREGIDO: Preguntar si quiere marcar todo el grupo
      const marcarTodoElGrupo = confirm(
        '📱 Este documento está en un grupo de notificación.\n\n' +
        'Al marcar como listo se procesará todo el grupo.\n\n' +
        '✅ Aceptar = Marcar todo el grupo como listo\n' +
        '❌ Cancelar = Volver al detalle\n\n' +
        '¿Desea continuar?'
      );
      
      if (marcarTodoElGrupo) {
        accionGrupo = 'marcar_todo_grupo';
        console.log('👥 Usuario eligió: Marcar todo el grupo');
      } else {
        // 🚫 CANCELAR: Volver al detalle sin hacer nada
        console.log('❌ Usuario canceló la acción - Volviendo al detalle');
        
        // Rehabilitar botón si estaba deshabilitado
        const btnConfirmar = document.querySelector('#marcarListoModal .btn-success');
        if (btnConfirmar) {
          btnConfirmar.disabled = false;
          btnConfirmar.innerHTML = '<i class="fas fa-check me-1"></i> Confirmar';
        }
        
        return; // 🔄 SALIR de la función sin enviar nada al servidor
      }
    }
    
    // ENVIAR al servidor
    const datosEnvio = {
      entrega_sin_verificar_pago: estadoFinal,
      justificacion_entrega_sin_pago: justificacion,
      accion_autorizacion: accionGrupo,
      marcarTodoElGrupo: accionGrupo === 'marcar_todo_grupo'
    };
    
    console.log('📤 Enviando al servidor:', datosEnvio);
    
    // Deshabilitar botón
    const btnConfirmar = document.querySelector('#marcarListoModal .btn-success');
    if (btnConfirmar) {
      btnConfirmar.disabled = true;
      btnConfirmar.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Procesando...';
    }
    
    try {
      const response = await fetch(`/matrizador/documentos/${documentoId}/marcar-listo`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(datosEnvio)
      });
      
      const data = await response.json();
      console.log('✅ Respuesta del servidor:', data);
      
      if (data.success) {
        // 🎯 MENSAJE INTELIGENTE basado en estado de pago y crédito
        let mensaje;
        
        if (estadoFinal) {
          mensaje = `✅ Documento marcado como listo - CRÉDITO AUTORIZADO`;
        } else {
          // Verificar estado de pago del documento para mensaje correcto
          const estadoPago = '{{documento.estadoPago}}';
          const valorPendiente = parseFloat('{{documento.valorPendiente}}' || '0');
          
          if (estadoPago === 'pagado_completo' || valorPendiente <= 0) {
            mensaje = `✅ Documento marcado como listo - PAGO VERIFICADO`;
          } else {
            mensaje = `✅ Documento marcado como listo - VERIFICAR PAGO antes de entregar`;
          }
        }
        
        alert(mensaje);
        
        // Cerrar modal y recargar
        const modal = bootstrap.Modal.getInstance(document.getElementById('marcarListoModal'));
        modal.hide();
        
        setTimeout(() => {
          window.location.reload();
        }, 1000);
        
      } else {
        throw new Error(data.message || 'Error desconocido');
      }
    } catch (error) {
      console.error('❌ Error:', error);
      alert(`Error al marcar documento como listo: ${error.message}`);
      
      // Rehabilitar botón
      if (btnConfirmar) {
        btnConfirmar.disabled = false;
        btnConfirmar.innerHTML = '<i class="fas fa-check me-1"></i> Confirmar';
      }
    }
  }

  // 🎨 ACTUALIZAR VISUAL DEL DOCUMENTO
  function actualizarEstadoDocumento(creditoAutorizado) {
    // Cambiar badge de estado
    const estadoElement = document.querySelector('.badge');
    if (estadoElement && estadoElement.textContent.includes('En Proceso')) {
      estadoElement.className = 'badge bg-info';
      estadoElement.innerHTML = 'Listo para Entrega';
    }
    
    // Ocultar botón de marcar
    const botonMarcar = document.querySelector('button[onclick*="marcarListo"]');
    if (botonMarcar) {
      botonMarcar.style.display = 'none';
    }
    
    // Ya no se usan badges de autorización (sistema limpiado)
  }

  console.log('📖 Vista de detalle cargada para documento {{documento.codigoBarras}}');
  
  // ============== FORMATEAR FECHAS DE EVENTOS ==============
  document.addEventListener('DOMContentLoaded', function() {
    console.log('🕒 Iniciando formateo de fechas en detalle de documento...');
    
    // Función para formatear fecha de manera robusta
    function formatearFechaSegura(fechaRaw) {
      if (!fechaRaw || fechaRaw === 'null' || fechaRaw === '' || fechaRaw === 'undefined') {
        return 'Sin fecha';
      }
      
      try {
        // Intentar diferentes formatos de fecha
        let fecha;
        
        // Si ya es un objeto Date
        if (fechaRaw instanceof Date) {
          fecha = fechaRaw;
        }
        // Si es un string ISO
        else if (typeof fechaRaw === 'string') {
          // Limpiar la fecha de caracteres extraños
          const fechaLimpia = fechaRaw.trim();
          fecha = new Date(fechaLimpia);
        }
        // Si es un timestamp
        else if (typeof fechaRaw === 'number') {
          fecha = new Date(fechaRaw);
        }
        else {
          console.warn('Formato de fecha no reconocido:', fechaRaw);
          return 'Formato inválido';
        }
        
        // Verificar si la fecha es válida
        if (isNaN(fecha.getTime())) {
          console.warn('Fecha inválida después de conversión:', fechaRaw);
          return 'Fecha inválida';
        }
        
        return fecha;
      } catch (error) {
        console.error('Error procesando fecha:', error, 'Fecha original:', fechaRaw);
        return 'Error en fecha';
      }
    }
    
    // Formatear fechas de eventos (fecha completa)
    document.querySelectorAll('.fecha-evento-detalle').forEach(function(elemento) {
      const fechaRaw = elemento.getAttribute('data-fecha');
      console.log('📅 Procesando fecha de evento:', fechaRaw);
      
      const fechaFormateada = formatearFechaSegura(fechaRaw);
      
      if (fechaFormateada instanceof Date) {
        elemento.textContent = fechaFormateada.toLocaleDateString('es-EC', {
          day: '2-digit',
          month: '2-digit', 
          year: 'numeric'
        });
        elemento.classList.add('text-success');
      } else {
        elemento.textContent = fechaFormateada;
        elemento.classList.add('text-muted');
      }
    });
    
    // Formatear horas de eventos (solo hora)
    document.querySelectorAll('.hora-evento-detalle').forEach(function(elemento) {
      const fechaRaw = elemento.getAttribute('data-fecha');
      console.log('🕒 Procesando hora de evento:', fechaRaw);
      
      const fechaFormateada = formatearFechaSegura(fechaRaw);
      
      if (fechaFormateada instanceof Date) {
        elemento.textContent = fechaFormateada.toLocaleTimeString('es-EC', {
          hour: '2-digit',
          minute: '2-digit',
          hour12: false
        });
      } else {
        elemento.textContent = '-';
      }
    });
    
    console.log('✅ Formateo de fechas de eventos completado');
  });
</script>

{{!-- 🆕 SCRIPT DE NOTIFICACIONES GRUPALES - SPRINT 3 --}}
<script src="/js/notificaciones-grupales.js"></script>
<script>
  // ============== FUNCIONES GLOBALES PARA NOTIFICACIONES GRUPALES ==============
  
  // ✅ FUNCIÓN mostrarModalAgrupar ELIMINADA - Era innecesaria
  // Los usuarios ahora usan directamente los checkboxes para seleccionar documentos
  
  /**
   * Función global para separar documento del grupo (OPTIMIZADA)
   * @param {number} documentoId - ID del documento
   */
  async function separarDeGrupo(documentoId) {
    console.log('🔗 [SEPARAR GRUPO] Separando documento:', documentoId);
    
    // Obtener información del grupo para personalizar mensaje
    const informacionGrupal = document.querySelector('[data-grupo-id]');
    const puedeModificar = informacionGrupal ? informacionGrupal.getAttribute('data-puede-modificar') === 'true' : false;
    
    // Personalizar mensaje según estado del grupo
    let mensaje;
    if (puedeModificar) {
      mensaje = '¿Estás seguro de que quieres separar este documento del grupo?\n\nEsto disolverá la agrupación y cada documento tendrá su propia notificación.';
    } else {
      mensaje = '¿Estás seguro de que quieres separar TU documento del grupo?\n\nNOTA: El grupo ya fue procesado, pero puedes separar tu documento.\nLos demás documentos permanecerán agrupados.';
    }
    
    // Confirmar acción
    if (!confirm(mensaje)) {
      return;
    }
    
    try {
      // 🚀 OPTIMIZADO: Usar la nueva función rápida sin hooks
      const response = await fetch(`/matrizador/api/revertir-agrupacion/${documentoId}`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        }
      });
      
      const resultado = await response.json();
      
      if (resultado.success || resultado.exito) {
        // Mensaje personalizado según el contexto
        let mensajeExito;
        if (puedeModificar) {
          mensajeExito = '✅ Documento separado del grupo exitosamente.\n\nAhora tendrá su propia notificación individual.';
        } else {
          mensajeExito = '✅ Tu documento fue separado del grupo.\n\nAhora podrás gestionarlo de manera independiente.\nLos demás documentos siguen agrupados.';
        }
        
        alert(mensajeExito);
        
        // Recargar la página para mostrar el nuevo estado
        setTimeout(() => {
          window.location.reload();
        }, 1500);
        
      } else {
        throw new Error(resultado.mensaje || resultado.error || 'Error desconocido al separar del grupo');
      }
      
    } catch (error) {
      console.error('❌ Error separando del grupo:', error);
      alert(`❌ Error al separar del grupo: ${error.message}`);
    }
  }

  // ============== FUNCIONES PARA MANEJO DE CHECKBOXES ==============
  
  /**
   * Seleccionar/deseleccionar todos los documentos
   * @param {boolean} seleccionar - Si seleccionar o deseleccionar
   */
  function toggleSelectAll(seleccionar) {
    console.log('🔄 [CHECKBOXES] Seleccionar todos:', seleccionar);
    const checkboxes = document.querySelectorAll('.doc-checkbox');
    console.log('📋 [CHECKBOXES] Encontrados', checkboxes.length, 'checkboxes');
    
    checkboxes.forEach((checkbox, index) => {
      checkbox.checked = seleccionar;
      console.log(`   - Checkbox ${index + 1}:`, checkbox.id, '→', checkbox.checked);
    });
    
    updateGroupButton();
  }
  
  /**
   * Actualizar el estado del botón de agrupación
   */
  function updateGroupButton() {
    const checkboxes = document.querySelectorAll('.doc-checkbox:checked');
    const contador = document.getElementById('contadorSeleccionados');
    const boton = document.getElementById('btnAgruparSeleccionados');
    
    console.log('🔄 [BOTÓN] Actualizando botón - Seleccionados:', checkboxes.length);
    
    if (contador) {
      contador.textContent = checkboxes.length;
    }
    
    if (boton) {
      boton.disabled = checkboxes.length === 0;
      
      if (checkboxes.length > 0) {
        boton.innerHTML = `<i class="fas fa-layer-group me-1"></i> Agrupar ${checkboxes.length} documentos`;
        boton.classList.remove('btn-secondary');
        boton.classList.add('btn-success');
        console.log('✅ [BOTÓN] Habilitado para', checkboxes.length, 'documentos');
      } else {
        boton.innerHTML = `<i class="fas fa-layer-group me-1"></i> Agrupar <span id="contadorSeleccionados">0</span> documentos`;
        boton.classList.remove('btn-success');
        boton.classList.add('btn-secondary');
        console.log('❌ [BOTÓN] Deshabilitado - sin selecciones');
      }
    } else {
      console.warn('⚠️ [BOTÓN] No se encontró el botón btnAgruparSeleccionados');
    }
  }
  
  /**
   * Procesar la agrupación de documentos seleccionados
   */
  async function procesarAgrupacion() {
    const checkboxes = document.querySelectorAll('.doc-checkbox:checked');
    const documentoActualId = {{documento.id}};
    
    console.log('📋 [AGRUPACIÓN] Iniciando procesamiento:', {
      documentoActual: documentoActualId,
      checkboxesSeleccionados: checkboxes.length
    });
    
    if (checkboxes.length === 0) {
      alert('Por favor selecciona al menos un documento para agrupar');
      return;
    }
    
    // Obtener IDs de documentos seleccionados
    const documentosIds = Array.from(checkboxes).map(cb => parseInt(cb.value));
    
    console.log('📋 [AGRUPACIÓN] Procesando agrupación:', {
      documentoLider: documentoActualId,
      documentosAdicionales: documentosIds,
      total: documentosIds.length + 1
    });
    
    // Mostrar estado de carga
    const boton = document.getElementById('btnAgruparSeleccionados');
    const textoOriginal = boton.innerHTML;
    boton.disabled = true;
    boton.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Agrupando...';
    
    try {
      // Llamar a la API para crear el grupo
      const response = await fetch('/matrizador/api/grupos-notificacion/crear', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          documentoLiderId: documentoActualId,
          documentosIds: documentosIds
        })
      });
      
      const resultado = await response.json();
      
      if (resultado.exito) {
        // Mostrar mensaje de éxito
        alert(`✅ ¡Grupo creado exitosamente!\n\nSe agruparon ${resultado.datos.documentosAgrupados} documentos.\nCódigo de verificación: ${resultado.datos.codigoVerificacion}\n\nAhora el cliente recibirá una sola notificación para todos los documentos.`);
        
        // Recargar la página para mostrar el nuevo estado
        setTimeout(() => {
          window.location.reload();
        }, 2000);
        
      } else {
        throw new Error(resultado.mensaje || 'Error desconocido al crear el grupo');
      }
      
    } catch (error) {
      console.error('❌ Error en agrupación:', error);
      alert(`❌ Error al agrupar documentos: ${error.message}`);
      
      // Restaurar botón
      boton.disabled = false;
      boton.innerHTML = textoOriginal;
    }
  }

  // Configurar datos del documento para notificaciones grupales
  document.addEventListener('DOMContentLoaded', function() {
    // Agregar atributos de datos al elemento principal
    const documentoContainer = document.querySelector('.document-detail-container') || document.body;
    
    {{#if documento}}
    documentoContainer.setAttribute('data-documento-id', '{{documento.id}}');
    documentoContainer.setAttribute('data-nombre-cliente', '{{documento.nombreCliente}}');
    documentoContainer.setAttribute('data-identificacion-cliente', '{{documento.identificacionCliente}}');
    
    {{#if notificacionGrupal}}
    documentoContainer.setAttribute('data-grupo-info', 'true');
    documentoContainer.setAttribute('data-grupo-id', '{{notificacionGrupal.id}}');
    documentoContainer.setAttribute('data-codigo-verificacion', '{{notificacionGrupal.codigoVerificacion}}');
    documentoContainer.setAttribute('data-total-documentos', '{{notificacionGrupal.documentos.length}}');
    documentoContainer.setAttribute('data-es-lider', '{{#if documento.esLiderGrupo}}true{{else}}false{{/if}}');
    {{/if}}
    {{/if}}
    
    // Inicializar sistema de notificaciones grupales
    if (window.NotificacionesGrupales) {
      window.NotificacionesGrupales.init();
      console.log('📱 [NOTIFICACIONES GRUPALES] Sistema inicializado correctamente');
    } else {
      console.warn('⚠️ [NOTIFICACIONES GRUPALES] Sistema no disponible');
    }
    
    console.log('📱 [NOTIFICACIONES GRUPALES] Datos del documento configurados');
    
    // ============== INICIALIZAR SISTEMA DE CHECKBOXES ==============
    
    // Verificar si hay elementos de agrupación en la página
    const checkboxes = document.querySelectorAll('.doc-checkbox');
    const selectAllCheckbox = document.getElementById('selectAllDocs');
    const botonAgrupar = document.getElementById('btnAgruparSeleccionados');
    
    console.log('🔍 [INIT] Elementos encontrados:', {
      checkboxes: checkboxes.length,
      selectAll: !!selectAllCheckbox,
      botonAgrupar: !!botonAgrupar
    });
    
    // Agregar event listeners a checkboxes individuales
    checkboxes.forEach((checkbox, index) => {
      checkbox.addEventListener('change', function() {
        console.log(`📋 [CHECKBOX ${index + 1}] Cambio:`, this.id, '→', this.checked);
        updateGroupButton();
        
        // Actualizar el checkbox "Todos" si es necesario
        if (selectAllCheckbox) {
          const todosSeleccionados = Array.from(checkboxes).every(cb => cb.checked);
          const ningunoSeleccionado = Array.from(checkboxes).every(cb => !cb.checked);
          
          if (todosSeleccionados) {
            selectAllCheckbox.checked = true;
            selectAllCheckbox.indeterminate = false;
          } else if (ningunoSeleccionado) {
            selectAllCheckbox.checked = false;
            selectAllCheckbox.indeterminate = false;
          } else {
            selectAllCheckbox.checked = false;
            selectAllCheckbox.indeterminate = true;
          }
        }
      });
    });
    
    // Agregar event listener al checkbox "Todos"
    if (selectAllCheckbox) {
      selectAllCheckbox.addEventListener('change', function() {
        console.log('📋 [SELECT ALL] Cambio:', this.checked);
        toggleSelectAll(this.checked);
      });
    }
    
    // Inicializar estado del botón
    if (botonAgrupar) {
      updateGroupButton();
    }
    
    console.log('✅ [INIT] Sistema de checkboxes inicializado correctamente');
    
    // ============== VERIFICACIÓN DE TELÉFONOS PARA AGRUPACIÓN ==============
    
    // Verificar consistencia de teléfonos al mostrar documentos agrupables
    verificarConsistenciaTelefonos();
  });

  /**
   * 📱 NUEVA FUNCIÓN: Verificar consistencia de teléfonos en documentos agrupables
   */
  function verificarConsistenciaTelefonos() {
    const telefonoActual = '{{documento.telefonoCliente}}';
    const documentosAgrupables = document.querySelectorAll('.doc-checkbox');
    
    if (!telefonoActual || telefonoActual === '' || documentosAgrupables.length === 0) {
      return; // No hay nada que verificar
    }
    
    console.log('📱 [TELÉFONOS] Verificando consistencia...');
    
    // Verificar si el teléfono actual es válido para WhatsApp (celular)
    const esWhatsAppValido = /^09\d{8}$/.test(telefonoActual);
    
    if (!esWhatsAppValido) {
      mostrarAlertaTelefono('actual_invalido', telefonoActual);
      return;
    }
    
    // TODO: En una implementación futura, verificar teléfonos de otros documentos
    // Por ahora, mostrar sugerencia para sincronizar
    if (documentosAgrupables.length > 0) {
      mostrarSugerenciaSincronizacion(telefonoActual);
    }
  }
  
  /**
   * 📱 NUEVA FUNCIÓN: Mostrar alerta sobre problemas de teléfono
   */
  function mostrarAlertaTelefono(tipo, telefono) {
    let mensaje = '';
    let icono = '⚠️';
    let clase = 'alert-warning';
    
    switch (tipo) {
      case 'actual_invalido':
        mensaje = `El número de teléfono actual (${telefono}) no es válido para WhatsApp. `;
        mensaje += `Para notificaciones grupales, necesitas un número de celular que inicie con 09.`;
        icono = '❌';
        clase = 'alert-danger';
        break;
      case 'inconsistente':
        mensaje = `Los documentos del mismo cliente tienen números diferentes. `;
        mensaje += `Para notificaciones grupales efectivas, todos deberían tener el mismo número de WhatsApp.`;
        break;
    }
    
    // Crear alerta temporal
    const alertaHtml = `
      <div class="alert ${clase} alert-dismissible fade show mt-3" role="alert" id="alerta-telefono">
        <strong>${icono} Atención:</strong> ${mensaje}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    `;
    
    // Insertar la alerta después del título del documento
    const titulo = document.querySelector('h2');
    if (titulo) {
      titulo.insertAdjacentHTML('afterend', alertaHtml);
      
      // Auto-remover después de 10 segundos
      setTimeout(() => {
        const alerta = document.getElementById('alerta-telefono');
        if (alerta) {
          alerta.remove();
        }
      }, 10000);
    }
  }
  
  /**
   * 📱 NUEVA FUNCIÓN: Mostrar sugerencia de sincronización de teléfonos
   */
  function mostrarSugerenciaSincronizacion(telefonoValido) {
    // Solo mostrar si hay documentos agrupables
    const seccionAgrupacion = document.querySelector('.documentos-agrupables');
    if (!seccionAgrupacion) return;
    
    const sugerenciaHtml = `
      <div class="alert alert-info mt-2" id="sugerencia-telefono">
        <i class="fas fa-lightbulb me-2"></i>
        <strong>💡 Sugerencia:</strong> 
        Para notificaciones grupales efectivas, asegúrate de que todos los documentos del cliente 
        tengan el mismo número de WhatsApp: <strong>${telefonoValido}</strong>
        <br>
        <small class="text-muted">
          <i class="fas fa-info-circle me-1"></i>
          Edita cada documento para actualizar el número antes de agrupar.
        </small>
      </div>
    `;
    
    // Agregar la sugerencia al final de la sección de agrupación
    seccionAgrupacion.insertAdjacentHTML('beforeend', sugerenciaHtml);
  }
</script>
{{else}}
<div class="alert alert-warning">
  <i class="fas fa-exclamation-triangle me-2"></i> El documento solicitado no existe o no tienes permisos para verlo.
</div>
