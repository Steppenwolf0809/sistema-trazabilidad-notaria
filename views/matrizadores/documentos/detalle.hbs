{{! Detalle de Documento - Matrizadores - VISTA MEJORADA CON INFORMACIÓN FINANCIERA }}
{{! layout: 'matrizador' }}
{{#if documento}}
<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <div>
      <i class="fas fa-file-alt me-2"></i> Detalle de Documento
    </div>
    <div>
      <a href="/matrizador/documentos" class="btn btn-sm btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i> Volver
      </a>
      
      <a href="/matrizador/documentos/editar/{{documento.id}}" class="btn btn-sm btn-primary ms-1">
        <i class="fas fa-edit me-1"></i> Editar
      </a>
      
      {{#if (eq documento.estado "en_proceso")}}
      <button type="button" class="btn btn-sm btn-success ms-1" onclick="marcarListo({{documento.id}})">
        <i class="fas fa-check me-1"></i> Marcar como listo
      </button>
      {{/if}}
      
      {{#if (eq documento.estado "listo_para_entrega")}}
      <a href="/matrizador/documentos/entrega/{{documento.id}}" class="btn btn-sm btn-info ms-1">
        <i class="fas fa-hand-holding me-1"></i> Entrega
      </a>
      {{/if}}
    </div>
  </div>
  <div class="card-body">
    <!-- Información general -->
    <div class="row mb-4">
      <div class="col-md-4">
        <div class="mb-3">
          <h5 class="border-bottom pb-2">Información General</h5>
          <p><strong>Código:</strong> <span class="badge bg-primary">{{documento.codigoBarras}}</span></p>
          <p><strong>Tipo:</strong> {{documento.tipoDocumento}}</p>
          
          <!-- Contenedor para badges de autorización -->
          <div class="badges-autorizacion mb-2" data-documento-id="{{documento.id}}">
            <!-- Los badges se cargan dinámicamente via JavaScript -->
          </div>
          <p><strong>Estado:</strong> 
            {{#if (eq documento.estado "en_proceso")}}
            <span class="badge bg-warning text-dark">En Proceso</span>
            {{else if (eq documento.estado "listo_para_entrega")}}
            <span class="badge bg-info">Listo para Entrega</span>
            {{else if (eq documento.estado "entregado")}}
            <span class="badge bg-success">Entregado</span>
            {{else if (eq documento.estado "nota_credito")}}
            <span class="badge bg-secondary">Nota de Crédito</span>
            {{else if (eq documento.estado "eliminado")}}
            <span class="badge bg-danger">Eliminado</span>
            {{else}}
            <span class="badge bg-secondary">{{translateEstado documento.estado}}</span>
            {{/if}}
          </p>
          <p><strong>📅 Fecha Registro:</strong> {{formatDate documento.created_at}}</p>
          {{#if documento.fechaFactura}}
          <p><strong>📄 Fecha Documento:</strong> {{formatDateDocument documento.fechaFactura}}</p>
          {{/if}}
          {{#if documento.fechaEntrega}}
          <p><strong>🚀 Fecha Entrega:</strong> {{formatDate documento.fechaEntrega}}</p>
          {{/if}}
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="mb-3">
          <h5 class="border-bottom pb-2">Cliente</h5>
          <p><strong>Nombre:</strong> {{documento.nombreCliente}}</p>
          <p><strong>Identificación:</strong> {{documento.identificacionCliente}}</p>
          {{#if documento.emailCliente}}
          <p><strong>Email:</strong> {{documento.emailCliente}}</p>
          {{/if}}
          {{#if documento.telefonoCliente}}
          <p><strong>Teléfono:</strong> {{documento.telefonoCliente}}</p>
          {{/if}}
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="mb-3">
          <h5 class="border-bottom pb-2">Mi Responsabilidad</h5>
          <p><strong>Estado del Proceso:</strong> 
            {{#if (eq documento.estado "en_proceso")}}
            <span class="badge bg-warning text-dark fs-6">⚠️ En mi bandeja de trabajo</span>
            {{else if (eq documento.estado "listo_para_entrega")}}
            <span class="badge bg-success fs-6">✅ Listo para entrega</span>
            {{else if (eq documento.estado "entregado")}}
            <span class="badge bg-info fs-6">📦 Entregado al cliente</span>
            {{else}}
            <span class="badge bg-secondary fs-6">{{translateEstado documento.estado}}</span>
            {{/if}}
          </p>
          {{#if (eq documento.estado "listo_para_entrega")}}
          <p><strong>🔑 Código de Entrega:</strong> 
            <span class="badge bg-success fs-4">{{documento.codigoVerificacion}}</span>
          </p>
          <p class="small text-muted">Proporcione este código al cliente para confirmar la entrega</p>
          {{else if (eq documento.estado "en_proceso")}}
          <div class="alert alert-info py-2">
            <small><i class="fas fa-info-circle me-1"></i>El código de entrega se generará cuando marque el documento como listo</small>
          </div>
          {{/if}}
        </div>
      </div>
    </div>
    
    <!-- Información de facturación y pagos -->
    <div class="row mb-4">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-money-bill-wave me-2"></i>Información Financiera</h5>
          </div>
          <div class="card-body">
            <div class="row">
              <div class="col-md-6">
                <div class="card border-primary">
                  <div class="card-header bg-primary text-white py-2">
                    <h6 class="mb-0"><i class="fas fa-file-invoice me-1"></i>Facturación</h6>
                  </div>
                  <div class="card-body">
                    <div class="row">
                      <div class="col-12 mb-2">
                        <strong>📄 N° Factura:</strong> 
                        <span class="badge bg-secondary">{{#if documento.numeroFactura}}{{documento.numeroFactura}}{{else}}No registrado{{/if}}</span>
                      </div>
                      <div class="col-12 mb-2">
                        <strong>💰 Valor Total:</strong> 
                        <span class="fs-5 text-primary">${{#if documento.valorFactura}}{{formatMoney documento.valorFactura}}{{else}}0.00{{/if}}</span>
                      </div>
                      {{#if documento.fechaFactura}}
                      <div class="col-12">
                        <strong>📅 Fecha Factura:</strong> {{formatDateDocument documento.fechaFactura}}
                      </div>
                      {{/if}}
                    </div>
                  </div>
                </div>
              </div>
              
              <div class="col-md-6">
                <div class="card border-{{#if (eq documento.estadoPago "pagado_completo")}}success{{else if (eq documento.estadoPago "pagado_con_retencion")}}info{{else if (eq documento.estadoPago "pago_parcial")}}warning{{else}}danger{{/if}}">
                  <div class="card-header bg-{{#if (eq documento.estadoPago "pagado_completo")}}success{{else if (eq documento.estadoPago "pagado_con_retencion")}}info{{else if (eq documento.estadoPago "pago_parcial")}}warning{{else}}danger{{/if}} text-white py-2">
                    <h6 class="mb-0"><i class="fas fa-credit-card me-1"></i>Estado de Pago</h6>
                  </div>
                  <div class="card-body">
                    <div class="row">
                      <div class="col-12 mb-2">
                        <strong>🏷️ Estado:</strong> 
                        {{#if (eq documento.estadoPago "pagado_completo")}}
                        <span class="badge bg-success fs-6">✅ Pagado Completo</span>
                        {{else if (eq documento.estadoPago "pagado_con_retencion")}}
                        <span class="badge bg-info fs-6">🧾 Pagado con Retención</span>
                        {{else if (eq documento.estadoPago "pago_parcial")}}
                        <span class="badge bg-warning text-dark fs-6">⚠️ Pago Parcial</span>
                        {{else}}
                        <span class="badge bg-danger fs-6">❌ Pendiente</span>
                        {{/if}}
                      </div>
                      <div class="col-12 mb-2">
                        <strong>💳 Método:</strong> 
                        <span class="badge bg-secondary">{{#if documento.metodoPago}}{{documento.metodoPago}}{{else}}No registrado{{/if}}</span>
                      </div>
                      {{#if (or (eq documento.estadoPago "pagado_completo") (eq documento.estadoPago "pagado_con_retencion") (eq documento.estadoPago "pago_parcial"))}}
                      <div class="col-12">
                        <strong>📅 Último Pago:</strong> 
                        <span class="badge bg-success-subtle text-success-emphasis px-2 py-1">
                          {{#if documento.fechaUltimoPago}}
                          {{formatDateTime documento.fechaUltimoPago}}
                          {{else if documento.fechaPago}}
                          {{formatDateTime documento.fechaPago}}
                          {{else}}
                          No registrada
                          {{/if}}
                        </span>
                      </div>
                      {{/if}}
                    </div>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- Desglose financiero para matrizadores -->
            {{#if (neq documento.estadoPago "pendiente")}}
            <div class="row mt-3">
              <div class="col-12">
                <div class="card border-info">
                  <div class="card-header bg-info text-white py-2">
                    <h6 class="mb-0"><i class="fas fa-calculator me-1"></i>Desglose Financiero</h6>
                  </div>
                  <div class="card-body">
                    <div class="row text-center">
                      <div class="col-md-3">
                        <div class="border-end">
                          <div class="text-muted small">VALOR TOTAL</div>
                          <div class="fs-4 text-primary">${{#if documento.valorFactura}}{{formatMoney documento.valorFactura}}{{else}}0.00{{/if}}</div>
                        </div>
                      </div>
                      <div class="col-md-3">
                        <div class="border-end">
                          <div class="text-muted small">PAGADO</div>
                          <div class="fs-4 text-success">${{#if documento.valorPagado}}{{formatMoney documento.valorPagado}}{{else}}0.00{{/if}}</div>
                        </div>
                      </div>
                      <div class="col-md-3">
                        <div class="{{#if documento.tieneRetencion}}border-end{{/if}}">
                          <div class="text-muted small">PENDIENTE</div>
                          <div class="fs-4 text-danger">${{#if documento.valorPendiente}}{{formatMoney documento.valorPendiente}}{{else}}0.00{{/if}}</div>
                        </div>
                      </div>
                      {{#if documento.tieneRetencion}}
                      <div class="col-md-3">
                        <div class="text-muted small">RETENCIÓN</div>
                        <div class="fs-4 text-warning">${{#if documento.valorRetenido}}{{formatMoney documento.valorRetenido}}{{else}}0.00{{/if}}</div>
                        {{#if documento.numeroComprobanteRetencion}}
                        <div class="small text-muted">Comp: {{documento.numeroComprobanteRetencion}}</div>
                        {{/if}}
                      </div>
                      {{/if}}
                    </div>
                  </div>
                </div>
              </div>
            </div>
            {{/if}}
          </div>
        </div>
      </div>
    </div>
    
    <!-- Notas -->
    {{#if documento.notas}}
    <div class="row mb-4">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h5 class="mb-0">Notas</h5>
          </div>
          <div class="card-body">
            <p>{{documento.notas}}</p>
          </div>
        </div>
      </div>
    </div>
    {{/if}}
    
    <!-- Comparecientes -->
    {{#if documento.comparecientes.length}}
    <div class="row mb-4">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h5 class="mb-0">Comparecientes</h5>
          </div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Nombre</th>
                    <th>Identificación</th>
                    <th>Rol</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each documento.comparecientes}}
                  <tr>
                    <td>{{this.nombre}}</td>
                    <td>{{this.identificacion}}</td>
                    <td>{{this.rol}}</td>
                  </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
    {{/if}}
    
    <!-- 🆕 HISTORIAL UNIVERSAL -->
    {{> historial-universal eventos=eventos esAdmin=false userRole="matrizador"}}
  </div>
</div>

<!-- Modal de confirmación para marcar como listo -->
<div class="modal fade" id="marcarListoModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Marcar documento como listo</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="modalBodyContent">
        <!-- El contenido se carga dinámicamente según el estado actual -->
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-success" onclick="confirmarMarcarListoDetalle()">
          <i class="fas fa-check me-1"></i> Confirmar
        </button>
        <input type="hidden" id="documentoIdDetalle" name="documentoId" value="{{documento.id}}">
      </div>
    </div>
  </div>
</div>

<!-- CSS eliminado - Ahora usa el sistema universal -->

<script>
  // 🎯 SISTEMA DE DOBLE VERIFICACIÓN - CHECKPOINT 2
  function marcarListo(id) {
    document.getElementById('documentoIdDetalle').value = id;
    
    // Mostrar modal dinámico según estado real del servidor
    mostrarModalMarcarListo(id);
    
    const modal = new bootstrap.Modal(document.getElementById('marcarListoModal'));
    modal.show();
  }

  // 🔄 MODAL HÍBRIDO - BD + CHECKBOX ACTUAL
  function mostrarModalMarcarListo(documentoId) {
    console.log('🔍 DEBUG MODAL ABIERTO (BD + CHECKBOX) - Documento:', documentoId);
    
    // 1. VERIFICAR estado actual del checkbox en la página (si existe)
    const checkboxCredito = document.getElementById('preAutorizacionCredito');
    const estadoCheckbox = checkboxCredito ? checkboxCredito.checked : null;
    const justificacionSelect = document.querySelector('select[name="justificacion_entrega_sin_pago"]');
    const justificacionCheckbox = justificacionSelect ? justificacionSelect.value : null;
    
    console.log('📋 Estado actual del checkbox:', {
      checkbox_existe: !!checkboxCredito,
      checkbox_elemento: checkboxCredito ? 'ENCONTRADO' : 'NO EXISTE (vista detalle)',
      checkbox_marcado: estadoCheckbox,
      justificacion_checkbox: justificacionCheckbox,
      vista_actual: checkboxCredito ? 'EDITAR' : 'DETALLE'
    });
    
    // 2. OBTENER datos guardados en la BASE DE DATOS
    fetch(`/matrizador/documentos/${documentoId}/datos`)
      .then(response => {
        if (!response.ok) {
          throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }
        return response.json();
      })
      .then(respuestaServidor => {
        // EXTRAER documento de la respuesta del servidor
        const documento = respuestaServidor.documento || respuestaServidor;
        
        console.log('📋 Datos obtenidos del servidor:', {
          respuesta_completa: respuestaServidor,
          documento_extraido: documento,
          id: documento?.id || 'No disponible',
          entrega_sin_verificar_pago_bd: documento?.entrega_sin_verificar_pago,
          tipo_dato: typeof documento?.entrega_sin_verificar_pago,
          valor_exacto: documento?.entrega_sin_verificar_pago,
          es_true: documento?.entrega_sin_verificar_pago === true,
          es_string_true: documento?.entrega_sin_verificar_pago === 'true',
          justificacion_bd: documento?.justificacion_entrega_sin_pago || null,
          fuente: 'SERVIDOR BD'
        });
        
        // 3. DETERMINAR estado final: BD es base, checkbox solo sobrescribe si existe
        let estadoFinal = documento?.entrega_sin_verificar_pago === true; // CORRECCIÓN: comparación exacta
        let justificacionFinal = documento?.justificacion_entrega_sin_pago || null;
        let fuente = 'BD';
        
        // SOLO si hay checkbox presente, usar su valor (vista de editar)
        if (checkboxCredito && estadoCheckbox === true) {
          estadoFinal = true;
          justificacionFinal = justificacionCheckbox || justificacionFinal || 'cliente_corporativo';
          fuente = 'CHECKBOX ACTUAL (marcado)';
        } else if (checkboxCredito && estadoCheckbox === false) {
          estadoFinal = false;
          justificacionFinal = null;
          fuente = 'CHECKBOX ACTUAL (desmarcado)';
        }
        // Si no hay checkbox (vista detalle), mantener estado de BD
        
        console.log('🎯 ESTADO FINAL DETERMINADO:', {
          bd_original: documento?.entrega_sin_verificar_pago,
          bd_es_true: documento?.entrega_sin_verificar_pago === true,
          checkbox_presente: !!checkboxCredito,
          checkbox_valor: estadoCheckbox,
          estado_final: estadoFinal,
          sera_credito: estadoFinal === true,
          justificacion: justificacionFinal,
          fuente: fuente
        });
        
        // 4. Configurar modal con estado final
        const documentoFinal = {
          ...documento,
          entrega_sin_verificar_pago: estadoFinal,
          justificacion_entrega_sin_pago: justificacionFinal,
          fuente_estado: fuente
        };
        
        configurarModalSegunDatos(documentoFinal);
      })
      .catch(error => {
        console.error('❌ Error al obtener datos del documento:', error);
        alert('Error al cargar información del documento. Por favor, recargue la página.');
      });
  }

  // 🎯 CONFIGURAR MODAL CON DATOS HÍBRIDOS (BD + CHECKBOX)
  function configurarModalSegunDatos(documento) {
    const modalBody = document.getElementById('modalBodyContent');
    const tieneCredito = documento.entrega_sin_verificar_pago === true;
    const fuente = documento.fuente_estado || 'BD';
    
            console.log('🔍 DEBUG CONFIGURACIÓN MODAL:', {
          documento_id: documento?.id || 'No disponible',
          tiene_credito: tieneCredito,
          justificacion: documento?.justificacion_entrega_sin_pago || 'No especificada',
          fuente_datos: fuente
        });
    
    if (tieneCredito) {
      // ESCENARIO A: DOCUMENTO CON CRÉDITO AUTORIZADO
      const fuenteTexto = fuente.includes('CHECKBOX') ? 
        '<small class="text-success"><i class="fas fa-edit"></i> Estado actualizado en esta sesión</small>' :
        `<small>Autorizado por: ${documento?.matrizador_nombre || 'Sistema'} el ${formatearFecha(documento?.fecha_autorizacion_entrega)}</small>`;
      
      modalBody.innerHTML = `
        <div class="alert alert-success">
          <i class="fas fa-shield-check"></i>
          <strong>Cliente con crédito autorizado</strong><br>
          Justificación: ${formatearJustificacion(documento?.justificacion_entrega_sin_pago)}<br>
          ${fuenteTexto}
        </div>
        <p>¿Confirma marcar como listo para entrega?</p>
        <p><strong>Recepción podrá entregar SIN verificar estado de pago.</strong></p>
        
        <div class="form-check mt-3">
          <input type="checkbox" id="revocarAutorizacion" name="revocar_autorizacion">
          <label for="revocarAutorizacion" class="text-warning">
            <i class="fas fa-exclamation-triangle"></i>
            Cambiar: Requiere verificación de pago para entregar
          </label>
        </div>
      `;
    } else {
      // ESCENARIO B: DOCUMENTO SIN AUTORIZACIÓN
      const fuenteTexto = fuente.includes('CHECKBOX') ? 
        '<small class="text-muted"><i class="fas fa-edit"></i> Sin autorización (actualizado en esta sesión)</small>' :
        '<small class="text-muted">Estado actual: Sin autorización de crédito</small>';
      
      modalBody.innerHTML = `
        <div class="alert alert-info">
          <i class="fas fa-credit-card"></i>
          <strong>Entrega con verificación de pago</strong><br>
          Recepción verificará que el pago esté al día antes de entregar.<br>
          ${fuenteTexto}
        </div>
        <p>¿Confirma marcar como listo para entrega?</p>
        
        <div class="form-check mt-3">
          <input type="checkbox" id="autorizarAhora" name="autorizar_ahora">
          <label for="autorizarAhora" class="text-success">
            <i class="fas fa-university"></i>
            <strong>Cliente con crédito autorizado</strong> - Última oportunidad
          </label>
          <small class="form-text text-muted">
            Marque solo si el cliente tiene crédito autorizado por la notaría
          </small>
        </div>
        
        <div id="justificacionFinal" style="display: none;" class="mt-3">
          <label class="form-label">Justificación:</label>
          <select class="form-select" name="justificacion_final">
            <option value="cliente_corporativo">Cliente corporativo con convenio</option>
            <option value="historial_pagos">Cliente con excelente historial</option>
            <option value="urgencia">Situación urgente justificada</option>
            <option value="otro">Otro motivo</option>
          </select>
        </div>
      `;
      
      // Event listener para justificación
      setTimeout(() => {
        const checkbox = document.getElementById('autorizarAhora');
        const justDiv = document.getElementById('justificacionFinal');
        if (checkbox && justDiv) {
          checkbox.addEventListener('change', function() {
            justDiv.style.display = this.checked ? 'block' : 'none';
          });
        }
      }, 100);
    }
  }

  // FUNCIÓN PARA FORMATEAR FECHAS
  function formatearFecha(fechaString) {
    if (!fechaString) return 'Fecha no disponible';
    
    const fecha = new Date(fechaString);
    return fecha.toLocaleDateString('es-EC', {
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit'
    });
  }

  // FUNCIÓN PARA FORMATEAR JUSTIFICACIONES
  function formatearJustificacion(justificacion) {
    if (!justificacion) return 'No especificada';
    
    const traducciones = {
      'cliente_corporativo': 'Cliente corporativo con convenio',
      'historial_pagos': 'Cliente con excelente historial de pagos',
      'urgencia_justificada': 'Situación urgente justificada',
      'cliente_frecuente': 'Cliente frecuente de confianza',
      'otro': 'Otro motivo'
    };
    
    return traducciones[justificacion] || justificacion;
  }

  // 🚀 CONFIRMACIÓN FINAL HÍBRIDA (BD + CHECKBOX)
  async function confirmarMarcarListoDetalle() {
    const documentoId = document.getElementById('documentoIdDetalle').value;
    
    console.log('🔍 DEBUG CONFIRMACIÓN (BD + CHECKBOX) - Documento:', documentoId);
    
    // 1. VERIFICAR estado actual del checkbox en la página (si existe)
    const checkboxCredito = document.getElementById('preAutorizacionCredito');
    const estadoCheckboxPagina = checkboxCredito ? checkboxCredito.checked : null;
    const justificacionSelectPagina = document.querySelector('select[name="justificacion_entrega_sin_pago"]');
    const justificacionCheckboxPagina = justificacionSelectPagina ? justificacionSelectPagina.value : null;
    
    // 2. OBTENER estado desde checkboxes del modal
    const revocarCheckbox = document.getElementById('revocarAutorizacion');
    const autorizarCheckbox = document.getElementById('autorizarAhora');
    const justificacionSelect = document.querySelector('select[name="justificacion_final"]');
    
    let estadoFinal = false;
    let justificacion = null;
    let fuenteDecision = '';
    
    // 3. LÓGICA DE PRIORIDAD PARA DETERMINAR ESTADO FINAL
    if (revocarCheckbox && revocarCheckbox.checked) {
      // Usuario quiere REVOCAR crédito en el modal
      estadoFinal = false;
      justificacion = null;
      fuenteDecision = 'MODAL: Revocado';
    } else if (autorizarCheckbox && autorizarCheckbox.checked) {
      // Usuario quiere AUTORIZAR crédito en el modal
      estadoFinal = true;
      justificacion = justificacionSelect ? justificacionSelect.value : 'cliente_corporativo';
      fuenteDecision = 'MODAL: Autorizado';
      
      if (!justificacion) {
        alert('⚠️ Debe seleccionar una justificación para autorizar el crédito');
        return;
      }
    } else if (estadoCheckboxPagina !== null) {
      // USAR estado del checkbox de la página (prioridad alta)
      estadoFinal = estadoCheckboxPagina;
      justificacion = estadoCheckboxPagina ? (justificacionCheckboxPagina || 'cliente_corporativo') : null;
      fuenteDecision = estadoCheckboxPagina ? 'CHECKBOX PÁGINA: Autorizado' : 'CHECKBOX PÁGINA: Sin autorización';
    } else {
      // FALLBACK: Consultar BD para mantener estado actual
      try {
        const response = await fetch(`/matrizador/documentos/${documentoId}/datos`);
        const documento = await response.json();
        estadoFinal = documento.entrega_sin_verificar_pago === true;
        justificacion = documento.justificacion_entrega_sin_pago;
        fuenteDecision = 'BD: Estado mantenido';
      } catch (error) {
        console.error('Error al obtener estado actual:', error);
        estadoFinal = false;
        fuenteDecision = 'FALLBACK: Sin crédito';
      }
    }
    
    console.log('🎯 DECISIÓN FINAL:', {
      estado_final: estadoFinal,
      justificacion: justificacion,
      fuente: fuenteDecision
    });
    
    // ENVIAR al servidor
    const datosEnvio = {
      entrega_sin_verificar_pago: estadoFinal,
      justificacion_entrega_sin_pago: justificacion
    };
    
    console.log('📤 Enviando al servidor:', datosEnvio);
    
    // Deshabilitar botón
    const btnConfirmar = document.querySelector('#marcarListoModal .btn-success');
    if (btnConfirmar) {
      btnConfirmar.disabled = true;
      btnConfirmar.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Procesando...';
    }
    
    try {
      const response = await fetch(`/matrizador/documentos/${documentoId}/marcar-listo`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(datosEnvio)
      });
      
      const data = await response.json();
      console.log('✅ Respuesta del servidor:', data);
      
      if (data.success) {
        const mensaje = estadoFinal 
          ? `✅ Documento marcado como listo - CRÉDITO AUTORIZADO`
          : `✅ Documento marcado como listo - VERIFICAR PAGO antes de entregar`;
        
        alert(mensaje);
        
        // Cerrar modal y recargar
        const modal = bootstrap.Modal.getInstance(document.getElementById('marcarListoModal'));
        modal.hide();
        
        setTimeout(() => {
          window.location.reload();
        }, 1000);
        
      } else {
        throw new Error(data.message || 'Error desconocido');
      }
    } catch (error) {
      console.error('❌ Error:', error);
      alert(`Error al marcar documento como listo: ${error.message}`);
      
      // Rehabilitar botón
      if (btnConfirmar) {
        btnConfirmar.disabled = false;
        btnConfirmar.innerHTML = '<i class="fas fa-check me-1"></i> Confirmar';
      }
    }
  }

  // 🎨 ACTUALIZAR VISUAL DEL DOCUMENTO
  function actualizarEstadoDocumento(creditoAutorizado) {
    // Cambiar badge de estado
    const estadoElement = document.querySelector('.badge');
    if (estadoElement && estadoElement.textContent.includes('En Proceso')) {
      estadoElement.className = 'badge bg-info';
      estadoElement.innerHTML = 'Listo para Entrega';
    }
    
    // Ocultar botón de marcar
    const botonMarcar = document.querySelector('button[onclick*="marcarListo"]');
    if (botonMarcar) {
      botonMarcar.style.display = 'none';
    }
    
    // Ya no se usan badges de autorización (sistema limpiado)
  }

  console.log('📖 Vista de detalle cargada para documento {{documento.codigoBarras}}');
  
  // ============== FORMATEAR FECHAS DE EVENTOS ==============
  document.addEventListener('DOMContentLoaded', function() {
    console.log('🕒 Iniciando formateo de fechas en detalle de documento...');
    
    // Función para formatear fecha de manera robusta
    function formatearFechaSegura(fechaRaw) {
      if (!fechaRaw || fechaRaw === 'null' || fechaRaw === '' || fechaRaw === 'undefined') {
        return 'Sin fecha';
      }
      
      try {
        // Intentar diferentes formatos de fecha
        let fecha;
        
        // Si ya es un objeto Date
        if (fechaRaw instanceof Date) {
          fecha = fechaRaw;
        }
        // Si es un string ISO
        else if (typeof fechaRaw === 'string') {
          // Limpiar la fecha de caracteres extraños
          const fechaLimpia = fechaRaw.trim();
          fecha = new Date(fechaLimpia);
        }
        // Si es un timestamp
        else if (typeof fechaRaw === 'number') {
          fecha = new Date(fechaRaw);
        }
        else {
          console.warn('Formato de fecha no reconocido:', fechaRaw);
          return 'Formato inválido';
        }
        
        // Verificar si la fecha es válida
        if (isNaN(fecha.getTime())) {
          console.warn('Fecha inválida después de conversión:', fechaRaw);
          return 'Fecha inválida';
        }
        
        return fecha;
      } catch (error) {
        console.error('Error procesando fecha:', error, 'Fecha original:', fechaRaw);
        return 'Error en fecha';
      }
    }
    
    // Formatear fechas de eventos (fecha completa)
    document.querySelectorAll('.fecha-evento-detalle').forEach(function(elemento) {
      const fechaRaw = elemento.getAttribute('data-fecha');
      console.log('📅 Procesando fecha de evento:', fechaRaw);
      
      const fechaFormateada = formatearFechaSegura(fechaRaw);
      
      if (fechaFormateada instanceof Date) {
        elemento.textContent = fechaFormateada.toLocaleDateString('es-EC', {
          day: '2-digit',
          month: '2-digit', 
          year: 'numeric'
        });
        elemento.classList.add('text-success');
      } else {
        elemento.textContent = fechaFormateada;
        elemento.classList.add('text-muted');
      }
    });
    
    // Formatear horas de eventos (solo hora)
    document.querySelectorAll('.hora-evento-detalle').forEach(function(elemento) {
      const fechaRaw = elemento.getAttribute('data-fecha');
      console.log('🕒 Procesando hora de evento:', fechaRaw);
      
      const fechaFormateada = formatearFechaSegura(fechaRaw);
      
      if (fechaFormateada instanceof Date) {
        elemento.textContent = fechaFormateada.toLocaleTimeString('es-EC', {
          hour: '2-digit',
          minute: '2-digit',
          hour12: false
        });
      } else {
        elemento.textContent = '-';
      }
    });
    
    console.log('✅ Formateo de fechas de eventos completado');
  });
</script>
{{else}}
