{{! Detalle de Documento - Matrizadores - VISTA MEJORADA CON INFORMACIÓN FINANCIERA }}
{{! layout: 'matrizador' }}
{{#if documento}}
<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <div>
      <i class="fas fa-file-alt me-2"></i> Detalle de Documento
    </div>
    <div>
      <a href="/matrizador/documentos" class="btn btn-sm btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i> Volver
      </a>
      
      <a href="/matrizador/documentos/editar/{{documento.id}}" class="btn btn-sm btn-primary ms-1">
        <i class="fas fa-edit me-1"></i> Editar
      </a>
      
      {{#if (eq documento.estado "en_proceso")}}
      <button type="button" class="btn btn-sm btn-success ms-1" onclick="marcarListo({{documento.id}})">
        <i class="fas fa-check me-1"></i> Marcar como listo
      </button>
      {{/if}}
      
      {{#if (eq documento.estado "listo_para_entrega")}}
      <a href="/matrizador/documentos/entrega/{{documento.id}}" class="btn btn-sm btn-info ms-1">
        <i class="fas fa-hand-holding me-1"></i> Entrega
      </a>
      {{/if}}
    </div>
  </div>
  <div class="card-body">
    {{!-- 🚨 AVISOS IMPORTANTES PARA NOTIFICACIONES GRUPALES --}}
    
    {{!-- CASO 1: Documento puede agruparse con otros --}}
    {{#if (and (eq documento.estado "en_proceso") informacionGrupal.puedeCrearGrupo)}}
    <div class="alert alert-warning border-start border-warning border-4 mb-4" role="alert">
      <div class="d-flex align-items-start">
        <i class="fas fa-exclamation-triangle text-warning me-3 mt-1"></i>
        <div>
          <h6 class="alert-heading mb-2">
            <strong>⚠️ ¡Atención! Documentos agrupables detectados</strong>
          </h6>
          <p class="mb-2">
            Se encontraron <strong>{{informacionGrupal.totalAgrupables}} documentos adicionales</strong> del mismo cliente 
            (<strong>{{documento.nombreCliente}}</strong>) que pueden agruparse para enviar una sola notificación.
          </p>
          <div class="d-flex flex-wrap gap-2 align-items-center">
            <small class="text-warning">
              <i class="fas fa-lightbulb me-1"></i>
              <strong>Recomendación:</strong> Considere agrupar antes de marcar como listo para optimizar las notificaciones al cliente.
            </small>
            <a href="#seccion-notificaciones-grupales" class="btn btn-sm btn-outline-warning">
              <i class="fas fa-arrow-down me-1"></i> Ver documentos disponibles
            </a>
          </div>
        </div>
      </div>
    </div>
    {{/if}}
    
    {{!-- CASO 2: Documento YA está en un grupo --}}
    {{#if (and (eq documento.estado "en_proceso") informacionGrupal.grupo)}}
    <div class="alert alert-info border-start border-info border-4 mb-4" role="alert">
      <div class="d-flex align-items-start">
        <i class="fas fa-layer-group text-info me-3 mt-1"></i>
        <div>
          <h6 class="alert-heading mb-2">
            <strong>📱 Documento agrupado para notificación</strong>
          </h6>
          <p class="mb-2">
            Este documento está agrupado con <strong>{{informacionGrupal.totalDocumentosGrupo}} documentos</strong> del mismo cliente 
            (<strong>{{documento.nombreCliente}}</strong>) para notificación consolidada.
          </p>
          <div class="d-flex flex-wrap gap-2 align-items-center">
            <small class="text-info">
              <i class="fas fa-info-circle me-1"></i>
              <strong>Al marcar como listo:</strong> Puede elegir procesar solo este documento o todo el grupo.
            </small>
            <a href="#seccion-notificaciones-grupales" class="btn btn-sm btn-outline-info">
              <i class="fas fa-arrow-down me-1"></i> Ver grupo completo
            </a>
          </div>
        </div>
      </div>
    </div>
    {{/if}}
    <!-- Información general -->
    <div class="row mb-4">
      <div class="col-md-4">
        <div class="mb-3">
          <h5 class="border-bottom pb-2">Información General</h5>
          <p><strong>Código:</strong> <span class="badge bg-primary">{{documento.codigoBarras}}</span></p>
          <p><strong>Tipo:</strong> {{documento.tipoDocumento}}</p>
          
          <!-- Contenedor para badges de autorización -->
          <div class="badges-autorizacion mb-2" data-documento-id="{{documento.id}}">
            <!-- Los badges se cargan dinámicamente via JavaScript -->
          </div>
          <p><strong>Estado:</strong> 
            {{#if (eq documento.estado "en_proceso")}}
            <span class="badge bg-warning text-dark">En Proceso</span>
            {{else if (eq documento.estado "listo_para_entrega")}}
            <span class="badge bg-info">Listo para Entrega</span>
            {{else if (eq documento.estado "entregado")}}
            <span class="badge bg-success">Entregado</span>
            {{else if (eq documento.estado "nota_credito")}}
            <span class="badge bg-secondary">Nota de Crédito</span>
            {{else if (eq documento.estado "eliminado")}}
            <span class="badge bg-danger">Eliminado</span>
            {{else}}
            <span class="badge bg-secondary">{{translateEstado documento.estado}}</span>
            {{/if}}
          </p>
          <p><strong>📅 Fecha Registro:</strong> {{formatDate documento.created_at}}</p>
          {{#if documento.fechaFactura}}
          <p><strong>📄 Fecha Documento:</strong> {{formatDateDocument documento.fechaFactura}}</p>
          {{/if}}
          {{#if documento.fechaEntrega}}
          <p><strong>🚀 Fecha Entrega:</strong> {{formatDate documento.fechaEntrega}}</p>
          {{/if}}
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="mb-3">
          <h5 class="border-bottom pb-2">Cliente</h5>
          <p><strong>Nombre:</strong> {{documento.nombreCliente}}</p>
          <p><strong>Identificación:</strong> {{documento.identificacionCliente}}</p>
          {{#if documento.emailCliente}}
          <p><strong>Email:</strong> {{documento.emailCliente}}</p>
          {{/if}}
          {{#if documento.telefonoCliente}}
          <p><strong>Teléfono:</strong> {{documento.telefonoCliente}}</p>
          {{/if}}
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="mb-3">
          <h5 class="border-bottom pb-2">Mi Responsabilidad</h5>
          <p><strong>Estado del Proceso:</strong> 
            {{#if (eq documento.estado "en_proceso")}}
            <span class="badge bg-warning text-dark fs-6">⚠️ En mi bandeja de trabajo</span>
            {{else if (eq documento.estado "listo_para_entrega")}}
            <span class="badge bg-success fs-6">✅ Listo para entrega</span>
            {{else if (eq documento.estado "entregado")}}
            <span class="badge bg-info fs-6">📦 Entregado al cliente</span>
            {{else}}
            <span class="badge bg-secondary fs-6">{{translateEstado documento.estado}}</span>
            {{/if}}
          </p>
          {{#if (eq documento.estado "listo_para_entrega")}}
            {{#if documento.codigoVerificacion}}
            <p><strong>🔑 Código de Entrega:</strong> 
              <span class="badge bg-success fs-4">{{documento.codigoVerificacion}}</span>
            </p>
            <p class="small text-muted">Proporcione este código al cliente para confirmar la entrega</p>
            {{else}}
            <div class="alert alert-warning py-2">
              <small><i class="fas fa-exclamation-triangle me-1"></i>Documento listo pero sin código de verificación (entrega inmediata o notificación omitida)</small>
            </div>
            {{/if}}
          {{else if (eq documento.estado "en_proceso")}}
          <div class="alert alert-info py-2">
            <small><i class="fas fa-info-circle me-1"></i>El código de entrega se generará cuando marque el documento como listo</small>
          </div>
          {{/if}}
        </div>
      </div>
    </div>
    
    <!-- Información de facturación y pagos -->
    <div class="row mb-4">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-money-bill-wave me-2"></i>Información Financiera</h5>
          </div>
          <div class="card-body">
            <div class="row">
              <div class="col-md-6">
                <div class="card border-primary">
                  <div class="card-header bg-primary text-white py-2">
                    <h6 class="mb-0"><i class="fas fa-file-invoice me-1"></i>Facturación</h6>
                  </div>
                  <div class="card-body">
                    <div class="row">
                      <div class="col-12 mb-2">
                        <strong>📄 N° Factura:</strong> 
                        <span class="badge bg-secondary">{{#if documento.numeroFactura}}{{documento.numeroFactura}}{{else}}No registrado{{/if}}</span>
                      </div>
                      <div class="col-12 mb-2">
                        <strong>💰 Valor Total:</strong> 
                        <span class="fs-5 text-primary">${{#if documento.valorFactura}}{{formatMoney documento.valorFactura}}{{else}}0.00{{/if}}</span>
                      </div>
                      {{#if documento.fechaFactura}}
                      <div class="col-12">
                        <strong>📅 Fecha Factura:</strong> {{formatDateDocument documento.fechaFactura}}
                      </div>
                      {{/if}}
                    </div>
                  </div>
                </div>
              </div>
              
              <div class="col-md-6">
                <div class="card border-{{#if (eq documento.estadoPago "pagado_completo")}}success{{else if (eq documento.estadoPago "pagado_con_retencion")}}info{{else if (eq documento.estadoPago "pago_parcial")}}warning{{else}}danger{{/if}}">
                  <div class="card-header bg-{{#if (eq documento.estadoPago "pagado_completo")}}success{{else if (eq documento.estadoPago "pagado_con_retencion")}}info{{else if (eq documento.estadoPago "pago_parcial")}}warning{{else}}danger{{/if}} text-white py-2">
                    <h6 class="mb-0"><i class="fas fa-credit-card me-1"></i>Estado de Pago</h6>
                  </div>
                  <div class="card-body">
                    <div class="row">
                      <div class="col-12 mb-2">
                        <strong>🏷️ Estado:</strong> 
                        {{#if (eq documento.estadoPago "pagado_completo")}}
                        <span class="badge bg-success fs-6">✅ Pagado Completo</span>
                        {{else if (eq documento.estadoPago "pagado_con_retencion")}}
                        <span class="badge bg-info fs-6">🧾 Pagado con Retención</span>
                        {{else if (eq documento.estadoPago "pago_parcial")}}
                        <span class="badge bg-warning text-dark fs-6">⚠️ Pago Parcial</span>
                        {{else}}
                        <span class="badge bg-danger fs-6">❌ Pendiente</span>
                        {{/if}}
                      </div>
                      <div class="col-12 mb-2">
                        <strong>💳 Método:</strong> 
                        <span class="badge bg-secondary">{{#if documento.metodoPago}}{{documento.metodoPago}}{{else}}No registrado{{/if}}</span>
                      </div>
                      {{#if (or (eq documento.estadoPago "pagado_completo") (eq documento.estadoPago "pagado_con_retencion") (eq documento.estadoPago "pago_parcial"))}}
                      <div class="col-12">
                        <strong>📅 Último Pago:</strong> 
                        <span class="badge bg-success-subtle text-success-emphasis px-2 py-1">
                          {{#if documento.fechaUltimoPago}}
                          {{formatDateTime documento.fechaUltimoPago}}
                          {{else if documento.fechaPago}}
                          {{formatDateTime documento.fechaPago}}
                          {{else}}
                          No registrada
                          {{/if}}
                        </span>
                      </div>
                      {{/if}}
                    </div>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- Desglose financiero para matrizadores -->
            {{#if (neq documento.estadoPago "pendiente")}}
            <div class="row mt-3">
              <div class="col-12">
                <div class="card border-info">
                  <div class="card-header bg-info text-white py-2">
                    <h6 class="mb-0"><i class="fas fa-calculator me-1"></i>Desglose Financiero</h6>
                  </div>
                  <div class="card-body">
                    <div class="row text-center">
                      <div class="col-md-3">
                        <div class="border-end">
                          <div class="text-muted small">VALOR TOTAL</div>
                          <div class="fs-4 text-primary">${{#if documento.valorFactura}}{{formatMoney documento.valorFactura}}{{else}}0.00{{/if}}</div>
                        </div>
                      </div>
                      <div class="col-md-3">
                        <div class="border-end">
                          <div class="text-muted small">PAGADO</div>
                          <div class="fs-4 text-success">${{#if documento.valorPagado}}{{formatMoney documento.valorPagado}}{{else}}0.00{{/if}}</div>
                        </div>
                      </div>
                      <div class="col-md-3">
                        <div class="{{#if documento.tieneRetencion}}border-end{{/if}}">
                          <div class="text-muted small">PENDIENTE</div>
                          <div class="fs-4 text-danger">${{#if documento.valorPendiente}}{{formatMoney documento.valorPendiente}}{{else}}0.00{{/if}}</div>
                        </div>
                      </div>
                      {{#if documento.tieneRetencion}}
                      <div class="col-md-3">
                        <div class="text-muted small">RETENCIÓN</div>
                        <div class="fs-4 text-warning">${{#if documento.valorRetenido}}{{formatMoney documento.valorRetenido}}{{else}}0.00{{/if}}</div>
                        {{#if documento.numeroComprobanteRetencion}}
                        <div class="small text-muted">Comp: {{documento.numeroComprobanteRetencion}}</div>
                        {{/if}}
                      </div>
                      {{/if}}
                    </div>
                  </div>
                </div>
              </div>
            </div>
            {{/if}}
          </div>
        </div>
      </div>
    </div>
    
    <!-- Notas -->
    {{#if documento.notas}}
    <div class="row mb-4">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h5 class="mb-0">Notas</h5>
          </div>
          <div class="card-body">
            <p>{{documento.notas}}</p>
          </div>
        </div>
      </div>
    </div>
    {{/if}}
    
    <!-- Comparecientes -->
    {{#if documento.comparecientes.length}}
    <div class="row mb-4">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h5 class="mb-0">Comparecientes</h5>
          </div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Nombre</th>
                    <th>Identificación</th>
                    <th>Rol</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each documento.comparecientes}}
                  <tr>
                    <td>{{this.nombre}}</td>
                    <td>{{this.identificacion}}</td>
                    <td>{{this.rol}}</td>
                  </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
    {{/if}}
    
    <!-- ============== NUEVA SECCIÓN: NOTIFICACIONES GRUPALES ============== -->
    {{#if informacionGrupal}}
    <div class="row mb-4" id="seccion-notificaciones-grupales" 
         data-grupo-id="{{#if informacionGrupal.grupo}}{{informacionGrupal.grupo.id}}{{else}}null{{/if}}"
         data-es-lider="{{informacionGrupal.esLiderDelGrupo}}"
         data-puede-modificar="{{informacionGrupal.puedeModificarGrupo}}">
      <div class="col-12">
        <div class="card border-info">
          <div class="card-header bg-info text-white">
            <h5 class="mb-0">
              <i class="fas fa-bell me-2"></i>Notificación Grupal
              {{#if informacionGrupal.grupo}}
              <span class="badge bg-light text-dark ms-2">Grupo activo</span>
              {{else}}
              <span class="badge bg-warning text-dark ms-2">Disponible</span>
              {{/if}}
            </h5>
          </div>
          <div class="card-body">
            {{#if informacionGrupal.grupo}}
            <!-- DOCUMENTO YA ESTÁ EN GRUPO -->
            <div class="alert alert-info mb-3">
              <div class="d-flex justify-content-between align-items-center">
                <div>
                  <i class="fas fa-info-circle me-2"></i>
                  <strong>Este documento está agrupado para notificación</strong>
                  <br>
                  <small>
                    {{#if informacionGrupal.esLiderDelGrupo}}
                    Rol: <span class="badge bg-primary">Líder del grupo</span>
                    {{else}}
                    Rol: <span class="badge bg-secondary">Miembro del grupo</span>
                    {{/if}}
                    | Código de verificación único: <span class="badge bg-success">{{informacionGrupal.grupo.codigoVerificacion}}</span>
                  </small>
                </div>
                {{#if informacionGrupal.puedeModificarGrupo}}
                <button class="btn btn-warning btn-sm" onclick="separarDeGrupo({{documento.id}})">
                  <i class="fas fa-unlink me-1"></i> Separar del grupo
                </button>
                {{else}}
                <button class="btn btn-outline-warning btn-sm" onclick="separarDeGrupo({{documento.id}})" title="Separar mi documento del grupo (función de matrizador)">
                  <i class="fas fa-user-times me-1"></i> Separar mi documento
                </button>
                {{/if}}
              </div>
            </div>
            
            {{#if informacionGrupal.documentosDelGrupo.length}}
            <h6 class="border-bottom pb-2">Documentos en el mismo grupo ({{informacionGrupal.documentosDelGrupo.length}})</h6>
            <div class="table-responsive">
              <table class="table table-sm table-hover">
                <thead>
                  <tr>
                    <th>Código</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th>Rol</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each informacionGrupal.documentosDelGrupo}}
                  <tr>
                    <td>
                      <a href="/matrizador/documentos/detalle/{{this.id}}" class="text-decoration-none">
                        {{this.codigoBarras}}
                      </a>
                    </td>
                    <td>{{this.tipoDocumento}}</td>
                    <td>
                      {{#if (eq this.estado "en_proceso")}}
                      <span class="badge bg-warning text-dark">En Proceso</span>
                      {{else if (eq this.estado "listo_para_entrega")}}
                      <span class="badge bg-success">Listo</span>
                      {{else}}
                      <span class="badge bg-secondary">{{this.estado}}</span>
                      {{/if}}
                    </td>
                    <td>
                      {{#if this.esLiderGrupo}}
                      <span class="badge bg-primary">Líder</span>
                      {{else}}
                      <span class="badge bg-secondary">Miembro</span>
                      {{/if}}
                    </td>
                  </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
            {{/if}}
            
            <div class="alert alert-warning mt-3">
              <small>
                <i class="fas fa-lightbulb me-1"></i>
                <strong>Notificación consolidada:</strong> Al marcar cualquier documento del grupo como listo, 
                se enviará UNA SOLA notificación WhatsApp con todos los documentos del grupo.
              </small>
            </div>
            
            {{else}}
            <!-- DOCUMENTO NO ESTÁ EN GRUPO - MOSTRAR OPCIÓN PARA AGRUPAR -->
            {{#if informacionGrupal.puedeCrearGrupo}}
            <div class="alert alert-success mb-3">
              <div class="d-flex align-items-start">
                <i class="fas fa-layer-group me-3 mt-1"></i>
                <div class="flex-grow-1">
                  <strong>¡Notificación grupal disponible!</strong>
                  <br>
                  <small>Se encontraron {{informacionGrupal.totalAgrupables}} documentos adicionales del mismo cliente</small>
                  <div class="mt-2">
                    <small class="text-success">
                      <i class="fas fa-hand-point-down me-1"></i>
                      <strong>Instrucción:</strong> Selecciona los documentos de abajo usando los checkboxes y luego presiona "Agrupar documentos"
                    </small>
                  </div>
                </div>
              </div>
              {{!-- 💡 AVISO INFORMATIVO SIMILAR AL CÓDIGO DE ENTREGA --}}
              <div class="mt-2 pt-2 border-top border-success-subtle">
                <small class="text-success d-flex align-items-start">
                  <i class="fas fa-lightbulb me-2 mt-1 opacity-75" style="font-size: 0.8rem;"></i>
                  <span>
                    <strong>Código grupal:</strong> Se generará automáticamente cuando agrupe los documentos. 
                    El cliente recibirá una sola notificación WhatsApp válida para todos los documentos seleccionados.
                  </span>
                </small>
              </div>
            </div>
            
            <h6 class="border-bottom pb-2">Documentos disponibles para agrupar ({{informacionGrupal.totalAgrupables}})</h6>
            <div class="table-responsive">
              <table class="table table-sm table-hover">
                <thead>
                  <tr>
                    <th width="50">
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="selectAllDocs" onchange="toggleSelectAll(this.checked)">
                        <label class="form-check-label" for="selectAllDocs">
                          <small>Todos</small>
                        </label>
                      </div>
                    </th>
                    <th>Código</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th>Fecha</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each informacionGrupal.documentosAgrupables}}
                  <tr>
                    <td>
                      <div class="form-check">
                        <input class="form-check-input doc-checkbox" type="checkbox" 
                               id="doc_{{this.id}}" value="{{this.id}}" 
                               data-codigo="{{this.codigoBarras}}" 
                               data-tipo="{{this.tipoDocumento}}"
                               onchange="updateGroupButton()">
                      </div>
                    </td>
                    <td>
                      <label class="form-check-label" for="doc_{{this.id}}">
                        <a href="/matrizador/documentos/detalle/{{this.id}}" class="text-decoration-none">
                          {{this.codigoBarras}}
                        </a>
                      </label>
                    </td>
                    <td>{{this.tipoDocumento}}</td>
                    <td>
                      <span class="badge bg-warning text-dark">En Proceso</span>
                    </td>
                    <td>{{formatDate this.created_at}}</td>
                  </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
            
            <!-- Botón de agrupación mejorado -->
            <div class="mt-3 d-flex justify-content-between align-items-center">
              <div class="text-muted">
                <small>
                  <i class="fas fa-check-square me-1"></i>
                  <strong>Paso 1:</strong> Marca los checkboxes de los documentos que quieres agrupar
                </small>
              </div>
              <button class="btn btn-success btn-lg" id="btnAgruparSeleccionados" onclick="procesarAgrupacion()" disabled>
                <i class="fas fa-layer-group me-1"></i> 
                <strong>Crear grupo de <span id="contadorSeleccionados">0</span> documentos</strong>
              </button>
            </div>
            
            <div class="alert alert-info mt-3">
              <small>
                <i class="fas fa-info-circle me-1"></i>
                <strong>Ventaja de agrupar:</strong> El cliente recibirá una sola notificación WhatsApp 
                con todos sus documentos y un código de verificación único para retirar todo junto.
              </small>
            </div>
            
            {{else}}
            <div class="alert alert-secondary">
              <i class="fas fa-info-circle me-2"></i>
              <strong>Sin documentos agrupables</strong>
              <br>
