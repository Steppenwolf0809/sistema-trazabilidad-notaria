<script>
// Función para marcar documento como listo (matrizador)
function marcarListo(documentoId) {
  if (confirm('¿Estás seguro de marcar este documento como listo para entrega?')) {
    fetch(`/matrizador/documentos/${documentoId}/marcar-listo`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        location.reload();
      } else {
        alert('Error: ' + data.message);
      }
    })
    .catch(error => {
      console.error('Error:', error);
      alert('Error al procesar la solicitud');
    });
  }
}

// Función para registrar pago (caja)
function registrarPago() {
  const form = document.getElementById('formRegistrarPago');
  const formData = new FormData(form);
  
  fetch(`/caja/documentos/{{documento.id}}/registrar-pago`, {
    method: 'POST',
    body: formData
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      location.reload();
    } else {
      alert('Error: ' + data.message);
    }
  })
  .catch(error => {
    console.error('Error:', error);
    alert('Error al registrar el pago');
  });
}

// Función para cambiar matrizador (caja)
function cambiarMatrizador(documentoId, nuevoMatrizadorId) {
  fetch(`/caja/documentos/${documentoId}/cambiar-matrizador`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({
      nuevoMatrizadorId: nuevoMatrizadorId
    })
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      location.reload();
    } else {
      alert('Error: ' + data.message);
    }
  })
  .catch(error => {
    console.error('Error:', error);
    alert('Error al cambiar el matrizador');
  });
}
</script>

