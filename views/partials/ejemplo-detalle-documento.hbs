async verDetalleDocumento(req, res) {
  try {
    const { id } = req.params;
    const ComponentesController = require('./componentesController');
    
    // Verificar que el documento esté asignado al matrizador
    const documento = await Documento.findOne({
      where: { 
        id: id,
        matrizador_id: req.user.id 
      }
    });
    
    if (!documento) {
      return res.status(404).render('error', { 
        mensaje: 'Documento no encontrado o no asignado' 
      });
    }
    
    // Obtener datos del detalle usando el componente universal
    const datosDetalle = await ComponentesController.obtenerDetalleDocumento('matrizador', id);
    
    res.render('matrizador/documentos/detalle', {
      ...datosDetalle,
      titulo: 'Mi Documento Asignado'
    });
  } catch (error) {
    console.error('Error:', error);
    res.status(500).render('error', { 
      mensaje: 'Error interno del servidor' 
    });
  }
}
--}}

