async verDetalleDocumento(req, res) {
  try {
    const { id } = req.params;
    const ComponentesController = require('./componentesController');
    
    // Obtener datos del detalle usando el componente universal
    const datosDetalle = await ComponentesController.obtenerDetalleDocumento('caja', id);
    
    if (datosDetalle.error) {
      return res.status(404).render('error', { 
        mensaje: datosDetalle.error 
      });
    }
    
    // Obtener datos adicionales específicos de caja
    const matrizadores = await Usuario.findAll({
      where: { rol: 'matrizador', activo: true },
      attributes: ['id', 'nombre', 'email']
    });
    
    res.render('caja/documentos/detalle', {
      ...datosDetalle,
      matrizadores,
      titulo: 'Control de Pagos - Documento'
    });
  } catch (error) {
    console.error('Error:', error);
    res.status(500).render('error', { 
      mensaje: 'Error interno del servidor' 
    });
  }
}
