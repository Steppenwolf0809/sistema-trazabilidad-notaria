async verDetalleDocumento(req, res) {
  try {
    const { id } = req.params;
    const ComponentesController = require('./componentesController');
    
    // Obtener datos del detalle usando el componente universal
    const datosDetalle = await ComponentesController.obtenerDetalleDocumento('admin', id);
    
    if (datosDetalle.error) {
      return res.status(404).render('error', { 
        mensaje: datosDetalle.error 
      });
    }
    
    res.render('admin/documentos/detalle', {
      ...datosDetalle,
      titulo: 'Supervisión de Documento'
    });
  } catch (error) {
    console.error('Error:', error);
    res.status(500).render('error', { 
      mensaje: 'Error interno del servidor' 
    });
  }
}
--}}

