</div>

{{!-- 
  DATOS DE EJEMPLO PARA CONTROLADORES
  
  En el controlador, usar ComponentesController así:
  
  const ComponentesController = require('./componentesController');
  
  // Obtener datos para dashboard admin
  const metricas = await ComponentesController.obtenerMetricasSegunRol('admin', { 
    fechaInicio: '2025-01-01', 
    fechaFin: '2025-01-31' 
  });
  
  const alertas = await ComponentesController.obtenerAlertasSegunRol('admin');
  
  const datosTabla = await ComponentesController.obtenerDocumentosParaTabla('admin', {
    fechaInicio: '2025-01-01',
    fechaFin: '2025-01-31'
  }, 1, 10);
  
  const coloresEstado = ComponentesController.obtenerColoresEstado();
  
  // Renderizar vista
  res.render('admin/dashboard', {
    metricas,
    alertas,
    datosTabla,
    coloresEstado,
    rol: 'admin'
  });
--}}

