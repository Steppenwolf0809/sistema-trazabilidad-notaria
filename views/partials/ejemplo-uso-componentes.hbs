{{!-- 
  EJEMPLO DE USO DE COMPONENTES UNIVERSALES
  Sistema Notarial - Demostración de cómo usar los componentes
  
  ESTE ARCHIVO ES SOLO PARA REFERENCIA Y DOCUMENTACIÓN
  No se usa en producción, es para mostrar cómo implementar los componentes
--}}

{{!-- EJEMPLO 1: Dashboard Admin usando todos los componentes --}}
<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <h1 class="h3 mb-4 text-gray-800">Dashboard Administrativo</h1>
    </div>
  </div>

  {{!-- 1. CARDS DE MÉTRICAS --}}
  {{> metric-cards 
      metricas=metricas 
      rol="admin" 
      periodo="Enero 2025"
  }}

  {{!-- 2. SISTEMA DE ALERTAS --}}
  {{> sistema-alertas 
      alertas=alertas 
      rol="admin" 
      mostrarHeader=true
  }}

  {{!-- 3. TABLA DE DOCUMENTOS --}}
  {{> tabla-documentos-universal 
      datosTabla=datosTabla 
      rol="admin" 
      coloresEstado=coloresEstado
  }}
</div>

{{!-- EJEMPLO 2: Dashboard Caja simplificado --}}
<div class="container-fluid">
  {{!-- Solo métricas y alertas compactas --}}
  {{> metric-cards 
      metricas=metricasCaja 
      rol="caja"
  }}

  {{> sistema-alertas 
      alertas=alertasCaja 
      rol="caja" 
      mostrarHeader=false
  }}

  {{> tabla-documentos-universal 
      datosTabla=documentosCaja 
      rol="caja" 
      coloresEstado=coloresEstado
  }}
</div>

{{!-- EJEMPLO 3: Dashboard Matrizador --}}
<div class="container-fluid">
  {{> metric-cards 
