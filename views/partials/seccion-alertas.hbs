{{! SECCIÓN ALERTAS - COMPONENTE UNIVERSAL }}
{{! Alertas importantes como notificaciones grupales y avisos críticos }}

{{#if config.mostrarAlertas}}
<!-- Alertas para notificaciones grupales -->
{{#if (and (eq documento.estado "en_proceso") informacionGrupal.puedeCrearGrupo)}}
<div class="alert alert-warning-professional mb-3">
  <div class="d-flex align-items-start">
    <i class="fas fa-exclamation-triangle me-3 mt-1"></i>
    <div>
      <h6 class="fw-bold mb-2">⚠️ Documentos agrupables detectados</h6>
      <p class="mb-2">Se encontraron <strong>{{informacionGrupal.totalAgrupables}} documentos adicionales</strong> del mismo cliente que pueden agruparse para enviar una sola notificación.</p>
      <a href="#seccion-notificaciones-grupales" class="btn btn-sm btn-warning-soft">
        <i class="fas fa-arrow-down me-1"></i> Ver documentos disponibles
      </a>
    </div>
  </div>
</div>
{{/if}}

{{#if (and (eq documento.estado "en_proceso") informacionGrupal.grupo)}}
<div class="alert alert-info-professional mb-3">
  <div class="d-flex align-items-start">
    <i class="fas fa-layer-group me-3 mt-1"></i>
    <div>
      <h6 class="fw-bold mb-2">📱 Documento agrupado para notificación</h6>
      <p class="mb-2">Este documento está agrupado con <strong>{{informacionGrupal.totalDocumentosGrupo}} documentos</strong> del mismo cliente para notificación consolidada.</p>
      <a href="#seccion-notificaciones-grupales" class="btn btn-sm btn-outline-primary">
        <i class="fas fa-arrow-down me-1"></i> Ver grupo completo
      </a>
    </div>
  </div>
</div>
{{/if}}

<!-- Alertas de estado crítico -->
{{#if (eq documento.estado "urgente")}}
<div class="alert alert-danger mb-3">
  <div class="d-flex align-items-start">
    <i class="fas fa-bolt me-3 mt-1"></i>
    <div>
      <h6 class="fw-bold mb-2">🚨 Documento marcado como URGENTE</h6>
      <p class="mb-0">Este documento requiere atención prioritaria y procesamiento inmediato.</p>
    </div>
  </div>
</div>
{{/if}}

<!-- Alertas de pago -->
{{#if (and config.mostrarAlertasPago (eq documento.estadoPago "pendiente"))}}
<div class="alert alert-warning mb-3">
  <div class="d-flex align-items-start">
    <i class="fas fa-credit-card me-3 mt-1"></i>
    <div>
      <h6 class="fw-bold mb-2">💳 Pago pendiente</h6>
      <p class="mb-0">Este documento tiene pagos pendientes que deben ser procesados antes de la entrega.</p>
      {{#if config.permisos.registrarPago}}
      <a href="/{{userRole}}/documentos/{{documento.id}}/pago" class="btn btn-sm btn-warning mt-2">
        <i class="fas fa-plus me-1"></i> Registrar Pago
      </a>
      {{/if}}
    </div>
  </div>
</div>
{{/if}}

<!-- Alertas de contacto -->
{{#if (and config.mostrarAlertasContacto (not documento.telefonoCliente))}}
<div class="alert alert-info mb-3">
  <div class="d-flex align-items-start">
    <i class="fas fa-phone me-3 mt-1"></i>
    <div>
      <h6 class="fw-bold mb-2">📞 Información de contacto incompleta</h6>
      <p class="mb-0">Este documento no tiene número de teléfono registrado. Las notificaciones automáticas no funcionarán.</p>
      {{#if config.permisos.editarCliente}}
      <button class="btn btn-sm btn-info mt-2" onclick="toggleSectionEdit('cliente')">
        <i class="fas fa-edit me-1"></i> Agregar Teléfono
      </button>
      {{/if}}
    </div>
  </div>
</div>
{{/if}}

{{/if}} 