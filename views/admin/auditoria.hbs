<!-- VISTA DE AUDITORÍA DE SEGURIDAD - DISEÑO PROFESIONAL UNIFICADO -->
<div class="min-h-screen bg-gray-50">
  <!-- Header Profesional -->
  <div class="bg-white border-b border-gray-200 mb-6">
    <div class="px-6 py-8">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-4xl font-bold text-gray-900 mb-2">
            <i class="fas fa-shield-alt text-indigo-600 mr-3"></i>
            Auditoría de Seguridad
          </h1>
          <p class="text-xl text-gray-600">
            Seguimiento completo de todas las acciones de seguridad del sistema
          </p>
        </div>
        <div class="flex items-center space-x-3">
          <span class="inline-flex items-center px-3 py-2 rounded-full text-sm font-medium bg-indigo-100 text-indigo-800">
            <i class="fas fa-database mr-2"></i>
            {{registros.length}} registros
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="px-6">
    <!-- Panel de Filtros Modernos -->
    <div class="bg-white rounded-xl shadow-md mb-6 overflow-hidden">
      <div class="bg-gradient-to-r from-indigo-600 to-blue-600 px-6 py-4">
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-semibold text-white flex items-center">
            <i class="fas fa-filter mr-2"></i>
            Filtros de Auditoría
          </h3>
          <button class="text-white hover:text-indigo-200 transition-colors" type="button" data-bs-toggle="collapse" data-bs-target="#filtrosCollapse">
            <i class="fas fa-chevron-down"></i>
          </button>
        </div>
      </div>
      
      <div class="collapse show" id="filtrosCollapse">
        <div class="p-6">
          <form id="filtroForm" method="GET" action="/admin/auditoria">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4 mb-4">
              <div>
                <label class="flex items-center text-sm font-medium text-gray-700 mb-2">
                  <i class="fas fa-calendar-day text-blue-500 mr-2"></i>
                  Fecha Inicio
                </label>
                <input type="date" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" 
                       id="fechaInicio" name="fechaInicio" value="{{filtros.fechaInicio}}">
              </div>
              
              <div>
                <label class="flex items-center text-sm font-medium text-gray-700 mb-2">
                  <i class="fas fa-calendar-check text-blue-500 mr-2"></i>
                  Fecha Fin
                </label>
                <input type="date" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" 
                       id="fechaFin" name="fechaFin" value="{{filtros.fechaFin}}">
              </div>
              
              <div>
                <label class="flex items-center text-sm font-medium text-gray-700 mb-2">
                  <i class="fas fa-cog text-green-500 mr-2"></i>
                  Tipo de Acción
                </label>
                <select class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" 
                        id="accion" name="accion">
                  <option value="">Todas las acciones</option>
                  {{#each tiposAccion}}
                    <option value="{{this.id}}" {{#if (eq ../filtros.accion this.id)}}selected{{/if}}>{{this.nombre}}</option>
                  {{/each}}
                </select>
              </div>
              
              <div>
                <label class="flex items-center text-sm font-medium text-gray-700 mb-2">
                  <i class="fas fa-check-circle text-yellow-500 mr-2"></i>
                  Resultado
                </label>
                <select class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" 
                        id="resultado" name="resultado">
                  <option value="">Todos los resultados</option>
                  <option value="exitoso" {{#if (eq filtros.resultado "exitoso")}}selected{{/if}}>Exitoso</option>
                  <option value="fallido" {{#if (eq filtros.resultado "fallido")}}selected{{/if}}>Fallido</option>
                </select>
              </div>
              
              <div>
                <label class="flex items-center text-sm font-medium text-gray-700 mb-2">
                  <i class="fas fa-user text-indigo-500 mr-2"></i>
                  Usuario
                </label>
                <select class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" 
                        id="idMatrizador" name="idMatrizador">
                  <option value="">Todos los usuarios</option>
                  {{#each matrizadores}}
                    <option value="{{this.id}}" {{#if (eq ../filtros.idMatrizador this.id)}}selected{{/if}}>{{this.nombre}}</option>
                  {{/each}}
                </select>
              </div>
            </div>
            
            <div class="flex items-center space-x-3">
              <button type="submit" class="inline-flex items-center px-6 py-2 bg-indigo-600 text-white font-medium rounded-lg hover:bg-indigo-700 transition-colors">
                <i class="fas fa-search mr-2"></i>
                Buscar
              </button>
              <a href="/admin/auditoria" class="inline-flex items-center px-6 py-2 bg-gray-100 text-gray-700 font-medium rounded-lg hover:bg-gray-200 transition-colors">
                <i class="fas fa-times mr-2"></i>
                Limpiar
              </a>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Tabla de Auditoría -->
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
      <div class="bg-gradient-to-r from-indigo-600 to-blue-600 px-6 py-4">
        <h3 class="text-lg font-semibold text-white flex items-center">
          <i class="fas fa-list mr-2"></i>
          Registros de Seguridad
        </h3>
      </div>
      
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
              <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                <i class="fas fa-clock text-blue-500 mr-1"></i>
                Fecha y Hora
              </th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                <i class="fas fa-user text-indigo-500 mr-1"></i>
                Usuario
              </th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                <i class="fas fa-cog text-green-500 mr-1"></i>
                Acción
              </th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                <i class="fas fa-file-alt text-blue-500 mr-1"></i>
                Documento
              </th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                <i class="fas fa-globe text-gray-500 mr-1"></i>
                IP
              </th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                <i class="fas fa-check-circle text-yellow-500 mr-1"></i>
                Resultado
              </th>
              <th class="px-6 py-4 text-center text-xs font-semibold text-gray-600 uppercase tracking-wider">
                <i class="fas fa-eye text-indigo-500 mr-1"></i>
                Detalles
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            {{#each registros}}
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm font-medium text-gray-900">{{formatDate this.created_at}}</div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  {{#if this.matrizador}}
                    <div class="flex items-center">
                      <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800 mr-2">
                        {{this.matrizador.rol}}
                      </span>
                      <span class="text-sm text-gray-900">{{this.matrizador.nombre}}</span>
                    </div>
                  {{else}}
                    <span class="text-sm text-gray-500 italic">Sistema</span>
                  {{/if}}
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  {{#switch this.accion}}
                    {{#case "consulta_codigo"}}
                      <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                        <i class="fas fa-search mr-1"></i>Consulta
                      </span>
                    {{/case}}
                    {{#case "verificacion_codigo"}}
                      <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                        <i class="fas fa-check mr-1"></i>Verificación
                      </span>
                    {{/case}}
                    {{#case "verificacion_llamada"}}
                      <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                        <i class="fas fa-phone mr-1"></i>Verificación Llamada
                      </span>
                    {{/case}}
                    {{#case "edicion_codigo"}}
                      <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">
                        <i class="fas fa-edit mr-1"></i>Edición Código
                      </span>
                    {{/case}}
                    {{#default}}
                      <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                        {{this.accion}}
                      </span>
                    {{/default}}
                  {{/switch}}
                </td>
                <td class="px-6 py-4">
                  {{#if this.documento}}
                    <a href="/admin/documentos/detalle/{{this.documento.id}}" class="text-blue-600 hover:text-blue-800 transition-colors">
                      <div class="text-sm font-medium">{{this.documento.codigo_barras}}</div>
                      <div class="text-xs text-gray-500">{{this.documento.nombre_cliente}}</div>
                    </a>
                  {{else}}
                    <span class="text-sm text-gray-400">N/A</span>
                  {{/if}}
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <code class="text-xs bg-gray-100 px-2 py-1 rounded">{{this.ip_origen}}</code>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  {{#if (eq this.resultado "exitoso")}}
                    <span class="inline-flex items-center text-sm text-green-600">
                      <i class="fas fa-check-circle mr-1"></i>Exitoso
                    </span>
                  {{else}}
                    <span class="inline-flex items-center text-sm text-red-600">
                      <i class="fas fa-times-circle mr-1"></i>Fallido
                    </span>
                  {{/if}}
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-center">
                  <button type="button" class="inline-flex items-center px-3 py-1 bg-indigo-100 text-indigo-700 rounded-lg hover:bg-indigo-200 transition-colors" 
                          data-bs-toggle="modal" data-bs-target="#detalleModal{{this.id}}">
                    <i class="fas fa-info-circle mr-1"></i>
                    Ver
                  </button>
                  
                  <!-- Modal de Detalles Mejorado -->
                  <div class="modal fade" id="detalleModal{{this.id}}" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-lg">
                      <div class="modal-content rounded-xl shadow-2xl">
                        <div class="modal-header bg-gradient-to-r from-indigo-600 to-blue-600 text-white">
                          <h5 class="modal-title flex items-center">
                            <i class="fas fa-info-circle mr-2"></i>
                            Detalles del Registro
                          </h5>
                          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body p-6">
                          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                              <h6 class="font-semibold text-gray-900 border-b border-gray-200 pb-2 mb-3">
                                <i class="fas fa-clock text-blue-500 mr-2"></i>
                                Información Temporal
                              </h6>
                              <div class="space-y-2">
                                <div class="flex justify-between">
                                  <strong class="text-gray-600">Fecha/Hora:</strong>
                                  <span class="text-indigo-600 font-medium">{{formatDate this.created_at}}</span>
                                </div>
                              </div>
                            </div>
                            
                            <div>
                              <h6 class="font-semibold text-gray-900 border-b border-gray-200 pb-2 mb-3">
                                <i class="fas fa-user text-indigo-500 mr-2"></i>
                                Usuario y Sesión
                              </h6>
                              <div class="space-y-2">
                                <div class="flex justify-between">
                                  <strong class="text-gray-600">Usuario:</strong>
                                  <span>{{this.matrizador.nombre}} ({{this.matrizador.rol}})</span>
                                </div>
                                <div class="flex justify-between">
                                  <strong class="text-gray-600">IP de Origen:</strong>
                                  <code class="bg-gray-100 px-2 py-1 rounded">{{this.ip_origen}}</code>
                                </div>
                              </div>
                            </div>
                            
                            <div class="md:col-span-2">
                              <h6 class="font-semibold text-gray-900 border-b border-gray-200 pb-2 mb-3">
                                <i class="fas fa-cog text-green-500 mr-2"></i>
                                Acción y Resultado
                              </h6>
                              <div class="grid grid-cols-2 gap-4">
                                <div class="flex justify-between">
                                  <strong class="text-gray-600">Acción:</strong>
                                  <span class="font-medium">{{this.accion}}</span>
                                </div>
                                <div class="flex justify-between">
                                  <strong class="text-gray-600">Resultado:</strong>
                                  <span class="{{#if (eq this.resultado 'exitoso')}}text-green-600{{else}}text-red-600{{/if}} font-medium">
                                    {{this.resultado}}
                                  </span>
                                </div>
                              </div>
                            </div>
                            
                            <div class="md:col-span-2">
                              <h6 class="font-semibold text-gray-900 border-b border-gray-200 pb-2 mb-3">
                                <i class="fas fa-globe text-gray-500 mr-2"></i>
                                Información Técnica
                              </h6>
                              <div class="bg-gray-50 rounded-lg p-3">
                                <strong class="text-gray-600">Navegador/Dispositivo:</strong>
                                <div class="text-sm text-gray-800 mt-1 font-mono">{{this.user_agent}}</div>
                              </div>
                            </div>
                            
                            {{#if this.detalles}}
                            <div class="md:col-span-2">
                              <h6 class="font-semibold text-gray-900 border-b border-gray-200 pb-2 mb-3">
                                <i class="fas fa-file-code text-indigo-500 mr-2"></i>
                                Detalles Adicionales
                              </h6>
                              <pre class="bg-gray-100 rounded-lg p-3 text-sm overflow-auto max-h-40">{{this.detalles}}</pre>
                            </div>
                            {{/if}}
                          </div>
                        </div>
                        <div class="modal-footer bg-gray-50">
                          <button type="button" class="px-4 py-2 bg-gray-500 text-white rounded-lg hover:bg-gray-600 transition-colors" data-bs-dismiss="modal">
                            Cerrar
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                </td>
              </tr>
            {{else}}
              <tr>
                <td colspan="7" class="px-6 py-12 text-center">
                  <div class="flex flex-col items-center">
                    <i class="fas fa-shield-alt text-gray-300 text-4xl mb-3"></i>
                    <h3 class="text-lg font-medium text-gray-900 mb-1">No hay registros de auditoría</h3>
                    <p class="text-gray-500">No se encontraron registros que coincidan con los criterios de búsqueda</p>
                  </div>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      
      <!-- Paginación Mejorada -->
      {{#if pagination.pages.length}}
        <div class="bg-gray-50 px-6 py-4 border-t border-gray-200">
          <nav class="flex justify-center">
            <ul class="inline-flex items-center space-x-1">
              {{#unless (eq pagination.currentPage 1)}}
                <li>
                  <a class="inline-flex items-center px-3 py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 rounded-l-lg hover:bg-gray-100 hover:text-gray-700 transition-colors" 
                     href="?page=1{{#if filtros.fechaInicio}}&fechaInicio={{filtros.fechaInicio}}{{/if}}{{#if filtros.fechaFin}}&fechaFin={{filtros.fechaFin}}{{/if}}{{#if filtros.accion}}&accion={{filtros.accion}}{{/if}}{{#if filtros.resultado}}&resultado={{filtros.resultado}}{{/if}}{{#if filtros.idMatrizador}}&idMatrizador={{filtros.idMatrizador}}{{/if}}">
                    <i class="fas fa-angle-double-left"></i>
                  </a>
                </li>
              {{/unless}}
              
              {{#each pagination.pages}}
                <li>
                  <a class="inline-flex items-center px-3 py-2 text-sm font-medium {{#if this.active}}text-white bg-indigo-600 border border-indigo-600{{else}}text-gray-500 bg-white border border-gray-300 hover:bg-gray-100 hover:text-gray-700{{/if}} transition-colors" 
                     href="?page={{this.num}}{{#if ../filtros.fechaInicio}}&fechaInicio={{../filtros.fechaInicio}}{{/if}}{{#if ../filtros.fechaFin}}&fechaFin={{../filtros.fechaFin}}{{/if}}{{#if ../filtros.accion}}&accion={{../filtros.accion}}{{/if}}{{#if ../filtros.resultado}}&resultado={{../filtros.resultado}}{{/if}}{{#if ../filtros.idMatrizador}}&idMatrizador={{../filtros.idMatrizador}}{{/if}}">
                    {{this.num}}
                  </a>
                </li>
              {{/each}}
              
              {{#unless (eq pagination.currentPage pagination.totalPages)}}
                <li>
                  <a class="inline-flex items-center px-3 py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 rounded-r-lg hover:bg-gray-100 hover:text-gray-700 transition-colors" 
                     href="?page={{pagination.totalPages}}{{#if filtros.fechaInicio}}&fechaInicio={{filtros.fechaInicio}}{{/if}}{{#if filtros.fechaFin}}&fechaFin={{filtros.fechaFin}}{{/if}}{{#if filtros.accion}}&accion={{filtros.accion}}{{/if}}{{#if filtros.resultado}}&resultado={{filtros.resultado}}{{/if}}{{#if filtros.idMatrizador}}&idMatrizador={{filtros.idMatrizador}}{{/if}}">
                    <i class="fas fa-angle-double-right"></i>
                  </a>
                </li>
              {{/unless}}
            </ul>
          </nav>
        </div>
      {{/if}}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Mostrar automáticamente el panel de filtros si hay algún filtro aplicado
    const tienesFiltros = "{{filtros.fechaInicio}}" || "{{filtros.fechaFin}}" || 
                          "{{filtros.accion}}" || "{{filtros.resultado}}" || 
                          "{{filtros.idMatrizador}}";
    
    console.log('Filtros aplicados:', tienesFiltros);
  });
</script> 