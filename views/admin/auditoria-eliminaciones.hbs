<!-- AUDITORÍA DE ELIMINACIONES - DISEÑO PROFESIONAL ELEGANTE -->
<div class="min-h-screen bg-gray-50">
  <!-- Header Profesional -->
  <div class="bg-white border-b border-gray-200 mb-6">
    <div class="px-6 py-8">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-4xl font-bold text-gray-900 mb-2">
            <i class="fas fa-trash-alt text-slate-600 mr-3"></i>
            Auditoría de Eliminaciones
          </h1>
          <p class="text-xl text-gray-600">
            Registro completo de documentos eliminados del sistema
          </p>
        </div>
        <div class="flex items-center space-x-3">
          <button class="inline-flex items-center px-4 py-2 bg-slate-100 text-slate-700 font-medium rounded-lg hover:bg-slate-200 transition-colors" 
                  onclick="exportarAuditoria()">
            <i class="fas fa-download mr-2"></i>
            Exportar
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="px-6">
    <!-- Panel de Filtros Modernos -->
    <div class="bg-white rounded-xl shadow-md mb-6 overflow-hidden border border-slate-200">
      <div class="bg-slate-100 px-6 py-4 border-b border-slate-200">
        <h3 class="text-lg font-semibold text-slate-700 flex items-center">
          <i class="fas fa-filter mr-2"></i>
          Filtros de Búsqueda
        </h3>
      </div>
      
      <div class="p-6">
        <form id="formFiltros" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          <div>
            <label class="flex items-center text-sm font-medium text-slate-700 mb-2">
              <i class="fas fa-exclamation-triangle text-slate-600 mr-2"></i>
              Motivo
            </label>
            <select class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" 
                    id="filtroMotivo" name="motivo">
              <option value="">Todos los motivos</option>
              <option value="documento_duplicado">Documento duplicado</option>
              <option value="error_critico">Error crítico</option>
              <option value="nota_credito">Nota de crédito</option>
              <option value="cancelacion_cliente">Cancelación cliente</option>
              <option value="otro">Otro</option>
            </select>
          </div>
          
          <div>
            <label class="flex items-center text-sm font-medium text-slate-700 mb-2">
              <i class="fas fa-calendar-day text-blue-500 mr-2"></i>
              Fecha Inicio
            </label>
            <input type="date" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" 
                   id="filtroFechaInicio" name="fechaInicio">
          </div>
          
          <div>
            <label class="flex items-center text-sm font-medium text-slate-700 mb-2">
              <i class="fas fa-calendar-check text-blue-500 mr-2"></i>
              Fecha Fin
            </label>
            <input type="date" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" 
                   id="filtroFechaFin" name="fechaFin">
          </div>
          
          <div>
            <label class="flex items-center text-sm font-medium text-slate-700 mb-2">
              <i class="fas fa-user-shield text-indigo-500 mr-2"></i>
              Administrador
            </label>
            <input type="text" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" 
                   id="filtroAdmin" name="administrador" placeholder="Buscar por administrador...">
          </div>
          
          <div class="lg:col-span-4">
            <div class="flex items-center space-x-3">
              <button type="submit" class="inline-flex items-center px-6 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors">
                <i class="fas fa-search mr-2"></i>
                Buscar
              </button>
              <button type="button" class="inline-flex items-center px-6 py-2 bg-slate-100 text-slate-700 font-medium rounded-lg hover:bg-slate-200 transition-colors" 
                      onclick="limpiarFiltros()">
                <i class="fas fa-times mr-2"></i>
                Limpiar
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>

    <!-- Estadísticas Principales -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-6">
      <div class="bg-slate-50 rounded-xl shadow-md overflow-hidden transform hover:scale-105 transition-transform duration-200 border border-slate-200">
        <div class="px-6 py-4">
          <div class="flex items-center">
            <div class="p-3 rounded-full bg-slate-100 mr-4">
              <i class="fas fa-trash-alt text-slate-600 text-xl"></i>
            </div>
            <div>
              <p class="text-slate-600 text-sm font-medium">Total Eliminados</p>
              <p class="text-slate-800 text-2xl font-bold" id="totalEliminados">-</p>
            </div>
          </div>
        </div>
      </div>
      
      <div class="bg-amber-50 rounded-xl shadow-md overflow-hidden transform hover:scale-105 transition-transform duration-200 border border-amber-200">
        <div class="px-6 py-4">
          <div class="flex items-center">
            <div class="p-3 rounded-full bg-amber-100 mr-4">
              <i class="fas fa-dollar-sign text-amber-600 text-xl"></i>
            </div>
            <div>
              <p class="text-amber-700 text-sm font-medium">Valor Impacto</p>
              <p class="text-amber-800 text-2xl font-bold" id="valorImpacto">$-</p>
            </div>
          </div>
        </div>
      </div>
      
      <div class="bg-blue-50 rounded-xl shadow-md overflow-hidden transform hover:scale-105 transition-transform duration-200 border border-blue-200">
        <div class="px-6 py-4">
          <div class="flex items-center">
            <div class="p-3 rounded-full bg-blue-100 mr-4">
              <i class="fas fa-calendar text-blue-600 text-xl"></i>
            </div>
            <div>
              <p class="text-blue-700 text-sm font-medium">Hoy</p>
              <p class="text-blue-800 text-2xl font-bold" id="eliminacionesHoy">-</p>
            </div>
          </div>
        </div>
      </div>
      
      <div class="bg-indigo-50 rounded-xl shadow-md overflow-hidden transform hover:scale-105 transition-transform duration-200 border border-indigo-200">
        <div class="px-6 py-4">
          <div class="flex items-center">
            <div class="p-3 rounded-full bg-indigo-100 mr-4">
              <i class="fas fa-chart-pie text-indigo-600 text-xl"></i>
            </div>
            <div>
              <p class="text-indigo-700 text-sm font-medium">Motivo Principal</p>
              <p class="text-indigo-800 text-lg font-bold" id="motivoPrincipal">-</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tabla de Eliminaciones -->
    <div class="bg-white rounded-xl shadow-md overflow-hidden border border-slate-200">
      <div class="bg-slate-100 px-6 py-4 border-b border-slate-200">
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-semibold text-slate-700 flex items-center">
            <i class="fas fa-list mr-2"></i>
            Registro de Eliminaciones
          </h3>
          <div class="flex items-center space-x-2">
            <label class="text-slate-700 text-sm font-medium">Mostrar:</label>
            <select class="px-3 py-1 border border-slate-300 bg-white text-slate-700 rounded-lg text-sm focus:ring-2 focus:ring-blue-500" id="limitePagina">
              <option value="20">20</option>
              <option value="50">50</option>
              <option value="100">100</option>
            </select>
          </div>
        </div>
      </div>
      
      <!-- Loader Mejorado -->
      <div id="loader" class="text-center py-12">
        <div class="flex flex-col items-center">
          <div class="animate-spin rounded-full h-12 w-12 border-4 border-slate-300 border-t-transparent mb-4"></div>
          <h5 class="text-lg font-medium text-gray-900 mb-2">Cargando registros...</h5>
          <p class="text-gray-500">Obteniendo datos de eliminaciones</p>
        </div>
      </div>

      <!-- Contenedor de Tabla -->
      <div id="tablaContainer" style="display: none;">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-slate-50 border-b border-slate-200">
              <tr>
                <th class="px-6 py-4 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">
                  <i class="fas fa-clock text-blue-500 mr-1"></i>
                  Fecha/Hora
                </th>
                <th class="px-6 py-4 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">
                  <i class="fas fa-barcode text-slate-500 mr-1"></i>
                  Código
                </th>
                <th class="px-6 py-4 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">
                  <i class="fas fa-file-alt text-blue-500 mr-1"></i>
                  Tipo
                </th>
                <th class="px-6 py-4 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">
                  <i class="fas fa-user text-indigo-500 mr-1"></i>
                  Cliente
                </th>
                <th class="px-6 py-4 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">
                  <i class="fas fa-exclamation-triangle text-slate-500 mr-1"></i>
                  Motivo
                </th>
                <th class="px-6 py-4 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">
                  <i class="fas fa-dollar-sign text-amber-500 mr-1"></i>
                  Impacto
                </th>
                <th class="px-6 py-4 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">
                  <i class="fas fa-user-shield text-indigo-500 mr-1"></i>
                  Admin
                </th>
                <th class="px-6 py-4 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">
                  <i class="fas fa-credit-card text-green-500 mr-1"></i>
                  Pago
                </th>
                <th class="px-6 py-4 text-center text-xs font-semibold text-slate-600 uppercase tracking-wider">
                  <i class="fas fa-eye text-blue-500 mr-1"></i>
                  Ver
                </th>
              </tr>
            </thead>
            <tbody id="tablaEliminaciones" class="bg-white divide-y divide-slate-200">
              <!-- Contenido dinámico -->
            </tbody>
          </table>
        </div>

        <!-- Paginación Mejorada -->
        <div class="bg-slate-50 px-6 py-4 border-t border-slate-200">
          <nav class="flex justify-center">
            <ul class="inline-flex items-center space-x-1" id="paginacion">
              <!-- Contenido dinámico -->
            </ul>
          </nav>
        </div>

        <!-- Mensaje sin resultados -->
        <div id="sinResultados" class="text-center py-12" style="display: none;">
          <div class="flex flex-col items-center">
            <i class="fas fa-inbox text-slate-300 text-4xl mb-3"></i>
            <h3 class="text-lg font-medium text-gray-900 mb-1">No se encontraron eliminaciones</h3>
            <p class="text-gray-500">No hay registros que coincidan con los filtros aplicados</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal Mejorado para Detalles -->
<div class="modal fade" id="modalDetalleEliminacion" tabindex="-1" aria-labelledby="modalDetalleEliminacionLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl">
    <div class="modal-content rounded-xl shadow-2xl">
      <div class="modal-header bg-slate-50 text-slate-700 border-b border-slate-200">
        <h5 class="modal-title text-lg font-semibold flex items-center" id="modalDetalleEliminacionLabel">
          <i class="fas fa-info-circle mr-2"></i>
          Detalles de Eliminación
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-6 bg-white">
        <div id="detalleEliminacion">
          <!-- Contenido dinámico -->
        </div>
      </div>
      <div class="modal-footer bg-slate-50 border-t border-slate-200">
        <button type="button" class="px-4 py-2 bg-slate-500 text-white rounded-lg hover:bg-slate-600 transition-colors" data-bs-dismiss="modal">
          Cerrar
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Estilos personalizados mejorados -->
