{{!-- JavaScript incluido en el layout --}}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    let graficoActual = null;
    let filtroActual = '{{filtroActual}}';
    
    document.addEventListener('DOMContentLoaded', function() {
        console.log('🎯 Inicializando dashboard ejecutivo con datos reales...');
        
        const datosGrafico = {{{json grafico.datos}}};
        if (datosGrafico && datosGrafico.labels && datosGrafico.labels.length > 0) {
            inicializarGrafico(datosGrafico);
        }
        
        // Inicializar sistema de pestañas elegante
        inicializarPestanas();
    });
    
    // Sistema de pestañas elegante
    function inicializarPestanas() {
        const tabBtns = document.querySelectorAll('.tab-btn');
        const tabContents = document.querySelectorAll('.tab-content');
        
        tabBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                const targetTab = btn.getAttribute('data-tab');
                
                // Remover clase active de todos los botones y contenidos
                tabBtns.forEach(b => b.classList.remove('active'));
                tabContents.forEach(c => c.classList.remove('active'));
                
                // Agregar clase active al botón clickeado y su contenido
                btn.classList.add('active');
                document.getElementById(`tab-${targetTab}`).classList.add('active');
                
                console.log('📑 Pestaña cambiada a:', targetTab);
            });
        });
    }
    
    function inicializarGrafico(datos) {
        const ctx = document.getElementById('chart-line');
        if (!ctx) return;
        
        if (graficoActual) {
            graficoActual.destroy();
        }
        
        graficoActual = new Chart(ctx, {
            type: 'line',
            data: datos,
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true,
                        position: 'top'
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return '$' + value.toLocaleString();
                            }
                        }
                    }
                },
                interaction: {
                    intersect: false,
                    mode: 'index'
                }
            }
        });
    }
    
    function aplicarFiltro(filtro) {
        console.log('📅 Aplicando filtro:', filtro);
        filtroActual = filtro;
        
        if (filtro !== 'personalizado') {
            const popover = document.getElementById('popoverPersonalizado');
            if (popover) popover.style.display = 'none';
        }
        
        window.location.href = `/admin?filtro=${filtro}`;
    }
    
    // === POPOVER ULTRA ELEGANTE === //
    function togglePopoverPersonalizado() {
        const popover = document.getElementById('popoverPersonalizado');
        const isVisible = popover.style.display === 'block';
        
        if (isVisible) {
            popover.style.display = 'none';
        } else {
            popover.style.display = 'block';
            filtroActual = 'personalizado';
            // Enfocar el primer campo
            setTimeout(() => {
                document.getElementById('fechaInicio').focus();
            }, 100);
        }
    }
    
    // Cerrar popover al hacer clic fuera
    document.addEventListener('click', function(event) {
        const popover = document.getElementById('popoverPersonalizado');
        const wrapper = document.querySelector('.filtro-personalizado-wrapper');
        
        if (popover && wrapper && !wrapper.contains(event.target)) {
            popover.style.display = 'none';
        }
    });
    
    function aplicarFiltroPersonalizado() {
        const fechaInicio = document.getElementById('fechaInicio').value;
        const fechaFin = document.getElementById('fechaFin').value;
        
        if (!fechaInicio || !fechaFin) {
            alert('Por favor selecciona ambas fechas');
            return;
        }
        
        if (new Date(fechaInicio) > new Date(fechaFin)) {
            alert('La fecha de inicio no puede ser mayor a la fecha fin');
            return;
        }
        
        window.location.href = `/admin?filtro=personalizado&fechaInicio=${fechaInicio}&fechaFin=${fechaFin}`;
    }
    
    function cancelarFiltroPersonalizado() {
        document.getElementById('popoverPersonalizado').style.display = 'none';
        
        if (filtroActual !== 'personalizado') {
            aplicarFiltro(filtroActual);
        }
    }
    
    function iraDocumentosAtrasados() {
        window.location.href = '/admin/documentos?filtro=atrasados';
    }
    
    function irAPagosVencidos() {
        window.location.href = '/admin/pagos?filtro=vencidos';
    }
    
    function iraOportunidadesCobro() {
        window.location.href = '/admin/documentos?filtro=listos_cobrar';
    }
    
    function cambiarPeriodo(periodo) {
        aplicarFiltro(periodo);
    }
</script> 
</script> 