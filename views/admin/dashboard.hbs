{{!-- Dashboard Admin Moderno - Interfaz Enterprise Profesional --}}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    
    {{!-- Fuentes Profesionales --}}
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Nunito:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    {{!-- CSS Moderno --}}
    <style>
        /* RESET Y BASE */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #f8fafc;
            color: #1f2937;
            line-height: 1.5;
        }
        
        /* CONTENEDOR PRINCIPAL */
        .dashboard-container {
            padding: 2rem;
            max-width: 1400px;
            margin: 0 auto;
        }
        
        /* HEADER PROFESIONAL */
        .dashboard-header {
            background: white;
            padding: 2rem;
            border-radius: 16px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            margin-bottom: 2rem;
            border: 1px solid #e5e7eb;
        }
        
        .dashboard-title {
            font-size: 2.5rem;
            font-weight: 800;
            color: #1f2937;
            margin-bottom: 0.5rem;
            font-family: 'Nunito', sans-serif;
        }
        
        .dashboard-subtitle {
            color: #6b7280;
            font-size: 1.125rem;
            margin-bottom: 2rem;
            font-weight: 500;
        }
        
        /* FILTROS SEGMENTADOS MODERNOS */
        .filtros-segmentados {
            display: flex;
            gap: 0;
            background: #f3f4f6;
            padding: 4px;
            border-radius: 12px;
            border: 1px solid #e5e7eb;
            margin-bottom: 2rem;
            width: fit-content;
        }
        
        .filtro-btn {
            padding: 0.75rem 1.5rem;
            border: none;
            background: transparent;
            color: #6b7280;
            font-weight: 600;
            font-size: 0.875rem;
            letter-spacing: 0.025em;
            cursor: pointer;
            transition: all 0.2s ease;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            text-transform: uppercase;
        }
        
        .filtro-btn:hover {
            color: #374151;
            background: rgba(59, 130, 246, 0.05);
        }
        
        .filtro-btn.activo {
            background: #2563eb;
            color: white;
            box-shadow: 0 4px 14px 0 rgba(37, 99, 235, 0.39);
        }
        
        .filtro-personalizado {
            position: relative;
            display: inline-block;
        }
        
        .panel-personalizado {
            position: absolute;
            top: 100%;
            left: 0;
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 1.5rem;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            z-index: 50;
            min-width: 320px;
            margin-top: 0.5rem;
            display: none;
        }
        
        .panel-personalizado.show {
            display: block;
        }
        
        /* GRID TARJETAS PROFESIONALES */
        .tarjetas-kpi {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }
        
        /* TARJETAS KPI MODERNAS */
        .tarjeta-kpi {
            background: white;
            border-radius: 16px;
            padding: 2rem;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            border: 1px solid #f3f4f6;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }
        
        .tarjeta-kpi:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }
        
        .kpi-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }
        
        .kpi-icono {
            width: 60px;
            height: 60px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: white;
            position: relative;
        }
        
        .kpi-icono::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 16px;
            background: inherit;
            opacity: 0.2;
        }
        
        .kpi-icono i {
            position: relative;
            z-index: 1;
        }
        
        /* COLORES TEMÁTICOS PROFESIONALES */
        .kpi-icono.verde { background: linear-gradient(135deg, #059669, #10b981); }
        .kpi-icono.azul { background: linear-gradient(135deg, #2563eb, #3b82f6); }
        .kpi-icono.naranja { background: linear-gradient(135deg, #ea580c, #f97316); }
        .kpi-icono.purpura { background: linear-gradient(135deg, #7c3aed, #8b5cf6); }
        
        .kpi-info {
            flex: 1;
        }
        
        .kpi-etiqueta {
            font-size: 0.875rem;
            font-weight: 600;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.5rem;
        }
        
        .kpi-numero {
            font-size: 3rem;
            font-weight: 800;
            color: #1f2937;
            line-height: 1;
            margin-bottom: 0.5rem;
            font-family: 'Nunito', sans-serif;
        }
        
        .kpi-descripcion {
            font-size: 0.875rem;
            color: #6b7280;
            font-weight: 500;
        }
        
        .kpi-cambio {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-top: 1rem;
            padding: 0.5rem 1rem;
            background: #f3f4f6;
            border-radius: 8px;
            font-size: 0.875rem;
            font-weight: 600;
        }
        
        .kpi-cambio.positivo {
            background: #dcfce7;
            color: #166534;
        }
        
        .kpi-cambio.negativo {
            background: #fee2e2;
            color: #dc2626;
        }
        
        /* FORMULARIOS MODERNOS */
        .form-grupo {
            margin-bottom: 1rem;
        }
        
        .form-label {
            display: block;
            font-size: 0.875rem;
            font-weight: 600;
            color: #374151;
            margin-bottom: 0.5rem;
        }
        
        .form-input {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            font-size: 0.875rem;
            transition: all 0.2s ease;
            background: white;
        }
        
        .form-input:focus {
            outline: none;
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }
        
        /* BOTONES MODERNOS */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.875rem;
            cursor: pointer;
            transition: all 0.2s ease;
            text-decoration: none;
        }
        
        .btn-primary {
            background: #2563eb;
            color: white;
        }
        
        .btn-primary:hover {
            background: #1d4ed8;
            transform: translateY(-1px);
            color: white;
            text-decoration: none;
        }
        
        .btn-secondary {
            background: white;
            color: #374151;
            border: 1px solid #d1d5db;
        }
        
        .btn-secondary:hover {
            background: #f9fafb;
            border-color: #9ca3af;
            color: #374151;
            text-decoration: none;
        }
        
        /* SECCIÓN DE CONTENIDO */
        .contenido-principal {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 2rem;
            margin-bottom: 2rem;
        }
        
        .tarjeta-contenido {
            background: white;
            border-radius: 16px;
            padding: 2rem;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            border: 1px solid #f3f4f6;
        }
        
        .seccion-titulo {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1f2937;
            margin-bottom: 1.5rem;
            font-family: 'Nunito', sans-serif;
        }
        
        /* TABLA MODERNA */
        .tabla-moderna {
            width: 100%;
            border-collapse: collapse;
        }
        
        .tabla-moderna th {
            background: #f8fafc;
            padding: 1rem;
            text-align: left;
            font-weight: 600;
            font-size: 0.875rem;
            color: #374151;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border-bottom: 1px solid #e5e7eb;
        }
        
        .tabla-moderna td {
            padding: 1rem;
            border-bottom: 1px solid #f3f4f6;
            font-size: 0.875rem;
        }
        
        .tabla-moderna tr:hover {
            background: #f8fafc;
        }
        
        /* BADGES MODERNOS */
        .badge {
            display: inline-flex;
            align-items: center;
            padding: 0.25rem 0.75rem;
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        
        .badge-success {
            background: #dcfce7;
            color: #166534;
        }
        
        .badge-warning {
            background: #fef3c7;
            color: #92400e;
        }
        
        .badge-danger {
            background: #fee2e2;
            color: #dc2626;
        }
        
        .badge-info {
            background: #dbeafe;
            color: #1e40af;
        }
        
        /* RESPONSIVE */
        @media (max-width: 768px) {
            .dashboard-container {
                padding: 1rem;
            }
            
            .tarjetas-kpi {
                grid-template-columns: 1fr;
                gap: 1rem;
            }
            
            .contenido-principal {
                grid-template-columns: 1fr;
                gap: 1rem;
            }
            
            .filtros-segmentados {
                flex-wrap: wrap;
                gap: 0.5rem;
                background: transparent;
                padding: 0;
                border: none;
            }
            
            .filtro-btn {
                border: 1px solid #d1d5db;
                border-radius: 8px;
                background: white;
            }
            
            .kpi-numero {
                font-size: 2rem;
            }
            
            .dashboard-title {
                font-size: 2rem;
            }
        }
        
        /* UTILIDADES */
        .text-center { text-align: center; }
        .hidden { display: none; }
        .flex { display: flex; }
        .items-center { align-items: center; }
        .justify-between { justify-content: space-between; }
        .gap-4 { gap: 1rem; }
        .mt-4 { margin-top: 1rem; }
        .mb-4 { margin-bottom: 1rem; }
        .p-4 { padding: 1rem; }
        .font-bold { font-weight: 700; }
        .text-sm { font-size: 0.875rem; }
        .text-lg { font-size: 1.125rem; }
        .text-xl { font-size: 1.25rem; }
        .text-2xl { font-size: 1.5rem; }
        .text-3xl { font-size: 1.875rem; }
        .text-4xl { font-size: 2.25rem; }
        .text-5xl { font-size: 3rem; }
    </style>
</head>
<body>
    <div class="dashboard-container">
        <!-- HEADER PROFESIONAL -->
        <div class="dashboard-header">
            <h1 class="dashboard-title">Panel de Control Ejecutivo</h1>
            <p class="dashboard-subtitle">Sistema de Notaría Digital - Vista Administrativa</p>
            
            <!-- FILTROS SEGMENTADOS MODERNOS -->
            <div class="filtros-segmentados">
                <button class="filtro-btn {{#if periodo.esHoy}}activo{{/if}}" onclick="aplicarFiltro('hoy')">
                    <i class="fas fa-calendar-day"></i>
                    Hoy
                </button>
                <button class="filtro-btn {{#if periodo.esSemana}}activo{{/if}}" onclick="aplicarFiltro('semana')">
                    <i class="fas fa-calendar-week"></i>
                    Semana
                </button>
                <button class="filtro-btn {{#if periodo.esMes}}activo{{/if}}" onclick="aplicarFiltro('mes')">
                    <i class="fas fa-calendar-alt"></i>
                    Mes
                </button>
                <button class="filtro-btn {{#if periodo.esAño}}activo{{/if}}" onclick="aplicarFiltro('año')">
                    <i class="fas fa-calendar"></i>
                    Año
                </button>
                <div class="filtro-personalizado">
                    <button class="filtro-btn {{#if periodo.esPersonalizado}}activo{{/if}}" onclick="togglePersonalizado()">
                        <i class="fas fa-calendar-alt ml-1"></i>
                        Personalizado
                    </button>
                    <div class="panel-personalizado" id="panelPersonalizado">
                        <div class="form-grupo">
                            <label class="form-label">Fecha Inicio:</label>
                            <input type="date" class="form-input" id="fechaInicio" value="{{periodo.fechaInicio}}">
                        </div>
                        <div class="form-grupo">
                            <label class="form-label">Fecha Fin:</label>
                            <input type="date" class="form-input" id="fechaFin" value="{{periodo.fechaFin}}">
                        </div>
                        <div class="flex gap-4 mt-4">
                            <button class="btn btn-primary" onclick="aplicarFiltroPersonalizado()">
                                <i class="fas fa-check"></i>
                                Aplicar
                            </button>
                            <button class="btn btn-secondary" onclick="cancelarPersonalizado()">
                                <i class="fas fa-times"></i>
                                Cancelar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- INDICADOR DE PERÍODO ACTIVO -->
            <div class="periodo-activo" style="margin-top: 1rem;">
                <div style="background: #dbeafe; color: #1e40af; padding: 0.75rem 1.25rem; border-radius: 8px; font-weight: 600; font-size: 0.875rem; display: inline-block;">
                    <i class="fas fa-info-circle mr-2"></i>
                    Datos de: {{periodo.periodoTexto}}
                </div>
            </div>
        </div>
        
        <!-- TARJETAS KPI PROFESIONALES -->
        <div class="tarjetas-kpi">
            <!-- KPI 1: INGRESOS -->
            <div class="tarjeta-kpi">
                <div class="kpi-header">
                    <div class="kpi-icono verde">
                        <i class="fas fa-dollar-sign"></i>
                    </div>
                    <div class="kpi-info">
                        <div class="kpi-etiqueta">Ingresos Totales</div>
                        <div class="kpi-numero">${{finanzas.ingresosPeriodo}}</div>
                        <div class="kpi-descripcion">{{periodo.periodoTexto}}</div>
                    </div>
                </div>
                <div class="kpi-cambio positivo">
                    <i class="fas fa-arrow-up"></i>
                    +12% vs período anterior
                </div>
            </div>
            
            <!-- KPI 2: DOCUMENTOS -->
            <div class="tarjeta-kpi">
                <div class="kpi-header">
                    <div class="kpi-icono azul">
                        <i class="fas fa-file-signature"></i>
                    </div>
                    <div class="kpi-info">
                        <div class="kpi-etiqueta">Documentos Procesados</div>
                        <div class="kpi-numero">{{metricas.totalDocumentos}}</div>
                        <div class="kpi-descripcion">{{#if (eq metricas.totalDocumentos 1)}}documento{{else}}documentos{{/if}} en {{periodo.periodoTexto}}</div>
                    </div>
                </div>
                <div class="kpi-cambio positivo">
                    <i class="fas fa-arrow-up"></i>
                    +8% vs período anterior
                </div>
            </div>
            
            <!-- KPI 3: PAGOS PENDIENTES -->
            <div class="tarjeta-kpi">
                <div class="kpi-header">
                    <div class="kpi-icono naranja">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="kpi-info">
                        <div class="kpi-etiqueta">Pagos Pendientes</div>
                        <div class="kpi-numero">${{finanzas.montoPendiente}}</div>
                        <div class="kpi-descripcion">{{metricas.documentosPendientes}} {{#if (eq metricas.documentosPendientes 1)}}documento{{else}}documentos{{/if}}</div>
                    </div>
                </div>
                <div class="kpi-cambio negativo">
                    <i class="fas fa-arrow-down"></i>
                    -5% vs período anterior
                </div>
            </div>
            
            <!-- KPI 4: EFICIENCIA -->
            <div class="tarjeta-kpi">
                <div class="kpi-header">
                    <div class="kpi-icono purpura">
                        <i class="fas fa-chart-bar"></i>
                    </div>
                    <div class="kpi-info">
                        <div class="kpi-etiqueta">Eficiencia</div>
                        <div class="kpi-numero">{{#if metricas.totalDocumentos}}{{math metricas.entregados metricas.totalDocumentos}}%{{else}}0%{{/if}}</div>
                        <div class="kpi-descripcion">{{#if (eq metricas.entregados 1)}}Documento entregado{{else}}Documentos entregados{{/if}}</div>
                    </div>
                </div>
                <div class="kpi-cambio positivo">
                    <i class="fas fa-arrow-up"></i>
                    +3% vs período anterior
                </div>
            </div>
        </div>
        
        <!-- CONTENIDO PRINCIPAL -->
        <div class="contenido-principal">
            <!-- DOCUMENTOS RECIENTES -->
            <div class="tarjeta-contenido">
                <h3 class="seccion-titulo">Documentos Recientes</h3>
                <div style="overflow-x: auto;">
                    <table class="tabla-moderna">
                        <thead>
                            <tr>
                                <th style="font-weight: 600; color: #374151;">Código</th>
                                <th style="font-weight: 600; color: #374151;">Cliente</th>
                                <th style="font-weight: 600; color: #374151;">Estado</th>
                                <th style="font-weight: 600; color: #374151; text-align: right;">Valor</th>
                                <th style="font-weight: 600; color: #374151;">Fecha</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each documentosRecientes}}
                            <tr style="transition: background-color 0.2s ease;" onmouseover="this.style.backgroundColor='#f8fafc'" onmouseout="this.style.backgroundColor='white'">
                                <td class="font-bold">{{this.codigo}}</td>
                                <td>{{this.cliente}}</td>
                                <td>
                                    {{#if (eq this.estado "entregado")}}
                                        <span class="badge badge-success">Entregado</span>
                                    {{else if (eq this.estado "listo_para_entrega")}}
                                        <span class="badge badge-info">Listo</span>
                                    {{else if (eq this.estado "en_proceso")}}
                                        <span class="badge badge-warning">En Proceso</span>
                                    {{else}}
                                        <span class="badge badge-danger">{{this.estado}}</span>
                                    {{/if}}
                                </td>
                                <td class="font-bold" style="text-align: right;">${{this.valorFormateado}}</td>
                                <td>{{formatDate this.fechaCreacion}}</td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>
            
            <!-- ACCIONES RÁPIDAS -->
            <div class="tarjeta-contenido">
                <h3 class="seccion-titulo">Acciones Rápidas</h3>
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    <a href="/admin/documentos" class="btn btn-primary">
                        <i class="fas fa-list-alt"></i>
                        Ver Todos los Documentos
                    </a>
                    <a href="/admin/reportes" class="btn btn-secondary">
                        <i class="fas fa-chart-pie"></i>
                        Generar Reportes
                    </a>
                    <a href="/admin/matrizadores" class="btn btn-secondary">
                        <i class="fas fa-users"></i>
                        Gestionar Matrizadores
                    </a>
                    <a href="/admin/auditoria" class="btn btn-secondary">
                        <i class="fas fa-shield-alt"></i>
                        Auditoría del Sistema
                    </a>
                </div>
                
                {{#if alertasCriticas}}
                <div style="margin-top: 2rem;">
                    <h4 style="font-size: 1.125rem; font-weight: 600; color: #dc2626; margin-bottom: 1rem;">
                        <i class="fas fa-exclamation-triangle"></i>
                        Alertas Críticas
                    </h4>
                    {{#each alertasCriticas}}
                    <div style="background: #fee2e2; border: 1px solid #fecaca; border-radius: 8px; padding: 1rem; margin-bottom: 0.5rem;">
                        <div style="font-weight: 600; color: #dc2626;">{{this.titulo}}</div>
                        <div style="color: #991b1b; font-size: 0.875rem;">{{this.descripcion}}</div>
                    </div>
                    {{/each}}
                </div>
                {{/if}}
            </div>
        </div>
    </div>
    
    <!-- SCRIPTS -->
    <script>
        // Funciones de filtro
        function aplicarFiltro(tipo) {
            window.location.href = `/admin?rango=${tipo}`;
        }
        
        function togglePersonalizado() {
            const panel = document.getElementById('panelPersonalizado');
            panel.classList.toggle('show');
        }
        
        function aplicarFiltroPersonalizado() {
            const fechaInicio = document.getElementById('fechaInicio').value;
            const fechaFin = document.getElementById('fechaFin').value;
            
            if (fechaInicio && fechaFin) {
                window.location.href = `/admin?rango=personalizado&fechaInicio=${fechaInicio}&fechaFin=${fechaFin}`;
            }
        }
        
        function cancelarPersonalizado() {
            document.getElementById('panelPersonalizado').classList.remove('show');
        }
        
        // Cerrar panel personalizado al hacer clic fuera
        document.addEventListener('click', function(e) {
            const panel = document.getElementById('panelPersonalizado');
            const filtroPersonalizado = document.querySelector('.filtro-personalizado');
            
            if (!filtroPersonalizado.contains(e.target)) {
                panel.classList.remove('show');
            }
        });
        
        // ============== FUNCIONES DE FILTROS ==============
        
        function aplicarFiltro(periodo) {
            // Agregar indicador de carga
            mostrarCargando(true);
            
            // Recargar página con el filtro seleccionado
            window.location.href = `/admin?rango=${periodo}`;
        }
        
        function mostrarCargando(mostrar) {
            const filtros = document.querySelectorAll('.filtro-btn');
            filtros.forEach(btn => {
                if (mostrar) {
                    btn.style.opacity = '0.7';
                    btn.style.pointerEvents = 'none';
                } else {
                    btn.style.opacity = '1';
                    btn.style.pointerEvents = 'auto';
                }
            });
        }
        
        // Helper para formatear fechas
        function formatDate(dateString) {
            if (!dateString) return '';
            const date = new Date(dateString);
            return date.toLocaleDateString('es-EC', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric'
            });
        }
    </script>
    
    <!-- Font Awesome -->
