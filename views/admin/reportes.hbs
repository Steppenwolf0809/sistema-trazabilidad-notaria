        </div>
        <div class="estadistica-item">
          <span class="estadistica-valor">$2,180</span>
          <span class="estadistica-etiqueta">Pendiente</span>
        </div>
        <div class="estadistica-item">
          <span class="estadistica-valor">82%</span>
          <span class="estadistica-etiqueta">Cobros</span>
        </div>
      </div>
    </a>

    <a href="/admin/reportes/pendientes" class="reporte-card">
      <div class="reporte-header">
        <div class="reporte-icon icon-operacional">
          <i class="fas fa-clock"></i>
        </div>
        <div class="reporte-info">
          <h3>Documentos Pendientes</h3>
