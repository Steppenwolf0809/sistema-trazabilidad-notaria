  {{else}}
  <!-- Vista de Reporte Individual -->
  <div class="reporte-contenido">
    <h3>
      <i class="fas fa-chart-bar"></i>
      {{tituloReporte}}
    </h3>
    
    {{!-- Aquí se renderiza el partial correspondiente al tipo de reporte --}}
    {{> (concat "admin/reportes/partials/" tipoReporte)}}
  </div>
  {{/unless}}
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  console.log('🎯 Sistema de reportes inicializado');
  
  // Configurar fechas por defecto para el período personalizado
  const hoy = new Date();
  const fechaDesde = document.getElementById('fechaDesde');
  const fechaHasta = document.getElementById('fechaHasta');
  
  if (fechaDesde && !fechaDesde.value) {
    const primerDiaMes = new Date(hoy.getFullYear(), hoy.getMonth(), 1);
    fechaDesde.value = primerDiaMes.toISOString().split('T')[0];
  }
  
  if (fechaHasta && !fechaHasta.value) {
    fechaHasta.value = hoy.toISOString().split('T')[0];
  }
});

function togglePanelFechas() {
  const panel = document.getElementById('panelFechas');
  const botones = document.querySelectorAll('.boton-filtro');
  
  // Remover clase activo de todos los botones
  botones.forEach(btn => btn.classList.remove('activo'));
  
  // Toggle del panel
  if (panel.classList.contains('activo')) {
    panel.classList.remove('activo');
  } else {
    panel.classList.add('activo');
    // Marcar botón personalizado como activo
    event.target.classList.add('activo');
  }
}
</script> 