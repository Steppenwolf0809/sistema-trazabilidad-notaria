{{!-- Dashboard Admin Elegante - Estilo Argon Dashboard --}}

<!-- Cards de métricas principales -->
<div class="flex flex-wrap -mx-3 mb-6">
  
  <!-- Card 1: Total Documentos -->
  <div class="w-full max-w-full px-3 mb-6 sm:w-1/2 sm:flex-none xl:mb-0 xl:w-1/4">
    <div class="relative flex flex-col min-w-0 break-words bg-white shadow-xl rounded-2xl bg-clip-border hover-lift">
      <div class="flex-auto p-4">
        <div class="flex flex-row -mx-3">
          <div class="flex-none w-2/3 max-w-full px-3">
            <div>
              <p class="mb-0 font-sans text-sm font-semibold leading-normal uppercase text-slate-500">Total Documentos</p>
              <h5 class="mb-2 font-bold text-slate-700">{{metricas.totalDocumentos}}</h5>
              <p class="mb-0 text-slate-500">
                {{#if metricas.cambioDocumentos}}
                <span class="text-sm font-bold leading-normal {{#if (gt metricas.cambioDocumentos 0)}}text-emerald-500{{else}}text-red-500{{/if}}">
                  {{#if (gt metricas.cambioDocumentos 0)}}+{{/if}}{{metricas.cambioDocumentos}}%
                </span>
                vs período anterior
                {{/if}}
              </p>
            </div>
          </div>
          <div class="px-3 text-right basis-1/3">
            <div class="inline-block w-12 h-12 text-center rounded-lg bg-gradient-to-tl from-blue-500 to-violet-500">
              <i class="fas fa-file-alt text-lg relative top-3.5 text-white"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Card 2: Total Facturado -->
  <div class="w-full max-w-full px-3 mb-6 sm:w-1/2 sm:flex-none xl:mb-0 xl:w-1/4">
    <div class="relative flex flex-col min-w-0 break-words bg-white shadow-xl rounded-2xl bg-clip-border hover-lift">
      <div class="flex-auto p-4">
        <div class="flex flex-row -mx-3">
          <div class="flex-none w-2/3 max-w-full px-3">
            <div>
              <p class="mb-0 font-sans text-sm font-semibold leading-normal uppercase text-slate-500">Total Facturado</p>
              <h5 class="mb-2 font-bold text-slate-700">${{finanzas.totalFacturado}}</h5>
              <p class="mb-0 text-slate-500">
                {{#if finanzas.cambioFacturado}}
                <span class="text-sm font-bold leading-normal {{#if (gt finanzas.cambioFacturado 0)}}text-emerald-500{{else}}text-red-500{{/if}}">
                  {{#if (gt finanzas.cambioFacturado 0)}}+{{/if}}{{finanzas.cambioFacturado}}%
                </span>
                vs período anterior
                {{/if}}
              </p>
            </div>
          </div>
          <div class="px-3 text-right basis-1/3">
            <div class="inline-block w-12 h-12 text-center rounded-lg bg-gradient-to-tl from-emerald-500 to-teal-400">
              <i class="fas fa-dollar-sign text-lg relative top-3.5 text-white"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Card 3: Pagos Pendientes -->
  <div class="w-full max-w-full px-3 mb-6 sm:w-1/2 sm:flex-none xl:mb-0 xl:w-1/4">
    <div class="relative flex flex-col min-w-0 break-words bg-white shadow-xl rounded-2xl bg-clip-border hover-lift">
      <div class="flex-auto p-4">
        <div class="flex flex-row -mx-3">
          <div class="flex-none w-2/3 max-w-full px-3">
            <div>
              <p class="mb-0 font-sans text-sm font-semibold leading-normal uppercase text-slate-500">Pagos Pendientes</p>
              <h5 class="mb-2 font-bold text-slate-700">{{metricas.documentosPendientes}}</h5>
              <p class="mb-0 text-slate-500">
                <span class="text-sm font-bold leading-normal text-orange-500">
                  ${{finanzas.montoPendiente}}
                </span>
                por cobrar
              </p>
            </div>
          </div>
          <div class="px-3 text-right basis-1/3">
            <div class="inline-block w-12 h-12 text-center rounded-lg bg-gradient-to-tl from-orange-500 to-yellow-500">
              <i class="fas fa-clock text-lg relative top-3.5 text-white"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Card 4: Retenciones -->
  <div class="w-full max-w-full px-3 sm:w-1/2 sm:flex-none xl:w-1/4">
    <div class="relative flex flex-col min-w-0 break-words bg-white shadow-xl rounded-2xl bg-clip-border hover-lift">
      <div class="flex-auto p-4">
        <div class="flex flex-row -mx-3">
          <div class="flex-none w-2/3 max-w-full px-3">
            <div>
              <p class="mb-0 font-sans text-sm font-semibold leading-normal uppercase text-slate-500">Retenciones</p>
              <h5 class="mb-2 font-bold text-slate-700">${{finanzas.totalRetenido}}</h5>
              <p class="mb-0 text-slate-500">
                <span class="text-sm font-bold leading-normal text-slate-600">
                  {{finanzas.porcentajeRetencion}}%
                </span>
                del total facturado
              </p>
            </div>
          </div>
          <div class="px-3 text-right basis-1/3">
            <div class="inline-block w-12 h-12 text-center rounded-lg bg-gradient-to-tl from-red-600 to-orange-600">
              <i class="fas fa-percentage text-lg relative top-3.5 text-white"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Botón de Comparación de Periodos -->
<div class="flex flex-wrap -mx-3 mb-6">
  <div class="w-full max-w-full px-3">
    <div class="relative flex flex-col min-w-0 break-words bg-gradient-to-r from-indigo-500 to-purple-600 shadow-xl rounded-2xl bg-clip-border">
      <div class="flex-auto p-4">
        <div class="flex items-center justify-between text-white">
          <div class="flex items-center">
            <div class="inline-block w-12 h-12 text-center rounded-lg bg-white/20 mr-4">
              <i class="fas fa-chart-line text-lg relative top-3.5 text-white"></i>
            </div>
            <div>
              <h6 class="mb-0 text-white font-bold">Comparación de Periodos</h6>
              <p class="mb-0 text-white/80 text-sm">Analiza el rendimiento entre diferentes periodos de tiempo</p>
            </div>
          </div>
          <div class="text-right">
            <a href="/admin/reportes/comparacion-periodos" 
               class="inline-flex items-center px-6 py-3 bg-white/20 hover:bg-white/30 text-white font-medium rounded-lg transition-all duration-200 hover:transform hover:scale-105 backdrop-blur-sm border border-white/20">
              <i class="fas fa-analytics mr-2"></i>
              Comparar Periodos
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Sección de alertas críticas -->
{{#if alertasCriticas.length}}
<div class="flex flex-wrap -mx-3 mb-6">
  <div class="w-full max-w-full px-3">
    <div class="relative flex flex-col min-w-0 break-words bg-gradient-to-r from-red-500 to-orange-500 shadow-xl rounded-2xl bg-clip-border">
      <div class="flex-auto p-6">
        <div class="flex items-center justify-between text-white">
          <div>
            <h6 class="mb-0 text-white font-bold">
              <i class="fas fa-exclamation-triangle mr-2"></i>
              Alertas del Sistema - Atención Requerida
            </h6>
            <p class="mb-0 text-white/80">{{alertasCriticas.length}} alertas requieren atención inmediata</p>
          </div>
          <div class="text-right">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-white/20 text-white">
              {{alertasCriticas.length}} alertas
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Grid de alertas -->
<div class="flex flex-wrap -mx-3 mb-6">
  {{#each alertasCriticas}}
  <div class="w-full max-w-full px-3 mb-6 lg:w-1/2 xl:w-1/3">
    <div class="relative flex flex-col min-w-0 break-words bg-white shadow-lg rounded-2xl bg-clip-border border border-{{tipo}}-200 hover-lift">
      <div class="flex-auto p-4">
        <div class="flex items-start justify-between mb-3">
          <div class="flex items-center">
            <div class="inline-flex items-center justify-center w-10 h-10 mr-3 text-white rounded-lg bg-{{tipo}}-500">
              <i class="{{icono}} text-sm"></i>
            </div>
            <div>
              <h6 class="mb-0 font-semibold text-{{tipo}}-600">{{titulo}}</h6>
              <span class="text-xs uppercase text-{{tipo}}-500 font-medium">{{prioridad}}</span>
            </div>
          </div>
        </div>
        <p class="mb-4 text-sm text-slate-500">{{descripcion}}</p>
        <a href="{{accion}}" class="inline-flex items-center px-4 py-2 bg-{{tipo}}-500 hover:bg-{{tipo}}-600 text-white text-sm font-medium rounded-lg transition-colors duration-200">
          <i class="fas fa-eye mr-2"></i>
          Revisar
        </a>
      </div>
    </div>
  </div>
  {{/each}}
</div>
{{/if}}

<!-- Sección de gráficos y tablas -->
<div class="flex flex-wrap mt-6 -mx-3">
  
  <!-- Gráfico de ingresos (lado izquierdo) -->
  <div class="w-full max-w-full px-3 mt-0 lg:w-7/12 lg:flex-none">
    <div class="relative flex min-w-0 flex-col break-words rounded-2xl border-0 border-solid bg-white bg-clip-border shadow-xl">
      <div class="mb-0 rounded-t-2xl border-b-0 border-solid p-6 pt-4 pb-0">
        <h6 class="capitalize text-slate-700 font-bold">Evolución de Ingresos</h6>
        <p class="mb-0 text-sm leading-normal text-slate-500">
          <i class="fa fa-arrow-up text-emerald-500"></i>
          <span class="font-semibold">{{finanzas.crecimientoMensual}}% más</span> que el mes anterior
        </p>
      </div>
      <div class="flex-auto p-4">
        <div>
          <canvas id="chart-ingresos" height="300"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- Tabla de documentos recientes (lado derecho) -->
  <div class="w-full max-w-full px-3 lg:w-5/12 lg:flex-none">
    <div class="relative flex flex-col min-w-0 break-words bg-white border-0 border-solid shadow-xl rounded-2xl bg-clip-border">
      <div class="p-4 pb-0 mb-0 rounded-t-4">
        <div class="flex justify-between">
          <h6 class="mb-2 text-slate-700 font-bold">Documentos Recientes</h6>
          <a href="/admin/documentos/listado" class="text-sm text-blue-500 hover:text-blue-600">Ver todos</a>
        </div>
      </div>
      <div class="overflow-x-auto">
        <table class="items-center w-full mb-4 align-top border-collapse border-gray-200">
          <thead class="align-bottom">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Documento</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Estado</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Valor</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            {{#each documentosRecientes}}
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center">
                  <div class="inline-flex items-center justify-center w-8 h-8 mr-3 text-sm rounded-lg 
                              {{#if (eq tipo 'protocolo')}}bg-blue-100 text-blue-600
                              {{else if (eq tipo 'diligencias')}}bg-green-100 text-green-600
                              {{else}}bg-purple-100 text-purple-600{{/if}}">
                    <i class="{{tipoIcono}} text-xs"></i>
                  </div>
                  <div>
                    <div class="text-sm font-medium text-slate-900">{{codigo}}</div>
                    <div class="text-sm text-slate-500">{{cliente}}</div>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full 
                            {{#if (eq estadoPago 'pagado')}}bg-green-100 text-green-800
                            {{else if (eq estadoPago 'pendiente')}}bg-yellow-100 text-yellow-800
                            {{else}}bg-red-100 text-red-800{{/if}}">
                  {{estadoPago}}
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-900">
                ${{valorFormateado}}
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Sección de resumen por matrizadores -->
<div class="flex flex-wrap mt-6 -mx-3">
  <div class="w-full max-w-full px-3">
    <div class="relative flex flex-col min-w-0 break-words bg-white border-0 border-solid shadow-xl rounded-2xl bg-clip-border">
      <div class="p-4 pb-0 mb-0 rounded-t-4">
        <h6 class="mb-2 text-slate-700 font-bold">Resumen por Matrizadores</h6>
        <p class="text-sm text-slate-500">Productividad y rendimiento en el período actual</p>
      </div>
      <div class="overflow-x-auto">
        <table class="items-center w-full mb-4 align-top border-collapse border-gray-200">
          <thead class="align-bottom">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Matrizador</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Documentos</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Ingresos</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Promedio/Doc</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Eficiencia</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            {{#each resumenMatrizadores}}
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center">
                  <div class="inline-flex items-center justify-center w-8 h-8 mr-3 text-sm bg-gradient-to-tl from-blue-500 to-violet-500 text-white rounded-lg">
                    {{iniciales}}
                  </div>
                  <div>
                    <div class="text-sm font-medium text-slate-900">{{nombre}}</div>
                    <div class="text-sm text-slate-500">{{rol}}</div>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-slate-900">{{totalDocumentos}}</div>
                <div class="text-xs text-slate-500">{{documentosUltimaSemana}} esta semana</div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-slate-900">${{totalIngresos}}</div>
                <div class="text-xs {{#if (gt crecimiento 0)}}text-green-500{{else}}text-red-500{{/if}}">
                  {{#if (gt crecimiento 0)}}+{{/if}}{{crecimiento}}% vs anterior
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-900">
                ${{promedioDocumento}}
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center">
                  <div class="w-16 bg-gray-200 rounded-full h-2 mr-2">
                    <div class="bg-gradient-to-r from-blue-500 to-blue-600 h-2 rounded-full" style="width: {{eficiencia}}%"></div>
                  </div>
                  <span class="text-sm font-medium text-slate-700">{{eficiencia}}%</span>
                </div>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Scripts para gráficos -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Gráfico de ingresos
  const ctx = document.getElementById('chart-ingresos');
  if (ctx) {
    try {
      // Datos seguros para el gráfico
      const etiquetas = {{#if finanzas.etiquetasMeses}}{{{json finanzas.etiquetasMeses}}}{{else}}['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun']{{/if}};
      const datos = {{#if finanzas.datosMeses}}{{{json finanzas.datosMeses}}}{{else}}[0, 0, 0, 0, 0, 0]{{/if}};
      
      new Chart(ctx, {
        type: 'line',
        data: {
          labels: etiquetas,
          datasets: [{
            label: 'Ingresos Mensuales',
            data: datos,
            borderColor: 'rgb(59, 130, 246)',
            backgroundColor: 'rgba(59, 130, 246, 0.1)',
            tension: 0.4,
            fill: true
          }]
        },
        options: {
          responsive: true,
          plugins: {
            legend: {
              display: false
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              ticks: {
                callback: function(value) {
                  return '$' + value.toLocaleString();
                }
              }
            }
          }
        }
      });
    } catch (error) {
      console.warn('⚠️ Error al cargar gráfico de ingresos:', error);
    }
  }
  
  console.log('✅ Dashboard Admin-Argon cargado correctamente');
  
  // RESPALDO: Asegurar que el sidebar toggle funcione
  const toggleBtn = document.querySelector('.sidebar-toggle');
  const sidebar = document.querySelector('.sidebar-argon');
  const mainContent = document.querySelector('.main-content');
  
  if (toggleBtn && sidebar && mainContent) {
    console.log('🔧 Configurando toggle manual del sidebar...');
    
    toggleBtn.addEventListener('click', function(e) {
      e.preventDefault();
      console.log('🔘 Toggle clicked!');
      
      // Toggle classes
      sidebar.classList.toggle('collapsed');
      document.body.classList.toggle('sidebar-collapsed');
      
      // Rotar icono
      const icon = this.querySelector('i');
      if (sidebar.classList.contains('collapsed')) {
        icon.style.transform = 'rotate(180deg)';
        console.log('📚 Sidebar colapsado');
      } else {
        icon.style.transform = 'rotate(0deg)';
        console.log('📖 Sidebar expandido');
      }
    });
    
    console.log('✅ Toggle manual configurado correctamente');
  } else {
    console.error('❌ No se encontraron elementos del sidebar:', {
      toggleBtn: !!toggleBtn,
      sidebar: !!sidebar,
      mainContent: !!mainContent
    });
  }
});
</script> 