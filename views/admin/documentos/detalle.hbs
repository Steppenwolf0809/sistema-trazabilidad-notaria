{{!-- VISTA DE SUPERVISIÓN - DETALLE SOLO LECTURA PARA ADMIN --}}
{{!-- SEGREGACIÓN DE FUNCIONES: Admin solo puede VER detalles, no editar/procesar/entregar --}}

{{#if documento}}
<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <div>
      <i class="fas fa-binoculars me-2"></i> 
      {{#if soloLectura}}
      Supervisión de Documento - Solo Lectura
      {{else}}
      Detalle de Documento
      {{/if}}
    </div>
    <div>
      <a href="/admin/documentos/listado" class="btn btn-sm btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i> Volver al Listado
      </a>
      
      {{!-- SEGREGACIÓN: Admin NO puede editar documentos --}}
      {{#unless soloLectura}}
      <a href="/admin/documentos/editar/{{documento.id}}" class="btn btn-sm btn-primary ms-1">
        <i class="fas fa-edit me-1"></i> Editar
      </a>
      
      {{#if (eq documento.estado "en_proceso")}}
      <button type="button" class="btn btn-sm btn-success ms-1" onclick="marcarListo({{documento.id}})">
        <i class="fas fa-check me-1"></i> Marcar como listo
      </button>
      {{/if}}
      
      {{#if (eq documento.estado "listo_para_entrega")}}
      <a href="/admin/documentos/entrega/{{documento.id}}" class="btn btn-sm btn-info ms-1">
        <i class="fas fa-hand-holding me-1"></i> Entrega
      </a>
      {{/if}}
      {{/unless}}
      
      {{#if soloLectura}}
      <div class="btn-group ms-2">
        <button type="button" class="btn btn-sm btn-outline-info" onclick="exportarDocumento()">
          <i class="fas fa-download me-1"></i> Exportar
        </button>
        <button type="button" class="btn btn-sm btn-outline-success" onclick="verHistorialCompleto()">
          <i class="fas fa-history me-1"></i> Historial Completo
        </button>
      </div>
      {{/if}}
    </div>
  </div>
  

  <div class="card-body">
    <!-- Información general -->
    <div class="row mb-4">
      <div class="col-md-4">
        <div class="mb-3">
          <h5 class="border-bottom pb-2">Información General</h5>
          <p><strong>Código:</strong> <span class="badge bg-primary">{{documento.codigoBarras}}</span></p>
          <p><strong>Tipo:</strong> {{documento.tipoDocumento}}</p>
          <p><strong>Estado:</strong> 
            {{#if (eq documento.estado "en_proceso")}}
            <span class="badge bg-warning text-dark">En Proceso</span>
            {{else if (eq documento.estado "listo_para_entrega")}}
            <span class="badge bg-info">Listo para Entrega</span>
            {{else if (eq documento.estado "entregado")}}
            <span class="badge bg-success">Entregado</span>
            {{else if (eq documento.estado "nota_credito")}}
            <span class="badge bg-secondary">Nota de Crédito</span>
            {{else if (eq documento.estado "eliminado")}}
            <span class="badge bg-danger">Eliminado</span>
            {{else}}
            <span class="badge bg-secondary">{{translateEstado documento.estado}}</span>
            {{/if}}
          </p>
          <p><strong>📅 Fecha Registro Sistema:</strong> {{formatDate documento.created_at}}</p>
          <small class="text-muted">Cuándo se subió al sistema</small>
          {{#if documento.fechaFactura}}
<p><strong>📄 Fecha Documento:</strong> {{formatDate documento.fechaFactura}}</p>
          <small class="text-muted">Fecha original del documento (XML)</small>
          {{/if}}
          {{#if documento.fechaEntrega}}
          <p><strong>🚀 Fecha Entrega:</strong> {{formatDate documento.fechaEntrega}}</p>
          {{/if}}
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="mb-3">
          <h5 class="border-bottom pb-2">Cliente</h5>
          <p><strong>Nombre:</strong> {{documento.nombreCliente}}</p>
          <p><strong>Identificación:</strong> {{documento.identificacionCliente}}</p>
          {{#if documento.emailCliente}}
          <p><strong>Email:</strong> {{documento.emailCliente}}</p>
          {{/if}}
          {{#if documento.telefonoCliente}}
          <p><strong>Teléfono:</strong> {{documento.telefonoCliente}}</p>
          {{/if}}
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="mb-3">
          <h5 class="border-bottom pb-2">Matrizador Asignado</h5>
          {{#if documento.matrizador}}
          <p><strong>Nombre:</strong> {{documento.matrizador.nombre}}</p>
          <p><strong>Email:</strong> {{documento.matrizador.email}}</p>
          <p><strong>Estado del Proceso:</strong> 
            {{#if (eq documento.estado "en_proceso")}}
            <span class="badge bg-warning text-dark fs-6">⚠️ En proceso</span>
            {{else if (eq documento.estado "listo_para_entrega")}}
            <span class="badge bg-success fs-6">✅ Listo para entrega</span>
            {{else if (eq documento.estado "entregado")}}
            <span class="badge bg-info fs-6">📦 Entregado</span>
            {{else}}
            <span class="badge bg-secondary fs-6">{{translateEstado documento.estado}}</span>
            {{/if}}
          </p>
          {{#if (eq documento.estado "listo_para_entrega")}}
          <p><strong>🔑 Código de Entrega:</strong> 
            <span class="badge bg-success fs-4">{{documento.codigoVerificacion}}</span>
          </p>
          {{/if}}
          {{else}}
          <p>No hay matrizador asignado</p>
          <div class="alert alert-warning py-2">
            <small><i class="fas fa-exclamation-triangle me-1"></i>Este documento requiere asignación de matrizador</small>
          </div>
          {{/if}}
        </div>
      </div>
    </div>
    
    <!-- Información de facturación y pagos -->
    <div class="row mb-4">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-money-bill-wave me-2"></i>Información de Facturación y Pagos</h5>
          </div>
          <div class="card-body">
            <!-- Información básica de facturación -->
            <div class="row mb-3">
              <div class="col-md-6">
                <div class="card border-primary">
                  <div class="card-header bg-primary text-white py-2">
                    <h6 class="mb-0"><i class="fas fa-file-invoice me-1"></i>Datos de Facturación</h6>
                  </div>
                  <div class="card-body">
                    <div class="row">
                      <div class="col-12 mb-2">
                        <strong>📄 N° Factura:</strong> 
                        <span class="badge bg-secondary">{{#if documento.numeroFactura}}{{documento.numeroFactura}}{{else}}No registrado{{/if}}</span>
                      </div>
                      <div class="col-12 mb-2">
                        <strong>💰 Valor Total:</strong> 
                        <span class="fs-5 text-primary">${{#if documento.valorFactura}}{{formatMoney documento.valorFactura}}{{else}}0.00{{/if}}</span>
                      </div>
                      {{#if documento.fechaFactura}}
                      <div class="col-12">
                        <strong>📅 Fecha Factura:</strong> {{formatDate documento.fechaFactura}}
                      </div>
                      {{/if}}
                    </div>
                  </div>
                </div>
              </div>
              
              <div class="col-md-6">
                <div class="card border-{{#if (eq documento.estadoPago "pagado_completo")}}success{{else if (eq documento.estadoPago "pagado_con_retencion")}}info{{else if (eq documento.estadoPago "pago_parcial")}}warning{{else}}danger{{/if}}">
                  <div class="card-header bg-{{#if (eq documento.estadoPago "pagado_completo")}}success{{else if (eq documento.estadoPago "pagado_con_retencion")}}info{{else if (eq documento.estadoPago "pago_parcial")}}warning{{else}}danger{{/if}} text-white py-2">
                    <h6 class="mb-0"><i class="fas fa-credit-card me-1"></i>Estado de Pago</h6>
                  </div>
                  <div class="card-body">
                    <div class="row">
                      <div class="col-12 mb-2">
                        <strong>🏷️ Estado:</strong> 
                        {{#if (eq documento.estadoPago "pagado_completo")}}
                        <span class="badge bg-success fs-6">✅ Pagado Completo</span>
                        {{else if (eq documento.estadoPago "pagado_con_retencion")}}
                        <span class="badge bg-info fs-6">🧾 Pagado con Retención</span>
                        {{else if (eq documento.estadoPago "pago_parcial")}}
                        <span class="badge bg-warning text-dark fs-6">⚠️ Pago Parcial</span>
                        {{else}}
                        <span class="badge bg-danger fs-6">❌ Pendiente</span>
                        {{/if}}
                      </div>
                      <div class="col-12 mb-2">
                        <strong>💳 Método:</strong> 
                        <span class="badge bg-secondary">{{#if documento.metodoPago}}{{documento.metodoPago}}{{else}}No registrado{{/if}}</span>
                      </div>
                      {{#if (or (eq documento.estadoPago "pagado_completo") (eq documento.estadoPago "pagado_con_retencion") (eq documento.estadoPago "pago_parcial"))}}
                      <div class="col-12">
                        <strong>📅 Último Pago:</strong> 
                        <span class="badge bg-success-subtle text-success-emphasis px-2 py-1">
                          {{#if documento.fechaUltimoPago}}
                          {{formatDateTime documento.fechaUltimoPago}}
                          {{else if documento.fechaPago}}
                          {{formatDateTime documento.fechaPago}}
                          {{else}}
                          No registrada
                          {{/if}}
                        </span>
                      </div>
                      {{/if}}
                    </div>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- Desglose financiero detallado -->
            {{#if (neq documento.estadoPago "pendiente")}}
            <div class="row">
              <div class="col-12">
                <div class="card border-info">
                  <div class="card-header bg-info text-white py-2">
                    <h6 class="mb-0"><i class="fas fa-calculator me-1"></i>Desglose Financiero</h6>
                  </div>
                  <div class="card-body">
                    <div class="row text-center">
                      <div class="col-md-3">
                        <div class="border-end">
                          <div class="text-muted small">VALOR TOTAL</div>
                          <div class="fs-4 text-primary">${{#if documento.valorFactura}}{{formatMoney documento.valorFactura}}{{else}}0.00{{/if}}</div>
                        </div>
                      </div>
                      <div class="col-md-3">
                        <div class="border-end">
                          <div class="text-muted small">PAGADO</div>
                          <div class="fs-4 text-success">${{#if documento.valorPagado}}{{formatMoney documento.valorPagado}}{{else}}0.00{{/if}}</div>
                        </div>
                      </div>
                      <div class="col-md-3">
                        <div class="{{#if documento.tieneRetencion}}border-end{{/if}}">
                          <div class="text-muted small">PENDIENTE</div>
                          <div class="fs-4 text-danger">${{#if documento.valorPendiente}}{{formatMoney documento.valorPendiente}}{{else}}0.00{{/if}}</div>
                        </div>
                      </div>
                      {{#if documento.tieneRetencion}}
                      <div class="col-md-3">
                        <div class="text-muted small">RETENCIÓN</div>
                        <div class="fs-4 text-warning">${{#if documento.valorRetenido}}{{formatMoney documento.valorRetenido}}{{else}}0.00{{/if}}</div>
                        {{#if documento.numeroComprobanteRetencion}}
                        <div class="small text-muted">Comp: {{documento.numeroComprobanteRetencion}}</div>
                        {{/if}}
                      </div>
                      {{/if}}
                    </div>
                    
                    <!-- Información del usuario que registró el pago -->
                    {{#if usuarioPago}}
                    <hr class="my-3">
                    <div class="text-center">
                      <small class="text-muted">
                        <i class="fas fa-user me-1"></i><strong>Registrado por:</strong> 
                        <span class="badge bg-info-subtle text-info-emphasis px-2 py-1">
                          {{usuarioPago.nombre}} ({{usuarioPago.rol}})
                        </span>
                      </small>
                    </div>
                    {{/if}}
                  </div>
                </div>
              </div>
            </div>
            {{/if}}
          </div>
        </div>
      </div>
    </div>
    
    <!-- Notas -->
    {{#if documento.notas}}
    <div class="row mb-4">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h5 class="mb-0">Notas</h5>
          </div>
          <div class="card-body">
            <p>{{documento.notas}}</p>
          </div>
        </div>
      </div>
    </div>
    {{/if}}
    
    <!-- Comparecientes -->
    {{#if documento.comparecientes.length}}
    <div class="row mb-4">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h5 class="mb-0">Comparecientes</h5>
          </div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Nombre</th>
                    <th>Identificación</th>
                    <th>Rol</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each documento.comparecientes}}
                  <tr>
                    <td>{{this.nombre}}</td>
                    <td>{{this.identificacion}}</td>
                    <td>{{this.rol}}</td>
                  </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
    {{/if}}
    
    <!-- Información de entrega (solo si está entregado) -->
    {{#if (eq documento.estado "entregado")}}
    <div class="row mb-4">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h5 class="mb-0">Datos de Entrega</h5>
          </div>
          <div class="card-body">
            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label class="fw-bold">Receptor:</label>
                  <div>{{documento.nombreReceptor}}</div>
                </div>
                
                <div class="mb-3">
                  <label class="fw-bold">Identificación:</label>
                  <div>{{documento.identificacionReceptor}}</div>
                </div>
              </div>
              
              <div class="col-md-6">
                <div class="mb-3">
                  <label class="fw-bold">Relación:</label>
                  <div>
                    {{#if (eq documento.relacionReceptor "titular")}}
                    Titular
                    {{else if (eq documento.relacionReceptor "familiar")}}
                    Familiar
                    {{else if (eq documento.relacionReceptor "mandatario")}}
                    Mandatario
                    {{else}}
                    {{documento.relacionReceptor}}
                    {{/if}}
                  </div>
                </div>
                
                <div class="mb-3">
                  <label class="fw-bold">Fecha de Entrega:</label>
                  <div>{{formatDate documento.fechaEntrega}}</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    {{/if}}
    
    <!-- ============================================================================ -->
    <!-- PANEL DE REVERSIONES - SOLO ADMIN -->
    <!-- ============================================================================ -->
    {{#if (eq userRole "admin")}}
    <div class="row mb-4">
      <div class="col-12">
        <div class="card border-warning">
          <div class="card-header bg-warning text-dark">
            <h5 class="mb-0">
              <i class="fas fa-undo me-2"></i>REVERSIONES DE EMERGENCIA - ADMIN
            </h5>
            <small>Solo usar en casos confirmados de error - Se registra en auditoría</small>
          </div>
          <div class="card-body">
            <div class="alert alert-warning">
              <i class="fas fa-exclamation-triangle me-2"></i>
              <strong>Importante:</strong> Las reversiones son operaciones críticas que modifican el estado del documento. 
              Requieren justificación detallada y quedan registradas permanentemente en auditoría.
            </div>
            
            <div class="row">
              <!-- Reversiones de Estado disponibles según el estado actual -->
              {{#if (eq documento.estado "listo_para_entrega")}}
              <div class="col-md-6 mb-3">
                <div class="card h-100 border-info">
                  <div class="card-body text-center">
                    <i class="fas fa-arrow-left fa-2x text-info mb-2"></i>
                    <h6>Desmarcar como Listo</h6>
                    <p class="small text-muted">Devolver a estado "en proceso"</p>
                    <button class="btn btn-info btn-sm" onclick="abrirModalReversion('desmarcar_listo', '{{documento.id}}')">
                      <i class="fas fa-undo"></i> Ejecutar
                    </button>
                  </div>
                </div>
              </div>
              {{/if}}
              
              {{#if (eq documento.estado "entregado")}}
              <div class="col-md-6 mb-3">
                <div class="card h-100 border-danger">
                  <div class="card-body text-center">
                    <i class="fas fa-hand-paper fa-2x text-danger mb-2"></i>
                    <h6>Deshacer Entrega</h6>
                    <p class="small text-muted">Marcar como "listo para entrega"</p>
                    <button class="btn btn-danger btn-sm" onclick="abrirModalReversion('deshacer_entrega', '{{documento.id}}')">
                      <i class="fas fa-undo"></i> Ejecutar
                    </button>
                  </div>
                </div>
              </div>
              {{/if}}
              
              {{#if documento.notificacionGrupalId}}
              <div class="col-md-6 mb-3">
                <div class="card h-100 border-primary">
                  <div class="card-body text-center">
                    <i class="fas fa-unlink fa-2x text-primary mb-2"></i>
                    <h6>Separar de Grupo</h6>
                    <p class="small text-muted">Remover de notificación grupal</p>
                    <button class="btn btn-primary btn-sm" onclick="abrirModalReversion('separar_grupo', '{{documento.id}}')">
                      <i class="fas fa-unlink"></i> Ejecutar
                    </button>
                  </div>
                </div>
              </div>
              {{/if}}
              
              {{#if (and documento.eliminado (esReciente documento.fechaEliminacion))}}
              <div class="col-md-6 mb-3">
                <div class="card h-100 border-success">
                  <div class="card-body text-center">
                    <i class="fas fa-recycle fa-2x text-success mb-2"></i>
                    <h6>Reactivar Documento</h6>
                    <p class="small text-muted">Restaurar documento eliminado</p>
                    <button class="btn btn-success btn-sm" onclick="abrirModalReversion('reactivar_documento', '{{documento.id}}')">
                      <i class="fas fa-recycle"></i> Ejecutar
                    </button>
                  </div>
                </div>
              </div>
              {{/if}}
              
              <!-- Si no hay reversiones disponibles -->
              {{#unless (or (eq documento.estado "listo_para_entrega") (eq documento.estado "entregado") documento.notificacionGrupalId (and documento.eliminado (esReciente documento.fechaEliminacion)))}}
              <div class="col-12">
                <div class="alert alert-info text-center">
                  <i class="fas fa-info-circle me-2"></i>
                  No hay reversiones disponibles para el estado actual del documento.
                </div>
              </div>
              {{/unless}}
            </div>
            
            <div class="text-end mt-3">
              <a href="/admin/reversiones/auditoria" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-history me-1"></i> Ver Auditoría de Reversiones
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
    {{/if}}
    
    <!-- 🆕 HISTORIAL UNIVERSAL -->
    {{> historial-universal eventos=eventos esAdmin=true userRole="admin"}}
  </div>
</div>

<!-- Modal de confirmación para marcar como listo -->
<div class="modal fade" id="marcarListoModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Marcar documento como listo</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p>Al marcar este documento como listo para entrega, se generará un código de verificación de 4 dígitos que será enviado al cliente.</p>
        <p>¿Está seguro de que el documento está listo para ser entregado?</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <form id="marcarListoForm" action="/admin/documentos/marcar-listo" method="POST" style="display: inline;">
          <input type="hidden" id="documentoId" name="documentoId" value="{{documento.id}}">
          <button type="submit" class="btn btn-success">Confirmar</button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- ============================================================================ -->
<!-- MODAL DE JUSTIFICACIÓN PARA REVERSIONES - ADMIN -->
<!-- ============================================================================ -->
<div class="modal fade" id="modalReversionAdmin" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-warning text-dark">
        <h5 class="modal-title">
          <i class="fas fa-exclamation-triangle me-2"></i>
          Confirmar Reversión de Emergencia
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-danger">
          <strong>⚠️ OPERACIÓN CRÍTICA:</strong> <span id="descripcionAccion"></span>
          <br><small>Esta acción será registrada en auditoría con su usuario y timestamp.</small>
        </div>
        
        <div class="mb-3">
          <label class="form-label fw-bold">Categoría del error: <span class="text-danger">*</span></label>
          <select id="motivoReversionAdmin" class="form-select" required>
            <option value="">Seleccione el motivo...</option>
            <option value="error_humano">Error humano en proceso</option>
            <option value="error_sistema">Error del sistema</option>
            <option value="solicitud_cliente">Solicitud justificada del cliente</option>
            <option value="corrección_datos">Corrección de datos incorrectos</option>
            <option value="procedimiento_urgente">Procedimiento urgente autorizado</option>
            <option value="orden_judicial">Orden judicial o legal</option>
            <option value="otros">Otros (especificar en justificación)</option>
          </select>
        </div>
        
        <div class="mb-3">
          <label class="form-label fw-bold">Justificación detallada: <span class="text-danger">*</span></label>
          <textarea id="justificacionReversionAdmin" class="form-control" rows="4" 
                    placeholder="Explique detalladamente por qué es necesaria esta reversión. Incluya contexto, responsable del error original y impacto. Mínimo 5 caracteres."
                    minlength="5" maxlength="1000" required></textarea>
          <div class="form-text">
            <span id="contadorCaracteresAdmin">0</span>/5 caracteres mínimos (máximo 1000)
          </div>
        </div>
        
        <div class="mb-3">
          <div class="form-check">
            <input type="checkbox" id="confirmarReversionAdmin" class="form-check-input" required>
            <label class="form-check-label" for="confirmarReversionAdmin">
              <strong>Confirmo que:</strong>
              <ul class="mt-1 mb-0">
                <li>Entiendo las consecuencias de esta reversión</li>
                <li>La justificación es veraz y completa</li>
                <li>Esta acción será registrada permanentemente en auditoría</li>
                <li>Acepto la responsabilidad de esta decisión</li>
              </ul>
            </label>
          </div>
        </div>
        
        <div class="alert alert-info">
          <i class="fas fa-info-circle me-2"></i>
          <strong>Registro de auditoría:</strong> Esta reversión será visible en el historial del documento 
          y en la auditoría general del sistema. No se puede deshacer una vez ejecutada.
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
          <i class="fas fa-times"></i> Cancelar
        </button>
        <button type="button" id="btnEjecutarReversionAdmin" class="btn btn-warning" disabled>
          <i class="fas fa-undo"></i> Ejecutar Reversión
        </button>
      </div>
    </div>
  </div>
</div>

<script>
// ============================================================================
// SISTEMA DE REVERSIONES - ADMIN
// ============================================================================

let tipoReversionActual = '';
let documentoIdActual = '';

function abrirModalReversion(tipoReversion, documentoId) {
  tipoReversionActual = tipoReversion;
  documentoIdActual = documentoId;
  
  // Configurar descripción según tipo de reversión
  const descripciones = {
    'desmarcar_listo': 'Cambiará el estado de "listo para entrega" a "en proceso" y eliminará el código de verificación.',
    'deshacer_entrega': 'Cambiará el estado de "entregado" a "listo para entrega" y limpiará todos los datos de entrega.',
    'separar_grupo': 'Removerá el documento del grupo de notificación, permitiendo notificación individual.',
    'reactivar_documento': 'Restaurará el documento eliminado y lo marcará como "en proceso".'
  };
  
  document.getElementById('descripcionAccion').textContent = descripciones[tipoReversion] || 'Operación de reversión crítica';
  
  // Limpiar formulario
  document.getElementById('motivoReversionAdmin').value = '';
  document.getElementById('justificacionReversionAdmin').value = '';
  document.getElementById('confirmarReversionAdmin').checked = false;
  document.getElementById('btnEjecutarReversionAdmin').disabled = true;
  actualizarContadorAdmin();
  
  // Mostrar modal
  const modal = new bootstrap.Modal(document.getElementById('modalReversionAdmin'));
  modal.show();
}

function actualizarContadorAdmin() {
  const textarea = document.getElementById('justificacionReversionAdmin');
  const contador = document.getElementById('contadorCaracteresAdmin');
  const longitud = textarea.value.length;
  
  contador.textContent = longitud;
  contador.className = longitud >= 5 ? 'text-success' : 'text-danger';
  
  validarFormularioAdmin();
}

function validarFormularioAdmin() {
  const motivo = document.getElementById('motivoReversionAdmin').value;
  const justificacion = document.getElementById('justificacionReversionAdmin').value;
  const confirmacion = document.getElementById('confirmarReversionAdmin').checked;
  
  const esValido = motivo && justificacion.length >= 5 && confirmacion;
  document.getElementById('btnEjecutarReversionAdmin').disabled = !esValido;
}

function ejecutarReversionAdmin() {
  const motivo = document.getElementById('motivoReversionAdmin').value;
  const justificacion = document.getElementById('justificacionReversionAdmin').value;
  
  if (!motivo || justificacion.length < 5) {
    alert('Por favor complete todos los campos requeridos (mínimo 5 caracteres en justificación)');
    return;
  }
  
  // Deshabilitar botón para evitar doble clic
  const btn = document.getElementById('btnEjecutarReversionAdmin');
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Ejecutando...';
  
  // Hacer petición AJAX
  fetch(`/admin/documentos/${documentoIdActual}/revertir-estado`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({
      tipoReversion: tipoReversionActual,
      motivoCategoria: motivo,
      justificacion: justificacion
    })
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      // Cerrar modal
      const modal = bootstrap.Modal.getInstance(document.getElementById('modalReversionAdmin'));
      modal.hide();
      
      // Mostrar mensaje de éxito
      alert('✅ Reversión ejecutada exitosamente. La página se recargará para mostrar los cambios.');
      
      // Recargar página
      location.reload();
    } else {
      alert('❌ Error: ' + (data.mensaje || data.error || 'No se pudo ejecutar la reversión'));
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-undo"></i> Ejecutar Reversión';
    }
  })
  .catch(error => {
    console.error('Error:', error);
    alert('❌ Error de conexión. Intente nuevamente.');
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-undo"></i> Ejecutar Reversión';
  });
}

// Event listeners
document.addEventListener('DOMContentLoaded', function() {
  const justificacionTextarea = document.getElementById('justificacionReversionAdmin');
  const motivoSelect = document.getElementById('motivoReversionAdmin');
  const confirmarCheck = document.getElementById('confirmarReversionAdmin');
  const btnEjecutar = document.getElementById('btnEjecutarReversionAdmin');
  
  if (justificacionTextarea) {
    justificacionTextarea.addEventListener('input', actualizarContadorAdmin);
  }
  
  if (motivoSelect) {
    motivoSelect.addEventListener('change', validarFormularioAdmin);
  }
  
  if (confirmarCheck) {
    confirmarCheck.addEventListener('change', validarFormularioAdmin);
  }
  
  if (btnEjecutar) {
    btnEjecutar.addEventListener('click', ejecutarReversionAdmin);
  }
});

function marcarListo(id) {
  document.getElementById('documentoId').value = id;
  const modal = new bootstrap.Modal(document.getElementById('marcarListoModal'));
  modal.show();
}

console.log('📖 Vista admin limpia cargada para documento {{documento.codigoBarras}}');
</script>
{{else}}
<div class="alert alert-warning">
  <i class="fas fa-exclamation-triangle me-2"></i> El documento solicitado no existe o no tienes permisos para verlo.
</div>
{{/if}} 