{{!-- DETALLE DE DOCUMENTO ADMIN - VISTA UNIFICADA CON FUNCIONALIDADES ESPECIALES --}}
{{!-- Layout sobrio usando componente universal con permisos completos de admin --}}

<!-- Include CSS y JS específicos para la vista unificada -->
<link rel="stylesheet" href="/css/documento-detalle-unificado.css">
<script src="/js/documento-detalle-unificado.js" defer></script>

{{#if documento}}
<div class="document-unified-container">
  
  <!-- Header del documento - ESPECÍFICO ADMIN CON ACCIONES ESPECIALES -->
  <div class="document-header">
    <div class="row align-items-center">
      <div class="col-lg-8">
        <h1 class="document-title">
          {{documento.tipoDocumento}}
          <span class="badge badge-estado {{#if (eq documento.estado "en_proceso")}}estado-en-proceso{{else if (eq documento.estado "listo_para_entrega")}}estado-listo{{else if (eq documento.estado "entregado")}}estado-entregado{{else}}estado-pendiente{{/if}} ms-3">
            {{#if (eq documento.estado "en_proceso")}}En Proceso
            {{else if (eq documento.estado "listo_para_entrega")}}Listo
            {{else if (eq documento.estado "entregado")}}Entregado
            {{else}}{{translateEstado documento.estado}}{{/if}}
          </span>
          <span class="badge bg-warning text-dark ms-2">
            <i class="fas fa-shield-alt me-1"></i> Admin
          </span>
        </h1>
        <p class="document-subtitle">Documento: {{documento.codigoBarras}} | Cliente: {{documento.nombreCliente}}</p>
      </div>
      <div class="col-lg-4">
        <div class="action-buttons justify-content-end">
          {{!-- ACCIONES PRINCIPALES ADMIN --}}
          <div class="dropdown">
            <button class="btn btn-warning dropdown-toggle action-button-primary me-2" data-bs-toggle="dropdown">
              <i class="fas fa-cog me-1"></i> Administrar
            </button>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" onclick="reasignarMatrizador('{{documento.id}}')">
                <i class="fas fa-user-exchange me-2"></i> Reasignar Matrizador
              </a></li>
              <li><a class="dropdown-item" onclick="cambiarEstado('{{documento.id}}')">
                <i class="fas fa-edit me-2"></i> Cambiar Estado
              </a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" onclick="autorizarUrgente('{{documento.id}}')">
                <i class="fas fa-bolt me-2"></i> Autorización Urgente
              </a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item text-danger" onclick="eliminarDocumento('{{documento.id}}')">
                <i class="fas fa-trash me-2"></i> Eliminar Documento
              </a></li>
            </ul>
          </div>
          <a href="/admin/documentos" class="btn btn-secondary-soft">
            <i class="fas fa-arrow-left me-1"></i> Volver
          </a>
        </div>
      </div>
    </div>
  </div>

  {{!-- USAR COMPONENTE UNIVERSAL CON CONFIGURACIÓN ADMIN COMPLETA --}}
  {{> documento-detalle-universal 
      documento=documento 
      userRole="admin"
      config=configuracionAdmin
      permisos=permisosAdmin
      informacionGrupal=informacionGrupal
      eventos=eventos
  }}

  {{!-- SECCIÓN ADMINISTRATIVA ESPECIAL - ÚNICA PARA ADMIN --}}
  <div class="row mb-4">
    <div class="col-12">
      <div class="info-card">
        <h6 class="section-title">
          <i class="fas fa-shield-alt"></i>
          Panel Administrativo
        </h6>
        
        <div class="row">
          
          {{!-- Gestión de Matrizador --}}
          <div class="col-md-6">
            <div class="admin-panel-section">
              <h6 class="admin-section-title">
                <i class="fas fa-user"></i> Gestión de Matrizador
              </h6>
              <div class="info-row">
                <span class="info-label">Actual:</span>
                <span class="info-value">{{#if documento.matrizador}}{{documento.matrizador.nombre}}{{else}}Sin asignar{{/if}}</span>
              </div>
              <button class="btn btn-outline-primary btn-sm mt-2" onclick="reasignarMatrizador('{{documento.id}}')">
                <i class="fas fa-user-exchange me-1"></i> Reasignar
              </button>
            </div>
          </div>
          
          {{!-- Control de Estado --}}
          <div class="col-md-6">
            <div class="admin-panel-section">
              <h6 class="admin-section-title">
                <i class="fas fa-list"></i> Control de Estado
              </h6>
              <div class="info-row">
                <span class="info-label">Estado:</span>
                <span class="info-value">
                  <span class="badge bg-{{getEstadoColor documento.estado}}">{{documento.estado}}</span>
                </span>
              </div>
              <button class="btn btn-outline-warning btn-sm mt-2" onclick="cambiarEstado('{{documento.id}}')">
                <i class="fas fa-edit me-1"></i> Cambiar Estado
              </button>
            </div>
          </div>
          
        </div>
        
        <hr class="my-3">
        
        <div class="row">
          
          {{!-- Autorizaciones --}}
          <div class="col-md-6">
            <div class="admin-panel-section">
              <h6 class="admin-section-title">
                <i class="fas fa-key"></i> Autorizaciones
              </h6>
              <button class="btn btn-outline-success btn-sm" onclick="autorizarUrgente('{{documento.id}}')">
                <i class="fas fa-bolt me-1"></i> Autorización Urgente
              </button>
            </div>
          </div>
          
          {{!-- Acciones Críticas --}}
          <div class="col-md-6">
            <div class="admin-panel-section">
              <h6 class="admin-section-title">
                <i class="fas fa-exclamation-triangle"></i> Acciones Críticas
              </h6>
              <button class="btn btn-outline-danger btn-sm" onclick="eliminarDocumento('{{documento.id}}')">
                <i class="fas fa-trash me-1"></i> Eliminar Documento
              </button>
            </div>
          </div>
          
        </div>
      </div>
    </div>
  </div>

  {{!-- PANEL DE REVERSIONES - SOLO ADMIN --}}
  <div class="row mb-4">
    <div class="col-12">
      <div class="info-card" style="border: 2px solid #f59e0b;">
        <div class="card-header-admin" style="background: linear-gradient(135deg, #f59e0b, #f97316); margin: -2rem -2rem 1.5rem -2rem; padding: 1.5rem 2rem; border-radius: 14px 14px 0 0;">
          <div class="d-flex align-items-center">
            <div class="admin-icon-reversion">
              <i class="fas fa-undo"></i>
            </div>
            <div>
              <h6 class="section-title mb-1" style="color: white;">
                REVERSIONES DE EMERGENCIA - ADMIN
              </h6>
              <small style="color: rgba(255,255,255,0.9);">Solo usar en casos confirmados de error - Se registra en auditoría</small>
            </div>
          </div>
        </div>
        
        <div class="alert alert-warning">
          <i class="fas fa-exclamation-triangle me-2"></i>
          <strong>Importante:</strong> Las reversiones son operaciones críticas que modifican el estado del documento. 
          Requieren justificación detallada y quedan registradas permanentemente en auditoría.
        </div>
        
        <div class="row">
          {{#if (eq documento.estado "listo_para_entrega")}}
          <div class="col-md-6 mb-3">
            <div class="info-card text-center reversion-card" style="border: 2px solid #3b82f6;">
              <i class="fas fa-arrow-left fa-2x text-primary mb-3"></i>
              <h6>Desmarcar como Listo</h6>
              <p class="small text-muted">Devolver a estado "en proceso"</p>
              <button class="btn btn-primary btn-sm" onclick="abrirModalReversion('desmarcar_listo', '{{documento.id}}')">
                <i class="fas fa-undo me-1"></i> Ejecutar
              </button>
            </div>
          </div>
          {{/if}}
          
          {{#if (eq documento.estado "entregado")}}
          <div class="col-md-6 mb-3">
            <div class="info-card text-center reversion-card" style="border: 2px solid #ef4444;">
              <i class="fas fa-hand-paper fa-2x text-danger mb-3"></i>
              <h6>Deshacer Entrega</h6>
              <p class="small text-muted">Marcar como "listo para entrega"</p>
              <button class="btn btn-danger btn-sm" onclick="abrirModalReversion('deshacer_entrega', '{{documento.id}}')">
                <i class="fas fa-undo me-1"></i> Ejecutar
              </button>
            </div>
          </div>
          {{/if}}
          
          {{#if documento.notificacionGrupalId}}
          <div class="col-md-6 mb-3">
            <div class="info-card text-center reversion-card" style="border: 2px solid #2563eb;">
              <i class="fas fa-unlink fa-2x text-primary mb-3"></i>
              <h6>Separar de Grupo</h6>
              <p class="small text-muted">Remover de notificación grupal</p>
              <button class="btn btn-primary btn-sm" onclick="abrirModalReversion('separar_grupo', '{{documento.id}}')">
                <i class="fas fa-unlink me-1"></i> Ejecutar
              </button>
            </div>
          </div>
          {{/if}}
          
          {{#if (and documento.eliminado (esReciente documento.fechaEliminacion))}}
          <div class="col-md-6 mb-3">
            <div class="info-card text-center reversion-card" style="border: 2px solid #10b981;">
              <i class="fas fa-recycle fa-2x text-success mb-3"></i>
              <h6>Reactivar Documento</h6>
              <p class="small text-muted">Restaurar documento eliminado</p>
              <button class="btn btn-success btn-sm" onclick="abrirModalReversion('reactivar_documento', '{{documento.id}}')">
                <i class="fas fa-recycle me-1"></i> Ejecutar
              </button>
            </div>
          </div>
          {{/if}}
          
          {{#unless (or (eq documento.estado "listo_para_entrega") (eq documento.estado "entregado") documento.notificacionGrupalId (and documento.eliminado (esReciente documento.fechaEliminacion)))}}
          <div class="col-12">
            <div class="alert alert-info text-center">
              <i class="fas fa-info-circle me-2"></i>
              No hay reversiones disponibles para el estado actual del documento.
            </div>
          </div>
          {{/unless}}
        </div>
        
        <div class="text-end mt-3">
          <a href="/admin/reversiones/auditoria" class="btn btn-secondary-soft">
            <i class="fas fa-history me-1"></i> Ver Auditoría de Reversiones
          </a>
        </div>
      </div>
    </div>
  </div>
  
</div>

{{!-- MODALES ESPECÍFICOS ADMIN --}}

{{!-- Modal de Reasignación de Matrizador --}}
<div class="modal fade" id="modalReasignarMatrizador" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <i class="fas fa-user-exchange me-2"></i>
          Reasignar Matrizador
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label">Seleccionar nuevo matrizador:</label>
          <select id="nuevoMatrizador" class="form-select">
            <option value="">Seleccione un matrizador...</option>
            {{#each matrizadoresDisponibles}}
            <option value="{{this.id}}">{{this.nombre}}</option>
            {{/each}}
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label">Motivo de la reasignación:</label>
          <textarea id="motivoReasignacion" class="form-control" rows="3" placeholder="Explique por qué se reasigna el documento"></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-primary" onclick="ejecutarReasignacion()">
          <i class="fas fa-user-exchange me-1"></i> Reasignar
        </button>
      </div>
    </div>
  </div>
</div>

{{!-- Modal de Cambio de Estado --}}
<div class="modal fade" id="modalCambiarEstado" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <i class="fas fa-edit me-2"></i>
          Cambiar Estado del Documento
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label">Nuevo estado:</label>
          <select id="nuevoEstado" class="form-select">
            <option value="en_proceso">En Proceso</option>
            <option value="listo_para_entrega">Listo para Entrega</option>
            <option value="entregado">Entregado</option>
            <option value="nota_credito">Nota de Crédito</option>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label">Motivo del cambio:</label>
          <textarea id="motivoCambioEstado" class="form-control" rows="3" placeholder="Explique por qué se cambia el estado"></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-warning" onclick="ejecutarCambioEstado()">
          <i class="fas fa-edit me-1"></i> Cambiar Estado
        </button>
      </div>
    </div>
  </div>
</div>

{{!-- MODAL DE JUSTIFICACIÓN PARA REVERSIONES - ADMIN --}}
<div class="modal fade" id="modalReversionAdmin" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-warning text-dark">
        <h5 class="modal-title">
          <i class="fas fa-exclamation-triangle me-2"></i>
          Confirmar Reversión de Emergencia
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-danger">
          <strong>⚠️ OPERACIÓN CRÍTICA:</strong> <span id="descripcionAccion"></span>
          <br><small>Esta acción será registrada en auditoría con su usuario y timestamp.</small>
        </div>
        
        <div class="mb-3">
          <label class="form-label fw-bold">Categoría del error: <span class="text-danger">*</span></label>
          <select id="motivoReversionAdmin" class="form-select" required>
            <option value="">Seleccione el motivo...</option>
            <option value="error_humano">Error humano en proceso</option>
            <option value="error_sistema">Error del sistema</option>
            <option value="solicitud_cliente">Solicitud justificada del cliente</option>
            <option value="corrección_datos">Corrección de datos incorrectos</option>
            <option value="procedimiento_urgente">Procedimiento urgente autorizado</option>
            <option value="orden_judicial">Orden judicial o legal</option>
            <option value="otros">Otros (especificar en justificación)</option>
          </select>
        </div>
        
        <div class="mb-3">
          <label class="form-label fw-bold">Justificación detallada: <span class="text-danger">*</span></label>
          <textarea id="justificacionReversionAdmin" class="form-control" rows="4" 
                    placeholder="Explique detalladamente por qué es necesaria esta reversión. Incluya contexto, responsable del error original y impacto. Mínimo 5 caracteres."
                    minlength="5" maxlength="1000" required></textarea>
          <div class="form-text">
            <span id="contadorCaracteresAdmin">0</span>/5 caracteres mínimos (máximo 1000)
          </div>
        </div>
        
        <div class="mb-3">
          <div class="form-check">
            <input type="checkbox" id="confirmarReversionAdmin" class="form-check-input" required>
            <label class="form-check-label" for="confirmarReversionAdmin">
              <strong>Confirmo que:</strong>
              <ul class="mt-1 mb-0">
                <li>Entiendo las consecuencias de esta reversión</li>
                <li>La justificación es veraz y completa</li>
                <li>Esta acción será registrada permanentemente en auditoría</li>
                <li>Acepto la responsabilidad de esta decisión</li>
              </ul>
            </label>
          </div>
        </div>
        
        <div class="alert alert-info">
          <i class="fas fa-info-circle me-2"></i>
          <strong>Registro de auditoría:</strong> Esta reversión será visible en el historial del documento 
          y en la auditoría general del sistema. No se puede deshacer una vez ejecutada.
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
          <i class="fas fa-times me-1"></i> Cancelar
        </button>
        <button type="button" id="btnEjecutarReversionAdmin" class="btn btn-warning" disabled>
          <i class="fas fa-undo me-1"></i> Ejecutar Reversión
        </button>
      </div>
    </div>
  </div>
</div>

{{!-- JavaScript específico admin --}}
<script>
// ============== VARIABLES GLOBALES ADMIN ==============

window.documentoId = {{documento.id}};
window.userRole = 'admin';

// ============== FUNCIONES ADMINISTRATIVAS ESPECÍFICAS ==============

// Función para reasignar matrizador
function reasignarMatrizador(documentoId) {
  console.log('👤 Abriendo modal reasignación matrizador para documento:', documentoId);
  const modal = new bootstrap.Modal(document.getElementById('modalReasignarMatrizador'));
  modal.show();
}

async function ejecutarReasignacion() {
  const nuevoMatrizador = document.getElementById('nuevoMatrizador').value;
  const motivo = document.getElementById('motivoReasignacion').value;
  
  if (!nuevoMatrizador || !motivo) {
    alert('Por favor complete todos los campos');
    return;
  }
  
  try {
    const response = await fetch(`/admin/documentos/${window.documentoId}/reasignar-matrizador`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        matrizador_id: nuevoMatrizador,
        motivo: motivo
      })
    });
    
    const data = await response.json();
    
    if (data.success) {
      alert('✅ Matrizador reasignado correctamente');
      const modal = bootstrap.Modal.getInstance(document.getElementById('modalReasignarMatrizador'));
      modal.hide();
      setTimeout(() => window.location.reload(), 1500);
    } else {
      throw new Error(data.message || 'Error desconocido');
    }
  } catch (error) {
    console.error('❌ Error reasignando matrizador:', error);
    alert(`❌ Error: ${error.message}`);
  }
}

// Función para cambiar estado
function cambiarEstado(documentoId) {
  console.log('📝 Abriendo modal cambio estado para documento:', documentoId);
  const modal = new bootstrap.Modal(document.getElementById('modalCambiarEstado'));
  modal.show();
}

async function ejecutarCambioEstado() {
  const nuevoEstado = document.getElementById('nuevoEstado').value;
  const motivo = document.getElementById('motivoCambioEstado').value;
  
  if (!nuevoEstado || !motivo) {
    alert('Por favor complete todos los campos');
    return;
  }
  
  try {
    const response = await fetch(`/admin/documentos/${window.documentoId}/cambiar-estado`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        estado: nuevoEstado,
        motivo: motivo
      })
    });
    
    const data = await response.json();
    
    if (data.success) {
      alert('✅ Estado actualizado correctamente');
      const modal = bootstrap.Modal.getInstance(document.getElementById('modalCambiarEstado'));
      modal.hide();
      setTimeout(() => window.location.reload(), 1500);
    } else {
      throw new Error(data.message || 'Error desconocido');
    }
  } catch (error) {
    console.error('❌ Error cambiando estado:', error);
    alert(`❌ Error: ${error.message}`);
  }
}

// Función para autorización urgente
function autorizarUrgente(documentoId) {
  console.log('⚡ Autorizando urgente para documento:', documentoId);
  if (confirm('¿Confirma autorizar este documento como urgente?\n\nEsto dará prioridad máxima en el procesamiento.')) {
    // Implementar lógica de autorización urgente
    alert('🚀 Autorización urgente aplicada (función en desarrollo)');
  }
}

// Función para eliminar documento
function eliminarDocumento(documentoId) {
  console.log('🗑️ Iniciando eliminación para documento:', documentoId);
  const motivo = prompt('¿Por qué desea eliminar este documento?\n\nEsta acción requiere justificación:');
  
  if (!motivo) {
    alert('La eliminación requiere un motivo');
    return;
  }
  
  if (confirm('⚠️ ATENCIÓN: ¿Confirma la eliminación?\n\nEsta acción será registrada en auditoría y requiere autorización especial.')) {
    // Implementar lógica de eliminación
    alert('🗑️ Documento marcado para eliminación (función en desarrollo)');
  }
}

// ============== SISTEMA DE REVERSIONES - ADMIN ==============
let tipoReversionActual = '';
let documentoIdActual = '';

function abrirModalReversion(tipoReversion, documentoId) {
  tipoReversionActual = tipoReversion;
  documentoIdActual = documentoId;
  
  // Configurar descripción según tipo de reversión
  const descripciones = {
    'desmarcar_listo': 'Cambiará el estado de "listo para entrega" a "en proceso" y eliminará el código de verificación.',
    'deshacer_entrega': 'Cambiará el estado de "entregado" a "listo para entrega" y limpiará todos los datos de entrega.',
    'separar_grupo': 'Removerá el documento del grupo de notificación, permitiendo notificación individual.',
    'reactivar_documento': 'Restaurará el documento eliminado y lo marcará como "en proceso".'
  };
  
  document.getElementById('descripcionAccion').textContent = descripciones[tipoReversion] || 'Operación de reversión crítica';
  
  // Limpiar formulario
  document.getElementById('motivoReversionAdmin').value = '';
  document.getElementById('justificacionReversionAdmin').value = '';
  document.getElementById('confirmarReversionAdmin').checked = false;
  document.getElementById('btnEjecutarReversionAdmin').disabled = true;
  actualizarContadorAdmin();
  
  // Mostrar modal
  const modal = new bootstrap.Modal(document.getElementById('modalReversionAdmin'));
  modal.show();
}

function actualizarContadorAdmin() {
  const textarea = document.getElementById('justificacionReversionAdmin');
  const contador = document.getElementById('contadorCaracteresAdmin');
  const longitud = textarea.value.length;
  
  contador.textContent = longitud;
  contador.className = longitud >= 5 ? 'text-success' : 'text-danger';
  
  validarFormularioAdmin();
}

function validarFormularioAdmin() {
  const motivo = document.getElementById('motivoReversionAdmin').value;
  const justificacion = document.getElementById('justificacionReversionAdmin').value;
  const confirmacion = document.getElementById('confirmarReversionAdmin').checked;
  
  const esValido = motivo && justificacion.length >= 5 && confirmacion;
  document.getElementById('btnEjecutarReversionAdmin').disabled = !esValido;
}

async function ejecutarReversionAdmin() {
  const motivo = document.getElementById('motivoReversionAdmin').value;
  const justificacion = document.getElementById('justificacionReversionAdmin').value;
  
  if (!motivo || justificacion.length < 5) {
    alert('Por favor complete todos los campos requeridos (mínimo 5 caracteres en justificación)');
    return;
  }
  
  // Deshabilitar botón para evitar doble clic
  const btn = document.getElementById('btnEjecutarReversionAdmin');
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Ejecutando...';
  
  try {
    const response = await fetch(`/admin/documentos/${documentoIdActual}/revertir-estado`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        tipoReversion: tipoReversionActual,
        motivoCategoria: motivo,
        justificacion: justificacion
      })
    });
    
    const data = await response.json();
    
    if (data.success) {
      // Cerrar modal
      const modal = bootstrap.Modal.getInstance(document.getElementById('modalReversionAdmin'));
      modal.hide();
      
      // Mostrar mensaje de éxito
      alert('✅ Reversión ejecutada exitosamente. La página se recargará para mostrar los cambios.');
      
      // Recargar página
      location.reload();
    } else {
      alert('❌ Error: ' + (data.mensaje || data.error || 'No se pudo ejecutar la reversión'));
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-undo me-1"></i> Ejecutar Reversión';
    }
  } catch (error) {
    console.error('Error:', error);
    alert('❌ Error de conexión. Intente nuevamente.');
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-undo me-1"></i> Ejecutar Reversión';
  }
}

// ============== EVENT LISTENERS ==============

document.addEventListener('DOMContentLoaded', function() {
  console.log('👑 Vista admin unificada inicializada');
  
  // Configurar event listeners para reversiones
  const justificacionTextarea = document.getElementById('justificacionReversionAdmin');
  const motivoSelect = document.getElementById('motivoReversionAdmin');
  const confirmarCheck = document.getElementById('confirmarReversionAdmin');
  const btnEjecutar = document.getElementById('btnEjecutarReversionAdmin');
  
  if (justificacionTextarea) {
    justificacionTextarea.addEventListener('input', actualizarContadorAdmin);
  }
  
  if (motivoSelect) {
    motivoSelect.addEventListener('change', validarFormularioAdmin);
  }
  
  if (confirmarCheck) {
    confirmarCheck.addEventListener('change', validarFormularioAdmin);
  }
  
  if (btnEjecutar) {
    btnEjecutar.addEventListener('click', ejecutarReversionAdmin);
  }
  
  console.log('✅ Sistema admin completamente inicializado');
});
</script>

