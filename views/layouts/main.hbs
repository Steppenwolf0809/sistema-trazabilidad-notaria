<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - ProNotary</title>
  
  <!-- Preconnect para optimización de carga de fuentes -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  
  <!-- Google Fonts - Inter (Sistema Tipográfico Unificado) -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <!-- Sistema Tipográfico Unificado ProNotary -->
  <link rel="stylesheet" href="/css/typography.css">
  
  <!-- Tailwind CSS -->
  <link href="/css/tailwind-output.css" rel="stylesheet">
  
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  
  <!-- ProNotary Mobile Responsive System -->
  <link rel="stylesheet" href="/css/mobile-responsive.css">

  <!-- ✨ Paleta de Colores Profesional -->
  <link rel="stylesheet" href="/css/paleta-profesional.css">
  
  <!-- Estilos personalizados -->
  <style>
    /* Sidebar colapsable con gradientes vibrantes */
    .sidebar {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      transition: all 0.3s ease;
      box-shadow: 4px 0 20px rgba(0,0,0,0.1);
    }
    
    .sidebar.collapsed {
      width: 60px !important; /* Reducir de 80px a 60px para consistencia */
    }
    
    .sidebar-item {
      transition: all 0.3s ease;
      border-radius: 12px;
      margin: 4px 8px;
    }
    
    .sidebar-item:hover {
      background: rgba(255,255,255,0.1);
      transform: translateX(4px);
    }
    
    .sidebar-item.active {
      background: rgba(255,255,255,0.2);
      border-left: 4px solid #fbbf24;
    }
    
    .sidebar-text {
      transition: opacity 0.3s ease;
    }
    
    .sidebar.collapsed .sidebar-text {
      opacity: 0;
      width: 0;
      overflow: hidden;
    }
    
    /* Header con gradiente */
    .navbar {
      background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
      box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    }
    
    /* Botón colapsar */
    .collapse-btn {
      transition: all 0.3s ease;
      border-radius: 8px;
    }
    
    .collapse-btn:hover {
      background: rgba(255,255,255,0.1);
      transform: rotate(180deg);
    }
    
    /* Main content responsive */
    .main-content {
      transition: margin-left 0.3s ease;
      margin-left: 250px; /* Reducir de 280px a 250px */
      padding: 15px 20px; /* Optimizar padding para más espacio */
    }
    
    .main-content.expanded {
      margin-left: 60px; /* Reducir de 80px a 60px */
    }
    
    /* Responsive */
    @media (max-width: 1024px) {
      .sidebar {
        transform: translateX(-100%);
        position: fixed;
        z-index: 50;
      }
      
      .sidebar.mobile-open {
        transform: translateX(0);
      }
      
      .main-content {
        margin-left: 0 !important;
      }
    }
  </style>
</head>
<body class="bg-gray-50">
  <!-- Sidebar -->
  <div id="sidebar" class="sidebar fixed left-0 top-0 h-full w-64 text-white z-40" style="width: 250px;"> <!-- Optimizar ancho a 250px -->
    <!-- Logo/Header -->
    <div class="flex items-center justify-between p-4 border-b border-white/10">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center">
          <i class="fas fa-file-contract text-xl"></i>
        </div>
        <div class="sidebar-text">
          <h1 class="text-lg font-bold">ProNotary</h1>
          <p class="text-xs text-white/70">Sistema Notarial</p>
        </div>
      </div>
      <button id="collapseBtn" class="collapse-btn p-2 lg:block hidden">
        <i class="fas fa-chevron-left"></i>
      </button>
    </div>
    
    <!-- Mobile hamburger button (será creado dinámicamente por JS) -->
    
    <!-- Navigation -->
    <nav class="p-4 space-y-2">
      <!-- Dashboard -->
      <a href="/admin" class="sidebar-item active flex items-center space-x-3 p-3 text-white/90 hover:text-white">
        <i class="fas fa-chart-pie w-5"></i>
        <span class="sidebar-text">Dashboard</span>
      </a>
      
      <!-- Documentos Section -->
      <div class="mt-6">
        <p class="sidebar-text text-white/50 text-xs uppercase tracking-wider px-3 mb-2">Documentos</p>
        <a href="/admin/documentos/listado" class="sidebar-item flex items-center space-x-3 p-3 text-white/90 hover:text-white">
          <i class="fas fa-file-alt w-5"></i>
          <span class="sidebar-text">Supervisar Documentos</span>
        </a>
      </div>
      
      <!-- Gestión Section -->
      <div class="mt-6">
        <p class="sidebar-text text-white/50 text-xs uppercase tracking-wider px-3 mb-2">Gestión</p>
        <a href="/admin/matrizadores" class="sidebar-item flex items-center space-x-3 p-3 text-white/90 hover:text-white">
          <i class="fas fa-users w-5"></i>
          <span class="sidebar-text">Matrizadores</span>
        </a>
        <a href="/admin/reportes" class="sidebar-item flex items-center space-x-3 p-3 text-white/90 hover:text-white">
          <i class="fas fa-chart-bar w-5"></i>
          <span class="sidebar-text">Reportes</span>
        </a>
      </div>
      
      <!-- Sistema Section -->
      <div class="mt-6">
        <p class="sidebar-text text-white/50 text-xs uppercase tracking-wider px-3 mb-2">Sistema</p>
        <a href="/admin/auditoria" class="sidebar-item flex items-center space-x-3 p-3 text-white/90 hover:text-white">
          <i class="fas fa-shield-alt w-5"></i>
          <span class="sidebar-text">Auditoría</span>
        </a>
        <a href="/admin/notificaciones/historial" class="sidebar-item flex items-center space-x-3 p-3 text-white/90 hover:text-white">
          <i class="fas fa-bell w-5"></i>
          <span class="sidebar-text">Notificaciones</span>
        </a>
        <a href="/admin/eliminaciones" class="sidebar-item flex items-center space-x-3 p-3 text-white/90 hover:text-white">
          <i class="fas fa-trash-alt w-5"></i>
          <span class="sidebar-text">Eliminaciones</span>
        </a>
      </div>
    </nav>
    
    <!-- Logout -->
    <div class="absolute bottom-4 left-0 right-0 px-4">
      <button onclick="cerrarSesion()" class="sidebar-item w-full flex items-center space-x-3 p-3 text-red-300 hover:text-red-100 hover:bg-red-500/20">
        <i class="fas fa-sign-out-alt w-5"></i>
        <span class="sidebar-text">Cerrar Sesión</span>
      </button>
    </div>
  </div>
  
  <!-- Header -->
  <header class="navbar fixed top-0 right-0 h-16 flex items-center justify-between px-6 text-white z-30" id="header" style="left: 250px;"> <!-- Actualizar left para nuevo ancho -->
    <div class="flex items-center space-x-4">
      <h2 class="text-xl font-semibold">{{title}}</h2>
    </div>
    
    <div class="flex items-center space-x-4">
      <!-- Search -->
      <div class="hidden md:flex items-center space-x-2 bg-white/10 rounded-lg px-3 py-2">
        <i class="fas fa-search text-white/70"></i>
        <input type="text" placeholder="Buscar documentos, clientes..." class="bg-transparent text-white placeholder-white/70 focus:outline-none w-64">
      </div>
      
      <!-- Notifications -->
      <button class="relative p-2 rounded-lg bg-white/10 hover:bg-white/20">
        <i class="fas fa-bell"></i>
        <span class="absolute -top-1 -right-1 bg-red-500 text-xs rounded-full w-5 h-5 flex items-center justify-center">3</span>
      </button>
      
      <!-- Settings -->
      <button class="p-2 rounded-lg bg-white/10 hover:bg-white/20">
        <i class="fas fa-cog"></i>
      </button>
      
      <!-- User -->
      <div class="flex items-center space-x-2 bg-white/10 rounded-lg px-3 py-2">
        <div class="w-8 h-8 bg-green-500 rounded-full flex items-center justify-center">
          <i class="fas fa-user text-sm"></i>
        </div>
        <div class="hidden md:block">
          <p class="text-sm font-medium">Administrador</p>
          <p class="text-xs text-white/70">admin</p>
        </div>
        <i class="fas fa-chevron-down text-sm"></i>
      </div>
    </div>
  </header>
  
  <!-- Main Content -->
  <main id="mainContent" class="main-content pt-16 min-h-screen">
    {{{body}}}
  </main>
  
  <!-- ProNotary Mobile Responsive System JS -->
  <script src="/js/mobile-responsive.js"></script>
  
  <!-- Scripts adicionales -->
  <script>
    // Logout function (integrada con sistema móvil)
    function cerrarSesion() {
      if (confirm('¿Estás seguro de que deseas cerrar sesión?')) {
        // Cerrar sidebar móvil si está abierto
        if (window.ProNotaryMobile && window.ProNotaryMobile.isOpen()) {
          window.ProNotaryMobile.closeSidebar();
        }
        window.location.href = '/auth/logout';
      }
    }
    
    // FUNCIÓN PARA LIMPIAR DATOS ANTIGUOS DE LOCALSTORAGE
    function limpiarDatosAntiguos() {
      localStorage.removeItem('notaria_autorizaciones');
      localStorage.removeItem('notaria_preautorizaciones');
      localStorage.removeItem('sistema_autorizaciones');
      console.log('✅ Datos antiguos de localStorage limpiados');
    }

    // EJECUTAR una vez
    document.addEventListener('DOMContentLoaded', function() {
      limpiarDatosAntiguos();
    });
  </script>
</body>
</html> 