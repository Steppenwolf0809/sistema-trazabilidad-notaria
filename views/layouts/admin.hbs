<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Administración Notarial</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- CSS Personalizados existentes (mantener compatibilidad) -->
  <link rel="stylesheet" href="/css/table-universal.css">
  <link rel="stylesheet" href="/css/notificaciones-legible.css">
  <link rel="stylesheet" href="/css/tabla-documentos-mejorada.css">
  
  <!-- Sidebar Argon Pro CSS -->
  <link rel="stylesheet" href="/css/sidebar-argon.css">
  
  <!-- Paleta de Colores Profesional -->
  <link rel="stylesheet" href="/css/paleta-profesional.css">
  
  <!-- Forzar Sidebar Profesional -->
  <link rel="stylesheet" href="/css/forzar-sidebar.css">
  
  <!-- Dashboard Ejecutivo CSS -->
  <link rel="stylesheet" href="/css/dashboard-ejecutivo.css">
  
  <!-- ProNotary Executive UI Design System -->

  
  <!-- Configuración de Tailwind personalizada -->
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            'sans': ['Inter', 'ui-sans-serif', 'system-ui'],
          },
          colors: {
            // PALETA PROFESIONAL NOTARIAL
            'primary': '#162840',
            'primary-light': '#4E7DA6',
            'primary-dark': '#0d1a2b',
            'secondary': '#BF8C60',
            'secondary-light': '#d4a574',
            'secondary-dark': '#a0734d',
            'success': '#B1C6B8',
            'warning': '#BF8C60',
            'danger': '#a0734d',
            'info': '#4E7DA6',
            'light': '#f8fafc',
            'dark': '#162840',
            'sidebar': '#162840',
            'sidebar-hover': '#4E7DA6',
            'gray-professional': '#D0D7D9',
            'gray-verdoso': '#B1C6B8'
          },
          spacing: {
            '68': '17rem',
            '76': '19rem'
          },
          minHeight: {
            '75': '75vh'
          }
        }
      }
    }
  </script>
  
  <!-- Estilos personalizados para componentes específicos -->
  <style>
    /* Glassmorphism effects */
    .glass {
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }
    
    /* Smooth transitions */
    * {
      transition: all 0.3s ease;
    }
    
    /* Sidebar animations */
    .sidebar-collapsed {
      transform: translateX(-calc(100% - 4rem));
    }
    
    /* Cards with elegant shadows */
    .card-elegant {
      background: white;
      border-radius: 1rem;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
      border: 0;
    }
    
    /* Gradient backgrounds - PALETA PROFESIONAL */
    .bg-gradient-primary {
      background: linear-gradient(135deg, #162840 0%, #4E7DA6 100%);
    }
    
    .bg-gradient-success {
      background: linear-gradient(135deg, #B1C6B8 0%, #D0D7D9 100%);
    }
    
    .bg-gradient-warning {
      background: linear-gradient(135deg, #BF8C60 0%, #d4a574 100%);
    }
    
    .bg-gradient-danger {
      background: linear-gradient(135deg, #a0734d 0%, #BF8C60 100%);
    }
    
    /* Elegant hover effects */
    .hover-lift:hover {
      transform: translateY(-2px);
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
    }
    
    /* Custom scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
    }
    
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 3px;
    }
    
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
    
    /* Estados del sidebar */
    .sidebar-argon.sidebar-collapsed {
      width: 4rem;
    }
    
    .sidebar-argon.sidebar-collapsed .sidebar-text {
      opacity: 0;
      pointer-events: none;
    }
    
    .sidebar-argon.sidebar-collapsed .nav-link-argon {
      justify-content: center;
    }
    
    /* Link activo - PALETA PROFESIONAL */
    .nav-link-argon.active {
      background: linear-gradient(135deg, #BF8C60 0%, #d4a574 100%);
      color: white !important;
      box-shadow: 0 4px 15px rgba(191, 140, 96, 0.4);
    }
    
    .nav-link-argon.active .shadow-soft-2xl {
      background: rgba(255, 255, 255, 0.2) !important;
      backdrop-filter: blur(10px);
    }
    
    .nav-link-argon.active i {
      color: white !important;
    }
    
    /* Hover effects */
    .nav-link-argon:hover:not(.active) {
      background: #f1f5f9;
      transform: translateX(4px);
    }
    
    /* Responsive */
    @media (max-width: 1279px) {
      .sidebar-argon {
        transform: translateX(-100%);
      }
      
      .sidebar-argon.show {
        transform: translateX(0);
      }
    }
    
    /* CONTENIDO PRINCIPAL CON FONDO GRADIENTE RESTAURADO */
    main, .main-content {
      margin-left: var(--sidebar-width);
      transition: margin-left 0.3s ease;
      min-height: 100vh;
    }
    
    /* Cuando sidebar está colapsado */
    body.sidebar-collapsed main,
    body.sidebar-collapsed .main-content {
      margin-left: var(--sidebar-collapsed-width);
    }
    
    /* Variables CSS disponibles globalmente */
    :root {
      --sidebar-width: 250px;
      --sidebar-collapsed-width: 64px;
    }
  </style>
</head>
<body class="font-sans antialiased bg-gray-50 text-slate-500">
  
  <!-- Fondo elegante superior - PALETA PROFESIONAL -->
  <div class="absolute w-full min-h-75" style="background: linear-gradient(135deg, #162840 0%, #4E7DA6 100%);"></div>
  
  <!-- Sidebar elegante para Admin -->
  {{> sidebar-argon 
      dashboardUrl="/admin/dashboard"
      showDocumentosSection=true
      showSupervisarDocumentos=true
      showGestionSection=true
      showMatrizadores=true
      showReportes=true
      reportesUrl="/admin/reportes"
      showSistemaSection=true
      sistemaSectionTitle="Sistema"
      showAuditoria=true
      showEliminaciones=true
      eliminacionesUrl="/admin/auditoria-eliminaciones"
      eliminacionesText="Eliminaciones"
      eliminacionesTooltip="Auditoría de Eliminaciones"
      showNotificaciones=true
      notificacionesUrl="/admin/notificaciones/historial"
      activeDashboard=activeDashboard
      activeListado=activeListado
      activeMatrizadores=activeMatrizadores
      activeReportes=activeReportes
      activeAuditoria=activeAuditoria
      activeEliminaciones=activeAuditoriaEliminaciones
      activeNotificaciones=activeNotificaciones
  }}
  
  <!-- Contenido principal -->
  <main class="main-content relative h-full max-h-screen transition-all duration-200 ease-in-out rounded-xl">
    
    <!-- Navbar superior -->
    {{> navbar-argon}}
    
    <!-- Contenido de la página -->
    <div class="w-full px-6 py-6 mx-auto">
      
      <!-- Alertas del sistema -->
      {{#if error}}
      <div class="flex items-center p-4 mb-4 text-red-800 rounded-lg bg-red-50 border border-red-200">
        <i class="fas fa-exclamation-triangle mr-3"></i>
        <div>
          <span class="font-medium">Error:</span> {{error}}
        </div>
      </div>
      {{/if}}
      
      {{#if success}}
      <div class="flex items-center p-4 mb-4 text-green-800 rounded-lg bg-green-50 border border-green-200">
        <i class="fas fa-check-circle mr-3"></i>
        <div>
          <span class="font-medium">Éxito:</span> {{success}}
        </div>
      </div>
      {{/if}}
      
      <!-- Contenido principal de la página -->
      {{{body}}}
      
    </div>
  </main>
  
  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  
  <!-- Scripts existentes de ProNotary (mantener funcionalidad) -->
  <script src="/js/table-universal.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/fix-badges.js"></script>
  
  <!-- Sidebar Argon Pro JavaScript -->
  <script src="/js/sidebar-argon.js"></script>
  
  <!-- Dashboard Ejecutivo JavaScript -->

  
  <!-- Scripts de compatibilidad ProNotary -->
  <script>
    // Limpiar datos antiguos de localStorage
    function limpiarDatosAntiguos() {
      localStorage.removeItem('notaria_autorizaciones');
      localStorage.removeItem('notaria_preautorizaciones');
      localStorage.removeItem('sistema_autorizaciones');
      console.log('✅ Datos antiguos de localStorage limpiados');
    }
    
    // Ejecutar una vez
    document.addEventListener('DOMContentLoaded', function() {
      limpiarDatosAntiguos();
    });
  </script>
  
</body>
</html> 